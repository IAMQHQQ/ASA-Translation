      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1740485178",
      "Source": "Consume this to permanently unlock the \"Touchdown\" emote. In the end zone, and good for six points!",
