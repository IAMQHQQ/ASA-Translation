    },
    {
      "NamespaceHash": "GraphLiteral::295099173",
      "Source": "You must be in water or snow to refill liquid",
      "Trans": {"SC":"你必须处于水中或积雪上才能补充液体低温液","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1093860654",
      "Source": "You must be near water or snow to refill liquid",
      "Trans": {"SC":"你必须靠近水域或积雪才能补充液体低温液","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3124138627",
      "Source": "Count: ",
      "Trans": {"SC":"数量: ","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
