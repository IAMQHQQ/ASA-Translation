    {
      "NamespaceHash": "Content::1977946177",
      "Source": "Summer Swirl Taffy",
      //夏日活动糖果
      "Trans": {"SC":"夏日漩涡太妃糖","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1924829193",
      "Source": "Taffy Effect",
      "Trans": {"SC":"太妃糖效果","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::329493734",
      "Source": "Summer Swirl Taffy gives your dino a sugar rush and temporarily changes its appearance.\n",
      "Trans": {"SC":"夏日漩涡糖果会让你的恐龙体验甜蜜的冲击, 并且会短暂改变其外观。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3601594501",
      "Source": "Craft this to make random dino candy with a sugar rush and a festive look.\n\nIt looks like taffy, but it tastes like Summer.  ",
      "Trans": {"SC":"制作带有节日气氛和甜蜜刺激的随机恐龙造型糖果。\n\n别看它像颗普通的太妃糖, 但是它尝起来却是有夏天的味道。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1297486973",
      "Source": "Cooler",
      "Trans": {"SC":"冷藏箱","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2991278237",
      "Source": "You can use this to skin the appearance of a small storage box to look like a cooler. For appearance only. Will not chill your beverages.",
      "Trans": {"SC":"你可以使用这个皮肤来改变储物箱的外观, 使其变成冷藏箱的外观。虽然看着像一个冷藏箱, 但它不能为你冷藏你的饮料。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3213115991",
      "Source": "BBQ",
      "Trans": {"SC":"","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1521239192",
      "Source": "You can use this to skin the appearance of a campfire to look like a barbecue grill. How do you like your meat?",
      "Trans": {"SC":"你可以使用这个皮肤来改变篝火的外观, 使其变成烤肉架的外观。你喜欢几分熟的什么口味的烤肉?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::971696828",
      "Source": "Torch Sparkler pa",
      "Trans": {"SC":"满天星火把","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3688658928",
      "Source": "Celebrate a holiday with sparkles! When applied to a Torch, can also be placed as a Wall Torch.",
      "Trans": {"SC":"你可以使用这个皮肤来改变火把的外观。节日庆祝少不了满天星! 也可装在火炬上。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4214349396",
      "Source": "Angler Hat",
      "Trans": {"SC":"渔夫帽","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2368035101",
      "Source": "Sun Visor",
      "Trans": {"SC":"空顶遮阳帽","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2057444184",
      "Source": "You can use this to skin the appearance of a helmet or hat. A sporty way to shield your eyes from sun and sweat.",
      "Trans": {"SC":"你可以使用这个皮肤来改变头盔或帽子的外观。它可以让你在运动时, 避免眼睛受到汗水和阳光的干扰。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::973470131",
      "Source": "Pineapple Sunglasses",
      "Trans": {"SC":"菠萝太阳镜","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4235101789",
      "Source": "You can use this to skin the appearance of a helmet or hat. For a tropic-cool look.",
      "Trans": {"SC":"你可以使用这个皮肤来改变头盔或帽子的外观。营造出一种热带风情的凉爽外观。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3923458791",
      "Source": "Steak Knife",
      "Trans": {"SC":"牛排刀","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3390190360",
      "Source": "You can use this to skin the appearance of a Sword into an oversized steak knife. Quality cutlery is a necessity for fine dining.",
      "Trans": {"SC":"你可以使用这个皮肤来改变剑的外观, 使其变成一把大号的牛排刀的外观。优质的餐具是精致用餐的必需品。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1972071234",
      "Source": "You can use this to skin the appearance of a sword into a steak knife. Quality cutlery is a necessity for fine dining.",
      "Trans": {"SC":"你可以使用这个皮肤来改变剑的外观, 使其变成牛排刀的外观。优质的餐具是精致用餐的必需品。","JA":""},
      //过期
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3412607434",
      "Source": "Balloon Sword",
      "Trans": {"SC":"气球剑","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::159704627",
      "Source": "You can use this to skin the appearance of a sword into a balloon sword. Makes stabbing fun!",
      "Trans": {"SC":"你可以使用这个皮肤来改变剑的外观, 使其变成气球剑的外观。让你的剑挥舞起来更具有趣味性吧!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2671818812",
      "Source": "Sarcos",
      //帝鳄
      "Trans": {"SC":"鳄鳄洞洞鞋","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2284522911",
      "Source": "You can use this to skin the appearance of a pair of boots. These crocs were really big back in the day.",
      "Trans": {"SC":"你可以使用这个皮肤来改变靴子的外观。这种洞洞鞋在之前可是非常流行的呢。","JA":""},
      //碰瓷crocs, 一语双关, 通配符真会玩.
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1194059796",
      "Source": "Puka Shell Bracelet",
      "Trans": {"SC":"普卡贝壳手链","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1485496578",
      "Source": "You can use this to skin the appearance of gloves into a puka shell bracelet. Righteous wristwear with a chill vibe.",
      "Trans": {"SC":"你可以使用这个皮肤来改变手套的外观, 使其变成普卡贝壳手链的外观。这条很棒的手链能给人一种轻松自在的感觉。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::173756413",
      "Source": "Balloon Pickaxe",
      "Trans": {"SC":"气球镐","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4276691829",
      "Source": "Frighten your enemies with this imposing Pickaxe Skin!",
      "Trans": {"SC":"用这款霸气威武的镐子皮肤吓跑你的敌人!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::780531219",
      "Source": "Balloon Hatchet",
      "Trans": {"SC":"气球斧","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2025765327",
      "Source": "You can use this to skin the appearance of a metal or stone hatchet into a balloon hatchet. Chop wood the silly way!",
      "Trans": {"SC":"你可以使用这个皮肤来改变金属斧或石镐的外观, 使其变成气球斧的外观。伐木也变得搞笑起来了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::437298991",
      "Source": "Squirt Gun",
      "Trans": {"SC":"小水枪","JA":""},
      //小手枪
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3758751776",
      "Source": "You can use this to skin the appearance of a fabricated pistol into a water gun. Warning: still fires bullets, despite whimsical appearance.",
      "Trans": {"SC":"你可以使用这个皮肤来改变制式手枪的外观, 使其变成一把小水枪的外观。警告: 别看它外观滑稽, 但是它是真的可以发射子弹!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3417997024",
      "Source": "Water Soaker",
      "Trans": {"SC":"喷水枪","JA":""},
      //喷火器
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::762839191",
      "Source": "You can use this to skin the appearance of a Flamethrower. Someone's getting wet!",
      "Trans": {"SC":"你可以使用这个皮肤来改变火焰喷射器的外观。有人要被淋湿啦!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::568483455",
      "Source": "Fireworks Hat",
      "Trans": {"SC":"烟花帽","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1492982478",
      "Source": "You can use this to skin the appearance of a helmet or hat. Keep headgear away from open flames.",
      "Trans": {"SC":"你可以使用这个皮肤来改变头盔或帽子的外观。注意! 穿戴后请远离明火!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2012725932",
      "Source": "Shark Costume",
      "Trans": {"SC":"鲨鲨套装","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3201504556",
      "Source": "This will override all other skins, acting as a full-body costume. Should always be set on Torso Armor.\r\n\r\nTurn your beach party into a feeding frenzy!",
      "Trans": {"SC":"使用这个皮肤来覆盖其它外观, 充当全身套装。该皮肤装备在躯干或胸甲上。\r\n\r\n让你的海滩派对变成一场饕餮盛宴!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::590039971",
      "Source": "This will override all other skins, acting as a full-body costume. Should always be set on Torso Armor.\n\nTurn your beach party into a feeding frenzy!",
      "Trans": {"SC":"使用这个皮肤来覆盖其它外观, 充当全身套装。该皮肤装备在躯干或胸甲上。\n\n让你的海滩派对变成一场饕餮盛宴!","JA":""},
      //充气霸王龙套装
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
