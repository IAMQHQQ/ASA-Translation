      "Source": "Bloodforge",
      "Trans": {"SC":"血铸熔炉","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::348297323",
      "Source": "Can repair any Item, regardless of where it was made. Can also Reinforce Items above their normal Durability. Requires Tek power to activate.",
      "Trans": {"SC":"可修复任意来源的物品, 还能将物品强化至超出常规耐久上限。需消耗泰克能量才能激活。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3771051270",
      "Source": "Heal your Cryopods here",
      "Trans": {"SC":"这里可以自愈其低温舱","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1251485454",
      "Source": "Cryo Hospital",
      "Trans": {"SC":"低温护理站","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2448346390",
      "Source": "Place Cryopods in this to restore their Health and Food, drain their Torpor, and add Experience over time. Requires Tek power to activate.",
      "Trans": {"SC":"将低温舱放入其中以恢复其生命值和食物, 排出其眩晕值, 并随时间增加经验。需要泰克能量才能激活。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
