    },
    {
      "NamespaceHash": "GraphLiteral::3071732265",
      "Source": "Unstable Combined results always have Quality equal to the average Quality of component Blueprints, but only have a {Chance}% chance to successfully combine",
      "Trans": {"SC":"不稳定合成的结果其品质始终等于“蓝图组件”的平均品质, 但是合成的成功率仅有{Chance}%","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1496749534",
      "Source": "STABLE COMBINE",
      "Trans": {"SC":"稳定合成","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2639799220",
      "Source": "Stable Combined results have Quality up to the average Quality of component Blueprints plus {MaxQuality}%, but can have Quality as low as {MinQuality}% that average",
      "Trans": {"SC":"稳定合成的结果其品质最高可达“蓝图组件”的平均品质+{MaxQuality}%, 但品质也可能低于该平均品质的{MinQuality}%","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
