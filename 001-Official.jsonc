      "NamespaceHash": "Content::1748200588",
      "Source": "You take <RichColor Color=\"1,0,0,1\">{FallDmgMulti}%</> reduced fall damage. When you suffer fall damage, you knockback enemies within 10 meters of you.",
      "Trans": {"SC":"你受到的坠落伤害降低 <RichColor Color=\"1,0,0,1\">{FallDmgMulti}%</>。当你承受坠落伤害时会击退自身范围 10 米内的敌人。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
