    {
      "NamespaceHash": "Content::3337035830",
      "Source": "Remove all items from the inventory, in order to start a game.",
      "Trans": {"SC":"移除物品栏全部物品, 以便开始游戏。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2258257993",
      "Source": "A table for playing poker (either tournament-style or sit-and-go) with up to 6 players.",
      "Trans": {"SC":"一张用于玩扑克牌游戏的桌子 (锦标赛 & 坐下即玩) 最多可容纳6名玩家。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1887456021",
      "Source": "Use to ping a location in the world. Who knows where it leads?",
      //藏宝图
      "Trans": {"SC":"使用这个来定位世界上某个位置。谁知道它会指引到哪里呢?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2028175889",
      "Source": "Use to ping the location of buried treasure. Have this in your inventory when you dig.",
      "Trans": {"SC":"使用这个来定位宝藏埋藏的位置。挖宝的时候记得将此物品放在你的背包里。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2567398833",
      "Source": "Use to ping the location of buried treasure. NOTE: To unbury, you need to have the original map in your inventory when you dig.",
      "Trans": {"SC":"使用这个来定位宝藏埋藏的位置。注意: 为了能顺利的挖出宝藏, 请确保挖掘的时候将原始地图放到你的背包里。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1002357107",
      "Source": "Drag onto C4 to give it the appearance of Dynamite",
      "Trans": {"SC":"将此物品拖拽到C4上, 使其外观看上去像雷管炸药一样。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2809255581",
      "Source": "You can use this to skin the appearance of Ghillie boots. Provides an arid look!  ",
      "Trans": {"SC":"你可以使用这个皮肤来改变吉利靴的外观。提供一种干旱地区风格的外观!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3748230752",
      "Source": "You can use this to skin the appearance of Ghillie gloves. Provides an arid look!",
      "Trans": {"SC":"你可以使用这个皮肤来改变吉利手套的外观。提供一种干旱地区风格的外观!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::46050852",
      "Source": "You can use this to skin the appearance of a Ghillie helmet or hat. Provides an arid look!",
      "Trans": {"SC":"你可以使用这个皮肤来改变吉利面具的外观。提供一种干旱地区风格的外观!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4038413859",
      "Source": "You can use this to skin the appearance of leggings or Ghillie pants. Provides an arid look!",
      "Trans": {"SC":"你可以使用这个皮肤来改变吉利护腿的外观。提供一种干旱地区风格的外观!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1562151948",
      "Source": "You can use this to skin the appearance of a Ghillie shirt or chestpiece. Provides an arid look!",
      "Trans": {"SC":"你可以使用这个皮肤来改变吉利胸甲的外观。提供一种干旱地区风格的外观!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3725918953",
      "Source": "This coffin, which can be placed horizontally or vertically, acts as a respawn point for you and your Tribe. Perfect for pretending you're an undertaker... or a vampire.",
      "Trans": {"SC":"这个棺材可以垂直或平躺着放, 它可以作为你部落的重生点。非常适合假装自己是一位入验师或者是...吸血鬼。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::703098102",
      "Source": "A well-made wooden chair for solo sitting. Looks at home in a Frontier saloon.",
      "Trans": {"SC":"一把制作精良的木椅, 摆在西部风格的酒吧里看起来非常合适。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1670169952",
      "Source": "A simple wooden stool that can be spun around for fun.",
      "Trans": {"SC":"一个简单的旋转凳, 可以为了快乐而转起来。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1004641970",
      "Source": "A well-made wooden table with a variety of uses. Looks at home in a Frontier saloon.",
      "Trans": {"SC":"一张制作精良的木桌, 具有多种用途。摆在西部风格的酒吧里看起来非常合适。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3475713577",
      "Source": "A versatile metal tool. Useful for improving Crop Plots, burying and unburying Treasure Chests, and finding underground water in an emergency.",
      "Trans": {"SC":"一件多功能的金属工具。它可以翻耕土地助于农作物生长和收获的加成, 还可以埋藏或挖掘宝藏以及在紧急的情况挖掘地下水源。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2711656512",
      "Source": "A simple sheet of paper. Perfect for drawing on.",
      "Trans": {"SC":"一张简单的纸张, 非常适合在上面绘画或制图。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3597375703",
      "Source": "A platform cart that can be built on, and pulled by many Creatures.",
      "Trans": {"SC":"这是一个可以拉货的小拖车, 可以在上面放置建筑, 并且多种生物都可以拉动它。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1729516064",
      "Source": "A simple wooden wall sign for basic messages, requires attaching to a ceiling",
      "Trans": {"SC":"一个简单的木制标牌, 用于张贴基本信息, 需要固定到天花板上。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4290684806",
      "Source": "A bell that makes a loud noise when rung, or a quieter noise when hit. Can also be used to make nearby tames defend the area aggressively.",
      "Trans": {"SC":"当它被拉响时会发出响亮的声音, 或当它被敲击的时候也会发出清脆的声音。它还可以让附近已驯服的生物更具有保卫领地的意识。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2251484907",
      "Source": "A fancy leather-covered armchair for solo sitting. Comfortable enough for your most elegant guests.",
      "Trans": {"SC":"一把装饰华丽的皮革扶手椅, 坐起来非常舒服, 适合招待优雅的客人。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2643415373",
      "Source": "An upright piano that can be used to play music. Has volume and range settings.",
      "Trans": {"SC":"一架立式钢琴, 可以用来演奏音乐。带有调节音量和音域的功能。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::217330793",
      "Source": "A metal-encased oil lamp that lights and warms the immediate area. Comes it four variations.",
      "Trans": {"SC":"一个金属外壳的油灯, 能够点亮并为周围区域提供温暖。共有四种不同的款式。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3594771494",
      "Source": "The main engine car for traveling along train tracks, and can pull Platform Cars along with it. Requires Charcoal to run.",
      "Trans": {"SC":"一辆沿着铁路行驶的火车头, 可用于拉动火车厢一起行驶。需要放入煤炭来运行。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2144946588",
      "Source": "A platform train car that can be hold most other Structures. Connect it to a train, and then decorate it however you like.",
      "Trans": {"SC":"一种可以容纳大多数建筑的火车车厢。把它连接到火车上, 然后根据您的喜好进行装饰吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::152581131",
      "Source": "A train track that can be connected to other train tracks to make a train network.",
      "Trans": {"SC":"一段可以连接其它火车网络的火车轨道。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1765422124",
      "Source": "A huge structure for storing water. Stores rain or manually deposited water, and distributes it to nearby structures. Can connect to other water tanks to form a network.",
      "Trans": {"SC":"一个巨大的蓄水建筑,可储存雨水或手动注水, 并将其分配到附近需要用到水的建筑上。可以与其它蓄水池连接形成网络。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2071187938",
      "Source": "Reduces fuel consumption & heat damage of nearby gas generators. Works at low wind speeds, but is more effective at higher wind speeds.",
      "Trans": {"SC":"可为附近的普通发电机减少燃料消耗以及过热导致的损耗。可在低风速状态下运行, 但是在高风速状态效果会更好。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2690614265",
      "Source": "You can use this to skin the appearance of a hat or helmet to look like Frontier-style bowler hat.",
      "Trans": {"SC":"你可以使用这个皮肤来改变头盔或帽子的外观。使其变成一顶具有西部风格的的圆顶硬毡帽。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1839853331",
      "Source": "You can use this to skin the appearance of footwear to look like Frontier-style drifter boots.",
      "Trans": {"SC":"你可以使用这个皮肤来改变靴子的外观。使其变成一双具有西部风格的流浪者靴子。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
