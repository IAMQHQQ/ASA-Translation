      "Trans": {"SC":"热血狂袭","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1746823290",
      "Source": "Gain an Active Ability: Sacrifice {HealthCost} of your current HP, your mount gains {AttackSpeed} melee attack speed for [Duration] seconds.",
      "Trans": {"SC":"获得一个主动技能: 牺牲当前{HealthCost}的生命值, 你的坐骑在[Duration]秒内获得{AttackSpeed}的近战攻击速度","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
