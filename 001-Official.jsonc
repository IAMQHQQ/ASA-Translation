    {
      "NamespaceHash": "Content::1347627642",
      "Source": "Pet Displays",
      "Trans": {"SC":"宠物展示台","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::885961712",
      "Source": "These displays are perfect for showing off your Shoulder-pets, tiny Tames, and Companions--all while providing some health and experience over time. Comes in Nest and Bed varieties",
      "Trans": {"SC":"这个展示架非常适合用来陈列处你的肩宠、小型生物以及你的随伴生物 -- 同时还能持续为它们提供生命值与经验值。可以选择多种小窝的样式哦。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::717958615",
      "Source": "Warbench",
      "Trans": {"SC":"锻造台","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3842467965",
      "Source": "Place Items in this to combine them into an Item more suited to your needs.",
      "Trans": {"SC":"放入物品以合成更符合你需要的物品。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2971904298",
      "Source": "Fabricated Crossbow",
      "Trans": {"SC":"制式弩","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::95910746",
      "Source": "This advanced crossbow can fire most types of arrow/bolt ammunition, and has three firing modes:  Normal, Spread, and Marksman. Can fire underwater.",
      "Trans": {"SC":"这款先进的弩可发射绝大多数类型的箭矢弹药, 并且具备三种发射模式: 普通模式、散射模式和精准狙击模式, 还能在水下进行发射。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::503736875",
      "Source": "Holo-Decoy Grenade",
      "Trans": {"SC":"全息诱饵手雷","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3191173346",
      "Source": "A throwable \"grenade\" that, on impact, creates a hologram version of the Survivor. Any Wild and non-ridden Tame in range will attack it instead of the Player for a small duration.",
      "Trans": {"SC":"一种可投掷的“诱饵手雷”, 当碰撞目标后会显现出一名生存者的全息影像。在短时间内受影响范围的所有野生生物与未被骑乘的驯养生物, 都会转而攻击该全息投影。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
