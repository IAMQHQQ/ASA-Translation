    {
      "NamespaceHash": "GraphLiteral::111885002",
      "Source": "We use Curseforge to support user-generated content in-game. \r\nBy clicking \"I Agree\" you agree to Curseforge's Terms of Use and Privacy Policy. \r\nA new Curseforge account will be created for you using your PlayStation Network ID.",
      "Trans": {"SC":"我们通过 Curseforge 来支持在游戏中使用玩家制作的内容。\r\n点击 \"我同意\" 即表示你同意 Curseforge 的隐私政策和使用条款 \r\n我们会使用你的 PlayStation Network ID 为你创建一个新的 Curseforge 账户。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::7455454",
      "Source": "We use Curseforge to support user-generated content in-game. \r\nBy clicking \"I Agree\" you agree to Curseforge's Terms of Use and Privacy Policy. \r\nA new Curseforge account will be created for you using your account on PlayStation™Network.\r\n\r\nNOTE: User Generated Content has not been rated by any official RATING BOARDS.",
      "Trans": {"SC":"我们通过 Curseforge 来支持在游戏中使用玩家制作的内容。\r\n点击 \"我同意\" 即表示你同意 Curseforge 的隐私政策和使用条款 \r\n我们将使用你在 PlayStation Network 的账户为你创建一个新的 Curseforge 账户。\r\n\r\n注意: 用户原创内容尚未经过任何官方评级机构的评级。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
