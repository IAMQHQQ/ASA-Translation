    },
    {
      "NamespaceHash": "GraphLiteral::828806139",
      "Source": "Increases stomach size and the number of icicles Ossidon can fire during its Icicle Rain.",
      "Trans": {"SC":"提高腹部容量, 并增加奥西顿在冰锥雨中可发射的冰锥数量。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1852504805",
      "Source": "Increases muscle size and the maximum creature size Ossidon can absorb into its Bolus.",
      "Trans": {"SC":"提高肌肉体量, 并提高奥西顿可吸入粘液团的最大生物体型。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2577892782",
      "Source": "Increases claw size.",
      "Trans": {"SC":"提高爪子尺寸。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
