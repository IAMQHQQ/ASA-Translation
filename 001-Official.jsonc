    {
      "NamespaceHash": "GraphLiteral::3880535544",
      "Source": "Meat Depleted - Replenishes in ",
      "Trans": {"SC":"肉类资源已耗尽 - 恢复时间 ","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::687874675",
      "Source": "Bola Immunity", //BUFFNAME
      "Trans": {"SC":"流星锤免疫","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //CoreBlueprints\Buffs\Buff_PostBola
    },
    {
      "NamespaceHash": "Content::3341727011",
      "Source": "You were recently restrained by a Bola, and cannot be restrained by one again.",
      "Trans": {"SC":"你最近已经被流星锤困住过了, 短时间内不会再次被流星锤困住。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
