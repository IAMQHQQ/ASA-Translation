    {
      "NamespaceHash": "Content::4290516598",
      "Source": "Happy Holidays!",
      "Trans": {"SC":"节日快乐!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2087681968",
      "Source": "Candy Cane Spear",
      "Trans": {"SC":"拐杖糖矛","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3890480368",
      "Source": "You can use this to skin the appearance of a Spear or Pike into a sharpened Candy Cane. Just don't pick your teeth with it.",
      "Trans": {"SC":"可以使用这个皮肤来改变长矛或长枪的外观, 使其变得像一根削尖的糖果拐杖。不能用来剔牙哟。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3913091294",
      "Source": "Candy Barricade",
      "Trans": {"SC":"糖果拒马","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::132860579",
      "Source": "You can use this to skin the appearance of a Spike Wall to look like a yummy holiday wall of candy cane spikes. If the pointy ends don't keep them away, the cavities will.",
      "Trans": {"SC":"可以使用这个皮肤来改变拒马的外观, 使其变得像一桩由好吃的拐杖糖尖刺构成拒马。如果尖刺阻挡不住他们, 那么蛀牙一定可以。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1771752379",
      "Source": "Gingerbread Costume",
      "Trans": {"SC":"姜饼人套装","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3399482386",
      "Source": "This will override all other skins, acting as a full-body costume. Should always be set on Torso Armor. Run, run, as fast as you can!",
      "Trans": {"SC":"使用这个皮肤来覆盖其它外观, 充当全身套装。该皮肤装备在躯干或胸甲上。\r\n\r\n快跑, 快跑, 能跑多快就跑多快!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3416932951",
      "Source": "Snowman Hat",
      "Trans": {"SC":"雪人帽","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4142086392",
      "Source": "You can use this to skin the appearance of a helmet or hat. Provides a frosty look.",
      "Trans": {"SC":"你可以使用这个皮肤来改变头盔或帽子的外观。给人一种冷冰冰的感觉。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1382376898",
      "Source": "Winter Gloves",
      "Trans": {"SC":"冬季手套","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::916554249",
      "Source": "You can use this to skin the appearance of gloves. Provides a warm and cozy look!",
