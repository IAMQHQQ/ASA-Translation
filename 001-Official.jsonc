      "Trans": {"SC":"\\n<RichColor Color=\"1, 1, 0, 1\">找到畸变所有\"鲍勃的传奇故事\"笔记来 +5 等级上限</>","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2037342309",
      "Source": "\\n<RichColor Color=\"1, 1, 0, 1\">Find all Bob's Tall Tale Explorer Notes on Scorched Earth for +5 Max Levels</>",
      "Trans": {"SC":"\\n<RichColor Color=\"1, 1, 0, 1\">找到焦土所有\"鲍勃的传奇故事\"笔记来 +5 等级上限</>","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1241223607",
      "Source": "\\n<RichColor Color=\"1, 1, 1, 1\">All Bob's Tall Tale Explorer Notes from Aberration found +5 Max Levels</>",
      "Trans": {"SC":"\\n<RichColor Color=\"1, 1, 1, 1\">畸变所有\"鲍勃的传奇故事\"笔记已找到 +5 等级上限</>","JA":""},
