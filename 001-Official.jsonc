      //黄巾起义
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2615394244",
      "Source": "This will override your shirt, pants, glove, and boot skins, acting as a full-body costume to make you look like Rebel Meiyin Li in 'ARK: The Animated Series'! Should always be set on Torso Armor.",
      "Trans": {"SC":"使用这个皮肤来覆盖其它外观, 充当全身套装, 可装扮成 '方舟：动画' 里的起义的李美盈一样! 该皮肤装备在躯干或胸甲上。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
