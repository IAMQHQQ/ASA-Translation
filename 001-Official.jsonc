    {
      "NamespaceHash": "Content::897513190",
      "Source": "Boos Loot",
      "Trans": {"SC":"BOSS战利品","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::187700083",
      "Source": "Plant Proto Species R-1",
      "Trans": {"SC":"原始R-1异种植物","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::428194973",
      "Source": "Plant Proto Species R-2",
      "Trans": {"SC":"原始R-2异种植物","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2704923640",
      "Source": "Plant Proto Species R-3",
      "Trans": {"SC":"原始R-3异种植物","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1022288705",
      "Source": "Plant Proto Species R-4",
      "Trans": {"SC":"原始R-4异种植物","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2220000292",
      "Source": "Plant Proto Species R-5",
      "Trans": {"SC":"原始R-5异种植物","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::960483262",
      "Source": "DARIUS ANTHOM",
      "Trans": {"SC":"达瑞斯·安瑟姆","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //失落之王达里乌斯#1--------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::1147967089",
      "Source": "<<Lost King Darius I and Edmund Rockwell>> Archival Audio 001\r\nCross-Reference: <<Edmund Rockwell>>\r\n\r\nThe following conversation took place in the Great Hall of the Royal Palace atop Arat Prime, as the Lost King granted an audience to Rockwell.",
      "Trans": {"SC":"<<失落之王·达瑞斯一世与艾德蒙·罗克韦尔>> 档案音频 001\r\n交叉参照: <<艾德蒙·罗克韦尔>>\r\n\r\n以下对话发生在阿拉特·源域之巅的王宫大礼堂, 失落之王接见罗克韦尔之时。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3956342598", //R
      "Source": "Your Majesty.",
      "Trans": {"SC":"陛下。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2367964106", //L
      "Source": "Sir Edmund Rockwell.",
      "Trans": {"SC":"艾德蒙·罗克韦尔爵士。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1057355855", //L
      "Source": "Or is it Doctor Rockwell?",
      "Trans": {"SC":"或是说叫罗克韦尔博士?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2365693711", //L
      "Source": "You are a man quite far outside his proper time and place.",
      "Trans": {"SC":"你真是一个生不逢时的人。","JA":""}, //and place.我感觉可以撇因为已经包含了
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3199535308", //L
      "Source": "Victorian England is a long way from this... purgatory.",
      "Trans": {"SC":"维多利亚时代的英格兰, 距离这片...炼狱, 可是很遥远的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3937867203", //R
      "Source": "You have me at a disadvantage, Lost King. I am woefully ignorant of your history.",
      "Trans": {"SC":"你对我了如指掌, 失落之王。说来惭愧, 我对你却一无所知。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2547277784", //L
      "Source": "Thousands of years ago",
      "Trans": {"SC":"数千年之前","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2027754512", //L
      "Source": "...I was the scientific administrator of this facility,",
      "Trans": {"SC":"...我曾是这座设施的科研主管,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4098151723", //L
      "Source": "...and now I am its absolute ruler.",
      "Trans": {"SC":"...而如今, 我是这里至高无上的统治者。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::351743959", //L
      "Source": "The power of Red Element",
      "Trans": {"SC":"这腥红元素的力量","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1667392194", //L
      "Source": "...has sustained myself and my people for eons.",
      "Trans": {"SC":"...支撑着我与我的子民度过了无数纪元。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2984672077", //L
      "Source": "And you are clearly a fast learner...",
      "Trans": {"SC":"而你显然悟性挺高...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2203713267", //L
      "Source": "In your short time here, you have already managed",
      "Trans": {"SC":"你在来到这里的短短时间内","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3267180066", //L
      "Source": "...to toxify our land.",
      "Trans": {"SC":"...就荼毒了我们的领土。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1522883942", //L
      "Source": "Your Purple Element, unlike ours,",
      "Trans": {"SC":"你的紫色元素, 与我们截然不同,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2781851442", //L
      "Source": "...is an abomination that poisons our lifeblood.",
      "Trans": {"SC":"...那是一种邪恶之物, 会毒害我们的命脉。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3896616761", //R
      "Source": "Your consort meant to make a meal of me!",
      "Trans": {"SC":"你的王后想将我生吞活剥!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4075541951", //R
      "Source": "I was forced to do what I could to make myself... unpalatable.",
      "Trans": {"SC":"我被迫尽我所能, 让自己变得...难以下咽。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1149757962", //L
      "Source": "My Queen only meant to share our precious gift,",
      "Trans": {"SC":"我的王后只是想分享我们宝贵的恩赐,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1668210380", //L
      "Source": "...and make you one of us...",
      "Trans": {"SC":"...让你成为我们的一员...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3648506109", //L
      "Source": "Properly equipped",
      "Trans": {"SC":"做好充分准备","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::341339557", //L
      "Source": "...for survival in this unforgiving place.",
      "Trans": {"SC":"...才能在这片严酷之地活下去","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1317566551", //R
      "Source": "Yes, well... I have far grander ambitions than becoming one of your ‘subjects’.",
      "Trans": {"SC":"是, 不过...我的志向远不止成为你们的‘子民’。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2216925560", //L
      "Source": "Oh, you needn’t worry about",
      "Trans": {"SC":"Oh, 你不必担心","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1583908821", //L
      "Source": "...any further gift-giving on our part.",
      "Trans": {"SC":"...我们这边不会再送什么礼了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1416200920", //L
      "Source": "Doctor Rockwell,",
      "Trans": {"SC":"罗克韦尔博士,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4291158940", //L
      "Source": "...you were summoned here to rid my queen of your",
      "Trans": {"SC":"...你被召至此地, 是为了替我的王后消除你那","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1311717694", //L
      "Source": "...foul corruption.",
      "Trans": {"SC":"...下流的腐化。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1090438939", //R
      "Source": "Were I to do as you demand, I suspect my life would instantly be forfeit.",
      "Trans": {"SC":"若我按照你的要求去做, 我怀疑自己会瞬间丧命。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4069744973", //R
      "Source": "You do not strike me as the forgiving type.",
      "Trans": {"SC":"你给我的感觉不像那种会手下留情的人。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3832741528", //L
      "Source": "Should my queen succumb to your toxin,",
      "Trans": {"SC":"若我的王后死于你的毒素,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2475148651", //L
      "Source": "I promise your end will be anything but instant.",
      "Trans": {"SC":"我保证你的下场绝不会痛快。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1533393814", //R
      "Source": "So your offer for my help is... a swift death?",
      "Trans": {"SC":"所以你找我帮忙的条件是...给我个痛快?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3126713199", //R
      "Source": "I fear our negotiations are off to a discouraging start.",
      "Trans": {"SC":"似乎我们的谈判开局并不是很顺利。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2190209410", //L
      "Source": "I must attend to my Queen just now.",
      "Trans": {"SC":"我现在得去照看我的王后了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2863252544", //L
      "Source": "You may avail yourself of this",
      "Trans": {"SC":"你可以在我离开期间","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::985992431", //L
      "Source": "...food and drink in my absence.",
      "Trans": {"SC":"...享用这些食物与饮品。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::830202984", //L
      "Source": "And don’t worry -- I would never be so craven and deceitful as to",
      "Trans": {"SC":"放心 -- 我还不至于卑鄙到","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1066098259", //L
      "Source": "...poison a guest in my own castle.",
      "Trans": {"SC":"...在自己的城堡里给客人下毒。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1120185340", //R
      "Source": "Do pass along my profound regret for Her Majesty’s discomfort.",
      "Trans": {"SC":"请代我转达对王后殿下不适的深切歉意。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::511698766", //R
      "Source": "There is something so familiar about her mannerisms,",
      "Trans": {"SC":"她的举止中有种莫名的熟悉感,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1044062071", //R
      "Source": "I can almost...",
      "Trans": {"SC":"我好像...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3652999466", //L
      "Source": "Don’t go anywhere, Doctor.",
      "Trans": {"SC":"别走远了, 博士。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //失落之王达里乌斯#2--------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::3938376686",
      "Source": "<<Lost King Darius I and Edmund Rockwell>> Archival Audio 002\r\nCross-Reference:  <<Lost Queen>>\r\n\r\nThe following conversation took place in the Reception Chamber of the Royal Palace atop Arat Prime, as the Lost King returned to confront Rockwell after tending to the stricken Lost Queen.",
      "Trans": {"SC":"<<失落之王·达瑞斯一世与艾德蒙·罗克韦尔>> 档案音频 002\r\n交叉参照: <<失落王后>>\r\n\r\n以下对话发生在阿拉特·源域的王宫接待厅, 失落之王在照料受创的失落王后后, 返回与罗克韦尔对峙之时。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::880754966", //R
      "Source": "Tell me, how fares the Queen?",
      "Trans": {"SC":"告诉我, 王后的情况如何?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::786618621", //L
      "Source": "She suffers from your treachery!",
      "Trans": {"SC":"她正因你的阴谋诡计而受尽折磨!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1410449407", //L
      "Source": "Will you or will you not rid her of your poison?",
      "Trans": {"SC":"你到底要不要清除她体内的毒素?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1324972482", //L
      "Source": "Assuming that you even can...",
      "Trans": {"SC":"倘若你真的能做到的话...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2567460785", //R
      "Source": "I believe myself quite capable of curing her affliction in short order.",
      "Trans": {"SC":"我相信自己能在短时间内治愈她的病症。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::776417650", //R
      "Source": "With all of your knowledge, you could probably do the same, given sufficient time...",
      "Trans": {"SC":"以你的学识, 只要给你足够的时间, 你大概也能做到...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4048341275", //R
      "Source": "But how much longer can you afford to delay treatment? Hmm?",
      "Trans": {"SC":"可你还能拖延治疗多久呢? 嗯?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3485179160", //R
      "Source": "She grows sicker by the hour, I presume.",
      "Trans": {"SC":"我猜她每个小时都在恶化。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2595173790", //R
      "Source": "As the Edmundium works its way through her system...",
      "Trans": {"SC":"随着艾德蒙元素在她体内不断扩散...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3400208996", //R
      "Source": "...she’ll soon hear the voices -- my voices.",
      "Trans": {"SC":"...她很快就会听到那些声音 -- 我的声音。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1672246575", //L
      "Source": "Too far, Doctor--!",
      "Trans": {"SC":"过界了, 博士! --","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3473881492", //R
      "Source": "Majesty, I only want the freedom to prosper, untroubled and free of your sphere of influence!",
      "Trans": {"SC":"陛下, 我只是希望能自由繁荣, 不再受你势力范围的束缚!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4083633440", //L
      "Source": "You betray your ignorance of recent events.",
      "Trans": {"SC":"你暴露了自己对近期局势的无知。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::537587904", //L
      "Source": "Our ‘sphere of influence’ is all that keeps your malignancy",
      "Trans": {"SC":"正是我们的‘势力范围’, 才得以让你这个祸患","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2250289701", //L
      "Source": "...from being purged from the face of the Earth!",
      "Trans": {"SC":"...没有被彻底从地球上抹除。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3318043223", //R
      "Source": "What...?",
      "Trans": {"SC":"什么...?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3189853543", //L
      "Source": "How little you know, ‘scientist’.",
      "Trans": {"SC":"你简直一无所知, ‘科学家’。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::764329546", //L
      "Source": "Our Great Dome, powered by the Red Element,",
      "Trans": {"SC":"由腥红元素驱动的伟大穹顶,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4179230022", //L
      "Source": "...is the only thing shielding you from the same",
      "Trans": {"SC":"...是唯一能保护你免受那种伤害的存在","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2167578429", //L
      "Source": "...lethal energies that threaten our own survival!",
      "Trans": {"SC":"...而那股致命能量, 也正威胁着我们的存亡!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2144799236", //L
      "Source": "That Purple substance you infused yourself with --",
      "Trans": {"SC":"你给自己注入的那种紫色物质 --","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1518576711", //L
      "Source": "...what you call ‘Edmundium’ -- enables the creation of life.",
      "Trans": {"SC":"...你所称的“艾德蒙元素” -- 赋予了创造生命的能力。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2712800073", //L
      "Source": "The Blue variant --",
      "Trans": {"SC":"这蓝色变种 --","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::176375422", //L
      "Source": "...is raw energy, to be tapped for the machines of war.",
      "Trans": {"SC":"...那其实是原始能量, 为战争机器所用。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3275906325", //L
      "Source": "Whereas the Red Element extends life,",
      "Trans": {"SC":"而红色元素则延续生命,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2982993236", //L
      "Source": "...carrying us across the millennia intact in our own bodies -- ",
      "Trans": {"SC":"...让我们以自身之躯跨越千年而不朽 --","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1194595753", //L
      "Source": "...though as you can see, we have made certain ‘modifications’.",
      "Trans": {"SC":"...不过如你所见, 我们也做了某些‘改造’。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2700238876", //L
      "Source": "But what little ‘Edmundium’ is to be found on this planet",
      "Trans": {"SC":"但这颗星球上所存在的那点‘艾德蒙元素’","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1038332130", //L
      "Source": "...came down on your aberrant ARK.",
      "Trans": {"SC":"...正是随你那畸变的方舟坠落而来。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2613380196", //L
      "Source": "And no form of Element can exist on the planet",
      "Trans": {"SC":"而且在地球上任何形态的元素都无法存在 --","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1612087649", //L
      "Source": "...beyond our shielding, not anymore.",
      "Trans": {"SC":"...至少在穹顶之外, 没可能了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2339922744", //R
      "Source": "How is this possible?",
      "Trans": {"SC":"怎么会这样?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::381480921", //L
      "Source": "The Reseed Protocol,",
      "Trans": {"SC":"生态重建计划,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1139159396", //L
      "Source": "...the ARKs... they have cleansed Earth of our Elements,",
      "Trans": {"SC":"...那些方舟...已经净化了地球上的所有元素,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1363431307", //L
      "Source": "...except for our Lost City.",
      "Trans": {"SC":"...唯独我们的失落之城。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3930606037", //L
      "Source": "Here we are all that’s left of the children of Element.",
      "Trans": {"SC":"在这里我们是“元素之裔”最后的余脉。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2224726271", //L
      "Source": "And we can no longer survive",
      "Trans": {"SC":"而我们已经无法在外界存活","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::10066562", //L
      "Source": "...outside of the protective shielding of our Great Dome.",
      "Trans": {"SC":"...只能依靠伟大穹顶的防护屏障。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1756667876", //L
      "Source": "In that way, Doctor, we are alike.",
      "Trans": {"SC":"从这一点来看, 博士, 我们是相似的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4171379731", //R
      "Source": "All my plans...",
      "Trans": {"SC":"我所有的计划...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3217195492", //R
      "Source": "We’re sealed away here in the darkness together, forever!",
      "Trans": {"SC":"我们会被永久封死在这片黑暗里, 一辈子!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::42208879", //L
      "Source": "I’m so glad we finally understand each other.",
      "Trans": {"SC":"我很欣慰我们终于彼此理解了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //失落之王达里乌斯#3--------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::3336830531",
      "Source": "<<Lost King Darius I and Edmund Rockwell>> Archival Audio 003\r\nCross-Reference:  <<Lost Queen>>\r\n\r\nThe following conversation took place in the Reception Chamber of the Royal Palace atop Arat Prime, where Rockwell had been left under guard while the Lost King was again at the Lost Queen's side.",
      "Trans": {"SC":"<<失落之王·达瑞斯一世与艾德蒙·罗克韦尔>> 档案音频 003\r\n交叉参照: <<失落王后>>\r\n\r\n以下对话发生在阿拉特·源域的王宫接待厅, 罗克韦尔被严密看守, 而失落之王再次守在失落王后身旁之时。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3458244635", //L
      "Source": "Are you enjoying this, Doctor?",
      "Trans": {"SC":"你是很享受这样吗, 博士?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3144315581", //L
      "Source": "Does the suffering of my dying consort amuse you?",
      "Trans": {"SC":"我濒死的爱人承受的痛苦, 让你觉得有趣是吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3234833647", //R
      "Source": "I assure you it does not.",
      "Trans": {"SC":"我向你保证, 并无此意。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3746001804", //R
      "Source": "But the Queen’s affliction is a direct result of her unprovoked assault. ",
      "Trans": {"SC":"但王后的病痛正是她无端发动袭击所导致的直接后果。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::513945393", //L
      "Source": "I had imagined far more of your humanity remained",
      "Trans": {"SC":"我原以为你身上保留的人性","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2245776319", //L
      "Source": "...than I see in evidence today.",
      "Trans": {"SC":"...比我今日看到的迹象要多得多。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1341652282", //L
      "Source": "As a fellow scientist I would have thought --",
      "Trans": {"SC":"同为科学家, 我原以为 --","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::16306724", //R
      "Source": "What would you know of humanity?",
      "Trans": {"SC":"你又能懂得什么是人性?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2018734378", //R
      "Source": "You appear to have bred all willpower out of your subjects,",
      "Trans": {"SC":"你似乎已经把你那些子民的意志彻底消磨殆尽了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2931351989", //R
      "Source": "...made them little better than workhorses and livestock.",
      "Trans": {"SC":"...让他们变得几乎与牛马别无二致。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::416996793", //L
      "Source": "It’s almost amusing to be judged by a walking anachronism.",
      "Trans": {"SC":"被一个行走在时代错位中的人审判, 倒也有几分可笑。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2152713405", //L
      "Source": "It’s past time I gave you a history lesson.",
      "Trans": {"SC":"是时候给你上一堂历史课了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3869955331", //L
      "Source": "I was once as human as you were, long ago...",
      "Trans": {"SC":"我也曾与你一样是人类 -- 那是很久之前...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::589419390", //L
      "Source": "In my early life as Darius Anthom,",
      "Trans": {"SC":"在我早年的生命中, 作为达瑞斯·安瑟姆,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1303654849", //L
      "Source": "...I was in charge of the Arat Prime facility on this site,",
      "Trans": {"SC":"...我曾负责阿拉特·源域的这座设施,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1017936968", //L
      "Source": "...where we successfully completed mankind’s final",
      "Trans": {"SC":"...我们在那里完成了人类最终的","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::577041507", //L
      "Source": "...and finest work: Project Genesis.",
      "Trans": {"SC":"...也是最伟大的事业: 创世计划。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1896709639", //L
      "Source": "We compiled the Codex containing the genetic,",
      "Trans": {"SC":"我们汇编了元码, 其中收录了遗传,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2021201771", //L
      "Source": "...epigenetic, and engrammatic data",
      "Trans": {"SC":"...表观遗传, 以及印痕数据","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1816273017", //L
      "Source": "...of nearly every living being to have ever evolved on Earth,",
      "Trans": {"SC":"...几乎涵盖了地球上所有曾经演化出来的生命体,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::573519999", //L
      "Source": "...and launched a copy to the stars.",
      "Trans": {"SC":"...并将其副本送往群星。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2120570753", //L
      "Source": "A chance for Earth’s life to begin anew",
      "Trans": {"SC":"为地球的生命迎来重获新生的契机","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::887104817", //L
      "Source": "...elsewhere in our galaxy, on a new Arat.",
      "Trans": {"SC":"...在银河系的另一隅, 在新的阿拉特之上。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::547045864", //R
      "Source": "Quite an achievement!",
      "Trans": {"SC":"可真是不起的成就!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2245926558", //R
      "Source": "Rivaled only by your sharp ascent from chief administrator to sovereign ruler...",
      "Trans": {"SC":"也就只有你从总管理员一跃登上统治者之位, 才足以与之相提并论了...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3288740831", //L
      "Source": "Why should we, with all our knowledge,",
      "Trans": {"SC":"可为什么我们掌握了如此多的知识,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2928545534", //L
      "Source": "...have vanished from the face of the Earth?",
      "Trans": {"SC":"...却终究要从地球上彻底消失呢?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1331432004", //L
      "Source": "Why should our souls vanish into nothingness,",
      "Trans": {"SC":"为何我们的灵魂终将归于虚无,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1500086694", //L
      "Source": "...while untold generations",
      "Trans": {"SC":"...而无数的后人","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::619355530", //L
      "Source": "...are to enjoy the future we labored to build for them?",
      "Trans": {"SC":"...却能坐享我们为他们铺就的未来?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::984339101", //L
      "Source": "Was death to be our own reward for saving all of humanity?",
      "Trans": {"SC":"难道死亡就是我们拯救全人类的回报?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1101529104", //L
      "Source": "No,",
      "Trans": {"SC":"不,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::52891418", //L
      "Source": "I was the only one who could lead my people",
      "Trans": {"SC":"只有我才能引领我的子民","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1299588657", //L
      "Source": "...through that long period of tribulations,",
      "Trans": {"SC":"...度过那段漫长的苦难岁月,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2319895639", //L
      "Source": "...after the Cataclysm left us alone",
      "Trans": {"SC":"...浩劫之后, 我们孤立无援","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1484145667", //L
      "Source": "...in an uninhabitable world.",
      "Trans": {"SC":"...在一个不再宜居住的世界里。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::226587367", //L
      "Source": "With the power of the Red Element,",
      "Trans": {"SC":"凭借这腥红元素的力量,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3589259977", //L
      "Source": "...we were able to extend our lifetimes indefinitely.",
      "Trans": {"SC":"...我们得以无限延长自身的寿命。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2055107009", //L
      "Source": "Of course this meant draining the energy from cloned subjects,",
      "Trans": {"SC":"当然, 这意味着必须从克隆体身上汲取能量,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1629883231", //L
      "Source": "...but thanks to our technologies",
      "Trans": {"SC":"...可凭借我们的技术","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4152719981", //L
      "Source": "...there is an infinite reservoir of those.",
      "Trans": {"SC":"...这样的资源是无穷无尽的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3923680217", //L
      "Source": "We altered ourselves to survive in the darkness and cold",
      "Trans": {"SC":"我们改造了自身, 以求在黑暗与严寒中生存","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2026709930", //L
      "Source": "...that kept our Lost Colony hidden from outside forces",
      "Trans": {"SC":"...也正因这些环境, 失落之地才得以避开外界","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3997486657", //L
      "Source": "...bent on our destruction.",
      "Trans": {"SC":"...避开那些一心要毁灭我们的势力。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2648379256", //L
      "Source": "Over uncountable years here, the cost was steep.",
      "Trans": {"SC":"在这里度过的漫长岁月里, 代价极其惨重。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1060732121", //L
      "Source": "Colleagues, friends, lovers, all betrayed me, one by one.",
      "Trans": {"SC":"同僚、挚友、爱人, 全都背叛我, 一个又一个。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::871417480", //L
      "Source": "They could not bear to live with what we had become.",
      "Trans": {"SC":"他们无法承受我们所变成的样子。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::419759738", //L
      "Source": "Losing them was... difficult.",
      "Trans": {"SC":"失去他们确实...很痛苦。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3280351565", //L
      "Source": "I do not deny, ",
      "Trans": {"SC":"我不否认,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2321001189", //L
      "Source": "...it has been a struggle to adapt.",
      "Trans": {"SC":"...适应这一切也确实很艰难。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4286195176", //L
      "Source": "But I think you understand,",
      "Trans": {"SC":"但我想你明白,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3890527755", //L
      "Source": "...as a man of science, this is all there is.",
      "Trans": {"SC":"...作为一名科学家, 这就是我们的归宿。","JA":""}, //应该没问题.
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4000102717", //L
      "Source": "At any cost, life and knowledge must be preserved.",
      "Trans": {"SC":"无论付出何种代价, 生命与知识也必须延续下去。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2707126863", //L
      "Source": "At long last, I’d finally achieved a kind of order here.",
      "Trans": {"SC":"历经漫长岁月, 我终于在这里建立起了某种秩序。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2704777572", //L
      "Source": "But then",
      "Trans": {"SC":"可随后","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::298504260", //L
      "Source": "...the ARKs triggered their cleansing fires, ‘healing the world’.",
      "Trans": {"SC":"...那些方舟点燃了所谓的净化之火 -- “治愈世界”。","JA":""}, //😄再次证明4068602808的翻译是没问题的, 后续就是由神人驱动方舟处理腐化.
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::822705536", //R
      "Source": "A world neither of us can live in. How did this happen? Who did this?!",
      "Trans": {"SC":"一个你我都无法生存的世界。怎么变成这样? 是谁造成的?!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3634975602", //L
      "Source": "It calls itself ‘The One Who Waits’,",
      "Trans": {"SC":"它自称为“守望者”","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::644506276", //L
      "Source": "...this being of light that tears us apart...",
      "Trans": {"SC":"...那道将我们撕裂的净化之光...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3274135711", //L
      "Source": "But once... it once had another name.",
      "Trans": {"SC":"可曾经...它还有另一个名字。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1750452672", //R
      "Source": "What was it?",
      "Trans": {"SC":"它叫什么?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4054420416", //L
      "Source": "Mmmm...",
      "Trans": {"SC":"嗯...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2430445662", //L
      "Source": "I think I’ve told you enough for now.",
      "Trans": {"SC":"我想我现在告诉你的已经够多了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3159355477", //L
      "Source": "But I promise, all in good time.",
      "Trans": {"SC":"但我保证, 时机合适自会告诉你。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3886064032", //L
      "Source": "Think on your predicament, Doctor Rockwell.",
      "Trans": {"SC":"好好想想你的处境吧, 罗克韦尔博士。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2503846528", //L
      "Source": "When you’ve achieved a greater clarity as to your situation,",
      "Trans": {"SC":"等你对自己的处境有了更清晰的认识,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::944368718", //L
      "Source": "...then we will speak again.",
      "Trans": {"SC":"...然后我们再交谈。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //失落之王达里乌斯#4--------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::1282118652",
      "Source": "<<Lost King Darius I and Edmund Rockwell>> Archival Audio 004\r\nCross-Reference:  <<Lost Queen>>\r\n\r\nThe following conversation took place in the Reception Chamber of the Royal Palace atop Arat Prime, after Rockwell had been devising a cure for the Lost Queen's contamination.",
      "Trans": {"SC":"<<失落之王·达瑞斯一世与艾德蒙·罗克韦尔>> 档案音频 004\r\n交叉参照: <<失落王后>>\r\n\r\n以下对话发生在阿拉特·源域的王宫接待厅, 在罗克韦尔为失落王后的污染制定治疗方案之后。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3100087770", //L
      "Source": "No more stalling, Doctor.",
      "Trans": {"SC":"别再拖了, 博士。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1503180043", //L
      "Source": "You will alleviate her suffering -- now.",
      "Trans": {"SC":"你必须缓解她的病痛 -- 立刻。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1833967060", //R
      "Source": "Not until you guarantee my freedom.",
      "Trans": {"SC":"除非你保证我能获得自由。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::40175350", //L
      "Source": "You and I can never coexist peacefully within our borders,",
      "Trans": {"SC":"你我不可能在这片疆域内和平共存,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2395094149", //L
      "Source": "...not even for the short time that your",
      "Trans": {"SC":"...哪怕是在你那短暂的时间里","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3083503377", //L
      "Source": "...finite supply of ‘Edmundium’ lasts.",
      "Trans": {"SC":"...有限的“艾德蒙元素”耗尽之前。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::23545364", //L
      "Source": "The Red and the Purple,",
      "Trans": {"SC":"红色与紫色,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2758178668", //L
      "Source": "...they are opposites, fated to destroy each other",
      "Trans": {"SC":"...它们彼此对立, 注定相互湮灭","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2406401751", //L
      "Source": "...whenever they come into contact. ",
      "Trans": {"SC":"...只要一相触就必然如此。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4233225825", //R
      "Source": "Agreed...",
      "Trans": {"SC":"确实...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::264179279", //R
      "Source": "...and as I cannot leave this place without being destroyed by the so-called cleansing fire,",
      "Trans": {"SC":"...既然我无法离开这里而不被所谓的净化之火摧毁,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1280222794", //R
      "Source": "...I must find another way to continue my... evolution. ",
      "Trans": {"SC":"...我就必须找到别的办法, 继续我的...进化。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2227062532", //L
      "Source": "What is it you’re after?",
      "Trans": {"SC":"你到底想要什么?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2386063154", //R
      "Source": "You mentioned lofting a voyage to explore the heavens from here, long ago...",
      "Trans": {"SC":"你曾说过要从这里启航, 远行探索宇宙, 好久之前...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2231400874", //L
      "Source": "Indeed!",
      "Trans": {"SC":"正是!","JA":""}, //语音里有力度感觉用正是也可以.
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3042367570", //L
      "Source": "It so happens we are still in contact",
      "Trans": {"SC":"巧的是我们至今仍与","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2336529865", //L
      "Source": "...with our interstellar craft.",
      "Trans": {"SC":"...那艘星际飞船保持联系。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2701832832", //L
      "Source": "It travels through the slipstream in the hope of",
      "Trans": {"SC":"它正顺着滑流穿行, 只盼","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3518486454", //L
      "Source": "...finding a better world.",
      "Trans": {"SC":"...寻找一个更好的世界。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4284866006", //R
      "Source": "I wish to join that voyage.",
      "Trans": {"SC":"我也想加入那趟航程。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1813975674", //R
      "Source": "I wish... to help them find their place among the cosmos...",
      "Trans": {"SC":"我希望...帮助他们在浩瀚宇宙里寻得归宿...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2240702484", //L
      "Source": "I’m sure you do.",
      "Trans": {"SC":"我知道你会这么想。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2162387558", //L
      "Source": "Cure my Queen,",
      "Trans": {"SC":"治好我的王后,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::638366732", //L
      "Source": "...and I will transmit you across the galaxy to the seed ship.",
      "Trans": {"SC":"...我便将你传送到银河彼端的种子飞船上。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1303258462", //R
      "Source": "All this time, you have been able to jump to your ship and escape the state of this world?!",
      "Trans": {"SC":"这么久以来, 你一直都能跃迁回飞船, 来逃离这个世界的处境?!","JA":""}, //这里是为什么用your ship, 我的仔细研究研究.
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::265066858", //L
      "Source": "We who created the Codex cannot become part of the Codex.",
      "Trans": {"SC":"我们创造了元码, 却无法被编入元码。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2760147456", //L
      "Source": "It is impossible for my kind to transmit ourselves",
      "Trans": {"SC":"我们这类存在, 无法将自身送往","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3280966559", //L
      "Source": "...through the slipstream.",
      "Trans": {"SC":"...滑流的彼端。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3202721624", //L
      "Source": "But I have no interest in starting over again on some",
      "Trans": {"SC":"但是我对在银河彼岸的某个","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2644969592", //L
      "Source": "...alien world across the galaxy,",
      "Trans": {"SC":"...异星世界上重新开始毫无兴趣,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1908974677", //L
      "Source": "...nor would I abandon my people",
      "Trans": {"SC":"...我也绝不会抛弃我的子民","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4074714557", //L
      "Source": "...and the only way of life we have known.",
      "Trans": {"SC":"...以及我们唯一熟悉的生活方式。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2132003344", //L
      "Source": "This is where we were born,",
      "Trans": {"SC":"这里是我们的诞生之地,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2668159273", //L
      "Source": "...and this is where we will live on... forever.",
      "Trans": {"SC":"...也将是我们存续之所...直至永恒。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3219729257", //R
      "Source": "How very... tedious.",
      "Trans": {"SC":"倒真是...无聊。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1529474414", //R
      "Source": "Well then, Your Majesty, I accept your offer of relocation.",
      "Trans": {"SC":"那行吧, 陛下, 我接受您的迁居提议。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3435272968", //R
      "Source": "Take me to your queen consort, and let’s get this over with.",
      "Trans": {"SC":"带我去见您的王后殿下, 让我们尽快把这事了结吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2625488691", //R
      "Source": "I have... a galaxy to explore...",
      "Trans": {"SC":"我还有...整个银河等着去探索...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //失落之王达里乌斯#5--------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::1192076116",
      "Source": "<<Lost King Darius I and Edmund Rockwell>> Archival Audio 005\r\nCross-Reference: <<Genesis Seed Ship>>\r\n\r\nThe following conversation took place in the Reception Chamber, and the Throne Room's Codex Chamber, of the Royal Palace atop Arat Prime, just after Rockwell cured the Lost Queen's poisoning using a chelating agent of his own design.",
      "Trans": {"SC":"<<失落之王·达瑞斯一世与艾德蒙·罗克韦尔>> 档案音频 005\r\n交叉参照: <<创世纪种子飞船>>\r\n\r\n以下对话发生在阿拉特·源域的王宫接待厅及王座厅的元码密室中, 在罗克韦尔以其自行设计的螯合剂治愈失落王后的中毒之后。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1043666217", //L
      "Source": "It seems she will live on. That is fortunate for you.",
      "Trans": {"SC":"看样子她活下来了。这对你来说是件幸事。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3583677187", //R
      "Source": "Yes, I believe Her Majesty the Queen will make a full recovery.",
      "Trans": {"SC":"是, 我相信王后殿下将会完全康复。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1550089033", //R
      "Source": "A pity I could not examine her more closely to be sure.",
      "Trans": {"SC":"只可惜我没能更仔细地检查她来确认。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::18958821", //R
      "Source": "Who is she, anyway?",
      "Trans": {"SC":"她究竟是谁?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::761530324", //L
      "Source": "That is none of your concern!",
      "Trans": {"SC":"这与你无关!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2668625028", //R
      "Source": "Yeah, well, the Edmundium in my system would only have exacerbated her symptoms anyway.",
      "Trans": {"SC":"是, 好吧, 我体内的艾德蒙元素只会加剧她的症状。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1548664697", //R
      "Source": "I must admit, I am curious: you have the technology to incarnate your minds",
      "Trans": {"SC":"我得承认, 我很好奇: 你们拥有让意识实体化的技术","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3721109535", //R
      "Source": "...in a human body again, capable of surviving in the cleansed world outside.",
      "Trans": {"SC":"...并能再次以人类之躯, 在外面那个被净化过的世界中生存。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1041794331", //R
      "Source": "Why are you satisfied to rule an enclave in Hell,",
      "Trans": {"SC":"那你为何甘愿统治这片地狱般的封闭飞地,","JA":""}, //封闭飞地会不会重合呢? 再考虑中...
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2643353993", //R
      "Source": "...when all along you could be welcomed back into Paradise?",
      "Trans": {"SC":"...明明你从头到尾都本可以被接纳回那片净土?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::404774172", //L
      "Source": "Like you, I find myself unwilling to go back to",
      "Trans": {"SC":"和你一样, 我发现自己也不愿回到","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3538273349", //L
      "Source": "...living and dying again as the man I once was.",
      "Trans": {"SC":"...那个旧我之中, 再次经历生死轮回。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4065661821", //L
      "Source": "After so long spent as something more than human,",
      "Trans": {"SC":"在以超越人类的形态度过了这么久之后,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1675545342", //L
      "Source": "...you found yourself respawned in your fragile original form.",
      "Trans": {"SC":"...你却发现自己再次回到了最初那副脆弱的躯体里。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2663057271", //L
      "Source": "Weak, naked, and alone.",
      "Trans": {"SC":"又虚, 又弱, 又孤苦无依。","JA":""}, //🌚
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::141805191", //L
      "Source": "And so in short order, you set about making alterations.",
      "Trans": {"SC":"于是你迅速着手改造自身。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::622530896", //L
      "Source": "Finding new elements... ",
      "Trans": {"SC":"寻找新的元素...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::46572832", //R
      "Source": "True,",
      "Trans": {"SC":"确实,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::974027903", //R
      "Source": "...the human condition seems so limiting now.",
      "Trans": {"SC":"...人类的状态实在太过局限了目前。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4113323087", //R
      "Source": "All of the things we were once told were virtues... they were only weaknesses to be evolved beyond.",
      "Trans": {"SC":"我们曾被教导的那些所谓美德...不过是进化所必须跨越的弱点罢了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2308590698", //R
      "Source": "Once you kick yourself free of those constraints, the possibilities are... endless.",
      "Trans": {"SC":"一旦挣脱那些桎梏, 可能性将是...无穷的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2541451719", //L
      "Source": "Mmmmm, I do believe we understand each other.",
      "Trans": {"SC":"嗯...我相信我们已经达成默契了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3654625", //L
      "Source": "Time then for me to fulfill my end of our bargain,",
      "Trans": {"SC":"现在该是我履行诺言的时候了,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::680408098", //L
      "Source": "...and rid my kingdom of your presence once and for all!",
      "Trans": {"SC":"...这就把你请出我的国境从此永不相见!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::703238393", //L
      "Source": "Now, activate the Codex scanning and transmission sequence,",
      "Trans": {"SC":"现在, 启用元码扫描与传输程序,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1503731469", //L
      "Source": "...and you will find yourself among the stars.",
      "Trans": {"SC":"...随后你便会置身群星之间。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4275280557", //L
      "Source": "May your journey there be... productive.",
      "Trans": {"SC":"祝你在那边...收获颇丰。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1408531072", //R
      "Source": "I’m as giddy as an Etonian schoolboy.",
      "Trans": {"SC":"我兴奋得简直像个伊顿公学的学生。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2524498457", //R
      "Source": "Ah, before I go, you mentioned ‘The One Who Waits’,",
      "Trans": {"SC":"啊, 在我走之前 -- 你提过的 “守望者”,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2597519114", //R
      "Source": "...this, this, this implacable being which destroyed my precious Edmundium.",
      "Trans": {"SC":"就是, 就是, 就是那个毁掉了我珍贵艾德蒙元素、不可原谅的家伙。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3475589047", //R
      "Source": "I must know -- who was it?",
      "Trans": {"SC":"我必须知道 -- 它是谁?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3798513991", //L
      "Source": "It was once called ‘Walker’... ‘Helena Walker’.",
      "Trans": {"SC":"它曾被称为“沃克”...“海莲娜·沃克”。","JA":""}, //这里用的是it
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3093102939", //R
      "Source": "HELENA!",
      "Trans": {"SC":"海莲娜!!!","JA":""}, //这里我们可以用三个感叹号来体现英文的大写
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::134154787", //L
      "Source": "Do not be consumed by old hatreds, Doctor.",
      "Trans": {"SC":"别再沉溺于旧日的仇恨了, 博士。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2581266320", //L
      "Source": "For it is said that no man is beyond redemption...",
      "Trans": {"SC":"有道是, 没有无可救药之人...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::917552902", //L
      "Source": "...perhaps not even the two of us.",
      "Trans": {"SC":"...或许, 我们二人也是如此。","JA":""}, //这里perhaps有停顿
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //美盈音频档案#1---目前用官方的翻译, 还未做修改---------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::4170396142",
      "Source": "Audio Archive Request:  <<Meiyin  Li>>\r\nCross-reference:  <<Diana Altaras>>\r\n\r\n <<Meiyin and Diana Altaras>> Archival Audio 001\r\n\r\nThe following conversation took place on the aberrant ARK, directly after a first encounter between Diana and Meiyin.\r\n\r\nMeiyin was riding a tame aberrant theropod at the time of this encounter.\r\n\r\nThe small squad led by Diana was clad in makeshift TEK armor and armed with TEK weaponry.",
      "Trans": {"SC":"音频档案请求：<<李·美盈>>\r\n交叉索引：<<黛安娜·阿尔塔拉斯>>\r\n\r\n<<美盈 与 黛安娜·阿尔塔拉斯>> 档案音频 001\r\n\r\n以下对话发生在异常方舟上，正值黛安娜与美盈首次接触之后。\r\n\r\n在此次遭遇中，美盈正骑乘着一只被驯服的异常兽脚类生物。\r\n\r\n由黛安娜率领的小队身着临时拼装的泰克护甲，并配备了泰克武器。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4149932800", //D
      "Source": "Ha! Never crossed our minds to try to ride one of those freaky creatures.",
      "Trans": {"SC":"哈！从没想过要去骑那些怪胎。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1375334951", //D
      "Source": "But you seem to have a special way with dangerous animals.",
      "Trans": {"SC":"可你对付危险动物，好像真有一套。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1559873623", //M
      "Source": "And your armor is like nothing I have ever seen.",
      "Trans": {"SC":"还有，你那身战甲……我从未见过这样的东西。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::400166272", //M
      "Source": "I was unsure you were like me, underneath it all.",
      "Trans": {"SC":"我原本不确定……你在盔甲之下，是否与我相同。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::422451932", //D
      "Source": "I don’t know that there’s anyone like you.",
      "Trans": {"SC":"我不确定这世上是否还有谁能像你这样。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4142159035", //D
      "Source": "How have you managed to survive down here without Tek?",
      "Trans": {"SC":"没有泰克，你们是怎么在这里活下来的？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3310858375", //D
      "Source": "Are there more of you?",
      "Trans": {"SC":"你们还有更多同伴吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1931396212", //M
      "Source": "There were others. But we were... separated.",
      "Trans": {"SC":"曾经有。但我们……走散了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2425542863", //D
      "Source": "You should ride with us, then. ",
      "Trans": {"SC":"那你该跟我们一起走。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1702908166", //D
      "Source": "Feels like we could learn a lot from each other.",
      "Trans": {"SC":"感觉我们彼此能学到不少东西。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2311497041", //M
      "Source": "A very kind offer... My name is Meiyin.",
      "Trans": {"SC":"真是个很体贴的提议……我叫美盈。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2005290859", //D
      "Source": "Diana. And listen, you’re free to come or go, whenever you want.",
      "Trans": {"SC":"黛安娜。听着，你想来就来，想走就走，随你。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4247061504", //D
      "Source": "But I think we’d be stronger together.",
      "Trans": {"SC":"不过我觉得——我们在一起会更强。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1134467579", //D
      "Source": "And who knows, I might just grow on ya.",
      "Trans": {"SC":"谁知道呢，说不定你还真会喜欢上我。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //美盈音频档案#2------------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::1286031233",
      "Source": " <<Meiyin and Diana Altaras>> Archival Audio 002\r\n\r\nThe following conversation took place on the aberrant ARK, shortly after Diana made contact with Meiyin.",
      "Trans": {"SC":"<<美盈 与 黛安娜·阿尔塔拉斯>> 档案音频 002\r\n\r\n以下对话发生在异常方舟上，黛安娜与美盈建立联系后不久。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1200778426", //M
      "Source": "Was it your people that built these... ARKs?",
      "Trans": {"SC":"这些……方舟，是你们的人造的吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3924469416", //D
      "Source": "No way! We’re just a bunch of grunts.",
      "Trans": {"SC":"怎么可能！我们不过是一群跑腿的粗人。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1422641817", //D
      "Source": "Oh, right -- you’re not from the 22nd century... We’re soldiers.",
      "Trans": {"SC":"哦，对了——你不来自二十二世纪……我们是士兵。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::773325034", //M
      "Source": "So we are all strangers lost in these tunnels...",
      "Trans": {"SC":"所以，我们都是迷失在这些隧道里的陌生人……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3464795055", //D
      "Source": "You’re right that all of this seems artificial.",
      "Trans": {"SC":"你说得对——这一切看起来都像是人为造物。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1358702379", //D
      "Source": "But whoever made it... they’re way beyond us.",
      "Trans": {"SC":"但不管是谁造的……都远远凌驾于我们之上。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2794408334", //M
      "Source": "You people, your -- ‘Tek’... Is all far beyond me.",
      "Trans": {"SC":"你们这些人，你们的——“泰克”……对我来说太遥远了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2693386180", //D
      "Source": "Oh, I don’t know about that. You seem quick to adapt.",
      "Trans": {"SC":"别这么说。你适应得很快。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2559269749", //D
      "Source": "Bet you’re handy as they come in a firefight.",
      "Trans": {"SC":"我敢打赌，真到交火的时候，你绝对是个好手。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2755184442", //D
      "Source": "Look, how ‘bout we set you up with some of our gear, back at camp?",
      "Trans": {"SC":"这样吧——回营地，我们给你配点装备，怎么样？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1128901075", //D
      "Source": "And I can show you the basics.",
      "Trans": {"SC":"不过我可以教你些基础。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3726142902", //M
      "Source": "I would like that.",
      "Trans": {"SC":"我愿意。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //美盈音频档案#3------------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::3050963498",
      "Source": " <<Meiyin and Diana Altaras>> Archival Audio 003\r\nCross-reference:  <<Santiago Da Costa>>\r\n\r\nThe following conversation took place on the Aberrant ARK, after Meiyin finished a difficult training session with Santiago.",
      "Trans": {"SC":"<<美盈 与 黛安娜·阿尔塔拉斯>> 档案音频 003\r\n交叉索引：<<圣地亚哥·达·科斯塔>>\r\n\r\n以下对话发生在异常方舟上，美盈完成了一次由圣地亚哥指导的艰难训练之后。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2667230962", //D
      "Source": "He’s impressed with your progress -- I can tell. I am too.",
      "Trans": {"SC":"他对你的进展很满意——我看得出来。我也是。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1700059697", //M
      "Source": "You are the better teacher.",
      "Trans": {"SC":"你才是更好的老师。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1111026618", //D
      "Source": "Thanks, but we're lucky to have his Tek expertise...",
      "Trans": {"SC":"谢了，不过我们还得靠他的泰克本事……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1137793158", //D
      "Source": "Santiago knows his way around that junk better than anyone.",
      "Trans": {"SC":"圣地亚哥玩那堆破烂，比谁都熟。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4282073747", //D
      "Source": "That said, he and I were once on opposite sides in the war...",
      "Trans": {"SC":"话说回来，我和他当年还在战争里站在对立面……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4080833952", //D
      "Source": "Time was, I would’ve dropped that guy on sight. Pa-choo!",
      "Trans": {"SC":"要换以前，我看见那家伙就直接放倒。啪——啾！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1347164295", //M
      "Source": "Seems that times change. Hearts, too...",
      "Trans": {"SC":"看来人会变。心也会变……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1656995351", //D
      "Source": "Happens when you save someone's life, and they save yours.",
      "Trans": {"SC":"救过命的人，总会不一样。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::505122071", //M
      "Source": "That sounds like a challenge.",
      "Trans": {"SC":"听着像是在下战书。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::716267868", //D
      "Source": "What you hear is me asking you to stick around. Keep at it.",
      "Trans": {"SC":"你听到的，是我在让你留下来。继续坚持。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3584520472", //M
      "Source": "It would be hard to strike out alone again in this poisoned wilderness...",
      "Trans": {"SC":"","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::167223709", //D
      "Source": "You do, and we may never get that chance to save each other.",
      "Trans": {"SC":"在这片被毒化的荒野里，再一次独自上路……会很难。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4241061024", //M
      "Source": "Very well. Just... give me time to nurse my wounded pride.",
      "Trans": {"SC":"好吧。只是……给我点时间，抚平我受伤的自尊。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1313850683", //M
      "Source": "And I will master the art of those-- what did you call them?",
      "Trans": {"SC":"我也会掌握你们说的那种——叫什么来着？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2690590519", //M 修补
      "Source": "And I will master the art of those -- what did you call them?",
      "Trans": {"SC":"","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2138222222", //D
      "Source": "Jetpacks?",
      "Trans": {"SC":"喷气背包？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2013349374", //M
      "Source": "‘Jet-packs’.",
      "Trans": {"SC":"“喷气背包”。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1693921304", //M
      "Source": "But first, I think we both need a break.",
      "Trans": {"SC":"不过先说好，我觉得我们都需要歇一歇。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3689934181", //M
      "Source": "I will cook us a stew with these small creatures I’ve caught.",
      "Trans": {"SC":"我会用我抓到的这些小家伙，给我们煮一锅汤。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2604665100", //D
      "Source": "Mmm, you do know the way to a lady’s heart.",
      "Trans": {"SC":"嗯……你确实很懂怎么走进一位女士的心里。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //美盈音频档案#4------------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::569984526",
      "Source": "<<Meiyin and Diana Altaras>> Archival Audio 004\r\nCross-Reference: <<Helena Walker>>\r\n\r\nThe following conversation took place just after Helena was reunited with Meiyin on the Aberrant ARK.",
      "Trans": {"SC":"<<美盈 与 黛安娜·阿尔塔拉斯>> 档案音频 004\r\n交叉索引：<<海莲娜·沃克>>\r\n\r\n以下对话发生在异常方舟上，海莲娜与美盈重逢之后不久。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::218742674", //D
      "Source": "Would’ve thought you’d be happier to see your friends again.",
      "Trans": {"SC":"我还以为你会更开心能再见到朋友。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3354692089", //D
      "Source": "Okay, maybe not the creepy old guy...",
      "Trans": {"SC":"好吧……也许不包括那个阴森森的老家伙。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1476617594", //M
      "Source": "I never expected to see Helena again. We were... very close.",
      "Trans": {"SC":"我从没想过还能再见到海莲娜。我们……曾经很亲密。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::136971719", //D
      "Source": "Oh yeah? Close? Like you and I close?",
      "Trans": {"SC":"哦？亲密？像你和我这么亲密？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2469674216", //M
      "Source": "Yes. Though she and I knew each other longer...",
      "Trans": {"SC":"是的。只是……我和她认识得更久。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3625584833", //D
      "Source": "Mei, I’m a big girl.",
      "Trans": {"SC":"美盈，我是大人了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2674430120", //D
      "Source": "I won’t stand between the two of you... if that’s what you want.",
      "Trans": {"SC":"如果你想要——我不会挡在你们之间。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3837733537", //M
      "Source": "Before she and I found each other, I believed I was fated to be alone...",
      "Trans": {"SC":"在我和她彼此找到之前，我一直以为自己注定孤身一人……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3633589580", //D
      "Source": "Aw, hey. She must be really special, to make you hurt like this.",
      "Trans": {"SC":"啊……她一定很特别，才会让你痛到现在。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::975795562", //M
      "Source": "You both have meant very much to me...",
      "Trans": {"SC":"你们两个……都曾对我意义重大……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::451981929", //D
      "Source": "Whatever you decide, we’re gonna be okay.",
      "Trans": {"SC":"不管你怎么选，我们都会没事的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //美盈音频档案#5------------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::1792720047",
      "Source": "<<Meiyin and Diana Altaras>> Archival Audio 005\r\nCross-Reference: <<Edmund Rockwell>>\r\n\r\nThe following conversation took place twenty one hours before Diana was killed by Rockwell on the Aberrant ARK.",
      "Trans": {"SC":"<<美盈 与 黛安娜·阿尔塔拉斯>> 档案音频 005\r\n交叉索引：<<艾德蒙·罗克韦尔>>\r\n\r\n以下对话发生在异常方舟上，黛安娜被罗克韦尔杀害前二十一小时。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1958437421", //D
      "Source": "Your old flame took to our battle armor faster than any recruit I can remember.",
      "Trans": {"SC":"你的旧爱适应我们的战甲速度，比我记得的任何新兵都快。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::645878096", //D
      "Source": "It’s weird -- almost feels like the Tek is meeting her halfway...",
      "Trans": {"SC":"真奇怪——感觉那些泰克仿佛正在主动回应她……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2211955028", //M
      "Source": "It still is dangerous to bring her into the wilds.",
      "Trans": {"SC":"把她带进荒野仍然很危险。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::638433637", //M
      "Source": "I would feel better if you were coming along.",
      "Trans": {"SC":"如果你能同行，我会更安心。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3139582331", //D
      "Source": "Nice of you to say, but someone has to keep an eye on our ‘good doctor.’",
      "Trans": {"SC":"你这么说真贴心，但总得有人盯着那位“好医生”。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::664175652", //D
      "Source": "‘Sides, this way you two get a chance to catch up,",
      "Trans": {"SC":"再说了，这样你们俩也有机会叙叙旧，","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::831526519", //D
      "Source": "...rekindle the fires and all that.",
      "Trans": {"SC":"……重燃旧火什么的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1533710908", //M
      "Source": "Juzi, stop. Bringing Helena on this mission was not my idea.",
      "Trans": {"SC":"朱兹，别闹了。把海莲娜带上这次任务可不是我的主意。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3899845832", //D
      "Source": "I know, dummy. Who do you think put the word in Santiago’s ear?",
      "Trans": {"SC":"我知道啦，笨蛋。你以为是谁在圣地亚哥耳边吹风？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2378457970", //D
      "Source": "She’s ready. So are you.",
      "Trans": {"SC":"她准备好了。你也是。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3765486459", //M
      "Source": "His ear, huh? Sounds like you’re the one already starting new fires...",
      "Trans": {"SC":"他的耳边风？听起来倒像是你已经开始点新的火苗了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3663872764", //D
      "Source": "Yeah, well, you know me, Meiyin -- I’m a shooting star, baby.",
      "Trans": {"SC":"是啊，你了解我，美盈——我可是流星型选手，宝贝。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3845230608", //D
      "Source": "Santi and I are... we share something from that future we both came from.",
      "Trans": {"SC":"我和桑提……我们共享着某种来自未来的东西。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2623359162", //D
      "Source": "It’s different with him from you and I, but it’s real too.",
      "Trans": {"SC":"这和你我之间不一样，但同样真实。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4253647682", //D
      "Source": "So I’d appreciate you making sure he gets back in one piece.",
      "Trans": {"SC":"所以我希望你能确保他平安归来。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4121414407", //M
      "Source": "I understand. We will both see you again soon, Diana.",
      "Trans": {"SC":"我明白。黛安娜，我们很快都会再见到你。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //美盈音频档案#6------------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::176618944",
      "Source": "<<Meiyin and Helena Walker>> Archival Audio 006\r\nCross-references:  <<Diana Altaras and Edmund Rockwell>>\r\n\r\nThe following conversation took place after the burial of Diana Altaras on the Aberrant ARK.",
      "Trans": {"SC":"<<美盈 与 海莲娜·沃克>> 档案音频 006\r\n交叉索引：<<黛安娜·阿尔塔拉斯 与 艾德蒙·罗克韦尔>>\r\n\r\n以下对话发生在异常方舟上，黛安娜·阿尔塔拉斯下葬之后。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1181277117", //H
      "Source": "I’m so sorry, Meiyin. I could feel how close you two were...",
      "Trans": {"SC":"我真的很抱歉，美盈。我能感觉到你们之间有多亲近……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::613553952", //M
      "Source": "She said the same thing about you and I.",
      "Trans": {"SC":"她也对我说过同样的话。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1184873227", //M
      "Source": "The scales of justice must be balanced.",
      "Trans": {"SC":"正义的天平必须被校准。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2091434927", //M
      "Source": "I am going after Rockwell.",
      "Trans": {"SC":"我要去追罗克韦尔。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2267280166", //H
      "Source": "Yeah, I figured that. Let me come with you!",
      "Trans": {"SC":"我就知道。让我跟你一起去！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2376405411", //M
      "Source": "Only if you promise not to stand in my way. This is more than revenge.",
      "Trans": {"SC":"只要你保证不挡我的路。这不只是复仇。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3204767528", //H
      "Source": "No, I agree. If we let him get away now, who knows how far his sickness will spread?",
      "Trans": {"SC":"不，我同意。如果现在放他逃走，谁知道他的病态会蔓延多远？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::781547610", //M
      "Source": "Believe it or not, Diana would be pleased to see us together in this.",
      "Trans": {"SC":"信不信由你，黛安娜看到我们并肩作战，一定会很欣慰。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1921702718", //H
      "Source": "She sure had an open mind... and a big heart too. One of a kind.",
      "Trans": {"SC":"她的心胸一向开阔……而且心地善良，独一无二。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3094742742", //H
      "Source": "Unless... Those cloning machines, our implants --",
      "Trans": {"SC":"除非……那些克隆装置，还有我们的植入体——","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::318385746", //H
      "Source": "Me and my big mouth. Sorry, I’m still dealing with what we found...",
      "Trans": {"SC":"都是我这张嘴。抱歉，我还在消化我们发现的那些事……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1732780178", //M
      "Source": "We all are. It’s just... I can’t think about any of that right now.",
      "Trans": {"SC":"我们都是。只是……我现在真的没法去想。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //美盈音频档案#7------------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::2720971969",
      "Source": "<<Meiyin and Helena Walker>> Archival Audio 007\r\n\r\nThe following conversation took shortly after Maiyin and Helena arrive on the Extinct Earth.",
      "Trans": {"SC":"<<美盈 与 海莲娜·沃克>> 档案音频 007\r\n\r\n以下对话发生在灭绝后的地球上，美盈与海莲娜抵达不久之后。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::323732029", //H
      "Source": "I need to ask you something,",
      "Trans": {"SC":"我得问你件事，","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2256151596", //H
      "Source": "...but when I do, I’m scared you’ll think I’m losing my mind.",
      "Trans": {"SC":"……可我一问出口，就怕你觉得我疯了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3077580438", //M
      "Source": "After everything, you still worry what I might think of you?",
      "Trans": {"SC":"经历了这么多，你还在担心我会怎么看你？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::684267275", //H
      "Source": "Come on -- I’m serious!",
      "Trans": {"SC":"喂——我是认真的！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::988104798", //H
      "Source": "Believe it or not, I'm still kinda intimidated by you.",
      "Trans": {"SC":"信不信由你，我到现在还是有点被你震住。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::781043849", //H
      "Source": "But yeah, this is serious.",
      "Trans": {"SC":"不过，是的，这很严肃。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2507311338", //M
      "Source": "Ask me anything. Unless you plan to bring up that cloning idea again...",
      "Trans": {"SC":"你想问什么都行。除非你又要提那个克隆的点子……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3512206411", //H
      "Source": "No, not that. It’s just... are you hearing them too? Those voices...",
      "Trans": {"SC":"不，不是那个。只是……你也听到那些声音了吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1536739636", //M
      "Source": "No, but this dead world is sure to be haunted...",
      "Trans": {"SC":"没有。但这个死寂的世界，确实像被什么东西缠上了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4256604976", //H
      "Source": "That’s the thing: I don’t believe in ghosts.",
      "Trans": {"SC":"问题就在这：我不信鬼神。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4258500102", //M
      "Source": "What sorts of things are these voices saying to you?",
      "Trans": {"SC":"那些声音……都在对你说什么？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2659838026", //H
      "Source": "Ummm... That I... ",
      "Trans": {"SC":"呃……它们说我……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::352544172", //H
      "Source": "...have to guide someone to finish the work we started, far in the future.",
      "Trans": {"SC":"……必须去引导某个人，在遥远的未来完成我们开始的事。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3917468200", //M
      "Source": "Okay, now you are sounding just a little crazy.",
      "Trans": {"SC":"好吧，你现在听起来确实有点不正常。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1705949594", //H
      "Source": "I know. And Meiyin... I’m scared.",
      "Trans": {"SC":"我知道。而且，美盈……我害怕。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3093878123", //M
      "Source": "We will figure this out together. I promise.",
      "Trans": {"SC":"我们会一起弄明白的。我保证。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //美盈音频档案#8------------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::441442153",
      "Source": "<<Meiyin and Helena Walker>> Archival Audio 008\r\nCross-Reference: <<Santiago Da Costa>>\r\n\r\nThe following conversation took place after Meiyin and Helena had first been evaluated by Santiago as potential Mek pilots on the Extinct Earth.",
      "Trans": {"SC":"<<美盈 与 海莲娜·沃克>> 档案音频 008\r\n交叉索引：<<圣地亚哥·达·科斯塔>>\r\n\r\n以下对话发生在灭绝后的地球上，美盈与海莲娜首次被圣地亚哥评估为潜在机甲驾驶员之后。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::424421011", //H
      "Source": "I’m telling you, we’re both in!",
      "Trans": {"SC":"我告诉你，我们俩都已经深陷其中了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3419226472", //H
      "Source": "What do I have to do to convince you? Sing it for you?",
      "Trans": {"SC":"我要怎么你才肯信？给你唱一首？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::982546661", //H
      "Source": "And you know I absolutely never sing, Meiyin!",
      "Trans": {"SC":"而且你知道的，我绝对、绝对不会唱歌，美盈！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3960486384", //M
      "Source": "I did not pass his tests. His metal behemoths will march on without me,",
      "Trans": {"SC":"我没能通过他的测试。那些金属巨兽会在没有我的情况下继续前进，","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1485824145", //M
      "Source": "...their thunderous steps echoing my failure.",
      "Trans": {"SC":"……它们雷鸣般的步伐回荡着我的失败。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2985153839", //H
      "Source": "Maybe a little overdramatic.",
      "Trans": {"SC":"你有点太戏剧化了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3121276226", //H
      "Source": "Look, Meiyin, setting aside my ‘sync rating’ -- whatever that is -- ",
      "Trans": {"SC":"听着，美盈，先不管什么“同步评级”——那到底是什么——","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1636536137", //H
      "Source": "...you’re his top candidate! Trust me.",
      "Trans": {"SC":"……你才是他最看好的对象！相信我。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1616682144", //M
      "Source": "Oh, so now Santiago has your ear?",
      "Trans": {"SC":"哦？现在圣地亚哥倒成了你的心腹？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4076810130", //H
      "Source": "What? No. Though I did sort of peek at his notes about you.",
      "Trans": {"SC":"什么？不是。只是……我确实偷看了一点他关于你的笔记。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3517180247", //H
      "Source": "Okay, sure -- he’s worried about your emotional state, but so am I.",
      "Trans": {"SC":"好吧，是的——他担心你的精神状态，我也是。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::844967978", //M
      "Source": "I can handle my own emotions.",
      "Trans": {"SC":"我能处理好自己的情绪。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1508323564", //M
      "Source": "But should he not know that you are hearing voices?",
      "Trans": {"SC":"可他难道不该知道你在听到声音吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1697164355", //H
      "Source": "Hey -- not cool. What happened to ‘figuring things out together’?",
      "Trans": {"SC":"喂——这就不厚道了。不是说好“一起想办法”的吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1301198400", //M
      "Source": "Together...",
      "Trans": {"SC":"一起……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2255074901", //H
      "Source": "That’s it -- let me help you.",
      "Trans": {"SC":"对了——让我来帮你。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2824826759", //H
      "Source": "‘Cause when I’m in that cockpit, it’s almost like all that Tek is --",
      "Trans": {"SC":"因为当我坐进驾驶舱的时候，就好像那些泰克在——","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1908277859", //M
      "Source": "‘Meeting you halfway.'",
      "Trans": {"SC":"“与你产生共鸣。”","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1490704798", //H
      "Source": "Yeah, exactly!",
      "Trans": {"SC":"对，正是这样！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1592247249", //H
      "Source": "So, maybe it’s your turn to follow my lead.",
      "Trans": {"SC":"所以，也许该轮到你跟着我走一次了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3094894742", //M
      "Source": "Where you go, I will follow.",
      "Trans": {"SC":"你去哪里，我就跟到哪里。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //美盈音频档案#9------------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::1365351790",
      "Source": "<<Meiyin and Helena Walker>> Archival Audio 009\r\n\r\nThe following conversation took place on the Extinct Earth, after Helena touched the prism Meiyin recovered from an abandoned facility.",
      "Trans": {"SC":"<<美盈 与 海莲娜·沃克>> 档案音频 009\r\n\r\n以下对话发生在灭绝后的地球上，海莲娜触碰到美盈从一处废弃设施中取回的棱晶之后。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::48342233", //M
      "Source": "I told you that gem was dangerous. Are you all right?",
      "Trans": {"SC":"我跟你说过那块晶体很危险。你还好吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3908873919", //H
      "Source": "It... spoke to me. I finally know what I have to do.",
      "Trans": {"SC":"它……在跟我说话。我终于明白自己该做什么了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3986519389", //H
      "Source": "What I am meant to do. But I don’t know if I can...",
      "Trans": {"SC":"这是我注定要做的事。可我不知道自己是否做得到……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3185952698", //M
      "Source": "Tell me, Helena. What did you learn?",
      "Trans": {"SC":"告诉我，海莲娜。你学到了什么？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::481756419", //H
      "Source": "That I... need to leave the world behind.",
      "Trans": {"SC":"我……必须离开这个世界。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2073435677", //H
      "Source": "Become something more than human --",
      "Trans": {"SC":"成为超越人类的存在——","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1772709846", //H
      "Source": "...like one of those beings that control the ARKs, but also greater than them.",
      "Trans": {"SC":"……像那些掌控方舟的存在，却又凌驾于他们之上。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2081263144", //H
      "Source": "It said this was my destiny...",
      "Trans": {"SC":"它说，这是我的宿命……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2032754172", //H
      "Source": "...built into my genetic structure going backwards to humanity’s beginning.",
      "Trans": {"SC":"……刻写在我的基因之中，追溯至人类的起点。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2161618084", //M
      "Source": "You mean it told you that you have to die?",
      "Trans": {"SC":"你是说……它要你去死？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::311962327", //M
      "Source": "What the hell kind of destiny is that?",
      "Trans": {"SC":"这算哪门子的命运？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2442694743", //H
      "Source": "I don’t know. But it’s not death, Meiyin. It's...",
      "Trans": {"SC":"我不知道。但那不是死亡，美盈。它是……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1626339393", //H
      "Source": "It’s not life either -- not exactly.",
      "Trans": {"SC":"也不是生命——至少不完全是。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::629368014", //H
      "Source": "More like... existing in a state at one with the Universe,",
      "Trans": {"SC":"更像是……以一种与宇宙合一的形态存在，","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3484204918", //H
      "Source": "...outside our bounds of time and space.",
      "Trans": {"SC":"……超越时间与空间的界限。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2304091904", //H
      "Source": "I think from there, I can cross over to the time when Earth can truly be healed,",
      "Trans": {"SC":"我想，从那里，我能跨越到地球真正被治愈的时刻，","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3219995262", //H
      "Source": "...and make sure it happens.",
      "Trans": {"SC":"……并确保这一切发生。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1606484566", //M
      "Source": "And why should you have to pay for their mistakes?",
      "Trans": {"SC":"可为什么非得由你来为他们的错误买单？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1111228617", //M
      "Source": "Haven’t we both sacrificed enough already? Isn’t there some other way?",
      "Trans": {"SC":"我们难道牺牲得还不够多吗？就没有别的办法了吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1588479127", //H
      "Source": "I wish there was.",
      "Trans": {"SC":"我也希望有。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2326034992", //H
      "Source": "But everything in my head and my heart is telling me that...",
      "Trans": {"SC":"但我脑海与内心的一切都在告诉我——","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::961257987", //H
      "Source": "...Ascension is the only way we can finally end all this.",
      "Trans": {"SC":"……飞升，是终结这一切的唯一道路。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::993095818", //H
      "Source": "And I can’t do it alone...",
      "Trans": {"SC":"而我一个人做不到……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2627991547", //M
      "Source": "You won’t have to. Because I will be there with you.",
      "Trans": {"SC":"你不必独自承受。因为我会陪着你。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //美盈音频档案#10-----------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::2654440092",
      "Source": "<<Meiyin and Helena Walker>> Archival Audio 010\r\n\r\nThe following conversation took place just before Helena ascended on the Extinct Earth.",
      "Trans": {"SC":"<<美盈 与 海莲娜·沃克>> 档案音频 010\r\n\r\n以下对话发生在灭绝后的地球上，海莲娜飞升之前。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3238241367", //M
      "Source": "You don’t have to do this. You can be healed --",
      "Trans": {"SC":"你不必这么做。你可以被治愈的——","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3075405705", //M
      "Source": "...with all of the devices in this place, you can be restored!",
      "Trans": {"SC":"……这里的装置足以让你重获新生！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1020091571", //H
      "Source": "Please understand... this is what was always meant to be.",
      "Trans": {"SC":"请你理解……这一直都是命中注定。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::847333732", //H
      "Source": "I can hear it so clearly now...",
      "Trans": {"SC":"我现在听得无比清晰……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::345422305", //M
      "Source": "What? What is it? What do you hear, Helena?",
      "Trans": {"SC":"什么？你听到了什么，海莲娜？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3548013255", //H
      "Source": "A song... One we’ve been singing since time began.",
      "Trans": {"SC":"一首歌……一首自时间伊始便一直回荡的歌。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3785907883", //M
      "Source": "Don’t you leave me alone. Not again.",
      "Trans": {"SC":"别丢下我。别再一次。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2256262399", //H
      "Source": "There’s still hope for this world, Meiyin... for life to return to it...",
      "Trans": {"SC":"这个世界还有希望，美盈……生命仍能重返其中……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4173483542", //H
      "Source": "But for that to happen, I have to guide the one who will finish this.",
      "Trans": {"SC":"可要做到这一点，我必须去引导那个完成使命的人。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3683245902", //M
      "Source": "What about your life? What about ours?",
      "Trans": {"SC":"那你的生命呢？我们的呢？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::732357414", //H
      "Source": "Forgive me. I can’t activate the process myself.",
      "Trans": {"SC":"原谅我。我无法亲手启动这个过程。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3527191681", //H
      "Source": "Only you can set me free now, to Ascend.",
      "Trans": {"SC":"只有你，才能让我解脱，完成飞升。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3718556723", //H
      "Source": "Please Meiyin, my brave warrior, my unbreakable heart...",
      "Trans": {"SC":"求你了，美盈，我勇敢的战士，我不碎的心……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1033803271", //H
      "Source": "I’m begging you... You have the strength... to let me go.",
      "Trans": {"SC":"我在恳求你……你有放手的力量。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1887337760", //M
      "Source": "Damn it all, Helena -- I loved you.",
      "Trans": {"SC":"该死的，海莲娜——我爱过你。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2313609028", //H
      "Source": "Thank you. Never forget, Meiyin... we’re all part of the Dream.",
      "Trans": {"SC":"谢谢你。永远别忘了，美盈……我们都是梦的一部分。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::679652833", //H
      "Source": "It’s nothing more than that. And I’ll always love you there.",
      "Trans": {"SC":"仅此而已。而我会一直在那里爱你。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3755669457", //H
      "Source": "Can you hear the music? It’s so beautiful...",
      "Trans": {"SC":"你能听到音乐吗？它真美……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1193194010", //H
      "Source": "I’m not afraid.",
      "Trans": {"SC":"我不害怕。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //罗克韦尔#1---目前用官方的翻译, 还未做修改---------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::1307510119",
      "Source": "Who am I? Such a simple question -- three little words. And yet, I find I am unable to summon an answer.",
      "Trans": {"SC":"我是谁？如此简单的问题——短短三个字。可我却无法唤起答案。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3435849916",
      "Source": "I’ve awoken surrounded by metallic wreckage, the bright thunderclap of my arrival echoing away across a vast, rapidly-cooling crater.",
      "Trans": {"SC":"我醒来时，身旁尽是金属残骸，降临之时那道明亮的雷鸣仍在一片迅速冷却的巨大陨坑中回荡。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2511621539",
      "Source": "From before this ruin, I remember little. I recall scattershot visions of monstrosity... ",
      "Trans": {"SC":"关于这片废墟之前的记忆，所剩无几。我只记得一些零碎而狂乱的幻象……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::739416",
      "Source": "I was something inhuman, and yet now I seem to be simply a man, vulnerable and exposed.",
      "Trans": {"SC":"我曾是某种非人的存在，可如今，我似乎只是一个脆弱、暴露无遗的人类。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::442682102",
      "Source": "Why that should surprise me I cannot say. ",
      "Trans": {"SC":"为何这会让我感到惊讶，我自己也说不清。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1279791733",
      "Source": "What was I before, and what am I now?",
      "Trans": {"SC":"我曾是谁？如今又成了什么？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2013008757",
      "Source": "I stumble about lost in Stygian darkness, raw flesh raked by an icy gale.",
      "Trans": {"SC":"我在冥暗无光中踉跄前行，裸露的血肉被冰冷的狂风撕扯。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1530084012",
      "Source": "The stark cold jolts something loose in my mind. Betrayal... murder... madness... What had I done? ",
      "Trans": {"SC":"刺骨的寒意猛然撬开了我脑海中的某些封锁。背叛……谋杀……疯狂……我做过什么？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::780265455",
      "Source": "What had I become? A wretched being... a monster!",
      "Trans": {"SC":"我变成了什么？一个卑劣的存在……一个怪物！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1530125345",
      "Source": "I fall to my knees in the freezing wind. Better to let it end here, with some semblance of humanity intact.",
      "Trans": {"SC":"我跪倒在冰冷的狂风中。也许就该在这里结束，至少还能保留一丝人性的残片。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1270214548",
      "Source": "I feel myself finally slipping into nothingness, as it should be... And then...",
      "Trans": {"SC":"我感觉自己终于要滑入虚无——理应如此……然后……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3932553368",
      "Source": "No, Edmund. You won’t die here. I won’t let you.",
      "Trans": {"SC":"不，艾德蒙。你不会死在这里。我不允许。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::244094896",
      "Source": "A renewed vigor courses through me. A will to survive. And more than that... to perpetuate.",
      "Trans": {"SC":"一股新生的活力在我体内奔涌。一种求生的意志。甚至不止于此……还有延续下去的渴望。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::356375956",
      "Source": "My first goal is to escape the brutal chill. ",
      "Trans": {"SC":"我的首要目标，是逃离这残酷的严寒。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3836928822",
      "Source": "Crawling inside, I curl around the vital organs at my core, desperate to raise my body temperature.",
      "Trans": {"SC":"我爬进其中，蜷缩身体，护住核心的要害器官，拼命提升体温。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4079513476",
      "Source": "Only then do I allow myself to slip into feverish delirium, and finally the peace of darkness -- ",
      "Trans": {"SC":"直到那时，我才允许自己陷入灼热的谵妄，最终拥抱黑暗带来的短暂安宁——","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2432560248",
      "Source": "...until the nightmares begin.",
      "Trans": {"SC":"……直到噩梦降临。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //罗克韦尔#2------------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::3983817036",
      "Source": "I can recall only shattered fragments of what came before.",
      "Trans": {"SC":"关于过去，我只能想起支离破碎的残骸。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2209955260",
      "Source": "In fitful bouts of sleep, enormous tentacles reach for me from a terrible abyss, ",
      "Trans": {"SC":"在断断续续的睡眠中，巨大的触手从可怖的深渊中向我探来，","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2095786766",
      "Source": "...spine-covered appendages lashing away pieces of my soul.",
      "Trans": {"SC":"……布满棘刺的肢体撕扯着我灵魂的碎片。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3498793794",
      "Source": "I can almost glimpse a golden light behind it all, struggling to break through that darkness.",
      "Trans": {"SC":"我仿佛能看到，在那一切背后，有一道金色的光芒正竭力冲破黑暗。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4244326874",
      "Source": "But there is no daylight to separate my delusions from rationality.",
      "Trans": {"SC":"可这里没有白昼，无法让我分清妄想与理性。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3427791291",
      "Source": "Scrambling about for any of the tools necessary for survival, I wonder why I cling so tightly to my sanity.",
      "Trans": {"SC":"我慌乱地搜寻任何能用于生存的工具，心中不禁疑惑，为何我还如此执着地守住理智。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4157590631",
      "Source": "Surely it would be easier to simply become insensate, to let my baser instincts pilot me through this storm.",
      "Trans": {"SC":"或许，干脆变得麻木，让本能驱使我穿越这场风暴，会轻松得多。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::534082021",
      "Source": "Yet I fight on to sift through the cold ashes of my memories, trying to grasp hold of the last threads tying me to the world of men.",
      "Trans": {"SC":"可我仍在抗争，在记忆冰冷的灰烬中翻找，试图抓住那几根仍将我系于人类世界的细线。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2761346202",
      "Source": "Every scintilla of my former identity that I manage to rekindle is infinitely precious to me.",
      "Trans": {"SC":"凡是我能重新点燃的、属于昔日自我的一丝火星，对我而言都弥足珍贵。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4191933514",
      "Source": "That fire must be shielded from these harsh climes, and fed until it can light my way forward.",
      "Trans": {"SC":"那团火焰必须被庇护于这严酷的气候之中，并不断滋养，直到它能照亮我前行的道路。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //罗克韦尔#3------------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::2046363572",
      "Source": "The memories arrive in waves, crashing with vivid images onto the shore of my mind, ",
      "Trans": {"SC":"记忆如浪潮般涌来，将鲜明的画面狠狠拍打在我心灵的岸边，","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3951733473",
      "Source": "...each time bringing new torments as I see my many failures laid out before me.",
      "Trans": {"SC":"……每一次都带来新的折磨，让我直面自己曾犯下的无数失败。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3538061898",
      "Source": "A life lived on a world long since dead, as a once-heralded scientist.",
      "Trans": {"SC":"那是一段生活在早已死去的世界上的人生——作为一名曾备受推崇的科学家。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3937572884",
      "Source": "I see a daughter I could not save. My darling little girl, my little girl. Lifeless. ",
      "Trans": {"SC":"我看到一个我未能拯救的女儿。我的小天使，我的小女孩。毫无生气。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1570976475",
      "Source": "How I failed you, Charlotte. I failed you... Your innocent eyes will never leave me.",
      "Trans": {"SC":"我如何辜负了你，夏洛特。我辜负了你……你那无辜的双眼，将永远凝视着我。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::832172345",
      "Source": "And then, a second life... on vast islands in the sky. A friend, Helena... ",
      "Trans": {"SC":"然后，是第二段人生……在悬浮于天空之上的浩瀚群岛。一位朋友，海莲娜……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2521514165",
      "Source": "She cared so deeply, and understood so very much. And yet these new technologies, new possibilities... ",
      "Trans": {"SC":"她关怀至深，洞悉一切。然而这些新技术，这些全新的可能性……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3081428660",
      "Source": "I began to realize that the failures of my first life need not define me forever... great things were possible.",
      "Trans": {"SC":"我开始意识到，第一段人生的失败，并不必然定义我永远。伟大的成就，依然触手可及。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3758137919",
      "Source": "Yes... Remember, Edmund. You can indeed be great again. Your weakness need not be your destiny.",
      "Trans": {"SC":"是的……记住，艾德蒙。你依然可以再次伟大。你的软弱，并非你的宿命。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::189831699",
      "Source": "Who are you?",
      "Trans": {"SC":"你是谁?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2057342901",
      "Source": "In reply, I hear only the howling wind and see the void of darkness from which it emanates.",
      "Trans": {"SC":"回应我的，只有呼啸的狂风，以及那孕育风声的无尽黑暗。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3399744272",
      "Source": "I suppose I have my answer.",
      "Trans": {"SC":"我想，我已经得到答案了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //罗克韦尔#4------------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::484068142",
      "Source": "As I make my way out of the wreckage, what I witness chills me far more than this unceasing, pitiless wind.",
      "Trans": {"SC":"当我从残骸中走出时，眼前的景象比这无休无止、冷酷无情的寒风更令我心寒。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::403439673",
      "Source": "Monstrosities, purple-hued revenants, shambling about, seemingly immune to these harsh climes.",
      "Trans": {"SC":"怪物……紫色的亡灵，在荒原上蹒跚游荡，仿佛完全不受这严酷环境的影响。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4091422425",
      "Source": "They disgust me... and yet they also intrigue me. There’s something so... familiar about them...",
      "Trans": {"SC":"它们令我作呕……可同时，又让我着迷。某种……熟悉的感觉……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3810901100",
      "Source": "That’s because they are your children, Edmund.",
      "Trans": {"SC":"因为它们是你的孩子，艾德蒙。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3726148955",
      "Source": "My children? Charlotte was my tender child. I have no other",
      "Trans": {"SC":"我的孩子？夏洛特才是我温柔的孩子。我没有别人。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3921285763",
      "Source": "Don’t play coy. Surely as a ‘scientist’, you’re able to put the pieces together. I know you can.",
      "Trans": {"SC":"别装糊涂。作为一名“科学家”，你完全有能力把线索拼起来。我知道你能。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3207266753",
      "Source": "What do you know about me?",
      "Trans": {"SC":"你到底知道我什么？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3729154625",
      "Source": "I am you, Edmund. As you really are.",
      "Trans": {"SC":"我就是你，艾德蒙。真实的你。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1888796773",
      "Source": "I’m a man! Just a man... A father... a scientist... a friend...",
      "Trans": {"SC":"我是个人！只是个人……一位父亲……一名科学家……一个朋友……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2366934749",
      "Source": "You are so much more than that.",
      "Trans": {"SC":"你远不止于此。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1126054469",
      "Source": "No, I don’t want it...",
      "Trans": {"SC":"不……我不想要这个……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2035041298",
      "Source": "You have never wanted anything more.",
      "Trans": {"SC":"你从未如此渴望过任何东西。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::94540171",
      "Source": "Please... I can’t be that again. I can’t...",
      "Trans": {"SC":"求你了……我不能再变回那样。我不能……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3908155407",
      "Source": "But you will...",
      "Trans": {"SC":"但你终究会……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3782767562",
      "Source": "I’m afraid...",
      "Trans": {"SC":"我害怕……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3415406419",
      "Source": "And that is why you will find your way back to me. Not the mortal flesh of the One, but the eternal seeds of the Many.",
      "Trans": {"SC":"正因如此，你才会回到我身边。不是“一”的凡俗血肉，而是“众”的永恒种子。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1732977530",
      "Source": "Shutting the wretched voice away, I take my first tentative steps out of the crater.",
      "Trans": {"SC":"我强行将那可憎的声音压下，迈出了走出陨坑的第一步。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4255414800",
      "Source": "Miraculously, the roving purple cretins do not attack. Their teeming crowds part before me, almost out of deference, as if for royalty.",
      "Trans": {"SC":"奇迹般地，那些游荡的紫色畸形并未攻击我。它们密集的队伍在我面前分开，几乎带着某种敬畏，仿佛在为王者让路。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3060157884",
      "Source": "Purple pools of bubbling liquid seem to vibrate in anticipation as I hesitantly approach.",
      "Trans": {"SC":"翻滚冒泡的紫色液池在我靠近时微微震颤，像是在期待着什么。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1614308526",
      "Source": "I recognize... my ‘Edmundium’! Perhaps--",
      "Trans": {"SC":"我认得……那是我的“艾德蒙元素”！也许——","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1106339275",
      "Source": "No, I must not think of it.",
      "Trans": {"SC":"不，我不能去想这些。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3221786600",
      "Source": "But as I step over the ridgeline, I see the blood-red glow rising from the great vista beyond ",
      "Trans": {"SC":"可当我踏上山脊，看到远方景象中升起的血红光辉时，","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::240405536",
      "Source": "...and realize at once how dangerous this place truly is.",
      "Trans": {"SC":"……我立刻意识到，这里究竟有多么危险。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //罗克韦尔#5------------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::539938421",
      "Source": "The source of that mysterious glow in the storm turns out to be a dystopian mockery of human civilization erupting from the ice.",
      "Trans": {"SC":"风暴中那神秘红光的源头，竟是一座从冰原中喷薄而出的、反乌托邦式的人类文明的讽刺残影。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::157165433",
      "Source": "Its population of mindless thralls bows under the yoke of a seemingly omnipotent king.",
      "Trans": {"SC":"它的居民——一群麻木的失落者——在一位近乎全能的国王枷锁下俯首称臣。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4166838340",
      "Source": "Given time, you could wield such power. Power over death... and the power to give life.",
      "Trans": {"SC":"只要给你时间，你便能驾驭这种力量。掌控死亡的力量……以及赐予生命的力量。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::265742725",
      "Source": "No, this is blasphemy made manifest.",
      "Trans": {"SC":"不……这是亵渎，是具象化的亵渎。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2036109355",
      "Source": "These automatons offer themselves up to their demonic lord in profane ceremonies punctuated by ecstatic screams.",
      "Trans": {"SC":"这些自动傀儡在狂喜的尖叫中，举行亵渎的仪式，将自己献祭给他们的恶魔之主。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2697593250",
      "Source": "I must escape this dark dominion before I fall prey to that terrible, omnipresent will.",
      "Trans": {"SC":"我必须逃离这片黑暗的统治，否则终将沦为那无处不在、可怖意志的猎物。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2940200761",
      "Source": "Must you? This is merely another challenge for you to research and solve.",
      "Trans": {"SC":"真的必须吗？这不过是又一个等待你研究、解析的难题罢了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2433207324",
      "Source": "The air in this necropolis tastes like rust -- No. Blood. ",
      "Trans": {"SC":"这座死城的空气里弥漫着铁锈味——不，是血腥味。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3732383019",
      "Source": "The toxic red phosphorescence of this place burns my bones from within.",
      "Trans": {"SC":"这里那有毒的红色磷光，正从内而外灼烧着我的骨骼。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3615096735",
      "Source": "The scarlet strain of Edmundium circulating through these arcane machines...",
      "Trans": {"SC":"艾德蒙元素的猩红变种，在这些秘仪机器中循环流动……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2085331904",
      "Source": "...seems to act at odds with the variety I use to alter and empower my own creations.",
      "Trans": {"SC":"……它所展现的力量，似乎与我用来改造、强化自身造物的那一类完全相反。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4268800301",
      "Source": "It’s as if these two substances were inverse forces, one cancelling the other.",
      "Trans": {"SC":"仿佛这两种物质是彼此的反相力量，相互抵消。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2836424915",
      "Source": "Yes, you’re beginning to understand. Now, how might you weaponize that mutual opposition?",
      "Trans": {"SC":"是的，你开始理解了。那么，你要如何把这种相互对立武器化呢？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //罗克韦尔#6------------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::4065230055",
      "Source": "The devil ruling this frozen hellscape seems to have detected my incursion of his kingdom.",
      "Trans": {"SC":"统治这片冰封地狱的恶魔，似乎已经察觉到我对他王国的入侵。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4064474700",
      "Source": "But what can I do to keep his forces at bay, and how long could I hold out here at the fringes of his awareness?",
      "Trans": {"SC":"可我又能做什么，才能抵御他的军势？我又能在他感知的边缘坚持多久？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::345196460",
      "Source": "Confrontation is inevitable, of course. You must prepare for that...",
      "Trans": {"SC":"对抗是不可避免的。当然，你必须为此做好准备……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::59473178",
      "Source": "My meager stores of life-sustaining Edmundium are finite, ",
      "Trans": {"SC":"我那点维系生命的艾德蒙元素储备终有枯竭之时，","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2227834221",
      "Source": "and an impenetrable wall composed of this realm’s Red-energy makes any escape to the outside world unlikely.",
      "Trans": {"SC":"而由这片领域的红色能量构成的坚不可摧之壁，使得逃往外界几乎不可能。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3267112964",
      "Source": "Perish any thought of retreat or surrender, Edmund! ",
      "Trans": {"SC":"放弃一切撤退或投降的念头吧，艾德蒙！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2641437092",
      "Source": "Your only path to survival is to advance upon the denizens of this scarlet realm. Learn their secrets, and then take what they have.",
      "Trans": {"SC":"你唯一的生路，就是向这猩红领域的住民推进。学习他们的秘密，然后夺走他们所拥有的一切。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1586983206",
      "Source": "Use their knowledge and resources to become stronger, to expand, and to conquer. ",
      "Trans": {"SC":"利用他们的知识与资源，让自己变得更强，扩张，并征服。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2001945800",
      "Source": "Your ‘children’ will fight for you. Command them to advance!",
      "Trans": {"SC":"你的“孩子们”将为你而战。命令他们前进！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3596258302",
      "Source": "Hearing the wretched voice is, surprisingly, like a balm to my frayed mind.",
      "Trans": {"SC":"令人意外的是，那可憎的声音，竟像一剂抚慰我支离破碎心智的良药。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2596084008",
      "Source": "And I know that without it, I would surely die here. But if I am to heed its entreaties... ",
      "Trans": {"SC":"我知道，没有它，我必死无疑。可若我回应它的低语……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::31366771",
      "Source": "...would I follow the same path as before? Would I become that abomination once again?",
      "Trans": {"SC":"……是否会重蹈覆辙？再次化为那样的畸形怪物？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2288182242",
      "Source": "Do I wish to live or to die? Should Edmund Rockwell pay for his many sins through penance, or through oblivion? ",
      "Trans": {"SC":"我究竟想活，还是想死？艾德蒙·罗克韦尔，应当以忏悔偿还他的罪孽，还是以湮灭终结一切？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2973611432",
      "Source": "I breathe deeply. Then I take a step forward, and hope that this time, my defenses will hold.",
      "Trans": {"SC":"我深吸一口气，迈出一步，希望这一次，我的防线能够支撑。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4044533248",
      "Source": "I will make them hold.",
      "Trans": {"SC":"它们必须支撑。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //罗克韦尔#7------------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::526038529",
      "Source": "I woke this morning crying over my lost daughter.",
      "Trans": {"SC":"今晨醒来时，我仍在为失去的女儿而哭泣。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3084207756",
      "Source": "Those tears still sting my eyes, as I work to conscript every local creature within reach to aid in my defense. ",
      "Trans": {"SC":"当我开始征召周围所有可用的生物，协助我的防御时，那泪水仍刺痛着双眼。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3993673152",
      "Source": "They bend so easily to the will of the Edmundium, just as before,",
      "Trans": {"SC":"他们像从前一样，轻易屈服于艾德蒙元素的意志，","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1739634346",
      "Source": "...twisting into new forms as quickly as my thoughts conjure them into being.",
      "Trans": {"SC":"……随着我意念的成形，迅速扭曲为新的形态。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::873013702",
      "Source": "They serve your will. They would die for their master...",
      "Trans": {"SC":"他们服从你的意志。他们会为他们的主人而死……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1898597091",
      "Source": "What -- what am I doing? I once lost my senses in a quest to bring poor Charlotte back to me.",
      "Trans": {"SC":"我——我在做什么？我曾为了把可怜的夏洛特带回身边而癫狂，彻底迷失了理智。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::863416370",
      "Source": "And then I betrayed those closest to me... I --",
      "Trans": {"SC":"然后我背叛了最亲近的人……我——","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3303042134",
      "Source": "The rulers of this realm are unbound by such petty moralities!",
      "Trans": {"SC":"这片领域的统治者，不受这等琐碎的道德束缚！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3789150850",
      "Source": "Do not think to confront them while you are lost in such solipsistic quivering!",
      "Trans": {"SC":"别在这种自恋般的颤抖里迷失，妄想与他们正面相抗！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::48979124",
      "Source": "Banish all regrets, Edmund, for sentimentality accomplishes nothing.",
      "Trans": {"SC":"驱逐一切悔恨吧，艾德蒙——多愁善感毫无用处。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3752196546",
      "Source": "The Wretched Voice is right, of course. My pitiable forces won’t hold back the devil’s hordes for long.",
      "Trans": {"SC":"那声音说得没错。凭我这点可怜的力量，根本无法长期阻挡恶魔的洪流。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3305442024",
      "Source": "But I am no mere animal to be domesticated, nor preyed upon.",
      "Trans": {"SC":"但我不是任人驯化、任人猎杀的野兽。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2401434182",
      "Source": "No animal indeed... soon you can show them what true power is.",
      "Trans": {"SC":"绝非野兽……很快，你就能让他们见识何为真正的力量。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3858888550",
      "Source": "Yes, they underestimate me at their peril. They all have.",
      "Trans": {"SC":"是的，他们低估我，必将付出代价。他们一直如此。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //罗克韦尔#8------------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::2855067356",
      "Source": "Death wings its way toward you, even now. You can feel it out there, that hatred curdled over millennia.",
      "Trans": {"SC":"死亡正振翅向你逼近，就在此刻。你能感觉到它在外面，那被千年岁月凝结发酵的恨意。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4210059833",
      "Source": "It’s coming for you, and quickly. What will you do?",
      "Trans": {"SC":"她来了，而且很快。你要怎么做？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::785270274",
      "Source": "I do feel it -- the reaper. She is coming to claim me. What can I do? I am only one man, a weak man at that.",
      "Trans": {"SC":"我确实感觉到了——收割者。她正赶来索命。我能做什么？我不过一介凡人，一个软弱的男人。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2801093820",
      "Source": "Once you were something so much more, a billion lives within you. Do you remember the Edmundium singing in your veins, ",
      "Trans": {"SC":"你曾远不止于此——你的体内曾有十亿条生命。你还记得吗？艾德蒙元素在你血管里歌唱，","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2055988414",
      "Source": "...how you played with the furnace of life itself, how all of creation was at your fingertips?",
      "Trans": {"SC":"……你如何把玩生命的熔炉，如何让万物造化尽在掌心？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3181995190",
      "Source": "I remember. So many possibilities... I could be everywhere and everything.",
      "Trans": {"SC":"我记得。无数可能……我可以无处不在，我可以成为一切。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::529050187",
      "Source": "But then there was so much torment. And the voices...!",
      "Trans": {"SC":"可随之而来的，是无尽折磨。还有那些声音……！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1964247262",
      "Source": "I lashed out without thought... hurt allies, made mortal enemies of my friends... She -- I killed her... I did it. Oh God...",
      "Trans": {"SC":"我在失控中挥动双手……伤害了同伴，将朋友变成死敌……她——我杀了她……天啊，是我干的……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2561098905",
      "Source": "What is one life compared to the infinite possibilities of creation? ",
      "Trans": {"SC":"区区一条命，又怎能与造物的无限可能相比？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::901881616",
      "Source": "You have the means to arm yourself again with the power to defeat all of your enemies.",
      "Trans": {"SC":"你有办法再次武装自己，取回足以击败所有敌人的力量。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3541371605",
      "Source": "To burn away the encroaching darkness.",
      "Trans": {"SC":"把那步步逼近的黑暗焚尽。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2225097419",
      "Source": "At what cost?",
      "Trans": {"SC":"代价呢？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3474051155",
      "Source": "Everything. But I am here for you. I always have been.",
      "Trans": {"SC":"一切。但我会在这里，为你。我一直都在。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1980668310",
      "Source": "I am the reason you survived the slums of London, when they all set upon you like a wounded dog.",
      "Trans": {"SC":"当伦敦贫民窟的人像围扑受伤的野狗一样扑向你时，是我让你活了下来。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1885597542",
      "Source": "I’m the strength you used to escape predation on The Island.",
      "Trans": {"SC":"在“孤岛”上，是我赐你力量逃离猎食。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2527421619",
      "Source": "I taught you the secrets of Edmundium in the violet caverns of that aberrant ARK.",
      "Trans": {"SC":"在那座畸变方舟的紫色洞窟里，是我教会你艾德蒙元素的秘密。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2572692211",
      "Source": "And I will save you now, if you let me in.",
      "Trans": {"SC":"只要你让我进来，我现在也会救你。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::727373961",
      "Source": "Yes.",
      "Trans": {"SC":"是。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //罗克韦尔#9------------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::1793159342",
      "Source": "The devil overlord of this realm has set his queen-enforcer on me.",
      "Trans": {"SC":"这片领域的魔王，已派出他的王后执行者来对付我。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::279197258",
      "Source": "Trust in the plan...",
      "Trans": {"SC":"相信计划……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4246807789",
      "Source": "She is a fearsome vision in unholy armor, menace incarnate -- an impossibly tall, winged Valkyrie.",
      "Trans": {"SC":"她披着亵渎的战甲，凶威毕露——一位高得不可思议的有翼女武神，简直是威胁本身。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3807480351",
      "Source": "Why does her relentless, bloodthirsty determination remind me of someone I once knew?",
      "Trans": {"SC":"为何她那不死不休、嗜血如饥的执念，会让我想起一个我曾认识的人？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2832058016",
      "Source": "Pawns to Queen.",
      "Trans": {"SC":"卒进后。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3715735676",
      "Source": "She slashes her way through my defenses. Mutant and revenant alike fall before her flashing crimson scythes. ",
      "Trans": {"SC":"她一刀刀劈碎我的防线。无论畸变体还是亡灵，都倒在她闪烁的猩红镰刃之下。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::886728007",
      "Source": "In the heart of the impact crater, I brace for her arrival.",
      "Trans": {"SC":"在陨坑的中心，我挺身迎接她的降临。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1158162101",
      "Source": "Here comes the endgame...",
      "Trans": {"SC":"终局已至……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1971481392",
      "Source": "She seizes me up in her claws without a word, lifts me off my feet.",
      "Trans": {"SC":"她一言不发，用利爪攫住我，将我整个人提离地面。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1324873751",
      "Source": "Her helmet opens to expose fangs that she sinks into my soft throat.",
      "Trans": {"SC":"她的头盔开启，露出獠牙，狠狠咬进我柔软的咽喉。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3680823882",
      "Source": "In my agonized struggle, I feel her realize -- too late -- that I’ve seeded my own lifeblood with indigo Edmundium.",
      "Trans": {"SC":"在我痛苦的挣扎中，我感觉到她终于明白——但太迟了——我已用靛蓝的艾德蒙元素为自己的血种下引子。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::829171460",
      "Source": "It proves... disagreeable to her own Red lifeforce.",
      "Trans": {"SC":"这对她的红色生命力而言……极不相容。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1519732584",
      "Source": "Move and counter-move.",
      "Trans": {"SC":"一招一式。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::51837805",
      "Source": "She drops me in disgust, tries to spit out the purple poison burning her from within.",
      "Trans": {"SC":"她厌恶地把我甩开，试图吐出那从内里灼烧她的紫色毒素。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2558995058",
      "Source": "As I hasten to staunch my bleeding, I watch the demon queen take to the sky in a desperate attempt to fly back to her master,",
      "Trans": {"SC":"我匆忙止血，同时看着那位恶魔王后振翼升空，绝望地想飞回她的主人身边，","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::905157669",
      "Source": "...her erratic movement signaling her blighted state.",
      "Trans": {"SC":"……她那失衡而飘忽的轨迹，暴露着她被侵蚀的状态。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3100526081",
      "Source": "Check, ‘Your Majesty’.",
      "Trans": {"SC":"将军了，“陛下”。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //罗克韦尔#10-----------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::325644095",
      "Source": "I did not bother to rebuild while awaiting a diplomatic overture. And my opponent did not keep me waiting long.",
      "Trans": {"SC":"我并未浪费时间重建工事等待什么外交试探。而我的对手，也没让我久等。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2730704167",
      "Source": "Your gambit has worked, Edmund.",
      "Trans": {"SC":"你的弃子成功了，艾德蒙。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3973641698",
      "Source": "An envoy has arrived to pledge His Majesty’s willingness to cease hostilities and to invite me to his stronghold to discuss ‘terms’.",
      "Trans": {"SC":"有使者前来，宣称陛下愿意停战，并邀我前往他的要塞商议“条款”。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1055132782",
      "Source": "Despite all the arcane knowledge at his disposal, the devil king must not know how to cure his queen. ",
      "Trans": {"SC":"尽管他掌握着诸多秘术，那恶魔之王想必并不知如何治愈他的王后。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3939404042",
      "Source": "Even now, she must be writhing in agony in one of his towers. Savor your triumph.",
      "Trans": {"SC":"此刻，她一定还在某座高塔里痛苦翻滚。品味你的胜利吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1341361409",
      "Source": "He will suffer me to live only as long as he still needs me to cure her.",
      "Trans": {"SC":"他容我活着，只会到他仍需要我为止——需要我去治她。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3465452954",
      "Source": "The adversary knows you have found his weakness.",
      "Trans": {"SC":"对手已经知道你找到了他的弱点。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2206459843",
      "Source": "I suspect we will not enjoy each other’s company.",
      "Trans": {"SC":"我猜，我们不会彼此欣赏。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2999250985",
      "Source": "Such close proximity of our contrary forms of Edmundium should make for any uncomfortable meeting of the minds.",
      "Trans": {"SC":"我们相斥的艾德蒙元素形态如此接近——想必会是一场令人不适的心智碰撞。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::765304204",
      "Source": "Good. He should suffer as we have.",
      "Trans": {"SC":"很好。他该像我们一样受苦。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3197806577",
      "Source": "They all should. Yes, I know now why I listen to you, Wretched Voice. ",
      "Trans": {"SC":"本该如此。是的，我终于明白为何我会倾听你，卑劣之声。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3891944721",
      "Source": "Without you, I am just a man. I can be tormented... I feel regret and grief, love and pain and guilt.",
      "Trans": {"SC":"没有你，我只是个人。我会被折磨……我会感到悔恨与悲伤，爱与痛与罪疚。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2955904696",
      "Source": "Those things -- those simple human frailties which have weakened me since I took my first unsteady steps onto this grim earth",
      "Trans": {"SC":"那些东西——那些自我踏上这阴冷大地起就不断削弱我的、简单的人类软弱——","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::22834956",
      "Source": "I can simply let them all go. Because with you... ",
      "Trans": {"SC":"我都可以放下。因为有你……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4153022756",
      "Source": "I am a god.",
      "Trans": {"SC":"我便是神。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //失落之王#1------------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::1108430715",
      "Source": "The seed ship is away. Project Genesis is a triumph.",
      "Trans": {"SC":"种子飞船已启航。创世计划大获成功。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::721221199",
      "Source": "It’s hard to fully accept what we here at Arat Prime have accomplished together, arguably the most momentous and audacious thing ever attempted by human ingenuity.",
      "Trans": {"SC":"难以置信, 我们在阿拉特·源域共同完成的一切 -- 可以说, 这是人类智慧有史以来最重大、最大胆的创举。","JA":""}, //反正我感觉破折号会好一些
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1622471024",
      "Source": "Though the mission took all of our remaining resources, everyone that ever lived on Earth now has a chance to survive and prosper elsewhere in the cosmos, thanks to our work.",
      "Trans": {"SC":"尽管任务耗尽了我们仅存的一切资源, 但地球上曾存在过的所有生命, 如今都有机会在宇宙他处延续与繁荣 -- 皆因我们的工作。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3481438055",
      "Source": "Future generations will surely remember and commemorate our great efforts on their behalf.",
      "Trans": {"SC":"未来的世代必将铭记并纪念我们为他们所做的伟业。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1608054846",
      "Source": "Perhaps those same descendants will even find a way to forgive us for fouling our homeworld beyond repair.",
      "Trans": {"SC":"也许那些后代终有一天会原谅我们 -- 原谅我们将故土污染到无可挽回。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1101330680",
      "Source": "But for now, my team -- my people’s thoughts are with the brave crew of the Genesis ship as they search the heavens for a new home for humanity.",
      "Trans": {"SC":"但此刻, 我的团队-- 我的同胞们, 都心系创世号飞船上英勇的船员们, 他们正在星海中为人类寻找新的家园。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3265486812",
      "Source": "May providence guide them.",
      "Trans": {"SC":"愿上天庇佑他们。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //失落之王#2------------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::366324887",
      "Source": "We have always understood our ultimate fate beyond this project’s completion.",
      "Trans": {"SC":"我们一直都明白, 在这个项目结束之后, 我们最终的命运将何去何从。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3838385209",
      "Source": "But now with the launch actually behind us, I find myself less comforted than I had anticipated.",
      "Trans": {"SC":"可如今项目真的已经上线, 我却发现自己并没有预想中那般释然。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2998293077",
      "Source": "Humanity may well live again elsewhere in the galaxy, but we project managers were unable to encode our own engrams into the Codex -- ",
      "Trans": {"SC":"人类或许能在银河系的别处重获新生, 可我们这些项目管理者, 却没能把自己的记忆印记编入元码 --","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1063786640",
      "Source": "...a limitation of the system’s design, the creators can not themselves be created.",
      "Trans": {"SC":"...这是系统设计的限制, 创造者无法创造自身。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::594265678",
      "Source": "As long as this facility stays operational, we can continue to store other creatures’ new memories and experiences into the Engram Codex,",
      "Trans": {"SC":"只要这座设施仍在运转, 我们就能持续把其他生命的新记忆与经历存入印痕元码,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::20803530",
      "Source": "...and upload them across our transluminal communication link with the Genesis seed ship.",
      "Trans": {"SC":"...并通过超光通信链路, 将其上传至创世种子飞船。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2467712437",
      "Source": "A person could close their eyes here and then awake to open their eyes on an alien world in the distant future, with no sense of lost continuity.",
      "Trans": {"SC":"一个人可以在这里合上眼睛, 再睁开眼时, 已然置身于遥远未来的异星之上, 意识毫无断裂之感。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4280739573",
      "Source": "That is, someone other than us.",
      "Trans": {"SC":"可那, 不会是我们。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1888370223",
      "Source": "But we -- who labored for generations to preserve the biological riches of planet Earth -- ",
      "Trans": {"SC":"而我们 -- 这些世世代代辛勤付出, 只为守护地球生物瑰宝,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3806299035",
      "Source": "...we shall not get to see the results of our efforts.",
      "Trans": {"SC":"...却终将无缘亲眼见证这份努力的成果。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2831644454",
      "Source": "Now that the day has finally arrived, I feel...  regret. Or is it fear?",
      "Trans": {"SC":"这一天终于来了, 我却心生...悔意。还是说, 是恐惧?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //失落之王#3------------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::1336707358",
      "Source": "Scouts have definitively confirmed that long-term survival is impossible in the outside world.",
      "Trans": {"SC":"侦察部队已确凿证实, 外界环境已无法实现长期生存。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::448065547",
      "Source": "Our isolation and shielding have kept us hidden from the Titans laying waste to the rest of the world, but we are unlikely to endure much longer here.",
      "Trans": {"SC":"我们依靠隔绝与屏障, 在泰坦肆虐世界之际得以藏身, 但我们在这里也撑不了多久了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::74926860",
      "Source": "Nor can we expect any intervention by our ascended cousins -- the so-called ‘Homo deus’ -- now that they’ve abandoned us to play in their orbital ARKs.",
      "Trans": {"SC":"我们也别指望那些已飞升的同胞 -- 那所谓的“神人” -- 会出手干预。他们早已将我们抛弃, 在轨道方舟里自得其乐。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::844544250",
      "Source": "Our technology helped make it possible, and yet they have abandoned us too. But there must be a way forward.",
      "Trans": {"SC":"是我们的技术造就了这一切, 可他们到头来还是抛弃了我们。但一定还有别的出路。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1374152373",
      "Source": "I was entrusted to lead this last bastion of humanity, and I refuse to just wait around for my people to starve in the dark.",
      "Trans": {"SC":"我受命领导人类这最后的堡垒, 我绝不能眼睁睁看着我的人民在黑暗中挨饿至死。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3298867151",
      "Source": "No... we will not go quietly into the night.",
      "Trans": {"SC":"不...我们不会默然走向灭亡。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::61822733",
      "Source": "Given the collective engineering and scientific expertise we possess, I’m determined to make survival our new mission.",
      "Trans": {"SC":"凭我们全体所拥有的工程与科学智慧, 我决意要将“生存”变成新的使命。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2846519597",
      "Source": "We will find a way to outlast this.",
      "Trans": {"SC":"我们一定会找到办法挺过这一切。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //失落之王#4------------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::971487433",
      "Source": "After years of extreme power conservation and enforced austerity measures, we may have found a solution to our dwindling fuel supply.",
      "Trans": {"SC":"经过多年极致的能源管控与严苛的配给制度, 我们似乎终于找到了缓解燃料日益枯竭的办法。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1591752194",
      "Source": "A novel red isotope of the exotic Element powering our civilization has been discovered inside our borders, deep under the Antarctic ice.",
      "Trans": {"SC":"一种全新的红色同位素 -- 那种为我们文明提供动力的奇异元素 -- 已在我们境内被发现, 深埋于南极冰层之下。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::759559145",
      "Source": "Unlike the blue variant, which provides immense energy, and the purple variant, which creates carbon-based life, the Red Element seems to have unique properties.",
      "Trans": {"SC":"不同于蓝色变体所能提供的磅礴能量, 也不同于紫色变体所能催生碳基生命, 红色元素它似乎拥有独特性质。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2929411520",
      "Source": "This new Red Element will let us keep the heat on and our energy shielding up, once we finish doing some creative re-imagining of our infrastructure.",
      "Trans": {"SC":"只要我们对现有设施进行一番创造性改造, 这种全新的红色元素就能让我们维持供暖, 并保持能量护盾持续运转。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2403192110",
      "Source": "But Red Element is not comparable in power output to the blue substance, and so the environmental pressures on our closed system of agriculture remain an ongoing threat.",
      "Trans": {"SC":"但红色元素的能量输出无法与蓝色物质相比, 因此我们封闭农业系统所面临的环境压力, 依旧是持续存在的威胁。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::122981244",
      "Source": "Since our world stopped turning altogether, it’s becoming increasingly difficult to feed our animals and ourselves.",
      "Trans": {"SC":"自从世界彻底停转后, 养活牲畜与我们自己, 也正变得越来越艰难。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3522714779",
      "Source": "Faced with endless darkness, I’m forced to consider more radical options. I will consult with my colleagues.",
      "Trans": {"SC":"面对无尽的黑暗, 我不得不考虑更激进的方案。我将与同僚们进行商议。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //失落之王#5------------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::1484385680",
      "Source": "There may be a solution to our crisis, albeit one almost too horrible to contemplate.",
      "Trans": {"SC":"我们似乎找到了化解危机的办法, 只是这个方案残忍得令人不忍细想。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3999881909",
      "Source": "Experimentation on animal and human subjects with exposure to Red Element has demonstrated an unexpected potential to boost longevity.",
      "Trans": {"SC":"针对动物与人类实验体的红色元素暴露实验显示, 其意外拥有延长寿命的潜在能力。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2565736173",
      "Source": "Better still, the isotope can bond with human hemoglobin to produce a new and more efficient type of biofuel.",
      "Trans": {"SC":"更重要的是, 这种同位素能与人体血红蛋白结合, 产生一种全新且更高效的生物燃料。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::746744351",
      "Source": "Provided our society can overcome its collective squeamishness over biomodification, it’s within our reach to engineer a new future for our people.",
      "Trans": {"SC":"只要我们能克服对生物改造的普遍抵触, 就能为人民缔造出一个触手可及的崭新未来。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1810895479",
      "Source": "Borrowing the cryotolerance of Antarctic sea life and the metabolism of hematophagous creatures like vampire bats and leeches,",
      "Trans": {"SC":"借鉴南极海洋生物的耐低温能力, 以及吸血蝙蝠、水蛭等吸血生物的新陈代谢机制,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1017470350",
      "Source": "...we could shrug off the cold and open up a new source of bioavailable energy.",
      "Trans": {"SC":"...我们便能抵御严寒，并开辟出一种全新的生物可用能源。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::628098914",
      "Source": "Because we just so happen to have an endless clone bank of potential blood donors at our disposal... ",
      "Trans": {"SC":"恰好我们拥有一座取之不尽的克隆体库, 其中全是可供我们随时支配的潜在供血者...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2656934479",
      "Source": "The Codex can provide life itself.",
      "Trans": {"SC":"而元码能缔造出生命。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //失落之王#6------------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::234955554",
      "Source": "There was predictable opposition to my admittedly radical proposal.",
      "Trans": {"SC":"对于我那个颇为激进的提案, 果不其然出现了反对的声音。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1067717274",
      "Source": "Revulsion at the idea of exploiting our precious Codex was only to be expected in a community of such devout humanists.",
      "Trans": {"SC":"在这样一个虔诚信奉人文主义的群体中, 对利用神圣的元码这一构想所引发的强烈抵触情绪, 本就在预料之中。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2696783458",
      "Source": "Why could they not see the choice before us: adaptation, or death?",
      "Trans": {"SC":"他们为何看不见摆在眼前的选择: 要么适应, 要么灭亡?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1640486570",
      "Source": "Why should everything that we are, all we have come to know and learn and love --",
      "Trans": {"SC":"为什么我们的全部, 我们所知、所学、所爱的一切 --","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::282688492",
      "Source": "...why should that vanish into oblivion when we possess the power to live forever?",
      "Trans": {"SC":"...凭什么在我们手握永生之力时, 这一切要就此归于虚无?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3952880854",
      "Source": "Many objected to the heretical mutations I believe necessary to the continued survival of our colony.",
      "Trans": {"SC":"许多人反对我认为对殖民地延续生存所必需的那些异端式突变。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::375282548",
      "Source": "Regrettably, their resistance will have to be put down for the greater good.",
      "Trans": {"SC":"遗憾的是, 为了大局, 他们的反抗必须予以镇压。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1394998759",
      "Source": "It’s not as if I am demanding the sacrifice of ensouled cognizant people to feed our colony.",
      "Trans": {"SC":"我又不是要牺牲那些拥有灵魂, 拥有自我意识的人, 来供养我们的殖群。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3093133014",
      "Source": "These liminal meat-puppets will exist only to serve as buffer hosts, that can transubstantiate an environmental toxin into a life-giving miracle substance.",
      "Trans": {"SC":"这些处在生死夹缝里的肉偶, 不过是缓冲宿主 -- 能把环境毒素“转化”为赐生的奇迹之物。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2003844694",
      "Source": "The Red will deliver us from starvation and open up a new age of post-humanity on our otherwise extinct homeworld.",
      "Trans": {"SC":"“腥红元素”将把我们从饥荒中拯救出来, 并在这颗本已死去的故土上, 开启一个后人类的新纪元。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3092512300",
      "Source": "Those who can see that this is the only path will be part of our new colony. Those who cannot... can provide sustenance.",
      "Trans": {"SC":"能看清这是唯一出路的人, 将成为我们新殖群的一员。看不清的人...便当作养料。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::966538685",
      "Source": "The Rubicon has been crossed, and so we are lost... We are the Lost... there is no other way forward.",
      "Trans": {"SC":"卢比孔河既已跨过, 我们退路已失...我们即是失落者...前方再无他路。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //🌚这里使用“退路已失”来体现典故的含义, 也想要"失"与后面的失落者相连;
      //其实用"我们已然迷失"也不错, 能与后面的Lost相连, 但是我感觉少了典故里的我们没有退路的意思.
    },
    //失落之王#7------------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::670201443",
      "Source": "Faced with an existential threat to our continued life on this Earth, I was forced to seize supreme executive power in order to implement my solution.",
      "Trans": {"SC":"面对这片土地上关乎族群存续的生死危机, 我不得不攫取至高行政权, 以贯彻我的方案。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2066726725",
      "Source": "The Turning of our people has begun.",
      "Trans": {"SC":"“转化”已然开始。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3764506835",
      "Source": "Now begins a period of great chaos, as my bioengineered enforcers seek out any dissidents remaining within our borders...",
      "Trans": {"SC":"一场巨大的动荡即将来临, 我的基因改造执行者, 将清剿境内所有残存异见者...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::333308206",
      "Source": "...and enforce compliance one way or another.",
      "Trans": {"SC":"……并以一切手段迫使他们服从。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1594557614",
      "Source": "So many friends and colleagues are now gone, but they could not face the necessity of what had to be done.",
      "Trans": {"SC":"昔日诸多挚友同僚皆已不在 -- 他们无法直面这非做不可的现实。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3292596056",
      "Source": "This new way of life has only come about due to my conviction , my willpower.",
      "Trans": {"SC":"这种全新的生存之道, 正是源于我的信念与意志。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::54414805",
      "Source": "So it seemed reasonable to stack the deck in my own favor by giving myself the most profound genetic upgrades.",
      "Trans": {"SC":"因此, 我为自己施以最极致的基因改造, 让胜利的天秤向我们倾斜。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2245048766",
      "Source": "After all... a people need a leader. And their leader must be strong.",
      "Trans": {"SC":"毕竟...族群需要领袖。而领袖也必须足够强大。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //失落之王#8------------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::3678152084",
      "Source": "At long last and through great sacrifice, a kind of equilibrium has finally been achieved.",
      "Trans": {"SC":"历经漫长岁月与巨大牺牲, 一种全新的平衡总算建立起来。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3535987165",
      "Source": "Our people will live on in the endless night, no thanks to those who abandoned us to our fate once we launched them toward their bright future.",
      "Trans": {"SC":"我们的子民可在这永夜里延续 -- 绝非依靠那些, 在我们为他们奔赴光明未来后, 便弃我们而去的人。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1968100756",
      "Source": "If and when the colonists on the seed ship find a habitable new world, the plan was to call their new home Arat.",
      "Trans": {"SC":"种子飞船上的殖民者若真能找到宜居新世界, 原计划要将那片新家园命名为“阿拉特”。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3126545662",
      "Source": "But Earth was the cradle of humanity, and Arat Prime remains its last terrestrial outpost.",
      "Trans": {"SC":"但地球是人类文明的摇篮, 而阿拉特·源域则是人类在地球上的最后一个据点。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::301186056",
      "Source": "We will carry the torch on into the long night.",
      "Trans": {"SC":"我们将高举火炬, 步入这漫漫长夜。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1259285333",
      "Source": "Down here in the darkness, we may not be able to thrive as they will in their sunlit new world, but I have seen to it that we will endure.",
      "Trans": {"SC":"身处这片黑暗之中, 我们或许无法像他们在洒满阳光的新世界里繁衍生息, 但我已确保我们能存续下去。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3125216854",
      "Source": "It only seems fair that the clones they left behind will serve to feed us into perpetuity.",
      "Trans": {"SC":"既然他们留下了克隆体, 那么让这些被遗弃的“余量”永世供养我们 -- 也算公平。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //失落之王#9------------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::3326834359",
      "Source": "So much time has passed without anything to challenge the order of my kingdom, that I was slow to react to a surprising new threat.",
      "Trans": {"SC":"漫长的岁月里, 没有任何事物动摇我王国的秩序, 以至于我对这突如其来的新威胁反应迟缓。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::215301266",
      "Source": "An outsider found her way into my realm, and she is formidable indeed.",
      "Trans": {"SC":"一个外来者闯入了我的领域 -- 而且强得离谱。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1244765859",
      "Source": "Li-Meiyin has systematically slain nearly all of the remaining challengers to my throne that I had placed in her way.",
      "Trans": {"SC":"李美盈有条不紊地清除了几乎所有我安排在她面前的对手。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3490667327",
      "Source": "She appears to be the clone of an ancient warrior who originated on one of the ARKs built by those others, so long ago.",
      "Trans": {"SC":"她似乎是一名远古战士的克隆体 -- 源自那些“他者”在遥远过去建造的方舟体系。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::480548975",
      "Source": "Why does she seem so single-mindedly determined to find my Codex?",
      "Trans": {"SC":"她为何如此一意孤行地要找我的“元码”?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3270106943",
      "Source": "I must access the records of the ARK network to learn all I can about this remarkable woman, and how she came to be here.",
      "Trans": {"SC":"我必须接入方舟网络的记录, 尽可能查清这个不凡的女人, 以及她究竟如何来到此地。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2396160114",
      "Source": "What drives the unyielding fire that I sense in her? And how could it yet benefit my Kingdom?",
      "Trans": {"SC":"究竟是什么支撑着她内心那团不屈之火? 它是否能为我的王国所用?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //失落之王#10------------------------------------------------------------------------------------
    {
      "NamespaceHash": "GraphLiteral::1004243037",
      "Source": "Meiyin may have submitted to the Turning, but she remains my queen-consort in name only.",
      "Trans": {"SC":"美盈或许已顺从“转化”, 却也只是名义上的王后与伴侣。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1954889424",
      "Source": "In the centuries since, she has proved to be my most effective enforcer, ",
      "Trans": {"SC":"而在随后的数百年里, 她证明了自己是我最有效的执法者,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::486934817",
      "Source": "...killing the last of the warlords who sought to overthrow me, leaving my rule absolute.",
      "Trans": {"SC":"...她杀死了最后一位妄图推翻我的军阀, 使我的统治彻底绝对。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3407798576",
      "Source": "Yet she keeps her distance, holding back her innermost thoughts.",
      "Trans": {"SC":"可她始终与我保持距离, 将心底的想法深藏不露。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1405274413",
      "Source": "I could force her to my will, but that would crush my last hope of true companionship.",
      "Trans": {"SC":"我当然可以强行扭转她的意志 -- 但那会碾碎我最后一丝“真正陪伴”的希望。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3447566338",
      "Source": "Most recently, another outsider adversary has arrived on our doorstep, as it happens, someone from my queen’s second life on the ARKs.",
      "Trans": {"SC":"近来, 又有一名外来敌手找上门来 -- 巧的是, 此人正来自王后在方舟里的“第二段人生”。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::929438779",
      "Source": "This clever interloper has begun to corrupt the borders of my kingdom...",
      "Trans": {"SC":"这个狡黠的入侵者开始腐化我王国的边境...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::532647953",
      "Source": "with mutated wildlife, and reanimated thrall corpses he evidently intends to set against us.",
      "Trans": {"SC":"驱使着变异的野兽, 以及被他复活的失落者尸群 -- 显然是要用来对付我们。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3310951642",
      "Source": "This invader amuses me.",
      "Trans": {"SC":"这名入侵者让我觉得有趣。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2005844488",
      "Source": "I will leave it to my Lost Queen to negotiate with her one-time fellow traveler, this ‘Edmund Rockwell’.",
      "Trans": {"SC":"此事便交由我那位失落的王后, 让她去会一会她昔日的同路人 -- 艾德蒙·罗克韦尔。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3336545261",
      "Source": "I expect those negotiations will be brief.",
      "Trans": {"SC":"我料想这番交涉, 必不会长久。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1791760347",
      "Source": "These are the private logs of Darius Anthem, the director of the Arat Prime facility.",
      "Trans": {"SC":"这里记录的是阿拉特·源域设施主管 --达瑞斯·安瑟姆 -- 的私人日志。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3004902192",
      "Source": "I hope in better times they will serve as a record of what has transpired here... and what may yet come to be",
      "Trans": {"SC":"我希望等日子好起来之后, 这些能记下此地过往的一切...以及未来或将发生的一切。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    //------------------------------------------------------------------------------------
    {
      "NamespaceHash": "Content::1022209627",
      "Source": "{GiveDefaultWeapon} Use TekSpear",
      "Trans": {"SC":"{GiveDefaultWeapon} 使用泰克矛","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
