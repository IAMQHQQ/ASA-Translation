    {
      "NamespaceHash": "Content::1346629632",
      "Source": "This will override your shirt, pants, glove, and boot skins, acting as a full-body costume to provides an enlightened look.\r\n\r\nShould always be set on Torso Armor.",
      "Trans": {"SC":"使用这个皮肤来覆盖其它外观, 充当全身套装, 提供一种超然的外观。\"自然的平衡已被打破.\" \r\n\r\n应该始终设置在躯干护甲上。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::499844842",
      "Source": "Inspired",
      "Trans": {"SC":"鼓舞","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
