      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //装备特性-描述
    },
    {
      "NamespaceHash": "Content::1168007466",
      "Source": "Projectiles from this weapon have a 10% chance to fire 2 additional times from the same location and in the same direction as the original projectile. Each shot fires 0.2 seconds after the previous projectile.",
