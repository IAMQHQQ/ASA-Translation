      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1772038642",
      "Source": "You can use this to skin the appearance of a Heavy Auto Turret to look like a Water Soaker. It's STILL playful if it's just water at this size... right?",
      "Trans": {"SC":"你可以使用这个皮肤来改重型自动炮台的外观。如果里面放的只是水的话, 那就会很有趣了...对吧?","JA":""},
