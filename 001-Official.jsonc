    {
      "NamespaceHash": "GraphLiteral::3071802939",
      "Source": "\r\n\r\nUse <RichColor Color=\"0, 1, 1, 1\">{1}</> to aim.\r\nUse <RichColor Color=\"0, 1, 1, 1\">{2}</> and <RichColor Color=\"0, 1, 1, 1\">{3}</> to zoom in and out.\r\nUse <RichColor Color=\"0, 1, 1, 1\">{4}</> to ping and track.",
      "Trans": {"SC":"\r\n\r\n使用 <RichColor Color=\"0, 1, 1, 1\">{1}</> 瞄准。\r\n使用 <RichColor Color=\"0, 1, 1, 1\">{2}</> 和 <RichColor Color=\"0, 1, 1, 1\">{3}</> 自由缩放。\r\n使用 <RichColor Color=\"0, 1, 1, 1\">{4}</> 来标点和追踪。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //泰克望远镜描述1.PC
      //22B27CFD4DADEA28CD9A2F934B276411
    },
    {
      "NamespaceHash": "GraphLiteral::2058238266",
      "Source": "Use{1}to aim.\r\nUse{2}and{3}to zoom in and out.\r\nUse{4}to ping and track.",
      "Trans": {"SC":"使用{1}瞄准。\r\n使用{2}和{3}自由缩放。\r\n使用{4}来标点和追踪。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //032CAA694B1203CF59020485B638ABB6
      //泰克望远镜描述2.Xbox
    },
