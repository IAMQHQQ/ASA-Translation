    },
    {
      "NamespaceHash": "Content::412670050",
      "Source": "A wooden wall that provides structural integrity, without completely blocking an area.",
      "Trans": {"SC":"一种提保证结构稳定却又不完全阻挡区域的木墙。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
