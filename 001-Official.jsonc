    {
      "NamespaceHash": "Content::1764617834",
      "Source": "Balloon Parachute",
      "Trans": {"SC":"气球降落伞","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1861781157",
      "Source": "You can use this to skin the appearance of a Parachute.",
      "Trans": {"SC":"你可以用这个来更换降落伞的外观。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::989602499",
      "Source": "Gloon Cupid Costume",
      "Trans": {"SC":"咕隆的丘比特套装","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2613795138",
      "Source": "This costume can be used to make your Gloon look like a festive creature!",
      "Trans": {"SC":"这个套装可以用来让你的咕隆看起来像一只节日生物!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::332453481",
      "Source": "Devil Horns",
      "Trans": {"SC":"恶魔之角","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2446515881",
      "Source": "You can use this to skin the appearance of a helmet or hat into a decorative horns. For those times you want to look naughty... really naughty.\r\n\r\nNon-human creatures adamantly refuse to wear this.",
      "Trans": {"SC":"你可以用它把头盔或帽子的外观替换成装饰性的角。适合你想让自己看起来坏坏的时候...特别坏的那种。\r\n\r\n非人类的生物是不愿意佩戴的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4278909218",
      "Source": "Devil Tail",
      "Trans": {"SC":"恶魔之尾","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::215349516",
      "Source": "You can use this to skin the appearance of pants to add a devilish tail.",
      "Trans": {"SC":"你可以用这个来更换裤子的外观。给自己添加一条恶魔尾巴。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::850309569",
      "Source": "Lace Shirt",
      "Trans": {"SC":"蕾丝衬衫","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3022244151",
      "Source": "You can use this to skin the appearance of a shirt into a lace shirt men or women. You could be on the cover of a love story.",
      "Trans": {"SC":"你可以用它把上衣外观替换成男女通用的蕾丝衬衫。穿上它就像爱情小说封面上的主角。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1390327715",
      "Source": "Valentines Whip",
      "Trans": {"SC":"情人节鞭子","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3867783366",
      "Source": "Use to skin a whip to look like a Valentines Whip",
      "Trans": {"SC":"用这个来将鞭子的外观更换为情人节样式的鞭子。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3374846829",
      "Source": "Lovely Round Balloon",
      "Trans": {"SC":"甜蜜的圆形气球","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3878233320",
      "Source": "You can use this to skin the appearance of a small decor box. A surprise awaits after placement.",
      "Trans": {"SC":"你可以用这个来更换小型装饰箱的外观。放置后会有惊喜等待着你。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3058050252",
      "Source": "Lovely Rug",
      "Trans": {"SC":"甜蜜的地毯","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2651403183",
      "Source": "Tucked inside this tiny decor box lives a little piece of Valentine's magic!\r\n\r\n With a sprinkle of mischief and a whole lot of love, the box opens to reveal a perfectly plump, heart-shaped rug in the deepest, dreamiest red. Ultra-soft faux fur that begs for bare toes, this mini masterpiece turns any spot into a cozy love nest",
      "Trans": {"SC":"这个小小的装饰箱里藏着一点情人节的魔法!\r\n\r\n礼盒中藏着一丝俏皮, 满载浓情爱意, 打开后便会呈现一块饱满圆润的心形小地毯, 色泽是浓郁又梦幻的深红。超柔软的仿兔绒材质, 让人忍不住光脚踩上去, 这件迷你小杰作能把任何角落都变成温馨的爱意小天地。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1563930616",
      "Source": "Lovely Heart Balloon",
      "Trans": {"SC":"甜蜜的爱心气球","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2385821267",
      "Source": "Lovely Chandelier",
      "Trans": {"SC":"甜蜜的枝形吊灯","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3972673110",
      "Source": "You can use this to skin the appearance of a small decor box. Manually trigger a glowing colored light. ",
      "Trans": {"SC":"你可以用这个来更换小型装饰箱的外观。可手动启用彩色发光效果。","JA":""},
