    {
      "NamespaceHash": "Content::3738891607",
      "Source": "Used to decorate the cab of your BattleRig with a barebones look.",
      "Trans": {"SC":"用于将你的战车驾驶室改装成极简风格的外观。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::421236432",
      "Source": "Used to decorate the cab of your BattleRig with a monster truck look.",
      "Trans": {"SC":"用于将你的战车驾驶室改装成怪兽卡车风格的外观。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2879074751",
      "Source": "Used to decorate the cab of your BattleRig with an off-road racer look.",
      "Trans": {"SC":"用于将你的战车驾驶室改装成越野赛车风格的外观。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2031868713",
      "Source": "Used to decorate the bed of your BattleRig with a barebones look.",
      "Trans": {"SC":"用于将你的战车后车厢改装成极简风格的外观。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3001777238",
      "Source": "Used to decorate the bed of your BattleRig with a monster truck look.",
      "Trans": {"SC":"用于将你的战车后车厢改装成怪兽卡车风格的外观。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3746242956",
      "Source": "Used to decorate the bed of your BattleRig with an off-road racer look.",
      "Trans": {"SC":"用于将你的战车后车厢改装成越野赛车风格的外观。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1642712732",
      "Source": "Used to decorate the engine block of your BattleRig with a barebones look.",
      "Trans": {"SC":"用于将你的战车发动机改装成极简风格的外观。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1959052590",
      "Source": "Used to decorate the engine block of your BattleRig with a monster truck look.",
      "Trans": {"SC":"用于将你的战车发动机改装成怪兽卡车风格的外观。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2153752321",
      "Source": "Used to decorate the engine block of your BattleRig with an off-road racerlook.",
      "Trans": {"SC":"用于将你的战车发动机改装成越野赛车风格的外观。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2243693378",
      "Source": "Used to decorate the engine block of your BattleRig with an off-road racer look.",
      "Trans": {"SC":"用于将你的战车发动机改装成越野赛车风格的外观。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::806461665",
      "Source": "Used to decorate the wheels and suspension of your BattleRig with a barebones look. Has an average top speed, and an average turning radius.",
      "Trans": {"SC":"用于将你的战车车轮和悬挂改装成极简风格的外观。它的速度和转弯幅度数值都很综合。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1456684458",
      "Source": "Used to decorate the wheels and suspension of your BattleRig with a monster truck look. Has the highest top speed, but the widest turning radius.",
      "Trans": {"SC":"用于将你的战车车轮和悬挂改装成越野赛车风格的外观。它的速度是最快的, 但转弯幅度也是最大的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1202246547",
      "Source": "Used to decorate the wheels and suspension of your BattleRig with an off-road racer look. Has the highest top speed, but the widest turning radius.",
      "Trans": {"SC":"用于将你的战车车轮和悬挂改装成越野赛车风格的外观。它的速度是最快的, 但转弯幅度也是最大的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2197136834",
      "Source": "Used to decorate the wheels and suspension of your BattleRig with a monster truck look. Has the lowest top speed, but the tightest turning radius.",
      "Trans": {"SC":"用于将你的战车车轮和悬挂改装成怪兽卡车风格的外观。虽然它的速度比较慢, 但转弯幅度是最小的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3942562571",
      "Source": "Attach this to the front of your BattleRig to gain a harvesting buzzsaw that harvests the Resources your ram into",
      "Trans": {"SC":"将该配件加装到战车的前端, 使你的战车化身为一台无情收割机, 能够采集部分你撞到的资源。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3688840740",
      "Source": "Attach this to the front of your BattleRig to gain a physical deflector that allows you to keep your speed while ramming things.",
      "Trans": {"SC":"将该配件加装到战车的前端, 使你的战车能让你在撞击物体时会保持原有的速度。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3215318992",
      "Source": "Attach this to the front of your BattleRig to gain extra armor that increases its surviability.",
      "Trans": {"SC":"将该配件加装到战车的前端, 你的战车将增加额外的护甲, 以提高其生存能力。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3673804366",
      "Source": "Attach this to the front of your BattleRig to gain spikes that deal extra damage during rams, and also reflects all melee damage dealt to your BatteRig.",
      "Trans": {"SC":"将该配件加装到战车的前端, 你的战车在撞击时会造成额外伤害, 并且还能反弹所有对战车造成的近战伤害。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2705284503",
      "Source": "Attach this to the rear of your BattleRig, then activate it to gain a boost of forward speed.",
      "Trans": {"SC":"将该配件加装到战车的后端, 激活后, 可获得向前的速度加成。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3503162806",
      "Source": "Attach this to the rear of your BattleRig, then activate it to grapple onto terrain, Creatures, Survivors, and more.",
      "Trans": {"SC":"将该配件加装到战车的后端, 激活后, 可用抓钩抓住地形、生物、生存者等等。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::327312885",
      "Source": "Attach this to the rear of your BattleRig, then activate it to jump off the ground of gain a minor flight boost while in air.",
      "Trans": {"SC":"将该配件加装到战车的后端, 激活后, 可从地面跳起, 在空中时能获得小幅飞行加成。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1280835878",
      "Source": "Attach this to the rear of your BattleRig, then activate it to release obscuring smoke behind you.",
      "Trans": {"SC":"将该配件加装到战车的后端, 激活后, 会在战车身后释放出遮蔽视线的烟雾。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1981901996",
      "Source": "Attach this to the bed of your BattleRig to gain access to a missile launcher that can lock onto flying targets for extra damage. Requires Rocket Homing Missiles to fire.",
      "Trans": {"SC":"将该配件加装到战车的后车厢, 就能使用一台导弹发射器, 它能发射器可锁定飞行目标以造成额外伤害。需要制导火箭弹才能发射。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3984999722",
      "Source": "Attach this to the bed of your BattleRig to gain access to a rapid-fire minigun that deals consistent damage over a long range. Requires Advanced Rifle Bullets to fire.",
      "Trans": {"SC":"将该配件加装到战车的后车厢, 就能使用一门速射机枪, 它能持续对远距离的目标进行火力输出。需要高级步枪子弹才能发射。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::156049504",
      "Source": "Attach this to the bed of your BattleRig to gain access to a short-range cone of tranquilizing shots. Requires Tranquilizer Darts to fire.",
      "Trans": {"SC":"将该配件加装到战车的后车厢, 就能使用一台霰弹式麻镖发射器, 它能发射出一个锥形区域的麻醉镖。需要麻醉镖才能发射。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::285036838",
      "Source": "Attach this to the bed of your BattleRig to gain access to a short-ranged flamethrower turret that deals percent-max-HP damage to anything it hits. Requires Flamethrower Ammo to fire.",
      "Trans": {"SC":"将该配件加装到战车的后车厢, 就能用一台短程火焰喷射器炮台, 被火焰喷射器击中的目标会受到基于其最大生命值百分比的伤害。需要火焰喷射器弹药才能发射。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::360839845",
      "Source": "Occupied Car Spawning area",
      "Trans": {"SC":"战车部署区域被这遮挡","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2645899297",
      "Source": "Base Car Equipment Item",
      "Trans": {"SC":"基础汽车装配部件","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
