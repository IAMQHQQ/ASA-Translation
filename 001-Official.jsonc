      "Source": "Collect Algae\r\n",
      "Trans": {"SC":"收集海藻\r\n","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //古巨龟
    },
    {
      "NamespaceHash": "GraphLiteral::3615810536",
      "Source": " Algae collectable )\r\n",
      "Trans": {"SC":" 团海藻待收集 )\r\n","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //古巨龟
    },
    {
      "NamespaceHash": "GraphLiteral::3298765478",
      "Source": " until Algae is Fully Grown\r\n",
