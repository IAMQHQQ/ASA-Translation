    {
      "NamespaceHash": "Content::1045283785",
      "Source": "Cargo Ledger",
      "Trans": {"SC":"货物账台","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2725121324",
      "Source": "Keeps track of items in nearby containers, and allows withdrawing those items without physically accessing each container.",
      "Trans": {"SC":"记录附近容器中的物品, 并允许无需逐一接触容器即可取出物品。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::427759766",
      "Source": "Aquarium",
      "Trans": {"SC":"水族箱","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3432742335",
      "Source": "A decorative Structure for showing off your best catches. Transfer Creatures into it via Fishing Basket, and display them in a beautiful aquatic habitat.",
      "Trans": {"SC":"用于展示你最佳渔获的装饰性建筑。通过鱼篮将生物转入其中, 并在美丽的水生栖境中展示它们。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3734289469",
      "Source": "Hand Cannon",
      "Trans": {"SC":"手炮","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1645378064",
      "Source": "The HandCannon is a high impact, single-shot firearm designed for area denial/displacement, rather than sustained damage. It excels in close-quarters and naval combat by allowing players to forcibly reposition enemies.",
      "Trans": {"SC":"手炮是一种高冲击单发火器, 侧重区域压制与位移控制, 而非持续伤害。它在近距离与海战中表现出色, 可迫使敌人改变位置。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2740374280",
      "Source": "Grapeshot",
      "Trans": {"SC":"霰弹炮弹","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1424355131",
      "Source": "A few simple bullets in a padded hide wrapping, used with Hand Cannons.",
      "Trans": {"SC":"几枚用厚皮包裹的简易子弹, 用于手炮。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::166384153",
      "Source": "Bounty Board",
      "Trans": {"SC":"悬赏板","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::659555353",
      "Source": "A Tribe-wide mission generator, for gaining Hexagons that can be spent in the Hexagon Exchange.",
      "Trans": {"SC":"全部落通用任务生成器, 可获得可在六角币交易所消费的六角币。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1755310013",
      "Source": "Tidepup Saddle",
      "Trans": {"SC":"潮佑螈鞍","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::197756684",
      "Source": "Equip a Tidepup with this to ride it.",
      "Trans": {"SC":"装备到潮佑螈上以骑乘。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1098770720",
      "Source": "Shipyard",
      "Trans": {"SC":"船坞","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2595405784",
      "Source": "An large Structure used to construct, fast-travel, and manage Ships. Must be placed in water.",
      "Trans": {"SC":"一座用于建造、快速旅行和管理船只的大型建筑。必须放置在水中。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2281765728",
      "Source": "Market",
      "Trans": {"SC":"市场","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::459584209",
      "Source": "Allows Survivors to safely buy and sell Items with other Survivors. Set the Item you want to buy/sell, a price (in Hexagons), and an quantity... then wait for someone to fulfill that order. Also works as a local hub for the Hexagon Exchange.",
      "Trans": {"SC":"允许生存者与其他生存者安全买卖物品。设置你想购买/出售的物品、价格 (以六角币计) 和数量...然后等待其他人完成订单。也可作为本地六角币交易所使用。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3541263049",
      "Source": "Sloop",
      "Trans": {"SC":"单桅帆船","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1555901628",
      "Source": "A very fast, medium-sized Ship for naval travel. Comes equipped with several cannons, and can be customized with tileset Structures.",
      "Trans": {"SC":"适合海上航行的高速中型船只。配备数门火炮, 并可使用拼装建筑进行自定义。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1434197564",
      "Source": "ToF Lights",
      "Trans": {"SC":"命运之潮灯具","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2491215549",
      "Source": "Requires fuel electricity to activate.",
      "Trans": {"SC":"需要燃料或电力才能启动。","JA":""},
