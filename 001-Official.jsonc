    {
      "NamespaceHash": "Content::3867906477",
      "Source": "Armadoggo Armor",
      "Trans": {"SC":"铠护犬护甲","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
      //随伴犬-配件
    },
    {
      "NamespaceHash": "Content::2801271487",
      "Source": "Equip a Companion with this, and it will give you hyperthermic insulation and it can carry food and drink for you.",
      "Trans": {"SC":"给随伴装备这个, 它能为你携带食物和饮品, 并为你提供高温抗性。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //随伴犬-配件
    },
    {
      "NamespaceHash": "Content::192860798",
      "Source": "Equip a Companion with this, and it can carry your ammo for you.",
      "Trans": {"SC":"给随伴装备这个, 它能为你携带弹药。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //随伴犬-配件
    },
    {
      "NamespaceHash": "Content::2794955476",
      "Source": "Equip a Companion with this, and it can distract hostile Creatures.",
      "Trans": {"SC":"给随伴装备这个, 它能为你分散敌对生物的注意力。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //随伴犬-配件
    },
    {
      "NamespaceHash": "Content::2381050063",
      "Source": "Equip a Companion with this, and it can heal you when you're injured.",
      "Trans": {"SC":"给随伴装备这个, 当你受伤时它可以治愈你。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //随伴犬-配件
    },
    {
      "NamespaceHash": "Content::1722953284",
      "Source": "Equip a Companion with this, and it can provide you a temporary speed boost.",
      "Trans": {"SC":"给随伴装备这个, 它能为你提供暂时的速度提升。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //随伴犬-配件
    },
    {
      "NamespaceHash": "Content::2903091215",
      "Source": "Equip a Companion with this, and it will allow you to breathe underwater for a time.",
      "Trans": {"SC":"给随伴装备这个, 它能为你提供短暂的水下呼吸时间。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //随伴犬-配件
    },
    {
      "NamespaceHash": "Content::3869104204",
      "Source": "Equip a Companion with this, and it will be even harder to take out.",
      "Trans": {"SC":"给随伴装备这个, 它就会变得更加难以击倒。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //随伴犬-配件
    },
    {
      "NamespaceHash": "Content::3143274845",
      "Source": "Equip a Companion with this, and it will carry an extra Chibi-pet for you.",
      "Trans": {"SC":"给随伴装备这个, 它能搭载一只袖珍宠物。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //随伴犬-配件
    },
    {
      "NamespaceHash": "Content::2590286299",
      "Source": "Equip a Companion with this, and it will carry gear more efficiently. Your Companion will also keep its inventory when it is disabled or killed.",
      "Trans": {"SC":"给随伴装备这个, 它能更高效地携带物品。当随伴受到很严重的伤害时, 会暂时地躲藏起来。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //随伴犬-配件
    },
    {
      "NamespaceHash": "Content::2756129710",
      "Source": "Equip a Companion with this, and it will deal more damage (on offense AND defense).",
      "Trans": {"SC":"给随伴装备这个, 它的进攻和防御都会对敌人造成额外的伤害。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //随伴犬-配件
    },
    {
      "NamespaceHash": "Content::933714158",
      "Source": "Equip a Companion with this, and it will give you hypothermic insulation and carry a sleeping bag for you.",
      "Trans": {"SC":"给随伴装备这个, 它将为你携带一张睡袋, 并为你提供低温抗性。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //随伴犬-配件
      //Equip a Companion with this, and it will give you insulation and carry a sleeping bag for you.
    },
    {
      "NamespaceHash": "Content::301203124",
      "Source": "Equip a Companion with this, and it will provide you with basic information about things you focus on.",
      "Trans": {"SC":"给随伴装备这个, 它能为你提供观察目标的基础信息。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //随伴犬-配件
    },
    {
      "NamespaceHash": "Content::2041719296",
      "Source": "Equip an Armadoggo with this to protect it.",
      "Trans": {"SC":"装备到铠护犬上以提供保护。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //随伴犬-配件
    },
    {
      "NamespaceHash": "Content::2950753429",
      "Source": "Your Companion is providing you with basic information on many things you focus on",
      "Trans": {"SC":"随伴会为你提供观察目标的基础信息。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //随伴犬-配件
    },
