    {
      "NamespaceHash": "Content::717629961",
      "Source": "Cornucopia Trough",
      "Trans": {"SC":"丰饶角饲料槽","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3420952468",
      "Source": "You can use this to skin the appearance of a Feeding Trough or Tek Feeding Trough to look like a cornucopia. Slop your tames from a horn of plenty!",
      "Trans": {"SC":"你可以使用这个皮肤来改变饲料槽或泰克饲料槽的外观, 使其变得像个丰饶角。装上它给你的驯养的生物喂食吧!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2563391625",
      "Source": "Cooked Turkey Hat",
      "Trans": {"SC":"烤火鸡头套","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1627659579",
      "Source": "You can use this to skin the appearance of a helmet or hat to look like a plush cooked turkey. Stuff this turkey with your head!",
      "Trans": {"SC":"你可以使用这个皮肤来改变头盔或帽子的外观, 使其变得像一只毛绒绒的火鸡。把你的头塞进这只火鸡里!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3963954675",
      "Source": "Pumpkin Pie Hat",
      "Trans": {"SC":"南瓜派帽子","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4100310732",
      "Source": "You can use this to skin the appearance of a helmet or hat to look like a plush slice of pie. Leave room in your inventory for dessert!",
      "Trans": {"SC":"你可以使用这个皮肤来改变头盔或帽子的外观, 使其变得像一只毛绒绒的馅饼。在你的背包里预留些空间放甜点!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3955517470",
      "Source": "Turkey Fryer",
      "Trans": {"SC":"火鸡炸锅","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2385963756",
      "Source": "You can use this to skin the appearance of a cooking pot to look like a turkey deep fryer. Always fry responsibly.",
      "Trans": {"SC":"可以使用它来改变烹饪锅的外观, 使其变成火鸡炸锅。油炸的时候一定要全神贯注。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3882799461",
      "Source": "Forest Crown",
      "Trans": {"SC":"森林皇冠","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4002750694",
      "Source": "You can use this to skin the appearance of a helmet or hat. Be the ruler of the autumnal forests.",
      "Trans": {"SC":"你可以使用这个皮肤来改变头盔或帽子的外观。成为秋季深林的统治者。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2498807650",
      "Source": "Friendly Gesture Emote",
      "Trans": {"SC":"友好手势表情","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::483811012",
      "Source": "Consume this to permanently unlock the \"Friendly Gesture\" emote. As seen on TV!",
