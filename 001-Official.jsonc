    {
      "NamespaceHash": "GraphLiteral::207134824",
      "Source": "ITEM TO REROLL",
      "Trans": {"SC":"重铸的物品","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1640846178",
      "Source": "INPUT COMPONENTS",
      "Trans": {"SC":"放入的组件","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::568178306",
      "Source": "The result item will be an item of the same type as the rerolled item, with the same Item quality, but with its stats re-rolled. {Chance} chance to fail and lower the result item quality by 20%.",
      "Trans": {"SC":"输出的物品与重铸的物品及品质保持不变, 但其属性会被重新生成。有{Chance}的几率会失败, 若失败将会导致输出的物品其品质下降20%","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //883B1A03452C8589E0508C9B6435EE9C
    },
    {
      "NamespaceHash": "GraphLiteral::3190082702",
      "Source": "The result item will have a quality equal to the quality of one of the items (50% chance of picking the highest quality item as the main item), added to 25% of the quality of the other 2 items.\r\nThis operation cannot fail.",
      "Trans": {"SC":"输出的物品其品质将选取其中一件物品的品质 (有50%的概率选取最高品质的物品作为主材料), 再加上另外两件物品总品质的25%\r\n此操作不会失败。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //4B9EFF76407EA4ADA39FE5900C0DD9C3
    },
    {
      "NamespaceHash": "GraphLiteral::4149890317",
      "Source": "REROLL REQUIREMENTS ARE NOT MET!",
      "Trans": {"SC":"未满足重铸需求!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
