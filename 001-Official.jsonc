    {
      "NamespaceHash": "Content::865734337",
      "Source": "Corrosive Ship Cannonball",
      "Trans": {"SC":"腐蚀舰炮弹","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::64219949",
      "Source": "This Ship-projectile contains acidic slime. Deals moderate damage to targets and corrodes their armor, causing them to take additional damage for a short duration.",
      "Trans": {"SC":"这种舰载弹药装有酸性黏液。可对目标造成中等伤害并腐蚀其护甲, 使其在短时间内受到额外伤害。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1480664523",
      "Source": "Incendiary Ship Cannonball",
      "Trans": {"SC":"燃烧舰炮弹","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2519563898",
      "Source": "This Ship-projectile contains flaming sludge. Deals moderate damage to targets and sets them on fire, dealing additional damage over time, and setting any Survivor or Tame that steps on the fire ablaze.",
      "Trans": {"SC":"这种舰载弹药装有燃烧淤泥。可对目标造成中等伤害并引燃目标, 持续造成额外伤害; 踏入火焰的生存者或驯养生物也会被点燃。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::732701732",
      "Source": "Reinforced Ship Cannonball",
