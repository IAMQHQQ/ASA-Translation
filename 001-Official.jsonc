    {
      "NamespaceHash": "Content::30061658",
      "Source": "Thrall Heavy Auto Turret",
      "Trans": {"SC":"射击训练场","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2659978345",
      "Source": "Ask Raptor Claus for a holiday gift! Make sure you're tucked away in bed near a Holiday Tree when he arrives with your <RichColor Color=\"0,1,1,1\">[ITEM TYPE]</>. The nicer you are, the better the reward! Some <RichColor Color=\"1,0,0,1\">Milk</> and <RichColor Color=\"0,1,0,1\">Cookies</> might also sweeten the deal. Though the naughty may not like what they get...",
      "Trans": {"SC":"向圣诞老人需要许愿一份礼物! 当圣诞老人带着你的<RichColor Color=\"0,1,2,2\">[ITEM TYPE]</>礼物到来时, 请确保你已经躺在圣诞树旁的床上。你表现的越好, 得到的奖励就会越好! 不过, 淘气的人可能不会喜欢他们得到的东西...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1308943874",
      "Source": "Take the fight to the Lost King!",
      "Trans": {"SC":"讨伐失落之王!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1749169924",
      "Source": "Grab the Key to unlock the Vault",
      "Trans": {"SC":"捡起钥匙以打开宝库","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::79796308",
      "Source": "Plant Proto Species R-",
      "Trans": {"SC":"原始异种植物R-","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2716095920",
      "Source": "Defeat the remaining Outpost defenders",
      "Trans": {"SC":"击败剩余的哨站守军","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2639935521",
      "Source": "Reinforcements Incoming!",
      "Trans": {"SC":"增援部队即将抵达!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4283869127",
      "Source": "Return to Mission area, or you will be removed from the Mission",
      "Trans": {"SC":"返回任务区域, 否则将被移出任务","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::57998617",
      "Source": "Out of Bounds",
      "Trans": {"SC":"超出边界","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3262420500",
      "Source": "Removed From Mission In: ",
      "Trans": {"SC":"将被移除任务倒计时: ","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::408142064", //H
      "Source": "Hear me! You found something real on the ARK with Diana and Helena, despite the loss and pain.",
      "Trans": {"SC":"听我说! 你同戴安娜和海莲娜一起在方舟上找到了真正重要的东西 -- 虽然经历了痛苦与离别。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2089264182", //H
      "Source": "Something you thought you'd lost in your first life... thousands of years before.",
      "Trans": {"SC":"那是你以为在第一段人生中失去的东西...在千年之前。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2803129190", //M
      "Source": "What? What did I find with them?",
      "Trans": {"SC":"什么? 我和她们一起找到了什么?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2265446452", //H
      "Source": "Yourself. Your true self -- Li Meiyin. And she’s still there within you now.",
      "Trans": {"SC":"你自己。真实的自己 -- 李美盈。而她现在仍然留存于你的内心。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3291817448", //M
      "Source": "I know you... Helena.",
      "Trans": {"SC":"我认得你...海莲娜。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2393754214", //H
      "Source": "And I know you, Meiyin.",
      "Trans": {"SC":"我也认得你, 美盈。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2287035734", //M
      "Source": "Thank you for helping me remember who I was... and who I still am.",
      "Trans": {"SC":"谢谢你帮我记起我曾经是谁...以及我依旧是谁。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3539226490", //M
      "Source": "You’ve ended my long nightmare. I just wanted...",
      "Trans": {"SC":"你终结了我长久以来的噩梦。我只是想...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3861108596", //H
      "Source": "To see me and Diana one more time.", //我还以为是美盈说的, 搞得我当时都不理解为什么这段话要用To see me😅
      "Trans": {"SC":"再见到我和戴安娜一面。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1869343061", //H
      "Source": "Now that can happen, thanks to the Engram Codex you've recovered.",
      "Trans": {"SC":"现在这一切可以实现了, 多亏你取回了印痕元码。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1436333767",
      "Source": "There was another where we are now, but... that was destroyed.",
      "Trans": {"SC":"我们如今所在的地方原本也曾有一个, 但是...它被毁了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3860132945", //H
      "Source": "We need your intact copy transmited to us, here on Arat.", //transmitted
      "Trans": {"SC":"我们需要你把完整的副本传输到这边 -- 就在阿拉特。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1302537269", //修补
      "Source": "We need your intact copy transmitted to us, here on Arat.",
      "Trans": {"SC":"我们需要你把完整的副本传输到这边 -- 就在阿拉特。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1508655447", //H
      "Source": "And add your own engrams into the data stream.",
      "Trans": {"SC":"再把你自己的印痕也加入数据流。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1869749258", //H
      "Source": "Then... we can finally be together again, on this new world.",
      "Trans": {"SC":"这样...我们终于能在这个新世界里重聚。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4156004623", //M
      "Source": "That's all I've wanted. And Diana?",
      "Trans": {"SC":"这就是我一直想要的...那戴安娜呢?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3292788763", //H
      "Source": "I have a friend that's working on it. It's just a matter of time.",
      "Trans": {"SC":"我有位朋友正在处理。只是时间问题。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::52753771", //H
      "Source": "Join us here and let the Lost Colony be cleansed, like the Earth has been.",
      "Trans": {"SC":"来加入我们吧, 让失落之地得到净化, 就像地球那样。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3569051258", //M
      "Source": "Your vision came true while I was Lost...?",
      "Trans": {"SC":"在我迷失的时候, 你的预言成真了?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::144198028", //H
      "Source": "Yes. I eventually found my champion, and the Titans finally fell once and for all.",
      "Trans": {"SC":"是的。我终于找到了我需要的天命之人, 而那些泰坦也终于彻底倒下了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::244955971", //H
      "Source": "Earth was cleansed of its Element poisoning and reseeded.",
      "Trans": {"SC":"地球的元素污染已被净化, 并重新播下了种子。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1493575375", //H
      "Source": "It's a paradise now, beyond wonder, with all things in balance.",
      "Trans": {"SC":"它现在是一片天堂, 美轮美奂, 万物和谐共生。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1415300527", //H
      "Source": "As we can make our Arat, together.",
      "Trans": {"SC":"这样我们可以一起打造属于我们的阿拉特。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4019295000", //M
      "Source": "Then let me join you in paradise, Helena. And we will bring Diana back to us.",
      "Trans": {"SC":"那就让我与你一同前往天堂吧, 海莲娜。我们一起把戴安娜带回来。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1128304331", //H
      "Source": "Everything will finally be set right.",
      "Trans": {"SC":"一切终将回归正轨。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2389911700", //Meeka
      "Source": "So, we got the Codex back from Earth. What are we waiting for? Let's use it to bring back my mom!",
      "Trans": {"SC":"所以, 我们已经从地球拿到元码了。那我们还在等什么呢? 快用它把我妈妈带回来吧!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::46188948", //H
      "Source": "It might not be that easy...",
      "Trans": {"SC":"事情可能没那么简单...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::51138895", //H
      "Source": "But before I tell you why, you have to promise this stays between you and I...",
      "Trans": {"SC":"不过在我告诉你原因之前, 你得保证这件事只有你知我知...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3356477090", //H
      "Source": "Just like the rest of our conversations, okay?",
      "Trans": {"SC":"就像我们之前聊的那样, 好吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1274898979", //Meeka
      "Source": "Yeah, sure.",
      "Trans": {"SC":"嗯, 好。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2046713413", //H
      "Source": "Yeah?",
      "Trans": {"SC":"是吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2884186696", //Meeka
      "Source": "I promise... Auntie Helena.",
      "Trans": {"SC":"我保证...海莲娜阿姨。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3885195518", //H
      "Source": "Buried deep within this planet is the core of the seed ship that brought us all here.",
      "Trans": {"SC":"在这颗星球的深处, 埋藏着把我们所有人带到这里的那艘‘种子飞船’的核心。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::768914581", //H
      "Source": "We need to input the complete copy of the Codex into its Respawn Matrices...",
      "Trans": {"SC":"我们需要把元码的完整副本输入它的复生矩阵...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2499547542", //H
      "Source": "...before we can revive Diana, Meiyin, or anyone else.",
      "Trans": {"SC":"...之后我们才能复活戴安娜, 美盈以及其他人。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::365495078", //H
      "Source": "And that might not be that easy.",
      "Trans": {"SC":"而这可能没那么容易。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2989364181", //Meeka
      "Source": "Why not?",
      "Trans": {"SC":"为什么呀?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2119640056", //H
      "Source": "I had to scuttle the seed ship to stop it from being overtaken by a terrible monster.",
      "Trans": {"SC":"为了不让那艘种子飞船被可怕的怪物占领, 我不得不让它自毁了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3066420623", //H
      "Source": "But the creature managed to leave one last copy of itself in that core.",
      "Trans": {"SC":"可那怪物还是在核心里给自己留下了一个备份。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::929414995", //H
      "Source": "While it was isolated over the past millenium, the entity was dormant and inert.",
      "Trans": {"SC":"在过去这千年里, 由于与外界隔绝, 它一直处于休眠且静止的状态。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1523034828", //H
      "Source": "And if we go down there, we might well awaken whatever remains of it.",
      "Trans": {"SC":"如果我们深入那里, 十有八九会唤醒它残留在那的任何东西。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1020586469", //Meeka
      "Source": "We’ve both survived all kinds of monsters. What's so bad about this one anyway?",
      "Trans": {"SC":"我们都对付过那么多怪物了。这个有什么好怕的?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1777207519", //H
      "Source": "When it was a tormented man, so long ago, his name was Edmund.",
      "Trans": {"SC":"当它还是个备受折磨的人时 -- 那是很久以前了 -- 他的名字叫艾德蒙","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::814331647", //Meeka
      "Source": "Wait... There's someone following us!",
      "Trans": {"SC":"等等...有人在跟踪我们!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2583429858", //H
      "Source": "Yes, there is. But where we're going, we're going to need his incredible strength.",
      "Trans": {"SC":"没错, 是有人跟着我们。不过我们要去的地方, 需要他那股惊人的力量。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4095563655", //H
      "Source": "And his spectacular skills, and mighty heart.",
      "Trans": {"SC":"还有他那一身绝活, 以及那颗无畏的心。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1524025515", //Bob
      "Source": "Were you expecting some other handsome, hairless hero? ",
      "Trans": {"SC":"你还以为会有其他又帅又滑溜的英雄吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::369995257", //Bob
      "Source": "Well, you got me.",
      "Trans": {"SC":"好吧, 正是在下。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::946943709",
      "Source": "Thrall Auto Turret",
      "Trans": {"SC":"血仆自动炮台","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4011753127",
      "Source": "You’ve done good work here for the sake of my kingdom.",
      "Trans": {"SC":"你为我的王国立下了功劳, 做得不错。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1022465457",
      "Source": "There are plenty of other outposts under siege, should you remain so civically inclined.",
      "Trans": {"SC":"还有许多其它哨站正遭围困 -- 倘若你仍愿意为王国效力的话。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3329774283",
      "Source": "There’s a revenant Malwyn teleporting your way now.",
      "Trans": {"SC":"有一只怨灵诡狱狐正传送到你那边来了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1270531090",
      "Source": "That miserable creature will curse all of your defenses until you pin it down and take it out!",
      "Trans": {"SC":"那个鬼东西会持续削弱你的所有防御, 直到你将其压制并除掉它。","JA":""}, //miserable creature到时候看看具体语音的语气再翻译
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1964353132",
      "Source": "Even Veilwyns haven’t been spared by the revenant curse...",
      "Trans": {"SC":"即使是霜灵狐也没能躲过怨灵诅咒...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3786167320",
      "Source": "There’s a pack of them coming now, and unless you want to be overrun, you'll need to put down their leader!",
      "Trans": {"SC":"它们现在正成群结队地冲过来, 不想被它们群起而攻, 你就必须先解决掉它们的头目!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3637125469",
      "Source": "Focus on taking out that revenant Carnotaur, before it rams its way through your defenses with those brutal skull-blades!",
      "Trans": {"SC":"优先集火怨灵食肉牛龙! 别让它用那对残暴的颅刃硬生生顶穿防线了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2925520199",
      "Source": "Hear the trumpeting yet? That’s the sound of a revenant Mammoth headed your way.",
      "Trans": {"SC":"听到那阵号角般的长鸣了吗? 那是怨灵猛犸正朝你这边冲来!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::963182815",
      "Source": "Its roars will embolden nearby enemy forces until you bring it down!",
      "Trans": {"SC":"它的咆哮会鼓舞附近的敌军, 尽快将它放倒!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1076290647",
      "Source": "Destroy all of them, do you hear me? I want all those things wiped from the face of my kingdom!",
      "Trans": {"SC":"把它们全部杀光! 听见没有? 我要把那些东西从我王国的疆域上彻底抹除!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2636435271",
      "Source": "I am so tired of those miserable creatures plaguing my kingdom. Do not let them have that outpost!",
      "Trans": {"SC":"我已经受够那些鬼东西在我的王国里作祟了。绝不能让它们占领那个哨站!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3948372668",
      "Source": "You had better not let another of my outposts fall to the revenant horde!",
      "Trans": {"SC":"你最好别再让我的任何一座哨站落入怨灵群之手!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1898151182",
      "Source": "Fight off that revenant filth! It's not like you have much choice, if you want to survive.",
      "Trans": {"SC":"干掉那群脏东西! 你应该没得选 -- 要是你想活命的话。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1218918328",
      "Source": "This is your chance to fortify your position before the enemy is on you!",
      "Trans": {"SC":"趁敌军尚未压境, 速速巩固你的防御!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3648022251",
      "Source": "Replicate all the defenses you can -- revenants are about to flood that outpost!",
      "Trans": {"SC":"能修筑多少防御就修筑多少 -- 怨灵大军马上就要涌向哨站了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3076677685",
      "Source": "You have revenants on their way to you now. Shore up your defenses!",
      "Trans": {"SC":"怨灵大军正向你逼近。快加固你的防线!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2413810335",
      "Source": "I can sense a revenant horde approaching. Fortify while you can!",
      "Trans": {"SC":"我感应到怨灵大军正在逼近。趁还有时间, 赶紧加固防线!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2822838726",
      "Source": "I will not suffer this insult lightly. My Bounty Hunter was tracking another fool,",
      "Trans": {"SC":"这种侮辱我不会就这么算了。我的赏金猎手原本是在追捕另一个蠢货,","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2023648870",
      "Source": "...but the reward I offered for your sorry skin should prove irresistible.",
      "Trans": {"SC":"...但我为你这贱命开出的悬赏, 没人拒绝得了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3194737837",
      "Source": "Losing a supply post may be a trivial setback, but you have become an irritant.",
      "Trans": {"SC":"丢个补给站不过是无关痛痒的小损失, 但你已成了我的眼中钉。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2516491011",
      "Source": "My Forgemaster is coming to you now to burn some sense into you.",
      "Trans": {"SC":"我的锻造大师现在就过来让你长点记性。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1379615125",
      "Source": "That outpost was there to watch for incoming revenants. Are you trying to get my children killed?",
      "Trans": {"SC":"那座哨站是用来监视来袭的怨灵而设的。你是想害死我的子民吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3855708298",
      "Source": "Enough of this. My best Marksman just returned from a mission, and he’s drawing a bead on you now.",
      "Trans": {"SC":"到此为止了。我的王牌狙击手刚执行任务归来, 现在正瞄着你呢。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3118376701",
      "Source": "You're starting to get on my nerves. My Cavalry Commander is coming to put the lash to you.",
      "Trans": {"SC":"你真的是让我火大了。我的骑兵统帅会来好好‘鞭策鞭策’你。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::977791071",
      "Source": "If you can't deal with his Desmodus, you don't stand a chance against mine.",
      "Trans": {"SC":"要是你连他的吸血蝠都打不过, 那你就根本不是我的对手。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1516267784",
      "Source": "This is a new low, even for you! As if I don’t have enough threats to deal with... Now you will share their fate.",
      "Trans": {"SC":"你真是刷新了下限! 我本来应付的威胁就够多了...现在, 你就和它们落得同样的下场吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::440579262",
      "Source": "The loyal thralls defending that outpost will easily repel your pathetic incursion.",
      "Trans": {"SC":"戍卫该哨站的忠仆大军, 将轻松碾碎你那可悲的入侵。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3427393454",
      "Source": "What makes you think I would allow you to attack one of my outposts? You’re no better than the revenants.",
      "Trans": {"SC":"你你凭什么以为我会容许你攻击我的哨站? 你和那些怨灵没什么两样。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3920248468",
      "Source": "Don't expect my children to just sit around while you destroy my property. Nor should you hope for any mercy.",
      "Trans": {"SC":"别以为我的子民会任由你毁坏我的财产, 我对你也不会有半分仁慈。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3056412646",
      "Source": "I clearly overestimated you.",
      "Trans": {"SC":"我显然高估你了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4009310658",
      "Source": "Pathetic.",
      "Trans": {"SC":"窝囊","JA":""}, //真菜, 辣鸡 😂
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1130622990",
      "Source": "I suppose now you know your limits.",
      "Trans": {"SC":"我想你现在知道自己几斤几两了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::241942999",
      "Source": "Was that truly the best you can do?",
      "Trans": {"SC":"这就是你全部的能耐吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::152403950",
      "Source": "*agonized growl*",
      "Trans": {"SC":"*痛苦嘶吼*","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3156462957",
      "Source": "Curse you and curse her! I swear I will have the last laugh.",
      "Trans": {"SC":"你不得好死 -- 她也一样! 走着瞧, 最后笑的会是我。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3489105277",
      "Source": "You’re the real monster here. Hell-bent on driving us to extinction... The last of our kind...",
      "Trans": {"SC":"你才是真正的怪物...你铁了心要把我们逼到绝路...我族最后的血脉啊...","JA":""}, //LK: 你了不起, 你清高
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4066000654",
      "Source": "You with your ‘angel on your shoulder’... How dare you invade our home and threaten my children!",
      "Trans": {"SC":"你一副道貌岸然的样子...竟敢入侵我们的家园, 危害我的子民!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1845317935",
      "Source": "You have no idea what I have had to overcome... What it took to build this kingdom up from the ashes!",
      "Trans": {"SC":"你根本不知道我都经历过什么...付出了怎样的代价, 才把这个王国从废墟中重建起来!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::328681763",
      "Source": "What do you know of survival? I’ve outlived any human in history or legend. Methuselah had nothing on me!",
      "Trans": {"SC":"你知道什么叫生存吗? 我比历史或传说中的任何人活得都更长。“玛土撒拉”在我面前也不值一提!","JA":""}, //在考虑要不要加"才叫"
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1587266491",
      "Source": "Why do you keep throwing yourself against me? I’ve shown you I can shrug off anything you do to hurt me.",
      "Trans": {"SC":"你为什么非要执意和我作对? 我早就让你见识过了, 你那点手段根本奈何不了我。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::468029317",
      "Source": "How much longer can you hope to fight on? You have none of my knowledge, none of my power...",
      "Trans": {"SC":"你还能硬撑到什么时候? 你既没有我的见识, 也没有我这般力量...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1153434261",
      "Source": "Do you understand now how hopeless this is? Back to the air, Gigadesmodus. Let my children deal with this fool!",
      "Trans": {"SC":"现在你明白这有多无力了吗? 飞回空中去, 巨翼魔蝠。让我的孩子们来收拾这个蠢货。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1933578733",
      "Source": "You wanted me down here with you? Now you can witness the power of the Red up close!",
      "Trans": {"SC":"你不是想我下来陪你吗? 那就近距离见识一下“腥红”之力吧!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2060614658",
      "Source": "It’s no use. You’re losing.",
      "Trans": {"SC":"没用的。你输定了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2590033701",
      "Source": "Back up and running!",
      "Trans": {"SC":"满血复活!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4113699861",
      "Source": "You can’t win.",
      "Trans": {"SC":"你赢不了的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::271000959",
      "Source": "Not fast enough!",
      "Trans": {"SC":"不够快!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1227561121",
      "Source": "Much too slow!",
      "Trans": {"SC":"太慢了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3677406243",
      "Source": "Broken Infested Wall",
      "Trans": {"SC":"受感染的破损墙壁","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3903589898",
