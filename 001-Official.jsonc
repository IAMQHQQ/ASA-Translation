      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::909144646",
      "Source": "This Ship-projectile is made from heavier metals than standard cannonballs. Deals very high damage to targets, and can even damage Player-owned Sturctures.",
      "Trans": {"SC":"这种舰载弹药采用比标准炮弹更重的金属制成。对目标造成极高伤害, 甚至能伤害玩家建筑。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
