    {
      "NamespaceHash": "Content::428806768",
      "Source": "Provides light, and some warmth. Doubles as a melee weapon in a pinch, and can be applied to various saddles & your belt for a hands free light source.",
      //火把描述
      "Trans": {"SC":"提供照明和一定的温暖, 在紧急时可当作近战武器使用, 还可以安装在各种鞍具和腰带上, 来实现免持式照明。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::488321937",
      "Source": "Put various ingredients with water in this to make soups, stews, and dyes.  Must contain basic fuel to light the fire.",
      //吊锅描述
      "Trans": {"SC":"将各种配料与水放入其中, 制作炖汤, 菜肴和染料。需要基本燃料才能点火。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3845377223",
      "Source": "The stone intake for a wireless irrigation network. Provides an unlimited supply water to nearby structures.",
      //石制引水管描述
      "Trans": {"SC":"可无线灌溉的石制引水口。能为附近的建筑无限供水。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::243148409",
      "Source": "The metal intake for a wireless irrigation network. Provides an unlimited supply water to nearby structures.",
      //金属引水管描述
      "Trans": {"SC":"可无线灌溉的金属引水口。能为附近的建筑无限供水。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1020656429",
      "Source": "Stores rain or manually deposited water & distributes it to nearby structures. Will connect to other water tanks to form a network.",
      //蓄水池描述
      "Trans": {"SC":"可储存雨水或手动注水, 并将其分配到附近需要用到水的建筑上。可以与其它蓄水池连接形成网络。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2142526038",
      "Source": "A simple stone ladder used to climb up or down tall structures.  Can also be used to extend existing ladders.",
      //石制楼梯描述
      "Trans": {"SC":"一种简单的石制梯子, 用于攀爬到高层建筑。也可用于延伸梯子的长度。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4147818369",
      "Source": "A very large reinforced ceiling gate that can be used with a Gateway to keep most dinosaurs in or out.",
      //巨型天窗门描述
      "Trans": {"SC":"这是一个巨型加固的天窗门, 可以配合其它建筑来设卡, 来阻挡大多数恐龙或困在其中。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1703703320",
      "Source": "A very large adobe gate that can be used with a Gateway to keep most dinosaurs in or out.",
      "Trans": {"SC":"这是一个巨型黏土天窗门, 可以配合其它建筑来设卡, 来阻挡大多数恐龙或困在其中。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4166815626",
      "Source": "Sit on it when you hear the call of nature. Do your business, feel refreshed, spoil all raw meat inside and then flush for efficient waste disposal! Requires connection to water to flush.",
      "Trans": {"SC":"当你感受到大自然的召唤时, 就坐上去。释放一下, 神清气爽, 连带里面的肉都会被腐坏, 最后冲冲水, 处理了废物, 干净又卫生! 需要供水才能冲水。","JA":""},
      //马桶描述-当你感受到大自然的召唤时, 你就坐上去。方便完后你就会感到浑身舒畅, 并且里面的肉会被腐坏, 最后冲水进行有效的废物处理! 需要供水才能冲水。
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3579701774",
      "Source": "Cooks large quantities of soups, stews, and dyes quickly.  Requires Gasoline or Power.",
      //工业大锅描述
      "Trans": {"SC":"可快速烹饪大量的炖汤, 菜肴和染料。需要电力或汽油才能启动。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1166806452",
      "Source": "Fabricate mechanized items here. Requires Gasoline or Power to be activated.",
      //机床内部描述
      "Trans": {"SC":"在这里制作工业机械化物品。需要电力或汽油才能启动。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3778831355",
      "Source": "Put various foods and a recipe in this to cook advanced consumables. Requires Gasoline or Power to be activated.",
      //工业大锅内部描述
      "Trans": {"SC":"将各种食材和食谱放到里边来烹饪出高级的消耗品吧。需要电力或汽油才能启动。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::208638285",
      "Source": "Put unrefined resources in this to refine them. Requires Gasoline or Power to be activated.",
      //工业熔炉内部描述
      "Trans": {"SC":"将未加工过的资源放到这里进行精炼。需要电力或汽油才能启动。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1744838044",
      "Source": "Transmute resources into new items. Requires Gasoline or Power to be activated.",
      //化学实验桌内部描述
      "Trans": {"SC":"将资源转换成新的物品。需要电力或汽油才能启动。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1593059711",
      "Source": "Cooks raw food when active, in bulk. Requires Gasoline or Power to be activated.",
      //工业烤箱内部描述
      "Trans": {"SC":"可用于快速批量烤肉。需要电力或汽油才能启动。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1904989940",
      "Source": "This is the perfect tree to use when celebrating the winter solstice!",
      //圣诞树描述
      "Trans": {"SC":"这是一颗在冬至庆祝最绝佳的树!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::903703564",
      "Source": "Box o' Chocolates",
      //情人节巧克力
      "Trans": {"SC":"盒装巧克力","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::494928386",
      "Source": "<RichColor Color=\"1, 0.5, 0.8, 1\">This chocolate's delicious, despite its origins. The Island's creatures LOVE it, as it fully heals them or advances their taming!</>",
      "Trans": {"SC":"<RichColor Color=\"1, 0.5, 0.8, 1\">这是一块非常美味的巧克力, 尽管它的来源有点特殊。岛上的生物都很喜欢它, 因为它可以完全自愈它们或者加快驯服它们的过程!</>","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //失效了-情人节巧克力描述
    },
    {
      "NamespaceHash": "Content::3034704446",
      "Source": "<RichColor Color=\"1, 0.5, 0.8, 1\">This chocolate's delicious, despite its origins. The Island's creatures LOVE it, as it fully heals them, advances their taming, and reduces their mating cooldown!</>",
      "Trans": {"SC":"<RichColor Color=\"1, 0.5, 0.8, 1\">这是一块非常美味的巧克力, 尽管它的来源有点特殊。岛上的生物都很喜欢它, 因为它可以完全自愈它们和加快驯服它们的过程, 以及还可以缩短它们的交配冷却时间!</>","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::954321319",
      "Source": "Highly advanced gauntlets that allow the wearer to perform devastating punches.\r\nEquipping requires learning this Tekgram.",
      //泰克拳套描述
      "Trans": {"SC":"高度先进的护手, 佩戴者可使出破坏性的重拳。\r\n需要先学会该泰克印痕技能才可使用。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1395911133",
      "Source": "A large reinforced ceiling gate that can be used with a Gateway to keep most dinosaurs in or out.",
      //大型天窗框描述
      "Trans": {"SC":"这是一个大型加固的天窗门, 可以配合其它建筑来设卡, 来阻挡大多数恐龙或困在其中。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3003875908",
      "Source": "This composite Tek slab can be used to secure hatches.",
      //泰克巨型天窗门描述
      "Trans": {"SC":"泰克材料加工而成的天窗门, 可以配合其它建筑来设卡, 来阻挡大多数恐龙或困在其中。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::969214380",
      "Source": "This will override all other skins, acting as a full-body costume. Should always be set on Torso Armor. Gather up some branches for a switch... It's time to punish the naughty!",
      "Trans": {"SC":"使用这个皮肤来覆盖其它外观, 充当全身套装。该皮肤装备在躯干或胸甲上。\r\n\r\n收集一些树枝作为皮鞭...是时候惩罚那些淘气的人了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //坎普斯套装介绍
    },
    {
      "NamespaceHash": "Content::2698914940",
      "Source": "Holiday Hearth Forge",
      "Trans": {"SC":"圣诞火炉","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::89742023",
      "Source": "You can use this to skin the appearance of a forge to look like a festive holiday hearth. Stockings carefully hung 'round the fire, in hope that some gift-giving might soon transpire...",
      "Trans": {"SC":"你可以使用这个皮肤来改变精炼炉的外观, 使其变成圣诞风格的火炉。袜子静静地挂在火炉旁, 盼望礼物快点到来...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
