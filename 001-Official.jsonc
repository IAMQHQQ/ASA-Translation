      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::393808122",
      "Source": "Keeps your temperature up, so long as it stays dry. Also reduces the Stamina cost of sprinting when Arctic Scout armor is equipped to all five slots.",
      "Trans": {"SC":"在保持干燥的情况下可持续保暖。当穿戴齐五件极地侦查装备时, 还可以降低冲刺的耐力消耗。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1244349384",
      "Source": "Neophyte Horns",
      "Trans": {"SC":"猎杀者之角","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
