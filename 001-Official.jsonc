    },
    {
      "NamespaceHash": "Content::125160240",
      "Source": "Archelon Algae",
      "Trans": {"SC":"古巨龟海藻","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
      //古巨龟
    },
    {
      "NamespaceHash": "Content::2941582212",
      "Source": "Incredibly nutritious Algae that grows on Archelon. Most wild herbivores love this stuff.",
      "Trans": {"SC":"一种生长在古巨龟身上且营养极其丰富的藻类。大多数素食动物都非常喜欢它。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //古巨龟
    },
    {
      "NamespaceHash": "Content::2099170735",
      "Source": "Algae Sushi",
      "Trans": {"SC":"海藻寿司","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
      //古巨龟
    },
    {
      "NamespaceHash": "Content::3635601390",
      "Source": "Incredibly nutritious sushi that any dino will love! Use this on a taming Dino to boost some lost taming effectiveness! But where did the rice come from?... (DOES NOT WORK ON PASSIVE TAMES! WILL BREAK EFFECTIVENESS!)",
      "Trans": {"SC":"营养极其丰富的寿司, 任何恐龙都喜欢它! 用它可以帮你提升一些丢失的驯养有效性! 嗯? 话说..米饭是从哪里来的呢?...(对和平驯服的生物不管用! 会降低有效性!)","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //古巨龟
    },
    {
      "NamespaceHash": "Content::3458952977",
      "Source": "Archelon Air Bubbles",
      "Trans": {"SC":"古巨龟氧气","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //古巨龟
    },
    {
      "NamespaceHash": "Content::3245116935",
      "Source": "You gain oxygen when near a saddled Archelon!",
      "Trans": {"SC":"靠近装配鞍具的古巨龟时能够补充氧气。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //古巨龟
    },
