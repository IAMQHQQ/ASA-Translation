    },
    {
      "NamespaceHash": "GraphLiteral::3634762912",
      "Source": "Cooldown (seconds)",
      "Trans": {"SC":"冷却 (秒)","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3537402741",
      "Source": "Attack Speed",
      "Trans": {"SC":"攻击速度","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
