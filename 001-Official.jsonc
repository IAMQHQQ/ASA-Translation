      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::889025693",
      "Source": "You can use this to skin the appearance of a chestpiece to look like a Frontier-style drifter shirt.",
      "Trans": {"SC":"你可以使用这个皮肤来改变上衣或胸甲的外观。使其变成一件具有西部风格的流浪者衬衫。","JA":""},
