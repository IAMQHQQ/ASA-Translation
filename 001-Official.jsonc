    },
    {
      "NamespaceHash": "Content::870983387",
      "Source": "An electrical defense tower that can burn, stun, or inflict damage vulnerability. Can be configured to automatically attack hostiles within range. Consumes Crystals to fire. Requires Power to activate.",
      "Trans": {"SC":"一种可设置自动攻击范围内敌对目标的防御型电塔, 能够造成灼伤、眩晕以及使目标承受过载受到的伤害会加深。发射时消耗水晶。需要电力来激活。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::347141254",
      "Source": "Holds Crystals, which power the Tesla Coil's energy attacks",
      "Trans": {"SC":"放置水晶为特斯拉电塔的攻击提供动能。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
