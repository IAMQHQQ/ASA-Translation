      "Trans": {"SC":"羁绊驯服","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3585871224",
      "Source": "Creatures you tame gain a <RichColor Color=\"1,0,0,1\">{ImprintBonus}%</> imprint bonus for you.",
