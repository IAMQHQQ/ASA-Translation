      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2239750370",
      "Source": "A technological marvel that connects to other allied Linked Storage Boxes. Items in one can be accessed in all others. Requires Power to access the shared storage.",
      "Trans": {"SC":"一项技术奇迹。部落中的“互联式储物箱”能够在箱内实现物品的互联共享。需要接入电源才能启用互联功能。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::322059389",
      "Source": "Items stored in this can be accessed from any Linked Storage Box of the same tribe.",
      "Trans": {"SC":"存放在里面的物品可通过同一部落的任何互联式储物箱进行访问。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3453273794",
      "Source": "Requires power or a battery to connect to the linked storage network.",
      "Trans": {"SC":"需要电力或电池才能实现互联式存储。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
