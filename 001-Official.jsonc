      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1739150726",
      "Source": "Drops aggro of creatures",
      "Trans": {"SC":"消除生物的仇恨","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3223762010",
      "Source": "Smoke Grenades you deploy last for <RichColor Color=\"1,0,0,1\">{!DurMulti}%</> longer. Throwing a Smoke Grenade instantly breaks you out of any trap, and drops aggro from Creatures while you remain in the smoke (3 minute cooldown).",
      "Trans": {"SC":"你投掷的烟雾弹持续时间将延长 <RichColor Color=\"1,0,0,1\">{!DurMulti}%</>。投掷烟雾弹可以让你立即摆脱所有陷阱, 并且当你处于烟雾中时, 可以消除生物对你的仇恨。(三分钟冷却时间)","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::280053648",
