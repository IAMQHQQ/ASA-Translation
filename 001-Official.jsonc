    {
      "NamespaceHash": "Content::2923541195",
      "Source": "You gain an increase to all stats while being ridden by your favorite rider. Each stack increases stats by 0.5%, and can be built up by having the same rider over time.",
      "Trans": {"SC":"在被心仪的骑手乘骑时, 所有属性将获得提升。持续与同一骑手搭配即可累积层数, 每叠加一层可提升0.5%属性。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
