    },
    {
      "NamespaceHash": "Content::695169902",
      "Source": "Unstable Red Element",
      "Trans": {"SC":"不稳定的腥红能量元素","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2444530219",
      "Source": "Element infused with Blood. Over time it will stabilize and become Red Element.",
      "Trans": {"SC":"浸染了血液的元素。随着时间推移逐渐稳定, 最终转变为腥红能量元素","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::625541412",
      "Source": "Red Element Shard",
      "Trans": {"SC":"腥红元素碎片","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2987137104",
      "Source": "A small chunk of strange, highly advanced material, infused with blood. It dissolves when transferred across ARKs.",
      "Trans": {"SC":"一小块浸染了血液的奇特高级物质, 浑身透射着能量。它在跨方舟传输时会溶解消失。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1762833504",
