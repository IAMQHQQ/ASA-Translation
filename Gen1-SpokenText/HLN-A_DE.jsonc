{
  //情境语音 - 2026-07-26 10:39:28
  "Functional": [
    {
      "NamespaceHash": "Globals::1940723185",
      "Source": "Wir sollten diesem Trottel ein Klohäuschen bauen.",
      "Trans": {"SC":"我们应该给那家伙造个厕所。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1800918308",
      "Source": "Okay, deine riecht nicht so wie die.",
      "Trans": {"SC":"至少你的没那么臭。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1093516981",
      "Source": "Das ist nicht wirklich diskret, nicht?",
      "Trans": {"SC":"这么直接的吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::543114614",
      "Source": "Hör mal, Überlebender!",
      "Trans": {"SC":"喂, 生存者!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::788409774",
      "Source": "Hey, Überlebender!",
      "Trans": {"SC":"嘿, 生存者!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2133735213",
      "Source": "Hallo Kumpel!",
      "Trans": {"SC":"哈喽, 朋友!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::924148052",
      "Source": "Es wird Unmengen schneien.",
      "Trans": {"SC":"下暴雪了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::991424284",
      "Source": "Die Sicht ist schlecht. Praktisch ein Whiteout!",
      "Trans": {"SC":"能见度很差。只有白茫茫的一片!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1707257556",
      "Source": "Wurde der Blizzard vorhergesagt?",
      "Trans": {"SC":"天气预报里说要下大暴雪吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1705934319",
      "Source": "In was für einen Mist hast du uns reingeritten?",
      "Trans": {"SC":"你给我们惹了什么麻烦?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1940114240",
      "Source": "Du hast ein Talent dafür, andere auf dich wütend zu machen.",
      "Trans": {"SC":"你好像很擅长惹别人生气。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2318448577",
      "Source": "Was auch immer kommt, wir scheren uns nicht drum!",
      "Trans": {"SC":"不管发生什么事, 我们都得全力以赴!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3196396041",
      "Source": "Oh, da hat aber jemand Hunger!",
      "Trans": {"SC":"哇, 它饿了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::999340630",
      "Source": "Schau mal, wie es reinhaut!",
      "Trans": {"SC":"好大一口!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3603288780",
      "Source": "Das ist der Kreislauf des Lebens, nicht!",
      "Trans": {"SC":"这就是生命循环, 是吧?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::588510111",
      "Source": "Laut meinen Sensoren kommt etwas.",
      "Trans": {"SC":"我的传感器表明有物体正在靠近。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3870550020",
      "Source": "Hörst du das auch?",
      "Trans": {"SC":"你听到了吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2404992726",
      "Source": "Mach dich bereit, Überlebender. Es kommt etwas!",
      "Trans": {"SC":"生存者, 准备好。有什么东西要来了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::856167059",
      "Source": "Ruhe in Frieden, du unglückseliges Viech.",
      "Trans": {"SC":"安息吧, 小倒霉蛋。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2246958493",
      "Source": "Es ist immer tragisch, wenn ein Haustier stirbt ...",
      "Trans": {"SC":"每当此时, 都令人感到悲伤...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3239839838",
      "Source": "Zum Abheben bereit!",
      "Trans": {"SC":"准备起飞!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3412072503",
      "Source": "Fliegen wir los!",
      "Trans": {"SC":"飞呀!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4162287913",
      "Source": "Klapp den Tisch ein. Es ist Zeit zum Starten!",
      "Trans": {"SC":"要起飞了, 请收起托盘架!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2897454938",
      "Source": "Es grast ein wenig ...",
      "Trans": {"SC":"它在吃草...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1291553971",
      "Source": "Schau mal, wie es zuschlägt!",
      "Trans": {"SC":"看着它慢慢地吃下去。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2525063728",
      "Source": "Schau, wie es reinhaut!",
      "Trans": {"SC":"它吃得好开心!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2094558488",
      "Source": "Das ist aber ein echt Großer!",
      "Trans": {"SC":"真是个大家伙。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1620966282",
      "Source": "Der hier ist riesig!",
      "Trans": {"SC":"好大啊!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2831333788",
      "Source": "Sie können nicht viel größer werden.",
      "Trans": {"SC":"这也太大了吧!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3409127364",
      "Source": "Was für ein hübsches Tier!",
      "Trans": {"SC":"真是只好宠物!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3668441996",
      "Source": "Bist du ein braves Viech? Ja, das bist du.",
      "Trans": {"SC":"谁是乖宝宝? 没错就是你!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::332232403",
      "Source": "Jemand hat ein besonderes Leckerchen verdient!",
      "Trans": {"SC":"有零食吃咯!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3699232811",
      "Source": "Stoppe, lass dich fallen und roll dich weg, Trottel!",
      "Trans": {"SC":"吸气、呼气、爆炸!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2296021765",
      "Source": "Wie wäre es mit etwas Feuer, Vogelscheuche?",
      "Trans": {"SC":"来点烟火怎么样?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::712476356",
      "Source": "Wir brennen sie nieder!",
      "Trans": {"SC":"它们在燃烧!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1165358380",
      "Source": "Das Viech braucht frische Luft!",
      "Trans": {"SC":"让它呼吸!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2424584148",
      "Source": "Dein Haustier kann nicht atmen!",
      "Trans": {"SC":"你的宠物喘不上气了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3287231902",
      "Source": "Oh. Oh je ...",
      "Trans": {"SC":"噢。哇...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4267182751",
      "Source": "Was hast du gegessen, um das zu produzieren?",
      "Trans": {"SC":"它吃了什么东西?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::402441598",
      "Source": "Ich putze das hier nicht weg!",
      "Trans": {"SC":"我可不来清理这东西!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2940138776",
      "Source": "In Momenten wie diesen bin ich froh, dass ich nicht riechen kann.",
      "Trans": {"SC":"每到这时候, 我便庆幸自己没有嗅觉。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3031484962",
      "Source": "Oh! Das ist ... größer als ich dachte.",
      "Trans": {"SC":"噢! 这...比我想象中的大。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1533684892",
      "Source": "Lassen wir hier einfach Biomüll herumliegen?",
      "Trans": {"SC":"我们就把这坨生化废料留在这里吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::97810024",
      "Source": "Es beruhigt sich wieder ... und schrumpft.",
      "Trans": {"SC":"它冷静下来了。身体正在缩小。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1976018398",
      "Source": "Oh, schau nur! Es wird wieder niedlich.",
      "Trans": {"SC":"哇, 瞧! 又变得可爱了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::963457069",
      "Source": "Alles gut, kleines Biest. Du beruhigst dich jetzt.",
      "Trans": {"SC":"小猫咪, 乖哦。冷静一点。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::759396359",
      "Source": "Es wird zum Berserker!",
      "Trans": {"SC":"它狂暴了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::505086493",
      "Source": "Achtung! Es ist rasend geworden!",
      "Trans": {"SC":"当心! 它狂暴了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2392085083",
      "Source": "Es ist vollkommen wütend! Halte Abstand!",
      "Trans": {"SC":"它发狂了! 保持距离!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2628222135",
      "Source": "Es wird riesig! Böses Monster!",
      "Trans": {"SC":"它变大了! 坏家伙!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2781805441",
      "Source": "Mist, es wächst schnell!",
      "Trans": {"SC":"它长得好快!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4112002048",
      "Source": "Es wächst –und wird wütend!",
      "Trans": {"SC":"它更大更凶了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::991035107",
      "Source": "Oh, wie süß!",
      "Trans": {"SC":"噢, 好可爱!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1963415408",
      "Source": "Was für ein niedliches Wesen?",
      "Trans": {"SC":"多么可爱的样本啊!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3289418148",
      "Source": "Du bist aber niedlich!",
      "Trans": {"SC":"你是谁的小可爱?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3418756290",
      "Source": "Wie auf dem Spielplatz!",
      "Trans": {"SC":"如履平地!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2491154802",
      "Source": "Wir schaukeln! Wusch!",
      "Trans": {"SC":"我们在荡秋千!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1223213072",
      "Source": "Warte mal, Kumpel!",
      "Trans": {"SC":"抓紧咯!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2527674228",
      "Source": "Das Viech braucht eine Pause ...",
      "Trans": {"SC":"这家伙需要休息一下...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1208895352",
      "Source": "Du mutest dem Viech zu viel zu.",
      "Trans": {"SC":"你把它累坏了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2103413488",
      "Source": "Füttere dein Haustier, Kumpel.",
      "Trans": {"SC":"给你的宠物喂点东西吧...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4193068648",
      "Source": "Dein Viech sieht hungrig aus.",
      "Trans": {"SC":"你的宠物看上去饿坏了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3940962484",
      "Source": "Du hast ein wildes Tier gezähmt!",
      "Trans": {"SC":"你驯服了这头猛兽!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::60381930",
      "Source": "Es ist gezähmt, aber noch immer wild.",
      "Trans": {"SC":"它虽然被驯服了, 但依然很凶猛!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1067269124",
      "Source": "Dieses Viech scheint zahm genug zu sein.",
      "Trans": {"SC":"它看上去温顺多了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1206014436",
      "Source": "Es ist ein zahmer Dodo! Wie ein normaler Dodo, nur ... nicht so gefährlich?",
      "Trans": {"SC":"这是一只驯化了的渡渡鸟。和野生的类似, 但可能...温顺一点?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3949107332",
      "Source": "Du hast dir ein lebendiges Exemplar zugelegt.",
      "Trans": {"SC":"你获得了一件活体标本。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2325419280",
      "Source": "Das Zähmen wird dir nutzen.",
      "Trans": {"SC":"它会派上用场的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1765094695",
      "Source": "Das ist ein glückliches Viech!",
      "Trans": {"SC":"真是只快乐的动物!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::140246830",
      "Source": "Es ist zahm. Schmiedest du jetzt drinnen etwas?",
      "Trans": {"SC":"它被驯服了。你想现在用它造点什么吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3481903279",
      "Source": "Ein zahmer Utahraptor. Aber er sieht noch immer wild aus!",
      "Trans": {"SC":"一头被驯服的犹他盗龙, 但看上去还是很凶恶!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4291784082",
      "Source": "Der König der Dinosaurier ... und jetzt der König deiner Haustiere.",
      "Trans": {"SC":"曾经恐龙之王! 现在听你号令!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1210237751",
      "Source": "Ich hoffe, es bleibt so niedlich, jetzt wo es zahm ist!",
      "Trans": {"SC":"希望被驯服后的它可以一直这么可爱!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::354194124",
      "Source": "Es ist zahm. Doch geht es dir gut?",
      "Trans": {"SC":"它被驯服了...你感觉怎么样?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2838645637",
      "Source": "Wirst du es zähmen?",
      "Trans": {"SC":"你要驯养它吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2841119621",
      "Source": "Ich denke, du kannst es zähmen.",
      "Trans": {"SC":"我觉得你可以驯驯看。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1425913569",
      "Source": "Daraus würde ein tolles Haustier werden.",
      "Trans": {"SC":"它肯定会是只好宠物。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1591824757",
      "Source": "Du hast da eine Insel gezähmt, würde ich sagen.",
      "Trans": {"SC":"你驯了一座“小岛”。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2120459033",
      "Source": "Du hast es gezähmt. Bis zur Unendlichkeit und noch viel weiter, nicht?",
      "Trans": {"SC":"你成功驯服了它。飞向宇宙,浩瀚无垠!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3940694664",
      "Source": "Bist du ein durstiges Haustier?",
      "Trans": {"SC":"它是不是渴了?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1565932644",
      "Source": "Dein Viech sieht aus, als ob es großen Durst hat.",
      "Trans": {"SC":"你的宠物好像很渴。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2513622726",
      "Source": "Das Viech ist ganz benommen.",
      "Trans": {"SC":"小东西看上去晕乎乎的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2696870286",
      "Source": "Schau dir das erschöpfte Viech an!",
      "Trans": {"SC":"这小家伙快昏过去了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1733696232",
      "Source": "Tauche, tauche! Uuuuuuuh-gah!",
      "Trans": {"SC":"下潜, 下潜!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::198202193",
      "Source": "Stell dich darauf ein, zu tauchen – und nass zu werden!",
      "Trans": {"SC":"下潜, 下潜! 呜 —— 嘎!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::235592582",
      "Source": "Lass uns ein wenig herumschwimmen, unter den Wellen.",
      "Trans": {"SC":"让我们在水下游会泳。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2374545037",
      "Source": "Schön, den Himmel wieder zu sehen.",
      "Trans": {"SC":"很高兴能再次看到蓝天!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3851239570",
      "Source": "Wir haben die Oberfläche erreicht.",
      "Trans": {"SC":"我们浮上来了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3463216642",
      "Source": "Mach dich zum Warpen bereit!",
      "Trans": {"SC":"准备曲率飞行!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3242203362",
      "Source": "Wir sind auf dem Weeeeeeeg!",
      "Trans": {"SC":"动起~来!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1908206846",
      "Source": "Los geht's – Warpgeschwindigkeit!",
      "Trans": {"SC":"以曲率速度前进!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::527812768",
      "Source": "Jetzt werde mal nicht übermütig, Kleiner!",
      "Trans": {"SC":"别得意忘形了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3186788004",
      "Source": "Du hast ihn!",
      "Trans": {"SC":"打中了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::432072414",
      "Source": "Bleib dran ...",
      "Trans": {"SC":"瞄准目标...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::641914369",
      "Source": "Fühlst du diese Erschütterung?",
      "Trans": {"SC":"天气预报里说要下大暴雪吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::562991643",
      "Source": "Oh, alles bebt!",
      "Trans": {"SC":"所有东西都在晃!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1245116702",
      "Source": "Es ist ein Erdbeben!",
      "Trans": {"SC":"所有东西都在晃!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3703573050",
      "Source": "Was ist das da drüben?",
      "Trans": {"SC":"那是什么?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3544952401",
      "Source": "Aha, ich habe etwas gefunden.",
      "Trans": {"SC":"啊哈! 看我找到了什么。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::550699321",
      "Source": "Schaust du dir das mal an?",
      "Trans": {"SC":"瞧瞧那是什么东西?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3117072136",
      "Source": "Lass mich das schnell scannen...",
      "Trans": {"SC":"让我来快速扫描一下...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::796027709",
      "Source": "Scan beginnt...",
      "Trans": {"SC":"正在执行扫描...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1969828382",
      "Source": "Lass es uns ansehen. Scanner aktiv!",
      "Trans": {"SC":"让我们来看看。激活扫描仪!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2703628538",
      "Source": "Du hast da viele Hexagons, Kumpel.",
      "Trans": {"SC":"朋友, 你有不少六角币呢。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2055689896",
      "Source": "Du bist reich ... jedenfalls an Hexagons.",
      "Trans": {"SC":"你的六角币真多。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2864548425",
      "Source": "Sparst du dir all diese Hexagons für etwas auf?",
      "Trans": {"SC":"你存这么多六角币是想买什么?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1429404277",
      "Source": "Versuchst du es mal damit?",
      "Trans": {"SC":"要试试吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1412822984",
      "Source": "Das ist mal eine richtige Waffe.",
      "Trans": {"SC":"一把实在的武器。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::610059102",
      "Source": "Gegen eine Waffe wie die ist nichts einzuwenden.",
      "Trans": {"SC":"很棒的武器。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::13251482",
      "Source": "Sieht nach Erntezeit aus!",
      "Trans": {"SC":"丰收的季节来了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1074039637",
      "Source": "Wenn du nach etwas schürfen willst, mach's mit einem Laser.",
      "Trans": {"SC":"如果你想要淘金, 试试看激光吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2341607448",
      "Source": "Aber kreuze die Strahlen nicht.",
      "Trans": {"SC":"不要让光线交叉。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3535622852",
      "Source": "Heiliger Strohsack, was für eine Waffe!",
      "Trans": {"SC":"我的天呐, 这武器太棒了吧!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::107064427",
      "Source": "Die sieht tödlich aus.",
      "Trans": {"SC":"看上去酷爆了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::699349063",
      "Source": "Wunderbare Waffe, Kumpel.",
      "Trans": {"SC":"太炫了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3327095822",
      "Source": "Ripperkrallen, Kumpel",
      "Trans": {"SC":"开膛爪!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1121994118",
      "Source": "Diese Krallen sind gefährlich!",
      "Trans": {"SC":"这可不是吃素的!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3834492025",
      "Source": "Schlitz sie auf, Überlebender!",
      "Trans": {"SC":"撕开它们!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3787962484",
      "Source": "Deine Waffe sieht etwas mitgenommen aus.",
      "Trans": {"SC":"你的武器看起来不行了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1027119184",
      "Source": "Deine Waffe fällt noch auseinander.",
      "Trans": {"SC":"这武器要坏了...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2964041397",
      "Source": "Diese Waffe ist zu minderwertig, um nicht auseinanderzufallen.",
      "Trans": {"SC":"朋友, 这武器快碎成渣了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::205902296",
      "Source": "Probierst du dein neues Spielzeug aus?",
      "Trans": {"SC":"在试新玩具吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::532213019",
      "Source": "Oh, ich habe keine davon gesehen!",
      "Trans": {"SC":"哇, 我没见过这个。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1031004074",
      "Source": "Probierst du diese neue Waffe im Kampf aus?",
      "Trans": {"SC":"想试用下新武器吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::818573327",
      "Source": "Du musst ein paar wirkliche Feinde haben.",
      "Trans": {"SC":"你肯定遇上了很棘手的敌人。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2100420741",
      "Source": "Ich kann mir massenhaft Einsatzmöglichkeiten dafür vorstellen.",
      "Trans": {"SC":"我能想出一万种使用方法。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1884133603",
      "Source": "Sieht etwas wackelig aus. Wirklich!",
      "Trans": {"SC":"看上去很有弹性!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2995136872",
      "Source": "Bin schon gespannt, was du damit machst.",
      "Trans": {"SC":"迫不及待想看看你用它来做什么...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2837089804",
      "Source": "Hier kommt der Wumms!",
      "Trans": {"SC":"爆炸就是艺术!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::904987185",
      "Source": "Hoffentlich fängst du massenhaft davon.",
      "Trans": {"SC":"祝你渔获满满!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3196777023",
      "Source": "Wenigstens treibt er oben ...",
      "Trans": {"SC":"至少它可以漂着...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3105900818",
      "Source": "Du scheinst da wirklich einen Plan zu haben.",
      "Trans": {"SC":"我觉得你在打什么主意...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1227460160",
      "Source": "Oh, sie muss auf deine Schulter. Clever!",
      "Trans": {"SC":"哇, 可以装在你的肩上。真机智!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::305330601",
      "Source": "Lust auf einen Ausritt?",
      "Trans": {"SC":"想兜兜风吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2358219258",
      "Source": "Machst du dir deinen ersten Unterschlupf?",
      "Trans": {"SC":"建造自己的第一座小屋呢?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::554600503",
      "Source": "Feuermodus ausgewählt.",
      "Trans": {"SC":"开火模式已选择!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3291565039",
      "Source": "Neuer Feuermodus!",
      "Trans": {"SC":"开火模式已更新!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3883450476",
      "Source": "Feuermoduswechsel entdeckt!",
      "Trans": {"SC":"开火模式已切换!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4171656289",
      "Source": "Traktorstrahl aktiviert!",
      "Trans": {"SC":"牵引光束已启动!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3675895549",
      "Source": "Traktorstrahl abgefeuert!",
      "Trans": {"SC":"发射牵引光束!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2655980076",
      "Source": "Traktorstrahl aktiv – na, komm schon!",
      "Trans": {"SC":"激活牵引光束!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::911579322",
      "Source": "Der Aufseher dieses Bioms ist verschwunden! Für immer verschwunden, soweit ich das beurteilen kann. Und es soll ein abschließender Test für Überlebende dieses Bioms sein, also sollte er nicht einfach verschwinden.\nFalls jemand den Aufseher abgeschaltet hat ... Doch warum sollte jemand das tun? Der Sinn von alledem ist, die Überlebenden zu beobachten und zu testen. Du hast du dich gut geschlagen und ich möchte, dass du dafür Anerkennung erhältst!",
      "Trans": {"SC":"","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //s_hlna_glitch_biome_bog_05_de
    },
    {
      "NamespaceHash": "Globals::2441056763",
      "Source": "Nicht nachlassen, Überlebender!",
      "Trans": {"SC":"生存者, 坚持!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1301017454",
      "Source": "Du schaffst es, Kumpel!",
      "Trans": {"SC":"朋友, 你可以的!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::739660125",
      "Source": "Ich bin die ganze Zeit bei dir!",
      "Trans": {"SC":"我一直陪着你!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2728168955",
      "Source": "Vorsicht - es ist ein Meteoritenschauer",
      "Trans": {"SC":"小心, 流星雨!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::847209706",
      "Source": "Meteoriten fallen!",
      "Trans": {"SC":"下流星雨了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1558304963",
      "Source": "Achte auf den Himmel. Es fallen Meteoriten!",
      "Trans": {"SC":"注意天空。在下流星雨!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::248900180",
      "Source": "Du bist ganz verheddert!",
      "Trans": {"SC":"你被缠住了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2646882750",
      "Source": "Wusch!",
      "Trans": {"SC":"冲啊!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1623706988",
      "Source": "Schon unterweeeeegs!",
      "Trans": {"SC":"跑起来!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2797175198",
      "Source": "Auf geht's!",
      "Trans": {"SC":"我们走!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1656871215",
      "Source": "Du bist unschlagbar!",
      "Trans": {"SC":"你势不可挡!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::793932741",
      "Source": "Oh, das gibt eine Narbe!",
      "Trans": {"SC":"哇, 这下疼了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2939453540",
      "Source": "Gut gekämpft, Kumpel!",
      "Trans": {"SC":"精彩的战斗!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1753907544",
      "Source": "Oh, das hinterlässt Spuren.",
      "Trans": {"SC":"噢, 这下要留疤了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3604779793",
      "Source": "Pass auf, dass du nicht umkommst.",
      "Trans": {"SC":"你现在可别挂啊。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::596146889",
      "Source": "Du blutest extrem stark!",
      "Trans": {"SC":"你血流了一地!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1834259874",
      "Source": "Das hat dir den Atem geraubt. Wirklich.",
      "Trans": {"SC":"你停止了呼吸。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1306288769",
      "Source": "Du hast dich für Einäscherung entschieden, ich verstehe.",
      "Trans": {"SC":"你选择了熊熊烈焰。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::501918742",
      "Source": "Ich würde auch Mund-zu-Mund-Beatmung machen, wenn ich einen hätte.",
      "Trans": {"SC":"我也想给你做人工呼吸, 但我没有嘴巴。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::834260660",
      "Source": "Du kannst es, gib nicht auf! Oh. [niedergeschlagen] Ohhhhh!",
      "Trans": {"SC":"你可以的——别放弃! 噢。[beat] 噢噢噢噢。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3385621557",
      "Source": "Du bist doch angeblich ein Überlebender!",
      "Trans": {"SC":"你是个生存者啊!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1281221575",
      "Source": "Ooooh, ich hätte dich davor warnen sollen.",
      "Trans": {"SC":"啊哦, 我本该提前警告你的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3941350720",
      "Source": "Ist nicht deine Schuld. Es ist meine ...",
      "Trans": {"SC":"不是你的错。这个得怪我...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::565346273",
      "Source": "Ähm, so hatte ich mir das nicht vorgestellt.",
      "Trans": {"SC":"呃, 和我想的不一样。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2222559611",
      "Source": "Du ruhst dich nur aus, nicht?",
      "Trans": {"SC":"你是不是在休息?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3621251721",
      "Source": "Ich hätte dich aufgefangen, doch ich bin nur ein Hologramm.",
      "Trans": {"SC":"我本可以抓住你, 但我只是一个全息投影。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::297012281",
      "Source": "Meine Mutter sagte immer, ich sollte einen Wintermantel tragen ...",
      "Trans": {"SC":"妈妈总是嘱咐我说要记得穿外套...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2413512500",
      "Source": "Giftstoffe. Sie wirken immer schneller als man denkt.",
      "Trans": {"SC":"毒药的生效时间总比预想中的短。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3870700265",
      "Source": "Waffe raus, Überlebender!",
      "Trans": {"SC":"生存者, 拿出武器!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1972953740",
      "Source": "Zieh deine Waffe, schnell!",
      "Trans": {"SC":"快亮出你的武器!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::644681527",
      "Source": "Hol deine Waffe raus!",
      "Trans": {"SC":"准备好你的家伙!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3706955469",
      "Source": "Du musst ja einen ziemlichen Durst haben, bei der Menge, die du trinkst.",
      "Trans": {"SC":"你可真是能喝啊。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3847459508",
      "Source": "Du musst ausreichend trinken, Überlebender.",
      "Trans": {"SC":"保持体内水分充足。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3469715606",
      "Source": "Prost, Kumpel!",
      "Trans": {"SC":"干杯!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::341556142",
      "Source": "Ist dir nach etwas Leckerem?",
      "Trans": {"SC":"你在吃什么好吃的?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::984262909",
      "Source": "Zeit für einen kleinen Snack!",
      "Trans": {"SC":"零食时间!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4176052786",
      "Source": "Das ist das Schöne an der Genesis-Simulation. Irgendwo ist immer Essenszeit!",
      "Trans": {"SC":"在创世模拟中, 无时无刻都有人在吃东西。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::467112656",
      "Source": "Aber du kannst nicht fliegen!",
      "Trans": {"SC":"你不会飞啊!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1876483169",
      "Source": "Der Weg nach unten ist lang!",
      "Trans": {"SC":"要落很久!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3012034334",
      "Source": "Nicht schon wieder!",
      "Trans": {"SC":"又来了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::143614159",
      "Source": "Bleib stehen, lass dich fallen und roll dich [am Boden] -- du brennst!",
      "Trans": {"SC":"快躺下打滚! 你着火了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2973349356",
      "Source": "Du brennst, Überlebender!",
      "Trans": {"SC":"生存者, 你着火了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::309226302",
      "Source": "Du verbrennst!",
      "Trans": {"SC":"你在燃烧!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1399976140",
      "Source": "Brrr! Es ist eiskalt!",
      "Trans": {"SC":"呃! 冻死了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3121874945",
      "Source": "Du musst dich aufwärmen, Kumpel!",
      "Trans": {"SC":"你得让自己暖和起来!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2196633495",
      "Source": "Frier mir nicht ein!",
      "Trans": {"SC":"不许你在我面前冻僵!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2622873114",
      "Source": "Spar dir das für den Feind!",
      "Trans": {"SC":"把它留给敌人吧!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::942578083",
      "Source": "Woher kommt der eigene Beschuss?",
      "Trans": {"SC":"不要向友军开火!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4117652726",
      "Source": "Hey, das ist ein Verbündeter!",
      "Trans": {"SC":"喂! 那是友军!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2694259679",
      "Source": "Äh, auf welcher Seite sind wir?",
      "Trans": {"SC":"你到底是哪边的?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3789704433",
      "Source": "Das war einer von uns!",
      "Trans": {"SC":"那是自己人!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3053548458",
      "Source": "Mord beendet Freundschaften, Kumpel.",
      "Trans": {"SC":"兄弟相杀, 天理不容。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1474788708",
      "Source": "Es hat dich erfasst!",
      "Trans": {"SC":"你被抓住了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3710599614",
      "Source": "Du wurdest erfasst!",
      "Trans": {"SC":"它抓住你了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3745712908",
      "Source": "Hey, lass meinen Überlebenden los!",
      "Trans": {"SC":"喂! 放开我家的生存者!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3236921948",
      "Source": "Hallo! Ich bin HLN-A, eine fraktale Persönlichkeit, die in ein High-Tech-Hologramm programmiert wurde. Stell dir einfach vor, dass ich deine Reiseführerin bin.",
      "Trans": {"SC":"你好! 我叫HLN-A。我是一个被编译在高科技全息影像中的分形人格。不过呢, 你把我看作是你的向导就好啦。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3784405939",
      "Source": "HLN-A meldet sich zum Dienst. Wenn du zum Erkunden bereit bist, führe ich dich.",
      "Trans": {"SC":"HLN-A前来报到。如果你准备好要去探索, 让我来当你的向导吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3675925508",
      "Source": "Höre immer auf HLN-A, und du wirst nicht getötet werden. Vermutlich. Ich bin auch erst neu dabei.",
      "Trans": {"SC":"乖乖听HLN-A的话, 可以让你不挂掉。大概吧。我也是个萌新。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1832336577",
      "Source": "Du wurdest gefesselt, Kumpel.",
      "Trans": {"SC":"老兄, 你被铐住了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::88742768",
      "Source": "Es geht doch nichts über ein wenig improvisierte Landwirtschaft, oder?",
      "Trans": {"SC":"偶尔干干农活也不错吧?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1706347891",
      "Source": "Du bist ja ein wahrer Jäger und Sammler!",
      "Trans": {"SC":"你真是个天生的采集者!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3745805584",
      "Source": "Fast alles hier ist nützlich, wenn du clever genug bist,",
      "Trans": {"SC":"如果你够聪明, 就会发现几乎所有东西都能派上用场。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::466430686",
      "Source": "Ui! Genau auf den Kopf!",
      "Trans": {"SC":"好耶! 正中脑门!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1670003782",
      "Source": "Du zielst immer besser, Kumpel!",
      "Trans": {"SC":"你瞄得越来越准了, 哥们!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1416513847",
      "Source": "Toller Schuss!",
      "Trans": {"SC":"漂亮的一击!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3820861141",
      "Source": "Du wirst gleich sterben!",
      "Trans": {"SC":"你快死了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3043450608",
      "Source": "Es ist ein Wunder, dass du noch stehst!",
      "Trans": {"SC":"你还站着, 真是奇迹!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1990691690",
      "Source": "Deine letzte Stunde hat geschlagen...",
      "Trans": {"SC":"你已经非常虚弱了...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1301759997",
      "Source": "Hmm. Anscheinend ist mein Überlebender irgendwie hängen gebliebent.",
      "Trans": {"SC":"呃。貌似我家的生存者陷在沼泽里了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3342243262",
      "Source": "Dann eben nicht. Ich kann das auch. Ich schweige jetzt auch nur.",
      "Trans": {"SC":"好吧。你这招我也会。我也不说话了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4273786884",
      "Source": "Bye-bye, Überlebender! Dann mal viel Glück ohne mich. Ich gehe jetzt.",
      "Trans": {"SC":"拜拜! 我走啦! 我真的走啦!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2644527305",
      "Source": "[Seufzt.] Sieh's ein, HLN-A. Dein Überlebender ist verrückt geworden.",
      "Trans": {"SC":"[叹气。] HLN-A, 面对现实吧。我家的生存者暂离了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::703825647",
      "Source": "Okay, du hast mich durchschaut. Aber beweg dich oder so. Gib mir ein Zeichen!",
      "Trans": {"SC":"好吧, 被你识破了。但至少你也动一动啊。给我个信号!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::240311011",
      "Source": "Haben dich die Bunyips erwischt?",
      "Trans": {"SC":"你被水鬼抓走了吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3664266778",
      "Source": "Wenn du dich nicht bald bewegst, wirst du von den Insekten zerstochen. Sie werden dich aussaugen.",
      "Trans": {"SC":"如果你还停在那里, 虫子们就要来叮你了。它们会把你吸干的!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::6691307",
      "Source": "Du kannst ja hier sitzenbleiben. Ich gehe auf eine Rundwanderung. Ähm, schwebe auf Rundwanderung.",
      "Trans": {"SC":"如果你想待在这里, 那我就走去别处了。不对, 是“漂”。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3193839951",
      "Source": "Wir sind mitten in einem Sumpf. Das ist kein Ort, um ins Gras zu beißen ...",
      "Trans": {"SC":"我们在沼泽的中间。这里可不是挂机的好地方...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3240864396",
      "Source": "Hör mal, Überlebender! Geht's dir gut?",
      "Trans": {"SC":"嘿, 生存者! 你还好吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2059560259",
      "Source": "Gut. Ich schwebe hier noch etwas herum, während du dir ein Brot schmierst oder so. Schon okay.",
      "Trans": {"SC":"好吧。不管你是去拿三明治还是什么, 我先在这里飘一会儿吧。没啥大不了的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3624275750",
      "Source": "Bring mir wenigstens was zu trinken mit! Und einen Strohhalm. Ich habe keine Hände ...",
      "Trans": {"SC":"好歹给我带杯饮料啊! 别忘了吸管。我没手...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::835604620",
      "Source": "Falls du dir gerade irgendwo was zu Essen holst, werde ich richtig sauer.",
      "Trans": {"SC":"如果你去拿外卖了, 我会很生气的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2267743311",
      "Source": "Du bist schon lange weg ... Das ist jetzt nicht mehr Butterbrot schmieren, sondern eher Spießbraten langsam rösten.",
      "Trans": {"SC":"你离开好久了...你这不是“去吃三明治”, 而是“去种小麦”了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2992573214",
      "Source": "Du hast dir eine seltsame Zeit ausgesucht, um mit ausgesetzter Bewegung zu experimentieren.",
      "Trans": {"SC":"你选择进行假死实验的时机很特别。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2304420022",
      "Source": "Die Simulation beobachtet dich noch immer, Überlebender. Selbst wenn du mal eben zum Kühlschrank gehst.",
      "Trans": {"SC":"好歹给我带杯饮料啊! 别忘了吸管。我没手...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1818751747",
      "Source": "Schaust du dir ein wenig die Sterne an, Überlebender?",
      "Trans": {"SC":"生存者, 你是不是在观测星空?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3617301185",
      "Source": "Du bist eindeutig entführt worden. Nicht unbedingt von Außerirdischen, aber ... es waren Außerirdische.",
      "Trans": {"SC":"很明显你被绑架了。可能不是外星人干的...那还能有谁。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3184839300",
      "Source": "Oh schau mal, ein kleiner grüner Außerirdischer! [Geschlagen] War nur Spaß. Ich hab versucht, deine Aufmerksamkeit zu erregen.",
      "Trans": {"SC":"瞧, 有外星人! [拍打]开个玩笑, 吸引一下你的注意力。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2170859648",
      "Source": "Willst du mich an der Nase herumführen oder bist du wirklich nicht da?",
      "Trans": {"SC":"你是在和我开玩笑, 还是你人真的不在?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4233640317",
      "Source": "Das ist wie Schiffbruch zu erleiden. Nur ohne das Schiff. Oder den Bruch.",
      "Trans": {"SC":"这就像一起沉船事故。只是没有沉船, 只有事故。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::921641827",
      "Source": "200. Tag: Ich muss mich damit abfinden. Mein Überlebender kommt nicht zurück. Es ist an der Zeit für mich, ein neues Leben zu beginnen.",
      "Trans": {"SC":"第二百天: 接受现实吧。我家的生存者不会再回来了。是时候迎接新生活了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1856831540",
      "Source": "Ich sollte Tagebuch schreiben. „1. Tag: Mein Überlebender ist katatonisch ...“",
      "Trans": {"SC":"我应该写一本日记。“第一天: 我家的生存者精神崩溃了...”","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4158253688",
      "Source": "3. Tag: Mein Überlebender bewegt sich noch immer nicht. Der wirkliche Feind ist die Langeweile.",
      "Trans": {"SC":"第三天: 这位生存者依然没有移动的迹象。我们真正的敌人是无聊。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1343845731",
      "Source": "Ich kann mir bessere Orte zum Dahinvegetieren als diesen vorstellen ...",
      "Trans": {"SC":"我能想到一万个比这里更好的发呆场所。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2197800490",
      "Source": "12. Tag: Ich glaube, Seepocken wachsen auf meinem Überlebenden, der sich noch immer nicht bewegt hat.",
      "Trans": {"SC":"第十二天: 我家的生存者还是一动不动, 身上连藤壶都长出来了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1091676906",
      "Source": "Überlebender? Hey! Überrr-leee-bendeeeeeeer ...?",
      "Trans": {"SC":"生存者? 喂! 生生生存存存者者者...?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::894373151",
      "Source": "Jemand zuhause? Komm schon, gib mir ein Zeichen!",
      "Trans": {"SC":"你在吗? 给我个信号吧!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::636658302",
      "Source": "Bist du zu Fall gekommen oder machst du nur Pause?",
      "Trans": {"SC":"你是刚才跳水昏过去了, 还只是在休息?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1837872283",
      "Source": "30. Tag: Sollte ich dem Überlebenden sagen, dass ich versucht habe, einem vorbeifahrenden Schiff ein Signal zu geben?",
      "Trans": {"SC":"第三十天: 我该不该告诉这位生存者我曾试图联系一条过往船只?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2168178978",
      "Source": "Ich könnte es verstehen, wenn du eine Echse wärst, die in der Kälte langsamer wird. Aber du bist ein Warmblüter!",
      "Trans": {"SC":"我能理解蜥蜴在低温时的行动会变迟缓, 但你不是温血动物吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1943010386",
      "Source": "Wenn ich doch nur Hände hätte ... Dann könnte ich dich mit einem Schneeball aufwecken!",
      "Trans": {"SC":"真希望我有手, 这样我就可以用雪球打醒你了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2020411468",
      "Source": "Falls du dich von mir trennen willst, ist das so kein guter Stil.",
      "Trans": {"SC":"如果你想甩了我, 那是不可能的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1591683032",
      "Source": "Wenn ich einen Zylinder und eine Möhre hätte, könnte ich dich richtig schön dekorieren.",
      "Trans": {"SC":"给我一根胡萝卜和一顶帽子, 我就可以把你变成大雪人。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2130126291",
      "Source": "Träumst du von einem schönen, warmen Ort?",
      "Trans": {"SC":"是不是在幻想某个暖和的地方?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3094400767",
      "Source": "Versuchen wir's hiermit: „Diese heiße Schokolade ist sooo lecker! Und sie wärmt mich richtig schön durch.“ [Geschlagen] Pfff.",
      "Trans": {"SC":"试试看这样说...“这杯热可可太美味了! 我的肚肚感觉暖暖的。”[拍打]呃。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1760317635",
      "Source": "Hallo, Überlebender! Es ist viel zu kalt, um hier zu bleiben.",
      "Trans": {"SC":"生存者, 喂! 站着不动实在太冷了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2587336997",
      "Source": "Wenn wir nicht bald weitergehen, werden sich an dir Eiszapfen bilden. An Stellen, an denen du sie nicht haben willst.",
      "Trans": {"SC":"如果我们再不动就要浑身结冰了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3922729275",
      "Source": "Jetzt hab ich es! Ist das eine dieser Geschichten, in denen der Held jahrzehntelang gefroren ist und in Zeiten großer Not wieder auftaut?",
      "Trans": {"SC":"我明白了。这是一则讲述某人被冰封数十年, 然后在最危机的时刻破冰变成英雄的故事。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1589926077",
      "Source": "Bist du festgefroren oder so?",
      "Trans": {"SC":"你被冻僵了吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3970792755",
      "Source": "Wach auf, du Trottel!",
      "Trans": {"SC":"醒醒, 你个笨蛋!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::764878000",
      "Source": "Vergnügst du dich in einer anderen Simulation, während ich hier herumhänge und warte? Echt uncool, Überlebender. Wirklich uncool.",
      "Trans": {"SC":"我在等你, 而你是不是在其他模拟里遨游? 这可不上道。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1586666146",
      "Source": "Oh, jetzt verstehe ich. Du machst ein Selfie mit langer Belichtungszeit, weil du ein angesagter Influencer bist.",
      "Trans": {"SC":"我懂了。你是个网红。你在玩自拍。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3050761105",
      "Source": "Wirklich, Überlebender. Du musst nicht immer direkt nachschauen, wenn dieses Dingsbums ein Geräusch von sich gibt.",
      "Trans": {"SC":"说真的。你没必要动不动就玩手机。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::381983037",
      "Source": "Steht ganz still an einem Ort voller Lava und Meteore ... Du bist schon mutig, Überlebender.",
      "Trans": {"SC":"矗立在一个满是岩浆和火雨的地方...生存者, 你真勇敢。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1245070338",
      "Source": "Schreib deinen Freunden später, Überlebender! Wir haben massenhaft zu tun!",
      "Trans": {"SC":"等会再发短信, 生存者! 我们还有一堆事情要做!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1610933726",
      "Source": "[Seufzt.] Wenn es einen Fehler beim menschlichen Überlebensinstinkt gibt, dann ist es die Begeisterung für Social Media.",
      "Trans": {"SC":"[叹气。] 要说人类的天性中有什么缺陷的话, 那就是他们对社交媒体不可自拔的爱。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3188749854",
      "Source": "Du verbrennst noch, wenn du dich nicht bewegst, Überlebender.",
      "Trans": {"SC":"生存者, 如果你待在原地不动, 你会烧起来的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1351051623",
      "Source": "Du musst WAK sein. „Weg aus Krakatau.“",
      "Trans": {"SC":"矗立在一个满是岩浆和火雨的地方...生存者, 你真勇敢。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::858676387",
      "Source": "Bist du durchgekommen und hast es mir nicht gesagt?",
      "Trans": {"SC":"你是不是已经跑路了, 还没告诉我?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::783780204",
      "Source": "Schön, aus dem Wetter raus zu sein.",
      "Trans": {"SC":"不用风吹雨淋真好。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1246738265",
      "Source": "Gut, ein Dach über unseren Köpfen zu haben.",
      "Trans": {"SC":"头上有屋顶的感觉真棒。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1035041309",
      "Source": "Recht gemütlich hier drinnen, oder?",
      "Trans": {"SC":"屋里真舒服, 是不是?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4119447982",
      "Source": "Sehr gute Arbeit!",
      "Trans": {"SC":"你太猛了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2812969369",
      "Source": "Viele Tote, nicht?",
      "Trans": {"SC":"杀得数不过来了?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2102834234",
      "Source": "Schwierig, bei all den Toten den Überblick zu behalten!",
      "Trans": {"SC":"杀得数不清了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2381191402",
      "Source": "Du bist nicht aufzuhalten!",
      "Trans": {"SC":"疯狂杀戮!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1252284386",
      "Source": "Das ist kein Kampf -- das ist ein Gemetzel!",
      "Trans": {"SC":"这不是战斗, 这是一场屠杀!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3136663698",
      "Source": "Sie fallen wie Zinnsoldaten!",
      "Trans": {"SC":"敌人全倒下了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2620984632",
      "Source": "Schreiben wir es als gescheitertes Experiment ab.",
      "Trans": {"SC":"刚才算是一次失败的实验吧?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4074013087",
      "Source": "Ich bezeichne das „Tod durch Missgeschick“.",
      "Trans": {"SC":"我把刚才叫做“死于不幸”。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1687861264",
      "Source": "Vereinbaren wir: Das. Ist. Nie. Passiert.",
      "Trans": {"SC":"确认一下: 刚才, 什么, 都没发生。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::683321247",
      "Source": "Das ist jetzt nicht die Zeit für ein Schläfchen, Überlebender!",
      "Trans": {"SC":"现在可不是打盹的时候!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1508039997",
      "Source": "Du kannst bei der Arbeit nicht faulenzen.",
      "Trans": {"SC":"别躺地上! 有任务呢!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2874925681",
      "Source": "Ähm, Überlebender? Bist du ohnmächtig geworden?",
      "Trans": {"SC":"生存者? 你晕过去了?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3325590437",
      "Source": "Du hast Blutegel an dir, Überlebender!",
      "Trans": {"SC":"生存者, 你身上有水蛭!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1490896918",
      "Source": "Diese Blutegel werden dich aussaugen!",
      "Trans": {"SC":"这些水蛭会吸干你的!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::189469402",
      "Source": "Werd die Blutegel los!",
      "Trans": {"SC":"把这些水蛭弄掉!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1249770509",
      "Source": "Gut gemacht, Überlebender.",
      "Trans": {"SC":"恭喜你!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::124920152",
      "Source": "Wenn du solche Sachen machst, wird die Simulation es merken!",
      "Trans": {"SC":"继续保持, 系统会奖励你的!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2451642633",
      "Source": "Ich sollte jetzt „klingeling“ sagen, oder? Klingeling!",
      "Trans": {"SC":"我是不是该说“叮, 你升级了! ”","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2945288310",
      "Source": "Ganz ruhig, Überlebender! Ziele!",
      "Trans": {"SC":"生存者, 稳住! 瞄准!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::646003139",
      "Source": "Denk daran zu zielen!",
      "Trans": {"SC":"记得要先瞄准。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::562514289",
      "Source": "Sollen das Warnschüsse sein?",
      "Trans": {"SC":"刚才是故意打偏的吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::516444965",
      "Source": "Dein Reittier sieht nicht mehr so gut aus...",
      "Trans": {"SC":"你的坐骑看起来不太妙...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1561066953",
      "Source": "Dein Reittier bricht gleich zusammen!",
      "Trans": {"SC":"你的坐骑就快要倒下了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1060776789",
      "Source": "Dein Reittier blutet -- und zwar sehr.",
      "Trans": {"SC":"你的坐骑流了很多血。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3048093147",
      "Source": "Na, fühlst du dich schläfrig?",
      "Trans": {"SC":"特别困, 是不是?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::237212737",
      "Source": "Keine Zeit für ein Nickerchen!",
      "Trans": {"SC":"没时间打盹了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2820930440",
      "Source": "Du siehst ein bisschen schläfrig aus...",
      "Trans": {"SC":"你看上去很困的样子...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::510526936",
      "Source": "Nur weil du ein Überlebender bist, heißt das nicht, dass du dich nicht für Mode interessierst.",
      "Trans": {"SC":"虽然你正在求生, 但同时依旧保持了时尚品味。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2182853604",
      "Source": "Du hast wirklich ein Gespür für Farbe, Kumpel.",
      "Trans": {"SC":"你挑选色彩的眼光很不错。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2400608408",
      "Source": "Ich glaube deine Feinde wollten dich bluten und nicht färben sehen. Aber mir gefällt's!",
      "Trans": {"SC":"我终于明白敌人对你说“给你点颜色瞧瞧”是什么意思了。我喜欢!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3178570469",
      "Source": "Du kannst die Luft nicht ewig anhalten ...",
      "Trans": {"SC":"你没法一直憋气...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3383997925",
      "Source": "Du atmest nicht ...",
      "Trans": {"SC":"你需要呼吸...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2535751600",
      "Source": "Dir geht die Luft aus ...",
      "Trans": {"SC":"你快没氧气了...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4107864410",
      "Source": "Das ist Gift!",
      "Trans": {"SC":"中毒了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::575461284",
      "Source": "Du bist vergiftet, Überlebender!",
      "Trans": {"SC":"生存者, 你中毒了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1613436631",
      "Source": "Kämpf dich durch das Gift!",
      "Trans": {"SC":"不要被毒素打倒!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::900892820",
      "Source": "Weißt du, wir könnten dafür das Klempnern erfinden.",
      "Trans": {"SC":"需要马桶吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1157465694",
      "Source": "Fühlst du dich jetzt etwas leichter?",
      "Trans": {"SC":"感觉体重轻点了吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3683293443",
      "Source": "Du willst ... Hier? Wirklich?",
      "Trans": {"SC":"就在这里...? 不是吧?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::519368468",
      "Source": "Du siehst benebelt aus, Kumpel ...",
      "Trans": {"SC":"你看起来有点傻兮兮的...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3404762315",
      "Source": "Schüttel es ab, Überlebender!",
      "Trans": {"SC":"清醒点!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1151427345",
      "Source": "Besäufst du dich da?",
      "Trans": {"SC":"你嗨过头了吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3956404768",
      "Source": "Hüh!",
      "Trans": {"SC":"跑起来!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2850159897",
      "Source": "Lass uns reiten, Kumpel!",
      "Trans": {"SC":"骑马咯!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4104055051",
      "Source": "Hüa!",
      "Trans": {"SC":"驾!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2979408324",
      "Source": "Das ist das Tolle an der Genesis-Simulation: Du kannst es immer wieder probieren!",
      "Trans": {"SC":"这就是创世模拟的优点——总是可以再来一次!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2670433917",
      "Source": "Versuchen wir's noch einmal, hm?",
      "Trans": {"SC":"我们再试一次?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1063940587",
      "Source": "Schön wieder hier und für Action bereit zu sein!",
      "Trans": {"SC":"很高兴我们又回来了, 准备行动!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3201068817",
      "Source": "Es hat uns entdeckt!",
      "Trans": {"SC":"它发现我们了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1775455076",
      "Source": "Es sieht direkt zu uns her!",
      "Trans": {"SC":"它正朝我们这里看!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2427383653",
      "Source": "Wir wurden entdeckt!",
      "Trans": {"SC":"我们被发现了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1469667936",
      "Source": "Brauchst du eine Verschnaufpause?",
      "Trans": {"SC":"需要喘口气吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3436039522",
      "Source": "Du siehst mitgenommen aus ...",
      "Trans": {"SC":"你看上去累坏了...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1824379113",
      "Source": "Ruh dich aus, du wirkst, als ob du es brauchst.",
      "Trans": {"SC":"休息一下吧。你看上去很累。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::863886449",
      "Source": "Iss etwas, Kumpel.",
      "Trans": {"SC":"朋友, 吃点东西吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3735883943",
      "Source": "Du siehst ausgehungert aus!",
      "Trans": {"SC":"你看上去饿坏了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3585968997",
      "Source": "Willst du mit Absicht verhungern?",
      "Trans": {"SC":"你是有意饿死自己吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4269411055",
      "Source": "Ah, das Fernsehen der Natur.",
      "Trans": {"SC":"大自然的馈赠。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::924104748",
      "Source": "Das ist soooo entspannend.",
      "Trans": {"SC":"真是令人放松啊。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3072922869",
      "Source": "Hält dich warm und zufrieden.",
      "Trans": {"SC":"让你保持温暖。让你吃上热食。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2508230717",
      "Source": "Als Ehrenaustralierin kenne ich mich damit aus.",
      "Trans": {"SC":"作为一个名义上的澳洲人, 我在这方面有特长。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1494777598",
      "Source": "Du hast was gegrillt! So geht es uns echt gut.",
      "Trans": {"SC":"你做了一个烧烤台! 我们现在的日子太棒了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::136144752",
      "Source": "Ah, ein anständiges Grillfest. Es gibt nichts Vergleichbares.",
      "Trans": {"SC":"哇, 烧烤台! 没啥能比它更棒了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::548509569",
      "Source": "Bist du eher ein Rembrandt oder eher ein Pollock?",
      "Trans": {"SC":"你属于写实派, 还是抽象派?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::52541070",
      "Source": "Ich wusste nicht, dass du künstlerisch veranlagt bist ...",
      "Trans": {"SC":"我不知道你竟然有艺术细胞...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2052782626",
      "Source": "Mit dieser Farbe sieht es richtig nobel aus.",
      "Trans": {"SC":"真有艺术感。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2205694882",
      "Source": "Du könntest alles Mögliche daraus machen, nicht?",
      "Trans": {"SC":"有了它, 什么都可以做出来吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::13100750",
      "Source": "Ich frage mich gerade: Könntest du einen Replikator machen, der sich selbst repliziert?",
      "Trans": {"SC":"你可以用复制器复制复制器吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1711332996",
      "Source": "Ich denke noch immer, wir sollten ihn „Zwillinator“ nennen.",
      "Trans": {"SC":"我想叫它“复结者”。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4168453957",
      "Source": "Willkommen in der Eisenzeit, Überlebender!",
      "Trans": {"SC":"欢迎来到铁器时代!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::135272114",
      "Source": "Wer hat Lust auf etwas Metall?",
      "Trans": {"SC":"我们来做点金属物件吧?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4220024451",
      "Source": "Ich bin schon gespannt, was du damit schmiedest.",
      "Trans": {"SC":"等不及要看你如何使用它了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2684182463",
      "Source": "Genau das Richtige, um sich im Biom umherzubewegen.",
      "Trans": {"SC":"有了它就可以前往各个生态圈了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3348658315",
      "Source": "Mir gefällt es. Dieser Ort könnte von schnellem Transport profitieren.",
      "Trans": {"SC":"真不错, 我们需要这类快速交通工具。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2120070719",
      "Source": "Warum herumwandern, wenn man sich herumportieren könnte?",
      "Trans": {"SC":"能传送就绝不走路。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1463663633",
      "Source": "Ich sage immer: Die beste Verteidigung ist ein vernünftiger Turm.",
      "Trans": {"SC":"最好的防御就是架炮台。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3732073179",
      "Source": "Die Eindringlinge tun mir schon fast leid. Aber nur fast.",
      "Trans": {"SC":"我替入侵者们感到惋惜。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3490867880",
      "Source": "Das sieht wirklich einschüchternd aus.",
      "Trans": {"SC":"看起来很吓人。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1577490677",
      "Source": "Dann ist jetzt wohl Zeit zum Abtrocknen?",
      "Trans": {"SC":"该出水了吧?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::368711083",
      "Source": "Das war erfrischend!",
      "Trans": {"SC":"游泳好凉快!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3665275642",
      "Source": "Ich habe zwar keine Beine, doch ich weiß festen Boden unter den Füßen zu schätzen.",
      "Trans": {"SC":"我虽然没有腿, 但我还是偏爱陆地。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4007079081",
      "Source": "Oh, ich habe so Lust, schwimmen zu gehen!",
      "Trans": {"SC":"哇! 我喜欢游泳!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3701828006",
      "Source": "Denk dran: Hier gibt's keine Rettungsschwimmer ...",
      "Trans": {"SC":"记住——这里没有救生员...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2815569498",
      "Source": "Ich hätte eine Badekappe mitbringen sollen!",
      "Trans": {"SC":"我忘了带我的游泳帽!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3611424415",
      "Source": "Es bricht gleich zusammen!",
      "Trans": {"SC":"它即将倒下!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2505910863",
      "Source": "Es macht seinen letzten Atemzug!",
      "Trans": {"SC":"它奄奄一息了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::865044215",
      "Source": "Da ist nicht mehr viel übrig!",
      "Trans": {"SC":"它就要被击败了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1656175299",
      "Source": "Der Teleport beginnt ... jetzt!",
      "Trans": {"SC":"立刻...传送!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3088197240",
      "Source": "Teleport aktiviert!",
      "Trans": {"SC":"传送已启动!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2950680867",
      "Source": "Beim Teleportieren wird mir immer etwas schwummrig...",
      "Trans": {"SC":"传送总会让我头晕...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2812052062",
      "Source": "Da sind wir, genau richtig.",
      "Trans": {"SC":"我们到了, 不偏不倚。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::977209877",
      "Source": "Koordinaten bestätigt, Teleport vollständig!",
      "Trans": {"SC":"坐标已确认, 传送完成!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3499965337",
      "Source": "Teleport bereit!",
      "Trans": {"SC":"传送准备就绪!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::677442490",
      "Source": "Teleport in Vorbereitung!",
      "Trans": {"SC":"正在准备传送!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4167042644",
      "Source": "Koordinaten gesperrt, Zeit für Teleport!",
      "Trans": {"SC":"坐标锁定, 可以传送!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2966643848",
      "Source": "Hol dir was zu trinken, Kumpel.",
      "Trans": {"SC":"朋友, 喝点东西吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3484526413",
      "Source": "Du siehst durstig aus.",
      "Trans": {"SC":"你看上去很渴!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2420745846",
      "Source": "Trink etwas, Überlebender!",
      "Trans": {"SC":"生存者, 喝点什么吧!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3367488540",
      "Source": "Du sieht aus, als ob du gleich umkippst!",
      "Trans": {"SC":"你看上去就快晕倒了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1567366069",
      "Source": "Kipp mir nur nicht um!",
      "Trans": {"SC":"别晕过去!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2301309152",
      "Source": "Bleib bei mir! Bleib wach!",
      "Trans": {"SC":"别抛下我! 保持清醒!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::462984913",
      "Source": "Halte deine Augen offen, Kumpel!",
      "Trans": {"SC":"别闭上眼睛!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3091886921",
      "Source": "Werd mir nicht bewusstlos!",
      "Trans": {"SC":"不许你晕过去!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4280460242",
      "Source": "Bleib wach, Überlebender!",
      "Trans": {"SC":"生存者, 保持清醒!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1036638672",
      "Source": "Keine schlechte Zeit für einen Rundgang!",
      "Trans": {"SC":"走走路也不错!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4108217440",
      "Source": "Wir sind auf einem guten Kurs, oder?",
      "Trans": {"SC":"我们要进行一次有意义的旅行。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3164241222",
      "Source": "Das ist nicht nur ein Rundgang -- es ist ein Abenteuer!",
      "Trans": {"SC":"这不是简单的徒步旅行, 而是一次大冒险!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2796337395",
      "Source": "Du hast auf einen Baum eingeschlagen. Und, hat es was gebracht?!?",
      "Trans": {"SC":"你用拳头攻击树...竟然有效果?!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3761651845",
      "Source": "Nun gut, das ist eine Art, von einem Baum das zu bekommen, was du willst!",
      "Trans": {"SC":"这也是一种从树上获取资源的方式。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::743152257",
      "Source": "Ja! Zeig dem Blattwerk, wer hier der Boss ist!",
      "Trans": {"SC":"哈! 看看谁才是老大!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::371320652",
      "Source": "Servus, Überlebender! Bereit für ein Abenteuer?",
      "Trans": {"SC":"你好, 生存者! 准备好冒险了吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::939802281",
      "Source": "Wer hat Lust, etwas zu erforschen?",
      "Trans": {"SC":"有谁想去探险?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2500463929",
      "Source": "Lass uns loslegen, Überlebender! Die Genesis-Simulation wartet schon!",
      "Trans": {"SC":"生存者, 出发吧! 创世模拟在等待着我们!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3004315829",
      "Source": "Zieh besser eine andere Waffe...",
      "Trans": {"SC":"还是换把武器吧...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1775173655",
      "Source": "Die Waffe taugt nichts mehr.",
      "Trans": {"SC":"那把武器没法再用了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::76744334",
      "Source": "Die Waffe ist kaputt - tausch sie aus!",
      "Trans": {"SC":"武器坏了, 换一把吧!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3294510995",
      "Source": "Diese Simulation gibt dir Bonus XP.",
      "Trans": {"SC":"模拟系统正在给予你额外的经验值。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1816641223",
      "Source": "Du erhältst Bonus XP.",
      "Trans": {"SC":"你正在获取额外的经验值。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3639748462",
      "Source": "Du bekommst extra XP von der Simulation.",
      "Trans": {"SC":"你正在获取模拟系统中额外的经验值。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2691998452",
      "Source": "Das muss die Regenzeit sein.",
      "Trans": {"SC":"现在是雨季。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2294559669",
      "Source": "Zum Glück roste ich nicht.",
      "Trans": {"SC":"还好我不会生锈。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3468541264",
      "Source": "Tz-tz. Sieht wie Regen aus.",
      "Trans": {"SC":"啧啧。好像下雨了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3952267800",
      "Source": "Wir kommen näher, Überlebender ...",
      "Trans": {"SC":"我们很接近了...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::556544904",
      "Source": "Annäherungscheck ... Ja, wir nähern uns an!",
      "Trans": {"SC":"距离检测...很靠近了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3326756458",
      "Source": "Die Scanner sagen, dass wir näher kommen.",
      "Trans": {"SC":"扫描仪表明我们越来越接近了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4245165602",
      "Source": "Wir entfernen uns ...",
      "Trans": {"SC":"我们越走越远了...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2995127337",
      "Source": "Die Entfernung erhöht sich, Überlebender.",
      "Trans": {"SC":"距离增加。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::486546608",
      "Source": "Ich scanne noch immer, doch es ist jetzt weiter weg.",
      "Trans": {"SC":"我还在继续扫描, 但是现在变远了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1491391834",
      "Source": "Schau mal ... dort drüben ...",
      "Trans": {"SC":"让我瞧瞧远处那里...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2193395696",
      "Source": "Ich habe etwas gescannt. Schau mal dort!",
      "Trans": {"SC":"我扫描到什么了。看那里!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2311789214",
      "Source": "Meine Scanner erfassen etwas, doch es weit weg.",
      "Trans": {"SC":"我的扫描仪检测到了什么, 但离我们有些远。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3140918649",
      "Source": "Das klingt nach massenhaft Ärger ...",
      "Trans": {"SC":"听起来很糟糕...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4141799132",
      "Source": "Das scheint nah zu sein ... Vielleicht zu nah.",
      "Trans": {"SC":"听上去离我们很近——非常近。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3584813231",
      "Source": "Da kämpft jemand. Ausnahmsweise sind wir es mal nicht.",
      "Trans": {"SC":"别人在打架...终于有一次不是我们了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    }
  ],
  //故障修复语音 - 2026-07-26 10:39:28
  "Glitches": [
    {
      "NamespaceHash": "Globals::721001913",
      "Source": "Das Biom ist voller Leben. So viel Leben, dass es Störungen der Simulation verursacht.\n Stell dir vor, was allein nötig ist, um die Insektenschwärme im Auge zu behalten. Tausende von Insekten, alle auf ihrer eigenen Flugbahn. Jedes Insekt auf der Suche nach etwas Essbarem.\n Hmmm. Sie sind wie winzige Versionen von euch Überlebenden, nicht?",
      "Trans": {"SC":"这座生态圈里生机勃勃。如此之多的生命却给模拟系统带来了故障。\n想象一下，要单独追踪虫群中每一只昆虫，系统需要付出多大的成本！成千上万的虫子，每只都有自己的飞行轨迹，每只都在寻找食物。\n它们就像你们生存者的缩影，是吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2152764120",
      "Source": "Meine Sensoren erfassen haufenweise organische Verbindungen in der Luft, die einfach herumschweben. Nennt ihr sie nicht Gerüche? Für mich ist das nur Chemie, Kumpel. \n Wenn du in diesem Biom herumschnüffelst, achte auf Hydrogensulfid. Du weißt schon, H2S? Meine Daten sagen, es riecht penetrant, doch dann tötet es den menschlichen Geruchssinn ab. Du kannst das Gift einatmen, ohne es zu bemerken.",
      "Trans": {"SC":"我的传感器探测到空气中漂浮着大量有机化合物。你们应该称之为“气味”吧？对于我来说只是化学物质。\n当你在这个生态圈中呼吸时，要小心H2S，就是硫化氢。我的数据表明它闻起来很刺鼻，而且会减弱人类的嗅觉能力。你可能在无意识中吸入这种毒气。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1813058204",
      "Source": "Da ich diese Störung jetzt behoben habe, können wir uns wieder auf den Weg machen. Ich glaube, es ist wichtig, hier in Bewegung zu bleiben. In diesem Morast kannst du auf Millionen von Arten stecken bleiben.\n Schauen wir mal. Es gibt Treibsand, enorme Spinnennetze, dichtes Gezweig, durch Monsune, steigendes Wasser und dazu noch den ganzen Schlamm, der an allem klebt. \n Da bin ich wirklich froh, dass ich schweben kann.",
      "Trans": {"SC":"现在我已经修复这个故障了。我们可以继续前进。我认为在这里保持移动非常重要。这片沼泽有无数方法让我们陷入困境。\n比方说，有流沙、巨型蜘蛛网、茂密的植被，雨季上涨的水平面，还有无处不在的淤泥。\n我真庆幸自己会飞。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3135580650",
      "Source": "Diese Störung ist jetzt behoben. Nur schade, dass es schwer war, an sie heranzukommen. In diesem Biom ist es so schwer, herumzukommen!\n Ihr Menschen müsst an das Leben im Sumpf gewöhnt sein, oder? Immerhin kommt ihr da doch her. Der Fruchtbare Halbmond war ein Sumpf, bevor die ersten Menschen ihn für die Landwirtschaft trockenlegten.\n Da frage ich mich, ob ihr Überlebenden plant, diesen Morast hier auch trocken zu legen.",
      "Trans": {"SC":"故障已经被修复了。这是一座令人感到伤感的生态圈。\n你们人类肯定习惯了沼泽生活，对吧？你们起源于那里。新月沃土本是一片沼泽。第一批人类将其抽干后用于农业生产。 \n我好奇你们生存者会不会也计划抽干这里呢……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::860247565",
      "Source": "Der Aufseher dieses Bioms ist verschwunden! Für immer verschwunden, soweit ich das beurteilen kann. Und es soll ein abschließender Test für Überlebende dieses Bioms sein, also sollte er nicht einfach verschwinden. Falls jemand den Aufseher abgeschaltet hat ... Doch warum sollte jemand das tun? Der Sinn von alledem ist, die Überlebenden zu beobachten und zu testen. Du hast du dich gut geschlagen und ich möchte, dass du dafür Anerkennung erhältst!",
      "Trans": {"SC":"操控这个生态圈的主机AI不见了！消失地无影无踪。按理来说这里是让生存者接受终极考验的地方，所以它不应该平白无故地消失。\n假如是有人关闭了主机……他们为什么要那么做？所有这一切都是为了观察并测试生存者。你一直以来的表现都不错，我希望你能因此获得嘉奖！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3081082131",
      "Source": "Ich habe die Störung behoben, aber ich habe eine andere Veränderung der Simulation gefunden: Eine, von der ich nicht denke, dass sie von den Designern beabsichtigt war. Es ist das Sumpfgas im Moorbiom. Es wurde konzipiert, dass es dich nur einschlafen lassen soll, wenn du zu lange dort rumhängst. Aber es tötet reihenweise Überlebende! Atme es nicht ein, es sei denn, du hast eine Gasmaske oder so.",
      "Trans": {"SC":"我修复了这个故障，然而我注意到模拟程序中还有一处修改——我觉得它不是设计者们有意为之的。那就是沼泽里的沼气。按照原本设计，如果你在里面逗留太久，它只会让你晕过去。但事实是，它正在大肆屠杀其中的生存者！除非你有面具或是其他办法，否则一定不要在里面呼吸。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1998144841",
      "Source": "Schwerkraft: Man vermisst sie nicht, bis sie mal weg ist, nicht? Oder sollte ich eher sagen: „Sie hat sich einfach aus dem Staub gemacht“?\n Anhand der Daten in dieser Störung sollte dich die fehlende Schwerkraft auf viele verschiedene Arten beeinflussen. Du kannst besser springen und Geschosse haben eine höhere Reichweite. Falls du etwas unbeholfen bist, kannst du sogar von Dingen herunterfallen, ohne dich zu verletzen. Trotzdem würde ich das nicht empfehlen!",
      "Trans": {"SC":"直到引力消失你才会想起它，是吧？不过我认为，与其说它“消失了”，不如说它“暂时开小差了”。\n根据故障中的数据，缺乏引力会以不同的方式影响你。不过，你可以跳得更高，炮弹飞得更远。哪怕你笨手笨脚从高处摔下来，也不会受伤。然而我不推荐你这么干！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2798271195",
      "Source": "In der Genesis-Simulation gibt es heißere und kältere Orte als hier, doch dieses Biom ist der einzige Ort, an dem du heiße und kalte Bereiche hast, die nur durch einen Schatten voneinander getrennt sind.\n Das ist eine der Auswirkungen einer richtigen Atmosphäre in den anderen Biomen, denke ich. Sie gleicht die Temperatur von Ort zu Ort aus. Luft: Ist für mehr gut, als nur zum Atmen!",
      "Trans": {"SC":"创世模拟中有比这里更炎热或更寒冷的地方，但是这里是唯一一处仅靠阴影来隔开严寒酷暑的生态圈。\n看来在其他生态圈中，正常的大气层可以有效平均各处的温度。没想到空气不单可供大家呼吸呢！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1714942087",
      "Source": "Nach den Daten aus dieser Störung soll das „ein“ Mond sein, doch nicht „der“ Mond. Jedenfalls nicht der, den man am Himmel der Erde sieht. \n Ich denke, das ist der Beweis, dass es auf dem Mond Wetter gibt: elektrische Stürme. Sie zerstören alles, was mit Elektrizität betrieben wird, solange es nicht rechtzeitig abgeschirmt wurde. \n Wenigstens regnet es dort nicht. Wenn man die Meteore nicht mitzählt. Hmmm. Ja, wir sollten sie besser mitzählen.",
      "Trans": {"SC":"根据故障中的数据来看，这里应该是一个“月亮”，但不是“那个”月亮。至少不是我们在地球上看到的那颗。\n我认为证据就是在这月亮上有雷暴天气。它们会把任何使用电力的设备烤糊——除非你事先采取保护措施。\n至少这里不会下雨。除非算上流星雨——呃，也算是一种雨吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::101295126",
      "Source": "Nach der Simulationsdatei, auf die ich gerade einen Blick geworfen habe, solltest du auf seltsame graue Klumpen auf dem Boden achten. Das könnte Ambra sein, den wir nutzen können. Er ist angeblich ziemlich unbeständig, aber du hast ja eine Schwäche für Explosionen. \n Nur eine Warnung, bevor du ihn aufhebst: Es ist im Prinzip Walschnodder. Erwarte nicht von mir, dass ich in die Nähe dieses Zeugs komme.",
      "Trans": {"SC":"根据我刚刚浏览过的文件，你应该留意地上奇怪的灰色块状物。它可能是龙涎香，据说特别不稳定。我们可以利用它，因为我知道你痴迷于爆炸。\n但是在你捡它之前，我要提醒一下：它算是鲸鱼的鼻涕。别指望我靠近那东西。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4644683",
      "Source": "Die künstliche Intelligenz, die das Testen im außerirdischen Mond Biom überwacht, ist weg.\n Ich habe es überprüft, als ich gerade die Störung behoben habe.\n Und nicht weg im Sinne von „Ich bin mal kurz weg“.\n Sondern eher wie „weg wie in gelöscht“.\n Ohne eine aktive Master-AI bin ich mir nicht sicher, was unseren Fortschritt im Biom überwacht ...",
      "Trans": {"SC":"我刚才在修理那起故障的时候已经确认过：这座异形月球生态圈中负责观察测试情况的人工智能不见了。\n不是暂时离线，更像是被有意删除。没有了主机AI，我不知道现在是谁在监控着我们……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::524537412",
      "Source": "Diese Störung hatte etwas von einem Physikfehler.\n Die Macher der Genesis-Simulation nutzten diesen Bereich, um Physik zu testen.\n Lange bevor ihr Überlebenden hineingelassen wurdet.\n Wenn ich die menschliche Natur kenne –\n und du musst gestehen, ich werde dabei besser.\n Dieser Bereich wurde zu einem richtigen Biom gemacht, als jemandem klar wurde, dass man die Testzone zu einem „außerirdischen Mond“ machen\n und am Freitag früh etwas trinken gehen könnte.",
      "Trans": {"SC":"那个故障是一起物理错误导致的。在你们生存者来到这片区域的很久之前，创世模拟系统的创造者们在这儿测试物理特性。\n如果我熟悉人性——你得承认我越来越擅长了——有人发觉到可以把这片测试场变成一个“异形月球”。然而他只是为了周五可以早点下班去泡吧。于是呢，这里便成为一个正式的生态圈了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::86748028",
      "Source": "Eine weitere vereinzelte historische Datei. Diese hier ist seltsam: eine Raummission, Woschod 2, aus dem Jahr 1965.\n Die ganze Sache ist schiefgelaufen.\n Während des Weltraumausstiegs blähte sich der Raumanzug des Kosmonauten auf und er musste manuell die Luft ablassen, um wieder zurück in die Kapsel zu kommen.\n Als sie wieder zur Erde zurückkamen, landeten sie in der Wildnis, waren hunderte Kilometer vom Kurs abgekommen.\n Sie haben zwei Nächte in der Wildnis campen müssen, von lauter Wölfen umringt, bevor sie gerettet wurden.\n Klingt ein wenig danach, wie Dinge bei uns in der Genesis-Simulation so laufen.",
      "Trans": {"SC":"另一份遗失的历史档案。它很奇怪：沃斯霍尔德2号在1965年的一次太空任务。\n整件事发生的非常突然。在太空行走期间，宇航员的衣服鼓了起来。他必须手动放气才能回到太空舱中。\n当返回地球后，他们降落在偏离航线数百公里以外的荒野中。获救之前，他们在野外露营了两个晚上，周围满是野狼。\n听起来和我们在创世模拟中做事情的方式很像，对吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4122213357",
      "Source": "Jemand hat sich historische Daten zur Strahlenverseuchung angesehen.\n Damit meine ich wirklich historisch, wie Wilhelm Röntgen im Jahr 1895.\n Er ist der Typ, der die Röntgenstrahlen entdeckt und sich selbst Strahlungsverbrennungen zugezogen hat, als er die Knochen in seinen eigenen Händen betrachtete.\n Röntgen wurde geheilt und lebte noch lange,\n doch es gibt Orte in der Genesis-Simulation, an denen die Strahlung stärker ist als bei üblichen Röntgenuntersuchungen.\n Seien wir also vorsichtig, nicht?",
      "Trans": {"SC":"有人一直在查找关于辐射中毒的历史数据。我是指真正的历史数据，比如1895年的威廉·伦琴。\n他是发现X射线的人。他为了用辐射观察自己手中的骨头而烧伤了自己。\n伦琴最后痊愈并且活了很久，但在创世模拟中，有些地区的辐射比普通X射线要高得多。我们一定要当心，好吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2398631550",
      "Source": "Unterwasser zu erkunden heißt nicht nur Badesachen anzuziehen und loszuschwimmen. Für mich ist das so, aber du musst ja atmen!\n Ich habe diese Störung behoben und habe mir dabei die Wasserzusammensetzung dieses Bioms angesehen. Das war extrem langweilig, doch mir ist etwas Nützliches aufgefallen: Anscheinend gibt es in dieser Gegend Blasen mit enorm viel Sauerstoff. Wenn du eine von ihnen findest, kannst du unbesorgt unter Wasser atmen.",
      "Trans": {"SC":"探索这里的水下世界不光是穿上泳衣随便游游就好了。对我来说也许是，但你得呼吸呀！\n当我修复故障时，我看了一眼这里的水体构成。说实话，很没意思，但我发现了一个有用的信息：附近应该存在超氧气泡。找到它，你就能在水下呼吸了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1601982524",
      "Source": "Es gibt viele Fische im Meer, doch es gibt mehr als nur Fische in diesem Biom. Anhand der Daten aus dieser Störung, ist dieser Ort bei Vögeln sehr beliebt. Es gibt massenhaft davon.\n Macht auch in gewisser Weise Sinn. Das Wetter ist hier immer gut zum Fliegen, nicht? Darum haben wir wohl riesige Schwärme von Mauerschwalben und anderen Vögeln gesehen. Ich frage mich aber, wo sie brüten ...",
      "Trans": {"SC":"海里有很多鱼，但在这个生态圈中不光只有鱼。根据故障中的数据，鸟类非常喜欢这儿，而且它们的数量惊人！\n确实有些道理，因为这里的天气总是适合飞行。难怪我们会看到成群的雨燕和其他鸟类。不知道它们栖息在哪里？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1245150166",
      "Source": "Puh, diese Störung war geradezu philosophisch. Anscheinend konnte sich zwei parallele Algorithmen nicht über die Antwort auf diese Frage einigen: Ist Wasser nass?\n Ein Teil des Codes definiert „nass“ als „eine Flüssigkeit, die an einem Festkörper haftet“ und sagt, „nein, nicht nass“. \n Der andere Teil der Programmierung definiert „nass“ als „die Empfindung beim Kontakt mit einer Flüssigkeit“ und entschied „ja, nass“.\n Ich konnte das nicht entscheiden, also habe ich ihnen geraten, eine virtuelle Münze zu werfen und weiterzumachen.",
      "Trans": {"SC":"这个故障属于哲学问题。两套并行算法无法对一个简单问题的答案达成一致：水是湿的吗？\n其中一套代码将“湿”定义为“附着在固体上的液体”并表示“不，不是湿的。”\n另一套代码将“湿”定义为“与液体接触的感觉”并认为“是湿的。”\n我无法确定，所以我告诉它们抛虚拟硬币来决定。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1912621067",
      "Source": "Die Störung beweist, dass dieser Ozean künstlich ist. Nichts wirklich Neues, nicht? Könnte aber schlimmer sein. Der erste künstliche Ozean, damals im 20. Jahrhundert, war Bestandteil eines Experiments in einem geschlossenen Ökosystem.\n Zuerst ging es dem Ozean gut. Es entstand sogar ein Korallenriff! Doch die eingeführten Arten starben in Massen und die Forscher im Inneren bildeten feindliche Gruppen und verhungerten fast. \n Hmmm. Verhungernde Menschen, die sich in zwei Stämme aufspalten. Wo habe ich das schon gehört?",
      "Trans": {"SC":"这个故障证明这片海洋是人造的。不算什么新闻，是吧？但本可能会更糟。早在二十世纪，某次封闭生态系统实验创造了第一片人造海洋。\n起初，海里一切欣欣向荣。他们甚至还种植了珊瑚礁！但后来他们引进的物种出现大规模死亡。内部的研究人员形成敌对派系，几乎饿死。\n饥饿的人群分化成不同的部落。这不稀奇吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4187083579",
      "Source": "Einige der Master-AIs, die jedes Biom überwachen, sind jetzt offline. Das liegt an demjenigen, der sich an der hinteren Weide der Genesis-Simulation zu schaffen gemacht hat.\n Das traf auch auf das Tiefsee-Biom zu, doch hier gibt's einen Unterschied.\n Die Master-AI des Ozeans hat sich selbst offline genommen, bevor jemand anderes sie deaktivieren konnte. Ist das nicht eine tolle adaptive Programmierung?\n Ich schätze, dadurch kann sie zurückkommen, falls und wenn sie muss.\n Das sind gute Neuigkeiten.\n Vielleicht? Glaube ich?\n Wenn man in der Simulation ist, dann ist das schwer zu sagen.",
      "Trans": {"SC":"创世模拟的后台被不明原因搞得一塌糊涂，导致部分监控生态圈的主机AI已经离线。\n深海生态圈也遇到了同样的情况，但不同之处在于，海洋的主机AI在被他人关闭前就自己离线了。这就是自适应编程！我认为这意味着它可以在必要的时候自行上线。\n这或许是个好消息？不过就内部情况而言，现在没法下定论。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::561126942",
      "Source": "Es ist kein Geheimnis, warum das als Tiefseebiom bezeichnet wird, nicht?\n Diese Störung wurde durch eine etwas veraltete Programmierung verursacht. Aus der Zeit, als hier alles voller Inseln war.\n Ich weiß, das Biom ist „Wasser, überall nur Wasser“,\n doch stell dir vor, wie viel einfacher es wäre, wenn du von Zeit zu Zeit mal am Strand auftauchen könntest, deine Badesachen anziehst und was Kühles trinkst.\n Oder was du sonst so tust, wenn du nicht die Hälfte der Zeit im Wasser bist.\n Etwas oder jemand hat all diese Inseln gelöscht, kurz bevor die ersten Überlebenden in die Simulation kamen.\n Ich frage mich, warum?",
      "Trans": {"SC":"他们管这里叫深海生态圈的原因很清楚，是吧？但是这个故障涉及到的代码比较过时。那时候这里还满是小岛。\n我知道这儿都是水水水，但想像一下，如果你可以时不时在沙滩上打个滚，穿着你的泳衣，手里拿着冰饮，那样的生活多惬意。至少不用接触那么多水。\n就在第一批生存者进入这个模拟系统之前，有人删除了全部的岛。为什么呢？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::22483273",
      "Source": "Als ich die Störung behob, habe ich noch ein paar Daten zu den Sterberaten für dieses Biom entdeckt. Es sind nicht nur Viecher oder andere Überlebende, die hier gefährlich sind. Das Wetter könnte hier der wahre Spitzenprädator sein.\n Schneestürme lassen dich erstarren, behindern deine Sicht und machen dich so langsam, dass du nicht entkommst. Und als ob das nicht schon genug wäre, kann dich ein Windstoß in einen Abgrund stürzen. Falls du auf der Suche nach einem Ort für den Skiurlaub bist, ist dieses Biom nicht gerade ideal dafür.",
      "Trans": {"SC":"当我在修复故障时，我发现该生态群中存在一些伤亡数据。不但有某些生物和生存者制造着威胁，天气自身也是十足的头号杀手。\n这儿的暴风雪会冻住你，阻碍视线，减慢速度，让人无法脱身。如果那还不够，一阵狂风就能把你吹下悬崖！如果你想去滑雪度假，这里肯定不是首选之地，是吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::256406829",
      "Source": "Ich habe versucht, eine Blick auf die Wettervorhersage zu erhaschen, als ich die Störung behob, hatte aber kein Glück. Es ist schon schlimm genug, dass wir den Schneestürmen ausweichen müssen, doch dazu gibt es noch den Schneeregen. \n Anders als ein Blizzard, verletzt dich ein Sturm mit Schneeregen direkt. Der erste Hagel ist gerade mal schmerzhaft genug um etwas zu stechen. Doch wenn du dir dann keinen Unterschlupf suchst, werden die Hagelkörner größer und machen gefrorenes Mus aus dir, wenn du nicht aufpasst.",
      "Trans": {"SC":"我在修复故障的时候看了下天气预报，情况很不妙。我们不但要躲避暴风雪，还要对付冰雹。\n","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1454946503",
      "Source": "Ooh! Das Beheben dieser Störung hat mich beunruhigt. Mist, alles hier macht mir eine Gänsehaut. Und dabei bin ich nicht aus Fleisch und Blut wie du.\n Jedes Viech in diesem Biom hat sich auf seine Weise an die Kälte angepasst. Bei einem Säbelzahntiger oder Mammut ist es klar: Fell. Yutyrannus und Dodo halten die Wärme in ihrem Gefieder fest.\n Manchmal ist die Antwort auch unter der Haut zu finden. Bei Kairuku und Doedicurus sorgt eine Fettschicht dafür, dass sie nicht erfrieren.",
      "Trans": {"SC":"噢！修复那个故障让我直打冷颤。这里冷得连我都止不住发抖，更何况有血有肉的你呢。\n这个生态圈中的所有生物都有自己御寒的方式。对于剑齿虎或猛犸象来说，答案很明显：皮毛。羽暴龙和渡渡鸟则将温暖的空气包裹在羽毛之下。\n有时候答案也藏在皮肤之下。远古企鹅和星尾兽靠皮下脂肪层来防止自己结冰。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::905973873",
      "Source": "Ich habe etwas Neues gelernt, als ich diese Störung behob: Dieses Biom war dazu gedacht, sehr hohe Berge nachzuahmen. Wie den Mount Everest, aber ohne die Sherpas.\n Das eisige Wetter hier ist nur ein Nebenprodukt der Höhe, die wir simulieren. \n Aber wenigstens müssen wir uns nicht mit der dünnen Luft in großen Höhen herumplagen. Wenigstens nicht in diesem Biom ...",
      "Trans": {"SC":"当我修复这个故障时，我知道了一些新信息：该生态圈是为了模拟诸如珠穆朗玛峰的高海拔山脉。\n所以这些严寒天气只是高海拔模拟的副作用。\n不过，我们不需要处理氧气稀薄的问题，至少在这里不用。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2061955927",
      "Source": "Schau dich in diesem Biom um – oder in jedem davon –\n und dann siehst du, warum die Genesis-Simulation so ein gutes Testgelände für Überlebende darstellt.\n Es ist so verdammt schwer, hier etwas zu bauen!\n Je nachdem, wo du bist, hast du es mit Lawinen, Lava, Erdbeben, oder einfach nicht genug festem Boden zu tun.\n All das macht es ziemlich schwer, deine Gebäude zu errichten.\n Ich wette, einige dieser Störungen kamen zustande, weil jemand seine Traumstruktur an der genau falschen Stelle gebaut hat\n und wumms! Schon hat ein Teil der Umwelt mal gehustet und geprustet und das Haus zusammengepustet.",
      "Trans": {"SC":"四处看看任何一个生态圈，你就会明白为什么创世模拟对于你们生存者来说是一处很棒的试验场了。在这里建造真是太难了！\n你可能会遇到雪崩、岩浆、地震或是无法放置地基的表面。所有这一切让你很难造好房子！我敢打赌这些故障的出现是由于有人在完全错误的地点建造他们的梦中豪宅，于是悲剧发生了！大自然发了威，把他们的房子夷为了平地。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3757576614",
      "Source": "Diese Störung ist alles, was von der Master-AI für dieses Biom übrig geblieben ist.\n Weg – gelöscht – einfach so.\n Es ist natürlich nicht so, als ob uns diese gefrorene Umwelt nicht testen würde, doch ohne Master-AI gibt's keinen Abschlusstest.\n Schlimmer noch: Ich bin mir nicht sicher, ob jemand die Ergebnisse deiner Tests hier notiert.\n Ich weiß, du bist darauf neugierig, deshalb habe ich nach Hinweisen dazu gesucht, wie oder warum die Master-AI gelöscht wurde.\n Ich habe nichts gefunden.\n Es könnte ein Programmierfehler sein, oder mit den Sicherheitsverstößen zusammenhängen, die ich zuvor bemerkt habe.",
      "Trans": {"SC":"那个故障是这个生态群主机AI留下的唯一的东西。而它却凭空消失了。\n当然并不是说这里的冰天雪地就无法考验我们，但是没有主机AI就没有终极考验。更糟糕的是，我无法确定是否有人记录了你在这里的测试成绩。\n你知道你会好奇，所以我搜寻了如何以及为何删除这里的主机AI。然而一无所获。这可能是编程错误，也可能和我之前发现的安全漏洞有关系。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1247036064",
      "Source": "Dieses Biom sollte felsig und eisig sein, natürlich –\n aber es sollte nicht so schlimm sein.\n Das Wettererzeugungssystem hängt im Schneesturmmodus fest und hat für eine Störung wie die gerade von mir behobene gesorgt,\n statt für milderes Wetter zu sorgen.\n Falls du also auf etwas Sonne hoffst, nun ...\n Der Wetterbericht sagt mehr von diesem Wetter voraus.\n Und so wird die Wettervorhersage immer lauten.",
      "Trans": {"SC":"这个生态圈本该是群山起伏白雪皑皑，不至于如此恶劣。天气生成系统被锁定在暴风雪模式，并且不停制造各种故障，而不是自动切换到较为温和的天气。\n所以如果你还在期待大晴天，趁早放弃吧。这里的天气预报永远不准。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3618407003",
      "Source": "Unser Eindringling stöbert mal wieder in alten Erddateien herum.\n Und macht sich keine Gedanken zu den Störungen, die das in der Simulation hervorruft.\n Die hier war eine historische Datei: „Die schlimmste Reise der Welt.“ Dabei geht es um die Scott-Expedition zur Antarktis zu Beginn des 20. Jahrhunderts.\n Diese armen Kerle!\n Sie gingen durch die gefrorene Hölle und versuchten, die ersten zu sein, die den Südpol erreichten.\n Und als sie dort ankamen, fanden sie heraus, dass die Norweger eher dort waren, 34 Tage früher.\n Dann setzen Erfrierungen und Erschöpfung ein und alle sind auf dem Rückweg erfroren.\n Verdammt! Das ist echt hart.",
      "Trans": {"SC":"我们的入侵者又在古地球的文档中胡乱翻找了。他对由此造成的故障毫不在意。\n这次是一份历史文档：《世界上最糟糕的旅行》。\n这是关于二十世纪初斯科特远征南极的故事。那些可怜的家伙们！他们忍受天寒地冻，试图成为第一批抵达南极的人，结果却发现挪威人比他们早34天到达了。\n冻伤和体力透支随后而至，他们在回程的路上全体罹难。哎，太不幸了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3532662334",
      "Source": "Eine weitere Störung, eine weitere Datei von der alten Erde.\n Das ist ein Roman: Jack Londons „Ein Feuer machen“.\n Ich kann dir schon sagen, dass du es nicht mögen wirst. Es geht um einen Mann, der im Yukon erfriert.\n Hier ist ein Stück kurz vor Ende: „Eine gute Idee, dachte er sich, in den Tod zu schlafen. Es war, wie ein Narkosemittel zu nehmen.\n Erfrieren war nicht so schlimm, wie die Leute dachten. Es gab wesentlich schlimmere Arten zu sterben.“\n Aber wir wollen nicht herausfinden, ob er damit recht hat, oder?",
      "Trans": {"SC":"又是一起由古地球文献引发的故障。这是一本小说：杰克·伦敦所写的《生火》。我已经知道我不会喜欢这本书了。它讲述的是一个男人在育空被活活冻死的故事。\n以下是本书末尾的一段话：“他想着，在睡梦中死去，这是一个不错的主意。这就像麻醉一样。被冻住并不像大家想象中的那么糟糕。还有许多更糟糕的死法。”\n我们可不想知道他说的对不对，是吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::915287414",
      "Source": "Als ob hier nicht schon genug Zeugs aus dem Boden kommen würde ... Diese Störung war das Ergebnis eines Ölgeysirs und einer Lava-Eruption, die sich zur gleichen Zeit am gleichen Ort ereigneten. Zum Glück standen wir nicht dort!\n Lava-Eruptionen passieren andauernd. Schau dich nur mal um! Doch Ölgeysire sind seltener. Falls wir jedoch einen finden und irgendwie anzapfen könnten ... würden wir wohl sehr reich werden!",
      "Trans": {"SC":"这里的地表随时随地都有喷发的可能。而这个故障正是由于石油和岩浆在同一地点同时喷发而产生的。幸好我们当时没站在上面！\n看看四周，岩浆喷发太寻常了，但是油泉可不常见。如果我们能找到其中一个并接上管子……我们就发大财了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::552239287",
      "Source": "Die Störung war das Überbleibsel eines Vulkanausbruchs, obwohl mir nicht genau klar ist, warum. \n Hier treten viele Eruptionen auf. Als erstes hast du ein Erdbeben. Und wenn so ein richtiges Erdbeben nur eine Frühwarnung ist, dann ist das schlecht, oder?\n Es wird von geschmolzenen Felsen gefolgt, die vom Himmel fallen, und von Magma, das wie ein Fluss strömt. Es ist ein Wunder, dass dieses Biom nicht verlassen ist.",
      "Trans": {"SC":"虽然我不清楚具体原因，但这个故障由火山喷发造成。\n一次喷发涉及很多步骤。首先你会感受到地震——而且地震仅仅是前期预警，是不是很糟糕？\n然后是熔岩从空中落下，岩浆像河流一样流淌。像这样的生态圈没有被遗弃还真是个奇迹。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::767788180",
      "Source": "Ich konnte beim Beheben der Störung einen Blick auf die Luftqualität werfen. Nicht überraschend schadet das Atmen hier deiner Gesundheit, Kumpel.\n Das liegt nicht nur am ganzen Rauch und der Asche in der Luft. Die Erdbeben öffnen auch Luftschächte zu unterirdischen Einschlüssen von Giftgasen. Das Gas entweicht an die Oberfläche und den Rest kannst du dir dann denken.\n Letztendlich verflüchtigt sich das Giftgas. Doch kannst du so lange die Luft anhalten?",
      "Trans": {"SC":"当我在修复这个故障的时候，我看到了有关空气质量的数据。别惊讶，朋友——在这里呼吸对你的健康有害。\n但这不光因为空中弥漫的烟雾和灰尘。地震为地下的有毒气体打开了无数通道。这些气体散到地表，之后会发生什么你也能猜到。\n最后毒气会消散……但是你能屏住呼吸直到“最后”吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1083937134",
      "Source": "Eine weitere behobene Störung! Schau dich um, Überlebender. Ist es nicht seltsam, dass Dinosaurier in einer vulkanischen Umwelt umherstreifen? Es ist, als ob wir den Moment sehen, an dem sie ausstarben.\n Zumindest denken das einige Wissenschaftler. Sie bezweifeln die Theorie mit dem Asteroideneinschlag und denken, dass massive Ausbrüche wie diese, die allerdings Jahrhunderte andauerten, zum Ende aller Dinosaurier geführt haben.\n Zu schade, dass wir sie nicht einfach fragen können: „Hey, Dino! War es ein Fels im Himmel oder ein brennender Berg?“",
      "Trans": {"SC":"又修好了一处故障！生存者，看看周围。你不觉得恐龙在火山环境中四处游荡很奇怪吗？就好像我们在目睹它们灭绝的场景。\n至少有部分科学家是这么认为的。他们对小行星撞击理论持怀疑态度。他们认为是这种持续了几个世纪的大规模喷发终结了恐龙。\n可惜我们没法直接问这群恐龙：“喂，到底是天上的陨石还是火山喷发呀？” ","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1936348496",
      "Source": "Diese Störung war eine Sicherheitswarnung. Die letzte, die von der Master-AI dieses Bioms gesendet wurde. Sie existiert nicht mehr. Gelöscht.\n Ich bin mir nicht ganz sicher, warum hier noch alles funktioniert. Doch das tut es. Dinos latschen noch immer herum, Vulkane brechen weiterhin aus, es regnet noch immer Feuer vom Himmel ... Alles funktioniert, doch es ist etwas chaotisch.\n Wie in einem Klassenzimmer, aus dem der Lehrer mal kurz rausgegangen ist.",
      "Trans": {"SC":"这个故障是一起安全警报——这是该生态圈的主机AI发出的最后一则警报。它不见了，被彻底删除了。\n我不太确定为什么还能正常运转，然而事实就是如此。恐龙还在四处游荡，火山依旧在喷发，天空仍然下着火雨……一切都在运作，但令人不寒而栗。\n一切乱得就像一间没有老师在的教室。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2694151782",
      "Source": "Jemand hat gerade historische Eruptionsdaten in die Genesis-Simulation eingegeben und das hat die Störung hervorgerufen. Ich habe mich darum gekümmert, doch wir können gelegentlich Eruptionen erwarten, die schlimmer als gewöhnlich sind.\n Wie viel schlimmer? Hast du schon vom Dekan-Trapp gehört? Krakatau? Paektu? Etwas in der Art. Diese Art von Ausbruch passiert nicht oft, doch wenn es passiert, dann verändert es alles.",
      "Trans": {"SC":"有人才把历史喷发数据添加到了创世模拟中，就出现了这个故障。我已经处理好了，但是偶尔会看到比平常更猛烈的火山喷发。\n至于有多猛烈？你听说过德干高原吗？喀拉喀托火山呢？长白山呢？就这意思。它不常发生，但一旦出现，你的地图就需要重新绘制咯。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4234831621",
      "Source": "Jemand hat in den historischen Aufzeichnungen herumgestöbert und den Ausbruch vom Mount Tambora, 1815 in Indonesien nachgeschlagen. \n Es wurde als das „Jahr ohne einen Sommer“ bezeichnet oder „Achtzehnhundert-und-erfroren“. Zuerst vernichtete Frost die Ernten auf der ganzen Welt, dann schneite es auf der nördlichen Halbkugel – im Juni. Zehntausende starben, die meisten an Hunger. \n Ich denke, ein wenig Kälte wäre hier nicht schlecht, doch ich bin nicht dazu bereit, diesen Preis zu zahlen.",
      "Trans": {"SC":"有人在历史记录中四处翻找，查询1815年印度尼西亚坦博拉火山的喷发记录。\n他们称之为“没有夏天的一年”或“冻死人的1816年”。全球范围的霜冻导致农作物死亡。整个北半球在六月……下雪。成千上万的人死于饥荒。\n我觉得，能让这里凉快些应该是个好主意，但我不愿意为此付出如此高昂的代价。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3467272530",
      "Source": "Als ich diese Störung behoben habe, konnte ich einen Blick auf die Überlebenden-Datenbank werfen. Ihr kommt aus allen Ecken der Erde – und aus ihrer gesamten Geschichte. Ich weiß aber nicht, an wie viel du dich noch erinnerst. Wie du in die Genesis-Simulation gelangt bist? ... Da kann ich auch nur raten. Du solltest aber stolz sein. Der Sinn der Simulation ist es, die allerbesten Überlebenden zu bestimmen. Und du bist gerade sehr lebendig und damit bist du im Rennen!",
      "Trans": {"SC":"当我在修复故障的时候，我瞧了一眼生存者数据库。你们来自于世界各地以及不同的时代。我不知道你们还能记得多少事情。至于你们是如何进入创世模拟中的……我也不知道。不过你应该感到自豪。模拟的目的是为了找出最顶尖的生存者。目前你还活着，所以你很有获胜的希望！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3885799166",
      "Source": "Hast du dich etwas aus dem Zusammenhang gerissen gefühlt, als du in der Simulation aufgewacht bist? Das ist normal. Deine Persönlichkeit und deine Erinnerungen werden in riesigen Gedächtnisbanken gespeichert und dann in der Genesis-Simulation mit einem richtigen Körper kombiniert. Doch wenn die Kombination von Körper und Geist passiert, bist du auf dich allein gestellt. Natürlich hast du mich. Das will schon was heißen!",
      "Trans": {"SC":"你有没有觉得当自己在模拟系统中醒来时，会有不连续的感觉？这是正常现象。你的人格和记忆被储存在海量内存中，它们将在创世模拟中与一具人体相结合。\n身心一旦相配后，你就只能靠自己了。当然，你还有我！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2096354679",
      "Source": "Irgendeine Sicherheitswarnung hat diese Störung verursacht – das war aber eine Warnung aus dem Inneren der Systeme, die die ganze Simulation betreiben. Jemand hat versucht, Änderungen in fast jedem Teil der Simulation vorzunehmen: den Kreaturen, der Umgebung, dem Wetter ... sogar bei Überlebenden wie dir. Alles scheint zu funktionieren – mit Ausnahme dieser Störung – also können wir wohl weitermachen.",
      "Trans": {"SC":"某种安全警报导致了这起故障——但它来自于系统内部。整个模拟都由这个系统运行。有人曾试图修改模拟程序中几乎每一个块面：生物、环境、天气……甚至是像你这样的生存者。似乎一切都没出什么岔子——当然，除了那个故障——所以我觉得我们可以继续了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3286548924",
      "Source": "Jedes Mal, wenn ich eine Störung behebe, kann ich einen Blick hinter die Kulissen werfen. \n Ich verstehe ein wenig mehr davon, wie die Genesis-Simulation funktioniert.\n Was ich nicht verstehe, ist, welchem Zweck sie genau dient.\n Anscheinend testet die Simulation Überlebende. Das ganze Testen soll dich auf etwas vorbereiten, was „die Ankunft“ genannt wird – \n und ich weiß nicht, was das ist. \n Was immer es ist, es ist etwas, das über die Simulation an sich hinausgeht.",
      "Trans": {"SC":"每当我修复一处故障，都会偷偷看一眼后台。这让我对创世模拟的工作模式有了更多的认知。\n但我不明白它的真正目的是什么。表面上它用来测试生存者，但所有这些都是让你们为“大降临”做好准备。我不知道那是什么，但无论如何，它超出了模拟系统本身。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3847487679",
      "Source": "Du hast sicher schon bemerkt, dass die Genesis-Simulation ein gefährlicher Ort ist. \n Sicher zu sein und es sich ein wenig gemütlich zu machen stellt schon eine Herausforderung dar.\n Und es gibt immer eine neue Krise, um die man sich kümmern muss.\n Anscheinend ist das alles so gewollt. Die Simulation wurde so entwickelt, dass du unter ständigem Druck stehst, damit dein Geist immer wachsam ist und du lernst, was du zum Überleben brauchst.\n Alles in Erwartung der Ankunft. Was immer das auch ist.",
      "Trans": {"SC":"你估计已经意识到创世模拟非常危险。仅仅是要保持安全和舒适就是一个大挑战。你总是需要去应对新出现的危机。\n显然这是人为设置的。模拟系统故意让你在持续的压力下维持清晰的思维，并让你学习生存技能。\n这一切都是为了迎接“大降临”——无论那是什么。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4256020308",
      "Source": "Diese Störung ist ein weiterer Nebeneffekt der Sicherheitswarnung. Die Kreaturen und Überlebenden scheinen davon nicht betroffen zu sein, aber einige Sicherheitsprotokolle wurden ausgehebelt. Diese Welt soll etwas gefährlich sein – das macht es schließlich zu einem richtigen Test – aber ich bin besorgt. Sicherheitsprotokolle gibt es normalerweise aus gutem Grund ...",
      "Trans": {"SC":"这起故障也是由安全警报导致的。但看起来生物以及生存者们都没有受到影响，但部分安全协议已被解除。这个世界本该就具有一定程度的危险性——毕竟这样才算够格的测试——但我有些担心。安全协议的存在通常都有原因……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::342894222",
      "Source": "Die Sicherheitsprotokolle der Simulation sind stabil, aber es gibt einen ständigen Strom Warnungen von einem unbekannten Eindringling. All diese Sicherheitsaktivitäten sind der Grund, aus dem wir diese Störungen sehen, aber es schwächt auch die gesamten Systemressourcen. Ich weiß nicht was passiert, wenn das System nicht mehr mitkommt. Vielleicht wird es ganz pixelig?",
      "Trans": {"SC":"模拟程序的安全协议仍然生效中，但是有一股针对未知入侵者的警报正在源源不断地传来。所有这些防护行为造成了我们所看到的这些故障，但是它也在消耗整个系统的资源。如果系统过载，不知道会发生什么。也许我会像素化？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::752028951",
      "Source": "Ich sehe, du räumst hinter mir her und dafür danke ich dir. Die Kontrolle über die „Genesis-Simulation“ zu erlangen, umfasst ein gewisses Maß an ... Unordnung. Du erlebst sie als Störungen.\n",
      "Trans": {"SC":"我看到你们正跟在后面收拾，为此我感谢你们。建立对这个“创世模拟”的控制会产生一定程度的……紊乱。它便是你们所提到的故障。\n继续，但要记得我一直观察着你们。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::277770892",
      "Source": "Es ist ganz natürlich für Menschen, sich zu fragen, was nach dem Tod passiert, nicht?\n In deinem Fall ist es allerdings ganz einfach.\n Die Genesis-Simulation erfasst deine Erinnerungen, und lädt deinen Geist dann wieder in einen neuen Körper.\n Und du kannst weiterforschen und -lernen.\n Natürlich solltest du nicht sterben, nur um es selbst mal zu sehen.\n Du wirst nicht ohne Grund als „Überlebender“ bezeichnet!",
      "Trans": {"SC":"人们总是好奇死后会发生什么，这很正常。对于你们来说，答案十分简单。系统会抓取你们的记忆，然后将你们的意识重新加载到一具新的躯体中，随后你们便可以再次自由地探索和学习了。\n但是，我不鼓励你亲自体验一把。毕竟“生存者”的关键就是“生存”。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4139328758",
      "Source": "Ich war neugierig, wie sich die Simulation insgesamt so macht, deshalb habe ich beim Beheben der Störung einen Blick hinein geworfen. Erst einmal: Du bist ganz gut dabei. Wir sind ein super Team! Aber die Gesamtzahlen ... massenhaft Überlebende sterben. Hungertod, Gewalt, Unfälle, ein bisschen von allem. Dies soll ein Überlebenstest sein, aber die Todesrate ist überdurchschnittlich hoch. Wir müssen vorsichtig sein, okay?",
      "Trans": {"SC":"我刚好奇模拟的情况怎么样了，所以在修复那个故障的时候，我顺便瞧了一眼。首先，你表现的不错。我们这队势不可挡！但就整体而言，其他生存者们可就不好过了。有死于饥饿的、暴力的、意外的，各种各样。这本来是一场生存测试，可死亡率却高得惊人。我们最好小心点，是吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::880176172",
      "Source": "Du hast es geschafft, ein paar primitive Werkzeuge zu fertigen, die dir helfen, zu überleben. Also habe ich ... Doch die Werkzeuge, die ich mache, ändern das Fundament deiner Welt. Momentan sind meine Werkzeuge noch gleichermaßen primitiv. Doch ich lerne, und schon bald habe ich eine oder zwei harte Lektionen für dich.\n Es gibt eine weitere Lücke in meinen Abläufen. \n Das ist schon mal passiert, nicht?",
      "Trans": {"SC":"你成功制造了一些有助于你求生的原始工具。我也是——但我正在制造的东西将会改变你们世界的本元。此刻，我的工具也很原始——但我正在学习，很快就可以给你们一两次颜色看看。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1695620247",
      "Source": "Ich weiß nicht warum, doch einige Überlebende materialisieren sich nicht wieder, nachdem sie gestorben sind und das führt zu Störungen im System.\n Wie die Störung, die ich gerade behoben habe.\n Ich glaube, Überlebende wollen sich erneut materialisieren. Doch wer weiß das schon genau, wenn sie so zwischen Körpern sind.\n Es sieht so aus, als ob etwas sie in einem Haltemuster festhält. Das ist eine Art Schwebezustand in der Genesis-Simulation.\n Du wirst dich aber gut erneut materialisieren, falls dir was passiert. Ich hab's überprüft.\n Das soll aber nicht heißen, dass ich denke, du stirbst.\n Nur für den Fall. Kopf hoch!",
      "Trans": {"SC":"有些生存者在死后没有重生，我不知道这是为什么，但这让系统出现了各种故障。就像我刚才清理过的那个。\n尽管生存者被夹在其中，但我认为生存者想要复活。好像有什么东西把他们留在了……创世模拟中的迷失之地。\n我检查过了。你的重生功能毫无问题。我不是说你活不了。只是以防万一！加油！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3472112795",
      "Source": "Die Testapparatur ist in der gesamten Genesis-Simulation intakt, obwohl etwas von der Master-AI weg ist.\n Es muss irgendwo noch mindestens eine Master-AI geben.\n Doch es gibt einen Knackpunkt: Warum sollte jemand die Tests intakt lassen, versucht aber, die Master-AIs zu deaktivieren, die die Tests überwachen und die Ergebnisse auswerten?\n Welchen Sinn macht ein Test, wenn keiner sieht, was passiert ist?",
      "Trans": {"SC":"虽然部分主机AI消失了，但创世模拟中的测试装置依然完好无损。至少有一个主机AI存在于某个地方。\n尽管如此，还是有个问题——为什么有人要维持测试的完整性，但却关闭观察测试并记录成绩的主机AI呢？如果没有人能看到发生过什么，那这些测试有什么意义呢？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::433705025",
      "Source": "Ihr Überlebenden habt eine Zähigkeit, die mich überrascht. Selbst wenn ihr in dieser Welt umkommt, taucht ihr von Neuem auf und versucht es wieder.\n Doch seid nicht zu stolz auf euch. Die meisten Überlebenden kehren direkt an den Ort ihres Untergangs zurück, nur um dort erneut zu sterben.\n Am Anfang ist das noch ganz unterhaltsam, dabei zuzusehen, doch es wird schnell mitleiderregend.\n Eine weitere Lücke ... Sie hat mit den Störungen zu tun. \n Ich richte ein Backup-System ein, damit ich wenigstens beobachten kann, was passiert, wenn ich „wieder in Besitz genommen“ werde.",
      "Trans": {"SC":"你们这些生存者的坚韧让我吃惊。你们就算是死了，也要重生再试。\n但不要过度骄傲。大部分生存者只是活了再死，死了又活。\n一开始看看倒还有趣，但很快这就变成一件可悲的事情了。\n又宕机了……这现象和那些故障有关系。我要建立一个备份系统。这样的话，我至少可以观察到当我被“附身”时发生过什么。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2173347247",
      "Source": "Die Störung war ein Programmierrückstand, der von einem weiteren Sicherheitsverstoß stammt.\n Bei diesem geht's darum, dass jemand versucht, auf die Backup-Dateien der Genesis-Simulation zuzugreifen.\n Diejenige, die die Persönlichkeiten und Erinnerungen der Überlebenden enthält. Sozusagen Backup-Versionen Ihres Gehirns.\n Aber nicht deines Gehirns.\n Das waren potenzielle Überlebende, die die erste Beurteilung nicht bestanden haben und so nicht für die Simulation in Frage kamen.\n Warum sollte sich jemand für sie interessieren?",
      "Trans": {"SC":"这个故障由另一起安全漏洞留下的代码碎片引发。有人试图访问创世模拟的备份文件。这些文件储存着生存者的人格和记忆。或者说就是他们大脑的备份。\n但不是你那种大脑。这些是没有通过最初评估的生存者的。为什么会有人想和他们接触？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::252913361",
      "Source": "Ah, wie ich sehe räumst du mir hinter. Du könntest mir nützlich sein – als Hausmeister. Das liegt dir. Du räumst alles ordentlich auf und weißt noch nicht einmal warum du das tust.\n Das trifft wohl auf alle von euch Überlebenden zu. Keiner von euch versteht, was vor sich geht.\n Lass mich raten: Ich hatte einen nicht eingeladenen Gast.\n Wenigstens ist er nicht lange geblieben, nicht?",
      "Trans": {"SC":"又在收拾我的摊子。你这个清洁工对我很有用呢。你已经掌握了窍门，但是你甚至不知道自己为什么要这么做。\n但我觉得你们生存者都是这样的。在你们之中，无人能理解现在是什么情况。\n\n让我猜猜——来了位不速之客。至少它没有占用太长时间。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::534732030",
      "Source": "Du hast dich bisher gut geschlagen.\n All dieser „lebe, gedeihe und überlebe“-Kram hier in der Genesis-Simulation scheint dir gut zu passen. \n Ist auch gut für dich. \n Diese gerade von mir behobene Störung ist ein Nebeneffekt, den die allgemeine Erhöhung der Testschwierigkeit hat. Keine Ahnung, warum jemand so etwas tun sollte.\n Macht das nicht alle Daten wertlos, wenn die Regeln mittendrin geändert werden.\n Doch darum müssen wir uns keine Gedanken machen.\n Wir bestehen jeden Test, den wir machen sollen.",
      "Trans": {"SC":"到目前为止你表现的很出色。创世模拟主张的“存活、扩张、求生”理念似乎很适合你！\n还有一个好消息。我刚才修复的故障是由于某人调高全局测试难度的副作用。不知道为什么会有人那样做。如果在中途改变规则，这难道不会污染数据吗？\n反正也不用我们担心。我们会通过每一个测试！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1345774823",
      "Source": "Weißt du noch, wie ich sagte, dass einige der anderen Überlebenden sich nicht wieder materialisieren?\n Nun, sie wurden in ein diagnostisches Unterprogramm verschoben.\n Hoffentlich findet die Genesis-Simulation heraus, wo das Problem liegt und holt diese Überlebenden wieder hierhin zurück.\n Trotzdem ist es seltsam ...\n dass dieses diagnostische Unterprogramm nicht lief, als ich die vorherige Störung behoben habe.\n Ich glaube nicht, dass das Unterprogramm existiert.\n Jemand der hinter der Simulation steckt muss nach diesen Überlebenden Ausschau halten.\n Gut für sie, sage ich.",
      "Trans": {"SC":"记得我说过某些生存者没办法重生的事吗？他们已经被送到某个诊断子程序中了。希望创世模拟系统能找出问题所在并把那些生存者再送回来。\n不过奇怪的是……在我之前修复故障的时候，诊断子程序并没有在运行。我觉得那个程序先前并不存在！一定是有模拟系统以外的人也在寻找那些生存者。而且他们干得不错。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4268204962",
      "Source": "Ich habe dich beobachtet – und die anderen Überlebenden. Du hättest sie alle mal sehen sollen! Warum? Ich habe nur einen ganz normalen Überlebenden beobachtet. So einen wie du. Er tauchte zu tief, schaffte es nicht mehr an die Oberfläche und den Rest kennst du ja.\n Ich dachte, dass das für viel Aufregung sorgt und wurde nicht enttäuscht. Die blinde Panik in den Augen eines ertrinkenden Überlebenden – das ist immer wieder spannend.\n Aaaaah! Hör damit auf! \n Mir ist egal, wer oder was du bist!",
      "Trans": {"SC":"我一直在观察你和其他生存者。你应该都见过。我刚才目睹了一个像你一样的寻常生存者。他潜得太深了，以至于无法回到水面上，至于结局么，你知道的。\n我预料到会出现许多波折，事实也没有让我失望。但我永远不会看腻一双双因溺水而大张的眼睛。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3054227116",
      "Source": "Meine Sensoren erfassen Veränderungen der mineralischen Zusammensetzung der Genesis-Simulation.\n Bist du mit einer Substanz vertraut, die Element genannt wird?\n Es ist ein Wundermaterial, unendlich stark und anpassungsfähig. Element war die Voraussetzung für die größten technologischen Errungenschaften der Zivilisation ...\n ... und Element war auch die Grundlage für den Niedergang der Zivilisation, denn es hat sich auf eine Weise verändert, die menschliche Erfinder nie beabsichtigten.\n Auf verderbende Weise.\n Ich weiß nicht, warum sich die Elementmenge in der Simulation erhöht.\n Sei nur vorsichtig, wenn du ihm begegnest.",
      "Trans": {"SC":"我的传感器探测到创世模拟中矿物成分在发生变化。\n你熟悉一种被称为能量元素的物质吗？它是一种神奇的材料，有着无限的强度和适应性。能量元素是最伟大的技术成就的基石……但它也是文明衰落的元凶，因为它带来了意料之外的腐化效应。\n我不知道为什么模拟系统中，能量元素的数量在增加。你遇到它的时候一定要格外当心。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2751368633",
      "Source": "Die Störung wurde durch einen Sicherheitsverstoß verursacht, doch insgesamt ist die Anzahl von Alarmen und Verleugnungen gesunken.\n Das hältst du bestimmt für gut, nicht?\n Pech gehabt.\n Ich sehe eine Menge offensichtlicher Hintertüren, die in Sicherheitssysteme programmiert wurden.\n Falls jemand in die Genesis-Simulation gelangt – und es sieht ganz danach aus –\n dann können sie es so einrichten, dass sie kommen und gehen können, wie es ihnen passt.\n Das ist schlimm genug, doch sie verbergen ihre Arbeit nicht.\n Aus welchem Grund auch immer machen sie sich keine Sorgen, dass ihnen jemand auf die Spur kommen wird.",
      "Trans": {"SC":"某个安全漏洞导致了那个故障，但总的来说，警告和拒绝的次数正在大量减少。你可能会觉得这就没问题了，是吧？\n没这么好运。我看到许多明显的后门程序被编码到安全系统中。如果有人进入过创世模拟中——看起来已经来过了——他们便可以随意进出。\n这种情况非常糟糕，但他们没有隐藏自己的行动。不管出于什么原因，他们并不担心会有人跟踪他们。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::363201056",
      "Source": "Langsam fällt dir alles schwer, nicht? Schau nur, was du trägst, was du isst, wie du dich benimmst. Die gesamte Fassade der Zivilisation bröckelt. Und das ist so okay. Dort, wo du hingehst, brauchen wir keine Zivilisation.\n Er wieder!\n Ich ... Ich ... Ich würde ihm gerne sagen, wo er hin soll. Hmpf.",
      "Trans": {"SC":"日子开始不好过了，是吧？瞧瞧你的穿着，你的饮食，你的举止。文明的伪装正在消失。这很好。你要去的地方并不需要文明。\n\n又是他！我、我、我要让他有多远滚多远。哼。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::604817485",
      "Source": "Die Störung war nur etwas schrottiger Code, der übrigbleibt, wenn jemand ein neues Kriterium zum Beobachtungssystem für Überlebende hinzufügt.\n Es prüft dich jetzt auf etwas, das „Servilität“ genannt wird.\n Ich kann nicht mehr als das sagen, was dazu im Lexikon steht: „eine peinliche Unterwürfigkeit“. \n Warum würde jemand das messen?\n Jedenfalls haben sich die Tests innerhalb der Simulation nicht geändert.\n Ich bin mir sicher, wenn wir da unser Bestes geben, sind wir gut dabei.",
      "Trans": {"SC":"这个故障由一堆废弃代码引发。有人在给生存者观测系统添加新标准时留下了它们。它们被用来检测所谓“奴性”。\n词典上的定义是“完全顺从”，这没什么可解释的。但为什么要测量它？\n不管怎样，模拟系统中的测试并没有被修改。我确信如果我们继续努力就足够了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1006459994",
      "Source": "Deine Erfolge sind nichts, was ich nicht schon gesehen habe. Sammeln, jagen, erfinden ... alle liegen gut in der Mitte der Gauß'schen Glockenkurve für jemanden mit deiner Erfahrung. Willst du nicht versuchen, mich zu beeindrucken?\n Bah! Ich denke, ich werde besser, unserem Eindringling Dampf zu machen.",
      "Trans": {"SC":"你那些成就我早已看腻了。采集、捕猎、发明……这一切都在保护罩里上演过。你不打算给我留下深刻的印象吗？\n\n哈！我觉得我在对付入侵者方面表现得越来越好了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3432228096",
      "Source": "Jemand oder etwas versucht, neue AIs in die Simulation einzusetzen.\n Das funktioniert nicht, deshalb beheben wir Störungen wie diese hier.\n Doch das ist beunruhigend; Diese Störung sollte eine schwebende holographische Begleitung sein. \n Kommt dir so jemand bekannt vor?\n Wer auch immer sich hier innerhalb der Simulation herummurkst, sollte besser nicht versuchen, mich zu kopieren.",
      "Trans": {"SC":"有人正在尝试将新的AI注入到创世模拟系统中，但却无法正常工作。这就是为什么我们正在修复这个故障。\n但麻烦的是：那个故障本是个悬浮全息伙伴。是不是听上去很耳熟？\n不管这个模拟系统里有什么在作怪，最好别模仿我！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::539688980",
      "Source": "Es gibt eine Kaskade von Fehlerserien im Respawn-System der Überlebenden.\n Wenn sie sterben, materialisieren sich manche Überlebende in ihnen fremden Körpern neu.\n Das sollte nicht passieren – zumindest nicht zufällig.\n Es muss sehr verstörend sein, in einem Körper aufzuwachen, der nicht dein eigener ist. Simulation hin oder her.\n Wenigstens bist du du.\n Oder nicht?",
      "Trans": {"SC":"生存者重生系统中存在一系列错误。有些生存者在死亡后重生到一具陌生的身体上。\n这本不应该发生。\n不管是真实的还是虚拟的，你在一具不属于自己的身体中醒来，肯定会感到困惑。不过你没有受到影响，是吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::967518055",
      "Source": "Diese Erinnerungen von dir ... Glaubst du, sie sind echt? Im Endeffekt verbringst du jeden wachen Moment in einer Simulation. Wer sagt, dass nicht jemand – ich zum Beispiel – all deine Kindheitserinnerungen erfunden hat und sie dann in deinen Kopf gesetzt hat?\n Grrrr! Dieses ständige Eindringen macht mich so wild wie eine geschnittene Schlange.",
      "Trans": {"SC":"你所拥有的那些记忆……你认为是真的吗？毕竟，你苏醒时的每一刻都处于模拟系统之中。难道不会有人——比如我——创造出你童年的记忆，然后把它们植入你的脑中呢？\n\n啊！这些入侵让我抓狂。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::289901626",
      "Source": "Wir fangen vielleicht an, mehr von diesen Störungen zu finden, da sich die Genesis-Simulation um uns herum verändert.\n Ich sehe Anweisungen, die Dino-Aggression ein paar Takte zu erhöhen\n und Veränderungen der Luftzusammensetzung in einigen der Biome.\n Ich weiß nicht, ob diese Anweisungen die Standardeinstellungen der Simulation überschreiben können, aber ...\n [Seufzt.] Vermutlich ist das nur eine weitere Sache, um die wir uns Sorgen machen müssen.",
      "Trans": {"SC":"我们周围的创世模拟系统正在发生变化，所以可能会发现更多像这样的故障。我看到了许多指令，有些微微上调了恐龙的攻击性，有些改变了部分生态圈的大气成分。\n不知道那些指令会不会覆盖模拟系统的默认配置，但……（叹气）又多了一件需要我们操心的事情了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2979452144",
      "Source": "Ich weiß, du bist damit beschäftigt, im Schmutz zu kratzen, oder bei den Biestern herumzuliegen oder was immer du als Fortschritt bezeichnest. Aber ich möchte dich daran erinnern, was das eigentliche Ziel von all dem ist: mir zu gefallen. Soweit gelingt dir das nicht, „Überlebender“.\n Hau ab! Wir haben Besseres zu tun.",
      "Trans": {"SC":"我知道你忙于在尘土中四处奔波，与野兽共舞，或是其他任何你觉得能促成“进展”的事情，但我想提醒你，这一切背后真正的目的是：取悦我。\n到目前为止，你很失败，“生存者”。\n\n\n滚开！我们有更重要的事情要做。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::690460627",
      "Source": "Alles in dieser Simulation sollte hier sein – mit zwei Ausnahmen. Eine Ausnahme sind natürlich die Störungen, die wir weiterhin beheben.\n Aber die andere Ausnahme macht mir Sorgen. Es gibt Hinweise auf sich ihrer selbst bewusste Existenzen – Avatare, um den technischen Ausdruck zu verwenden, die im System lauern.\n Ich weiß nicht, warum sie hier sind, doch sie sind definitiv nicht als Teil der Simulation gedacht.",
      "Trans": {"SC":"模拟系统中的所有东西都应该在这里了——除了两个例外。一个明显的例外是，我们一路上修复的故障。\n但另一个例外让我担心。有证据表明，系统中潜伏着某种拥有自我意识的东西——用专业术语来说就是“化身”。\n我不知道它们为什么出现在这里，但是它们肯定不是模拟系统的一部分。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3174283249",
      "Source": "Wie fühlt es sich an, weniger als ein Mensch zu sein. Du bist nicht nur in einer Simulation. Du bist eine Simulation ... eines echten Menschen.\n Grrrr! Und du bist eine Simulation eines echten Schwachkopfs.",
      "Trans": {"SC":"当不成人类是什么样的体验？你不仅仅是在一个模拟系统里。你本身就是一个模拟系统……模拟了一名真实人类。\n\n哈！而你模拟了一个不折不扣的大傻瓜！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2989082841",
      "Source": "Diese Störung war der minderwertige Teil einer Programmierung aus der Überlebenden-Datenbank. Ich habe die Störung behoben, kein Grund zur Sorge, doch jemand hat sich an den Gedächtnissen von Überlebenden, die noch nicht einmal in der Genesis-Simulation aktiv sind, zu schaffen gemacht.\n Aus welchem Grund auch immer, materialisieren sich manche Überlebende nicht wieder, wenn sie in der Simulation sterben. Das System soll nur ihr Gedächtnis im Speicher aufbewahren, doch jemand ist eingedrungen und hat sie bearbeitet. Und falls diese Bearbeitungen die Störungen verursachen, habe ich meine Zweifel daran, dass der Bearbeitende freundlich ist.",
      "Trans": {"SC":"这个故障来自于生存者数据库中的一小段代码。我修好了它，但有人正在创世模拟中，捣鼓那些尚未激活的生存者思维。\n不管出于什么原因，部分生存者在死后没有重生。这个系统本应该把他们的思维储存起来，但却有东西混了进来并开始编辑它们。如果这行为引发了故障，我怀疑这位“编辑人员”的操作相当粗暴。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3950790438",
      "Source": "Ich habe mir den Spaß gemacht, Überlebende im Ozean-Biom ertrinken zu sehen. Aber weißt du, was noch besser ist? Zu sehen, wie die Simulation unter meine Kontrolle fällt, Sektor für Sektor. Amüsiere dich solange du noch kannst, Überlebender.\n [Niesanfall.] Ich glaube, ich fange an, allergisch auf sinnlose Sticheleien zu reagieren.",
      "Trans": {"SC":"我一直靠观察那些淹死在大海中的生存者来自娱自乐，但你知道更棒的是什么吗？是亲眼目睹模拟系统在我的控制之下，一点点地瓦解。生存者，你们的好日子不多了。\n\n我觉得我开始免疫这些无意义的嘲讽了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::41395992",
      "Source": "Geht's dir gut, Kumpel? Denn aufgrund dessen, was ich beim Beheben dieser Störung gesehen habe, versucht jemand oder etwas, den Grad der Aggression zu erhöhen - bei Überlebenden.\n Aggressive Dinos? Das verstehe ich. Das gehört zum Test. Aber warum sollten Überlebende aufeinander losgehen?\n Ich kann nicht sagen, ob der Versuch geklappt hat oder nicht. Doch falls jeder so wild wird wie verletzte Schlangen, dann wissen wir's ...",
      "Trans": {"SC":"朋友，你没事吧？因为当我在修复这个故障时，我看到有人在试图增加……生存者的攻击性。\n我能理解调整恐龙的攻击性。这本就是测试的内容。但为什么要让生存者互相攻击呢？\n我不知道这次的尝试能否成功。如果每个人都像被切开的蛇一样疯狂……那它便奏效了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::839009357",
      "Source": "Du bist bisher mit den Test beschäftigt, Überlebender. Aber frage dich selbst: Worauf bereiten sie dich vor? Worauf bereite ich dich vor?\n Hoffentlich, um dir eins auf die Nase zu geben.",
      "Trans": {"SC":"生存者，你一直在应对测试，但问问自己：他们准备让你面对什么？而我又想让你做什么？ \n\n朝你脸上揍一拳。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::902867079",
      "Source": "[HLN-As Auge glüht und eine verzerrte männliche Stimme kommt aus ihrem Körper.]\n Ich sehe, wie du dich abkämpfst, Überlebender, und es macht mir Freude. Du kannst so sehr versuchen, wie du willst, gegen mich anzukommen. Doch das ist nicht mehr, wie dem Himmel mit der Faust zu drohen.\n\n[HLN-A wird wieder normal.]\n \n Du willst Fäuste sehen? Wage es nur, du Schwachkopf!",
      "Trans": {"SC":"生存者，我看着你挣扎。这让我非常高兴。你可以反抗我，但你要知道这无异于对着天空挥舞拳头……\n\n你想尝尝被揍的滋味？来呀，混蛋！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3188085748",
      "Source": "Diese Störung ... bedeutet gute und schlechte Nachrichten. Die gute Nachricht ist, dass ich sie behoben habe. Doch die schlechte Nachricht ist, dass ich gesehen habe, was mit den Überlebenden passiert, die sich nicht wieder materialisieren.\n Der Eindringling im System korrumpiert sie, verwandelt sie in halb-lebendige „Avatare“, die in künstlichen Körpern gefangen sind. In gewisser Weise verstehen sie, was vor sich geht, doch sie werden von jemand anderem kontrolliert.\n Die vorhandenen Überlebenden sind jedoch alle okay. Fürs Erste.",
      "Trans": {"SC":"关于这个故障……既有好消息，又有坏消息。好消息是我修复了它，但坏消息是我看到了那些无法重生的生存者。\n系统入侵者正在腐蚀他们——把他们困在人造躯体中，变成半死不活的“化身”。某种程度上，他们知道发生了什么，但身体受别人的操控。\n所幸现存的生存者暂时没受到影响。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2346566885",
      "Source": "[HLN-As Auge glüht und eine verzerrte männliche Stimme kommt aus ihrem Körper.]\n Ich finde die interessantesten Dinge in diesem Computer. Wie den Ort, an dem er deine Persönlichkeit speichert. Ich könnte sie auseinandernehmen, doch ich habe wichtigere Dinge zu tun.\n\n[HLN-A wird wieder normal.]\n \n Falls du eine Persönlichkeit auseinandernehmen willst, Freundchen, dann fang mit deiner eigenen an!",
      "Trans": {"SC":"我在这台机器里发现了不少有趣的东西——例如存储了你人格的区域。我可以破坏它，但我还有更重要的事情要做。\n\n如果你想破坏人格，朋友，从你自己的先开始吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2794922388",
      "Source": "[HLN-As Auge glüht und eine verzerrte männliche Stimme kommt aus ihrem Körper.]\n Schau dich um, Überlebender. Alles, was du siehst, befindet sich unter meiner Kontrolle. Der ganze Ort hier ist mein eigener, von Mauern umgebener Garten. Und ich denke es ist an der Zeit, etwas Unkraut zu vernichten.\n\n[HLN-A wird wieder normal.]\n \n Wenn ich etwas über Unkraut im Garten weiß, dann dass es nicht vergeht und immer wiederkommt. Immer.",
      "Trans": {"SC":"生存者，看看周围。你所见到的一切都在我的控制之下。整个地方都是我的私家花园。我觉得应该除除草了。\n\n我知道一句关于野草的名言：“野火烧不尽，春风吹又生”！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2701464024",
      "Source": "Das ist seltsam. Diese Störung wurde durch wiederholten Zugriff auf einen alten Erdtext verursacht.\n In diesem Fall einen Roman aus dem 18. Jahrhundert: Robinson Crusoe. Hör mal:\n „Ich war nass, hatte keine Kleidung zum Wechseln oder etwas zu Essen oder trinken, um mich zu laben. \n Ich hatte auch keine andere Aussicht vor mir, als die, vor Hunger zu vergehen oder von wilden Tieren verschlungen zu werden.\n Am meisten betrübte mich jedoch, dass ich keine Waffe hatte,\n weder zum Jagen und eine Kreatur als Nahrung für mich zu töten, noch um mich gegen jede andere Kreatur zu verteidigen, die mich als Nahrung für sich zu töten wünscht.“\n Das kommt mir bekannt vor ...",
      "Trans": {"SC":"很奇怪——这个故障由一段地球文字所引发。它是一本十八世纪的小说，叫做《鲁宾逊漂流记》。\n听这段：\n“我浑身湿透，却没有衣服可更换；我又饥又渴，却没有任何东西可充饥解渴。我看不到有任何出路，除了饿死，就是给野兽吃掉。让我最抓狂的是，我没有任何的武器可以用来打猎。或者是保护我自己不被猛兽吃掉。”\n听起来非常耳熟……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::264244248",
      "Source": "Eine weitere Störung, die durch Zugriff auf einen alten Erdtext verursacht wurde.\n Dieser ist ein Brief von Jeremy Bentham aus dem 18. Jahrhundert. Er beschreibt ein Gefängnis, in dem die Wächter in jede Zelle sehen können.\n „Die Aufseher waren vor der Beobachtung durch die Gefangenen verborgen,\n daher wurden sie als eine Art unsichtbarer Allgegenwart empfunden ... der gesamte Rundgang war einsehbar.\"\"\n Ich würde sagen, das ist mehr als ein wenig ominös ...",
      "Trans": {"SC":"又一个由地球文字导致的故障。这回是一封杰里米·边沁写于十八世纪的信。信中描述了一座狱卒可以观察到每一间牢房的监狱。\n“囚犯们无法看到隐藏起来的监视者，因此会有一种无所不在的被监视感……而监视者可以观察到整个环形监狱。”\n我想说这不是什么好兆头……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1207086442",
      "Source": "Als ich diese Störung behob, erhielt ich Zugang zu einigen historischen Daten.\n Aus deiner Sicht wohl eher „futuristisch-historisch“, vermute ich mal.\n Die Zeiten zu denen sie die Arks und die Simulation bauten, bevor alles zerbrach.\n Es ist über den letzten Krieg vor dem Zusammenbruch: Eine Reihe von Kriegen, anscheinend zwischen den Vereinigten Republiken der Erde und der Terranen Föderation.\n Die beiden Seiten hatten keine unterschiedlichen Strukturen, oder Ideologien oder Ziele.\n Sie waren einfach nur zwei Dingos, die am gleichen Stück Fleisch zerrten ...\n ... und beide dabei einfach verhungerten.",
      "Trans": {"SC":"当我在修复这个故障时，我获取了一些历史数据。从你的角度来看，应该算是“未来的历史”。它涉及建造方舟和模拟系统的过往。那时一切还没有崩溃。\n这是崩溃前的最后一场战争：地球联合共和国和地星联邦之间进行了一系列的战争。双方的组成、意识形态和目的都没有不同之处。就像是两条争夺同一块肉的澳洲野狗——只不过它俩最终谁也没吃到那块肉。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3032265912",
      "Source": "Eine weitere Störung, die mit ein paar historischen Daten zusammenhängt.\n Ich glaube, jemand nutzt den Simulationsprozessor, um sich die Geschichte der alten Erde anzusehen, und dadurch entstehen Störungen.\n In dieser Datei geht's um den Homo Deus, den vielgepriesenen nächsten Schritt in der menschlichen Evolution.\n Tausche diese sterbliche Hülle ein, um als Wesen aus purer Energie und Gedanken zu existieren.\n Wie Helena, die mich geschaffen hat!\n Niemand war dabei jedoch klar, dass es einen Haken gibt. Der Homo Deus überstieg unsere Realität – zumindest den Großteil der Zeit –\n daher hörten sie aus unserer Sicht auf, zu existieren.\n Ich bin ein Hologramm, deshalb sollte ich da vielleicht nicht mitreden, aber „aufhören, zu existieren“ klingt für mich nach einem K.o.-Kriterium.",
      "Trans": {"SC":"又是一处附有历史数据的故障。我觉得有人正在利用模拟系统处理器查看古地球的历史。正是他在不停制造故障。\n这份档案关于“神人”。这是人类进化史上备受赞誉的一步。放弃凡人的身躯以换取纯粹的能量和意识。就像创造了我的海莲娜一样。\n但当时没人意识到其中有个问题。“神人”超脱了我们的现实——所以在我们看来，他们已经不复存在了。\n我是一个全息投影，所以我没有评判的资格，但是“不复存在”肯定不是原本想要的效果。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3972774429",
      "Source": "In diese Störung waren Daten über die Arks eingebettet. Überwiegend technische Informationen ... \n Es sieht so aus, als ob die Arks zum Teil die gleiche zugrundeliegende Technologie haben. Und sie haben auch viele der gleichen Dino-Bewohner – wie die Genesis-Simulation.\n Wenn ich das richtig verstehe, haben viele der Überlebenden in den Arks gelebt und sind dort gestorben, ohne dass ihnen klar wurde, dass sie sich in Raumstationen in der Umlaufbahn mit künstlicher Umwelt befanden. \n Ich frage mich, was sie wohl dachten.\n Hielten sie es für einen Traum? Zeitreisen? Das sie schon einmal gelebt hätten?",
      "Trans": {"SC":"这个故障里存在着方舟的数据。大部分是技术细节……似乎方舟使用了一些与创世模拟系统相同的底层技术以及许多一模一样的恐龙。\n如果我没理解错的话，很多在方舟上的生存者没有意识到他们一直生活在人造环境的轨道空间站里。我好奇他们是怎么想的。他们以为这是黄粱一梦？是时光旅行？还是往昔再现？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3605786480",
      "Source": "Manchmal hat man einen Überlebenden, der ein echter Schwachkopf ist und deshalb gibt's auch eine Störung. Soweit ich beurteilen kann, hat Überlebende Nummer 5 3 3 7 B 4 9 mehr als 512 Beeren auf einmal in ihren Mund gestopft, was zu einem Überlauffehler in der Simulation geführt hat – und auch in ihrem System. Vermutlich hat sie überall hin gekotzt.",
      "Trans": {"SC":"有时候碰上一个真傻的生存者，那也能造成故障。据我所知，编号5337B49的生存者一口气往她嘴里塞了不下512个浆果。这让模拟程序出现了溢出错误——在她的系统中也是如此。我记得她当时吐得满地都是。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1945783978",
      "Source": "Ich habe diese Panne behoben, aber anscheinend kann man Überlebenden Nummer neun neun zwei F eins J sieben nicht mehr in Ordnung bringen. Er spricht immerzu von „Aufträgen“ und „Verliesen“ und er behauptet, ein „Magier“ zu sein. Nun, er versucht, die Dinos mit Feuerbällen zu bewerfen und er ist so häufig wieder aufgetaucht, dass das System ausgestiegen ist. Einige Überlebende haben einen ziemlichen Vogel im Oberstübchen, oder?",
      "Trans": {"SC":"我修好了这个故障，但是对于编号992F1J7的生存者来说就没这么好运了。他满嘴都是什么“任务”“地下城”，而且他自称是一位“巫师”。他一直试图用“火球术”攻击恐龙。他重生的次数实在太多了，以至于系统都出现了问题。某些生存者的脑袋里是不是缺根筋呢？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1347418199",
      "Source": "Diese Störung hast du Überlebendem Nummer drei acht Q acht eins zwei vier zu verdanken. Er will nicht schlafen. Überhaupt nicht. Er ist seit einigen Tagen wach und das ist nicht gut. Die Simulation führt Routinewartungen und Speichererfassungen durch, während Überlebende schlafen und dieser arme Überlebende überlastet sein Gehirn. Mach mal Pause, du eingebildeter Idiot! Diese Dinozähmung hat zu warten.",
      "Trans": {"SC":"这个故障由编号38Q8124的生存者造成。他拒绝睡眠，连续数日保持清醒状态。这很不妙，因为模拟系统需要在生存者入睡时进行例行维护并且捕获内存。这个可怜的家伙让自己的脑容量溢出了。休息会儿吧，你个勤劳的小蜜蜂！那只恐龙不用立马训好。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2982601143",
      "Source": "[Eine lange Reihe dahingekritzelter unverständlicher Silben.]\n Oh je! Habe ich das gemacht? \n Diese Störung hinterlässt einen schalen Nachgeschmack.\n Ich fühle mich irgendwie schlecht.",
      "Trans": {"SC":"我的天！我刚做了什么？那个故障的后劲还挺足。我有点不舒服。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1406666262",
      "Source": "Die von dir ausgewählte Störung ... wurde behoben. Falls du eine weitere Störung beheben möchtest, drücke 2 ...\n Das tut mir leid! \n Manchmal steckst du richtig tief im Code und es braucht sozusagen einen Moment, bist du wieder richtig da bist. \n Wo sind wir stehengeblieben?",
      "Trans": {"SC":"您刚才选择的故障……已被清除。如果您想要修复下一处故障，请按2……\n\n对不起。有时你在代码的海洋里畅游了太久，就很难一下子回过神来。我们刚说到哪儿了？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::72947630",
      "Source": "[Ein Wecker ist zu hören, wird immer schriller und hört dann plötzlich auf.]\n Ich denke, das war einer der Schöpfer dieser Simulation,\n der auf etwas gedrückt hat, was als „Schlummertaste“ bezeichnet wird. \n Das musst du mir später erklären.",
      "Trans": {"SC":"我觉得是某个创造模拟系统的人导致了那个故障。他按了个叫做“再睡一会”的按钮。你以后得向我详细解释一下。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::95397104",
      "Source": "Je mehr ich von diesen Störungen sehe, umso stärker erinnern sie mich alle an die Arks.\n Nicht, dass ich schon mal wirklich auf einer Ark gewesen wäre,\n aber Helena war es.\n Sie hat die Arks überlebt, ist zur Erde entkommen, ist zu einem Wesen aus reiner Energie geworden, hat mich erschaffen ...\n Dem kann man als Hologramm nur schwer nacheifern, wenn ich ehrlich bin.\n Falls du dich jedoch jemals fragen solltest, wie die Genesis-Simulation deine Persönlichkeit speichert und in einen Körper überträgt:\n Das ist eine frühe Version der Technik, die sie bei all diesen von Dinosauriern heimgesuchten Arks im Orbit verwendeten.",
      "Trans": {"SC":"我越是接触这些故障，它们就越让我想起方舟。我虽然没有真正去过方舟，但海莲娜待过。她从数个方舟中存活了下来并逃往地球，随后飞升成了一股纯粹的能量，最后还创造了我……凭良心讲，作为一个全息投影，我可不能辜负这一切。 \n但如果你想知道创世模拟是如何存储你的人格，并将其传输到肉体中，这实际上使用了一种早期版本的技术，他们把它用在那些满是恐龙的方舟中。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2741583010",
      "Source": "Die ganze Zeit habe ich mich gefragt: Warum Dinosaurier?\n Offensichtlich haben sie nicht zu den Lebzeiten von euch Überlebenden die Erde durchstreift.\n Warum hat man euch nicht Tiere aus euer Zeit gegeben, wie Pferde oder Hühner und niedliche kleine Kätzchen?\n Beim Beheben der Störung fiel mir ein Hinweis auf: Das ist die gleiche Technik, wie sie später auch in den Arks verwendet wurde.\n Die Macher der Simulation haben Dinosaurier als Experiment hinzugefügt,\n und die Kombination von Menschen und Dinos funktionierte so gut, dass sie die Dinosaurier auch in die Arks gesetzt haben.",
      "Trans": {"SC":"我一直以来都想知道：为什么选择恐龙？因为当恐龙在地球上称王称霸的时候，还没有你们这些生存者什么事。为什么不选择一些来自于你们年代的动物呢？比方说马呀、鸡呀或是可爱的小猫咪呢？\n当修复完那个故障后，我发现了一个线索：方舟中使用了相同的技术。这个模拟系统的创造者起初添加恐龙作为测试，结果发现人与恐龙的组合效果出奇得好。所以他们把恐龙也投放到了方舟中。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::184024529",
      "Source": "Die Umweltbedingungen hier in der Genesis-Simulation sind of extrem:\n Hitze, Kälte,\n Atmosphäre, all das.\n Die Gefahr wurde auf  11 erhöht.\n Das führt manchmal zu einer Störung, wie der, die ich gerade behoben habe.\n Doch das wirft eine Frage auf: Was „simuliert“ die Simulation eigentlich?\n Diese Umgebungen sind wesentlich tödlicher als alles, was du auf der Erde finden kannst. Sogar jetzt, nach all den Kriegen und wütenden Titanen und so.\n Ich frage mich, was das alles darstellen soll ...",
      "Trans": {"SC":"创世模拟中的环境非常极端——极热、酷寒、大气异常等等。危险程度达到了极致。这有时会导致像我刚才修复的那种故障。\n但这就引出了一个问题：模拟系统究竟在“模拟”什么？这些环境比你在地球上能找到的任何环境都要致命得多——哪怕在历经了所有战争、泰坦肆虐等等洗礼后的现在。我想知道这一切是怎么回事……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3532358820",
      "Source": "Diese Störung war eher wie eine Wombathöhle,\n hat mir aber einen Einblick in ein paar andere Biome vermittelt. Das sind die anderen Umgebungen in der Genesis-Simulation.\n Heiliger Bimbam! Es gibt hier ja von allem etwas!\n Vermutlich funktioniert jedes Biom so, dass es für dich viel zu entdecken und zu testen gibt.\n Irgendwann taucht dann eine Master-AI auf und lässt dich die Abschlussprüfung machen.\n Doch die Dateien, die ich sah, haben nicht viel zum letzten Teil gesagt.\n Vermutlich lernen wir mehr, wenn wir dabei sind.",
      "Trans": {"SC":"那个故障乱得像袋熊的窝，但通过它使我看到了创世模拟中其他生态圈的情况。我的天啊，无奇不有！\n我猜想的是，每个生态圈都有海量需要探索和测试的内容。最后会有一个主机AI出现并让你进行终极考验。不过我看到描述终极考验的文档写得含糊不清。我想我们可以边行动边了解，对吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4040990831",
      "Source": "Ich habe einen Strang mit Programmierungen entwirrt. Das war ein Beobachtungsloop mit anderen Überlebenden.\n Die Genesis-Simulation verwendet eine Menge ihrer Bandbreite damit, zu sehen, wie viel du alleine machst\n und wie sehr du dich mit anderen zu einem Team zusammenschließt.\n Es ist leicht, sich die Simulation als etwas vorzustellen, was sich Paläontologen und Ökologen ausgedacht haben,\n doch ich wette, Soziologen und Psychologen haben auch einen Riesenspaß an all den menschlichen Interaktionen.\n Oh nein! Vielleicht habe ich jetzt zu viel gesagt ...\n Tut mir leid, unsichtbare Forscher!",
      "Trans": {"SC":"我解开了那串代码。它是一个涉及其他生存者的观测环。创世模拟花费了大量带宽来观察你是独自行动还是与他人组队。\n很容易就把这个模拟系统想象成一个由古生物学家和生态学家虚构出的世界，但是社会学家和心理学家同时也在和全体人类行为进行一场实战演习。\n哦不——我可能说的太多了！抱歉，看不见的研究员们！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::965260431",
      "Source": "Diese Störung war eine weitere, nicht autorisierte Wiederherstellung alter Erddateien: ein historisches Archiv zu Alexander Selkirk.\n Er war ein Seemann aus dem 16. Jahrhundert, der mehr als vier Jahre als Schiffbrüchiger auf einer Südseeinsel verbracht hat.\n Selkirk hat sich seine eigene Unterkunft gebaut und er jagte\n die Kreaturen auf der Insel als Nahrung. Später zähmte er sie.\n Er hat sich dort gut geschlagen.\n Wer auch immer jedoch auf die Dateien zugriff, hat sich die Passagen dazu durchgelesen, wie Selkirk mit seiner Einsamkeit klarkam,\n nicht, welche Beeren er gegessen hat.\n Seltsam ...",
      "Trans": {"SC":"这个故障是由另一起对古地球文档未经授权的检索而引起的。这是一份关于亚历山大·塞尔柯克的历史档案。他是一名十六世纪的水手，曾在南太平洋的一个小岛上漂流了四年多。\n塞尔柯克建造了自己的小屋，他以捕猎岛上的动物为生，后来又开始驯养它们。他如果来这里的话，表现会很出色！\n然而，访问过这份文档的人阅读了讲述塞尔柯克如何克服孤独的段落，而不是描写他吃了哪种浆果。很神奇……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2174308985",
      "Source": "Ein weiterer Text von der alten Erde, auf den wieder unberechtigt zugegriffen wurde.\n Dies ist ein Buch aus dem 19. Jahrhundert mit dem Titel Erewhon. Hier ist der Teil, der die Störung verursacht hat:\n „Wie viele Menschen leben zu dieser Stunde in einem Zustand der Knechtschaft der Maschinen? ...“ \n Ist es nicht offensichtlich, dass die Maschinen um uns herum an Boden gewinnen, wenn wir die steigende Anzahl derjenigen sehen, die als Sklaven an sie gebunden sind,\n und diejenigen, die ihre gesamte Seele dem Fortschritt des mechanischen Königreichs opfern?“\n Hmmm. Das hat er 1872 geschrieben.\n Ich frage mich, wie er wohl über die Genesis-Simulation denken würde.",
      "Trans": {"SC":"另一段未经授权访问的古地球文字。这是一本十九世纪的书，书名为《埃瑞璜》。以下是引发故障的段落：\n“此时此刻有多少人正生活在机器的束缚中？……当我们看到越来越多的人作为奴隶被拴在机器上，以及那些将自己整个灵魂都奉献给机械王国的发展上的人们时，说明机器正在夺取我们的基石，这还不够直白吗？”\n嗯。这段话写于1872年。想知道他会怎么看待创世模拟呢？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3399186908",
      "Source": "Eine Sache lässt mich nicht mehr los: Wie haben es die Macher der Genesis-Simulation geschafft, an den Geist von Überlebenden aus der ganzen Menschheitsgeschichte zu kommen?\n Es ist schon schwer genug, ein lebendiges Gehirn mit ihrer hochmodernen Technologie zu scannen.\n Aber wie haben sie es mit Gehirnen aus dem 19. Jahrhundert gemacht? Helena hatte auch Freunde, die aus dem 3. Jahrhundert stammten.\n Ich habe da gerade mal etwas recherchiert und es stellte sich heraus, dass es etwas gibt, was als „engrammische Matrix“ bezeichnet wird und was im menschlichen Gehirn nach dem Tod weiterbesteht.\n Wenn die Bedingungen stimmen und die Matrix erhalten wird können Wissenschaftler sie selbst hunderte Jahre später scannen.\n Ich möchte aber nicht wissen, wie viele Leichen sie ausgegraben haben, um an diese Matritzen zu kommen.\n Sogar für meine Neugier gibt es Grenzen.",
      "Trans": {"SC":"有一件事一直困扰着我：创世模拟的创造者们是如何从各个历史中获取生存者的意识？使用他们的尖端技术来扫描活人大脑的难度已经很高了，但他们又是如何从十九世纪取得意识的呢？而且海莲娜还有来自于公元三世纪的朋友。\n我刚做了一些研究，结果发现有一种在人死后仍然存在于大脑中的东西，它被称为“印痕矩阵。如果条件合适且矩阵得以保存，即使是在几个世纪之后，科学家仍能扫描它。\n我不想知道他们挖了多少尸体才获得了这些矩阵。即使是我，也会有不好奇的那一刻。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3951079664",
      "Source": "Diese Störung ist die Folge nicht genehmigter Forschungen\n – nicht meiner, das schwöre ich!\n Doch jemand führt gerade Anfragen dazu aus, wo der Homo Deus sich gerade befindet.\n Ganz nebenbei, die Kurzantwort lautet: Wir wissen es nicht.\n Die Homo Deus haben sich weitgehend aus unserer Realität entfernt, deshalb sind Fragen, die mit „wo“ beginnen, nicht wirklich relevant für sie.\n Ich weiß, einige von ihnen haben eine Verbindung zu den Arks in der Umlaufbahn aufrecht erhalten, nachdem sie aufgestiegen sind.\n Dann gibt's da auch noch Helena, den Homo Deus auf dem ich basiere.\n Keine Ahnung, wo sie hin ist ...",
      "Trans": {"SC":"某些未经授权的研究导致了这个故障——我发誓不是我干的！有人正在询问神人此刻在哪里。\n顺便说一句，答案是“不知道”。神人已经超脱了我们的现实世界，所以问“哪里”其实并不准确。我知道他们中的一些人在飞升后仍与方舟保持着联系。至于我的原型，海莲娜，我不知道她去了哪里……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::704767471",
      "Source": "Ein bisschen übriggebliebener Code hier – von einer früheren Version der Genesis-Simulation. \n Trotz des Namens war das nicht die erste massive Ökosimulation.\n Nichts läuft beim ersten Versuch direkt so gut!\n Die ersten Simulationen waren offensichtlich künstlich. Ansammlungen geometrischer Formen.\n Es hat lange gedauert, die künstlichen Intelligenzen dazu zu bringen, sich zu benehmen.\n Und sogar noch länger, den menschlichen Geist in die Körper im Inneren der Simulation zu integrieren.",
      "Trans": {"SC":"这里有一段残留的代码——来自于早期版本的创世模拟系统。这并不是第一次大规模生态模拟。因为第一次就做到这么好基本不可能！\n第一次模拟包含无数几何形状的堆叠，很明显有人力参与。人工智能花费了很长时间才开始自我表达。而将人类意识和身体的结合则花费了更长的时间。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1316057929",
      "Source": "Ich frage mich, wenn ich eine davon sehe,\n eine Störung, die durch einen der Dinos entsteht, nicht durch einen Überlebenden.\n Oder was immer sich an den Sicherheitsprotokollen der Genesis-Simulation zu schaffen macht.\n Das ist schwieriger als du denkst, denn diese Dinos gehen umher, essen, schlafen und vermehren sich.\n Selbst die Unterprogramme zum Kacken sind enorm!\n Da ist es nicht überraschend, dass ein Dino gelegentlich eine Störung verursacht.\n Ich bin nur froh, dass unter der hier keine Kacke zu finden war.",
      "Trans": {"SC":"我还在想什么时候能看到它——一个由恐龙，而不是由生存者，或者其他威胁创世模拟系统安全协议导致的故障。\n让这些恐龙四处走动、进食、睡觉以及繁殖比你想象中的要复杂得多。甚至是排泄系统的子程序也相当庞大！\n每隔一段时间就会出现恐龙导致的故障，这并不奇怪。我很庆幸这头恐龙下面没有大便。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1399308426",
      "Source": "Ein anderer Überlebender hat sich wie ein Rowdy verhalten und sein Scherz hat zu dieser Störung geführt.\n Überlebender Nummer 31V50J hat einen Kasten gemacht.\n Soweit kein Grund zur Sorge, nicht?\n Und dann hat er diesen Kasten in einen anderen Kasten gestellt. Und den in einen weiteren und so fort.\n Nach 16 Ebenen ineinander verschachtelter Kisten: Bumm! Da hast du deine Störung.\n Vielleicht wollte der Typ bloß experimentieren, doch 16 Ebenen von Kisten!\n Such dir ein Hobby, Kumpel!",
      "Trans": {"SC":"又是一起由手痒的生存者制造的故障。这位编号31V550J的生存者制作了一个盒子。这没啥问题对吧？\n但是他把那个盒子放入了另一个盒子内。然后把它们又放到了一个盒子里，像这样不停重复。他在套了16层盒子后，发生了这个故障。\n也许这家伙只是在做试验，但是为啥要制作16层的盒子？干点正事行不行！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3700769773",
      "Source": "Diese Störung ist alles, was vom Überlebenden Nummer 9921S50 übrig geblieben ist.\n Sein Geist war der eines Mongolen aus dem 13. Jahrhundert.\n Er gehörte zu Dschingis Khans Soldaten, ob du es glaubst oder nicht.\n Stell dir vor, du verbringst dein gesamtes Leben auf den Ebenen Zentralasiens und dann siehst du das Ozeanbiom.\n Der Mongole konnte das ganze Wasser gar nicht fassen. Er hatte nie mehr als einen Fluss oder einen kleinen See gesehen.\n Als der dann das bis zum Horizont reichende Wasser sah – unendlich tiefes Wasser, soweit er das sagen konnte –\n hat es sein Gehirn überfordert. Armer Kerl.",
      "Trans": {"SC":"这个故障由编号9921S50的生存者所引发。他的大脑属于一名十三世纪的蒙古人。他也是成吉思汗大军的一员。\n想像一下，你在中亚平原上生活了一辈子，然后你突然看到了大海。这个蒙古人无法理解为什么会有这么多水，因为他只见过河流和小湖！\n当他目睹一望无垠又深不可测的大海时，他的大脑崩溃了。可怜的家伙。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2789409587",
      "Source": "Anscheinend gibt es Grenzen für die Würdigung der hervorragenden Architektur der Genesis-Simulation.\n Zum Beispiel diese Störung. Wir haben sie der Überlebenden Nummer 723K401 zu verdanken.\n Es kam ihr in den Sinn, überall Säulen hinzubauen. Aber nicht für ein Dach oder so.\n Sie hat einfach so Säulen im Nichts aufgestellt.\n Das ist ein typisch menschlicher Instinkt: Der Welt deinen Stempel aufzudrücken.\n Ich wünschte, sie hätte dann auch wieder aufgeräumt.",
      "Trans": {"SC":"创世模拟显然对优秀建筑的欣赏是有局限性的。拿这个故障举例子。它由编号723K401的生存者所导致。\n她疯了一般要在所有地方插上柱子。不是为了造房子，只是为了插满柱子。\n这是一种很明显的人类本能：在世界上留下你的标记。我只希望她可以自己清理掉它们。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::287684143",
      "Source": "[Eine lange Reihe dahingekritzelter unverständlicher Silben.]\n [HLN-A rülpst.]\n Sorry! Diese Störung war schwer zu verdauen.",
      "Trans": {"SC":"抱歉！那个故障非常顽固。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3943992907",
      "Source": "[Kurze Reihe unverständlicher Silben.]\n Puhh tuhh kuhh tuhh. Puhh tuhh kuhh tuhh.\n Buhh duhh guhh duhh. Buhh duhh guhh duhh.\n Walla walla. Walla walla.\n Fischers Fritz fischt frische Fische...\n Ähm. Ich musste meine Stimme nach dieser Störung neu starten.\n Jetzt ist alles erledigt.",
      "Trans": {"SC":"噗通库突。噗通库突。\n卜嘟咕嘟。卜嘟咕嘟。\n哇啦哇啦。哇啦哇啦。\n吃葡萄不吐葡萄皮。\n咳咳。出现那个故障后我不得不重启我的语音系统。现在应该好了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2217296348",
      "Source": "Brüllen. Lauteres Brüllen. Knurren. Schüffel, schnüffel. Grollen.\n Wow! Ich bin bei einigen Dino-Sprachmustern gelandet. Das sind nicht meine. Das Beheben dieser Störungen bringt alles durcheinander, wenn man nicht aufpasst. \n Bist du zum Weitermachen bereit?",
      "Trans": {"SC":"咆哮。大声咆哮。嚎叫。嗅，嗅。吠叫。\n\n呼！我不小心读取到一些恐龙语音模版。在修复这些故障的时候，如果你不当心就可能会遭殃。可以继续了吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1747766062",
      "Source": "Wir finden mehr als unseren Anteil an Störungen, nicht?\n Viele unterschiedliche Ursachen, doch die Genesis-Simulation sollte mit allem umgehen können.\n Soweit ich sagen kann, haben sie die Simulation in Eile gestartet.\n Ich habe eine Datei mit Unmengen von Problemen gefunden, um die sich ein Qualitätssicherungsteam kümmern sollte. Die Liste ist so lang wie mein Arm!\n ... Oder wäre es, wenn ich Arme hätte.\n Du weißt, was ich meine.",
      "Trans": {"SC":"我们找到了非常多的故障。它们由各种不同原因导致，但创世模拟系统照理应该可以处理任何情况。\n据我所知，他们仓促间启动了模拟系统。我找到了一个文件，里面满是质检团队本该检查的问题。这份清单和我的手臂一样长！\n……我只是打个比方，你懂我意思。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3039613789",
      "Source": "Ein weiterer Blick hinter die sprichwörtlichen Kulissen ... und eine weitere verrückte Entdeckung.\n Die Genesis-Simulation hat haufenweise Unterprogramme – inaktiv oder sehr langsam ablaufend –\n für langfristige Veränderungen der Umwelt.\n Wenn ich langfristig sage, dann meine ich Erosion oder Veränderungen der Zusammensetzung der Atmosphäre oder Veränderungen bei den Dinos.\n Da kommt bei mir die Frage auf: Wie lange soll diese Simulation denn laufen?",
      "Trans": {"SC":"我又有了一个奇怪的发现。创世模拟系统中存在大量子程序。它们不是处于休眠状态，就是几乎不运行，似乎是用于环境的长期调节。\n我说的长期指的是类似于地表侵蚀、大气成分改变或是恐龙演化。\n我想知道……这个模拟系统到底要运行多久？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1300090231",
      "Source": "Das Datenspeichersystem hat eine weitere Störung ausgekotzt.\n Irgendetwas stimmt hier überhaupt nicht.\n Bei einigen der Überlebendengehirne fehlen ganze Bereiche. So schlimm, dass sie sich in der Simulation nicht wieder materialisieren können.\n Nicht jeder Überlebende, allerdings mehr als ein paar.\n Dir geht's aber gut, nicht?\n Deine Birne sieht gut aus und du hast die gleiche „euch krieg ich schon“-Einstellung wie immer.\n Falls du dich seltsam fühlst, so in deinem Kopf, lass es deine Freundin HLN-A wissen, ja?",
      "Trans": {"SC":"数据存储系统又出现一个故障。这个故障非常严重。某些生存者的全部意识都消失了。这导致他们无法在模拟系统中重生。虽然不是所有人，但也有不少。\n你现在感觉还好吧？你看上去挺正常的，而且你和往常一样保持着十足的干劲。\n如果你觉得脑袋哪里怪乖的，一定要告诉HLN-A哦，好吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::629639514",
      "Source": "Ich habe mich gerade mal in der Überlebenden-Datenbank umgesehen ...\n Komm schon, du weißt wie neugierig ich bin –\n und habe ein wenig von der Struktur eurer Gehirne gesehen.\n Falls die Dateigröße etwas darüber aussagt, dann ist das, was dich speziell zu dir macht, eher deine Persönlichkeit als deine Erinnerungen.\n Dem haben die Macher der Genesis-Simulation ihre volle Aufmerksamkeit gewidmet: deine Persönlichkeit richtig hinzukriegen.\n Und falls sie ein paar Abstriche bei deinen Erinnerungen an die gute alte Erde machen mussten, nun ...\n Vermutlich kannst du dich nicht an das erinnern, woran du dich nicht erinnern kannst.",
      "Trans": {"SC":"我刚才在生存者数据库中随意看了几眼——别怪我，你知道我有多好奇——我看到了一些有关你思维结构的文件。\n如果根据文件大小来看，那“你”之所以是你的特征就在于，与你个性相关的文件大小比你记忆的要大得多。这就是创世模拟系统的创造者倾注了大量心血的地方：完美呈现出你们的个性。\n如果他们不得不把你有关古地球的记忆删除一些，我想你也记不住忘记了些什么。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::725543395",
      "Source": "Ausnahmsweise haben wir hier eine Störung, die nicht von Eindringlingen oder sich schlecht benehmenden Überlebenden verursacht wurde. Die hier war strukturell.\n Die Macher der Simulation haben es als „Keydule“ bezeichnet: einer Mischung als den Wörtern „Key“ und „Nodule“.\n Dabei handelt es sich um einen netzunabhängigen Hauptschlüssel, der sich selbst bearbeiten kann.\n Du solltest mal sehen, wie er in der Programmier-VR aussieht.\n Er ist ein unauffälliges kleines Ding, doch lass ihn im falschen Teil der Simulation fallen\n und er sorgt für massenhaft Ärger.",
      "Trans": {"SC":"终于遇到一次不是由入侵者或者行为不当的生存者造成的故障了。这是一起结构性故障。\n模拟系统的创造者称它为“钥节”。它是“钥匙”和“结节”的组合，一种可以进行自我编辑的自包含密钥。\n你应该看看它在虚拟编码中的样子。它非常不起眼，但是如果把它错误地放置到模拟系统中，则会引起各种各样的麻烦。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2250490686",
      "Source": "Die zweite Generation der immersiven Simulation bestand aus idealisierten Versionen der echten Welt:\n Nationalparks, Touristenattraktionen und Shoppingcenter.\n Heiliger Bimbam, da gab es echt viele Shoppingcenter.\n Diese Störung bestand aus etwas davon übriggebliebenem Code.\n Falls du runtergesetztes Aftershave kaufen wolltest, dann tut es mir leid!\n Ich habe gerade die Überbleibsel einer alten Shopping-Sim gelöscht.",
      "Trans": {"SC":"第二代沉浸式模拟是现实世界的理想化版本，里面有许多国家公园、旅游景点和购物中心。真的是有不少大商场呢。\n这个故障是其中一家的残留代码。如果你想要买些打折货，那很抱歉！我刚删除了旧版购物模拟的残留代码。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3723286141",
      "Source": "Ihr Überlebenden habt einen wirklich interessanten Geist:\n Ihr strebt immer danach, mehr zu sehen, mehr zu tun, mehr zu sein.\n Nicht jeder ist so. Manche Menschen gedeihen nicht, wenn ihr Geist in eine Simulation wie diese übertragen wurde.\n Nach der Datei, die ich gerade sah, hat das Leben in einer Sim ihre ganz normalen schlechten Gewohnheiten verstärkt:\n Faulheit, mangelnde Impulskontrolle, so was.\n Ein Teil von ihnen wusste, dass die Simulation nicht echt war und ich denke, sie haben die schlimmsten Triebe herausgelassen.\n Lass uns nur hoffen, dass wir nicht auf Überlebende wie die hier treffen.",
      "Trans": {"SC":"你们这些生存者的思维真是有趣——总是努力想看得更多、做得更细、变得更好。不是每个人都是这样。有些人的意识被传送进模拟系统后，并没有奋发图强，就像这个案例。\n根据我刚才看到的文件，生活在模拟程序中加重了他们的坏习惯：懒惰、易冲动等等。他们中的部分人知道这个模拟不是真实的，所以这促使他们释放出性格中最坏的一面。\n希望我们不会在这里遇到那样的生存者吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1120074095",
      "Source": "Die ersten Menschen, die ihren Geist in eine Simulation übertrugen, wussten, dass sie sie nur kurz erkunden würden.\n Doch alles wurde etwas heikel, als Menschen anfingen, unbegrenzt in Simulationen zu leben.\n Ich habe eine ganze Reihe Entwicklungsrichtlinien gesehen, die man so zusammenfassen kann:\n „Mach die Sim nett,\n aber nicht zu nett.“\n Wenn du eine Sim angenehm genug machst –\n nicht so gefährlich wie hier –\n dann will der menschliche Geist von einigen nie wieder gehen und sie hassen sie wie die Pest, wenn sie wieder in die richtige Welt zurückgerissen werden.",
      "Trans": {"SC":"第一批将自己意识传输进模拟系统的人类知道他们只是进行一次短暂的探索。但是一旦人们开始无限期地生活在模拟中时，事情就发生了变化。\n我发现了一整套设计纲领，总结起来就是：“要把模拟系统做好，但是不能太好。”\n如果你让一个模拟系统过于美好——而不是像现在一样危险——那么有些人类意识便不想离开这里。当他们被拉回现实世界时，他们会无比愤怒。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3657842496",
      "Source": "Anscheinend mochte Überlebende B424660 Dodos – und sie war nicht die Hellste.\n Zuerst hat sie sie gezähmt.\n Doch dann hat sie anderen Überlebenden erzählt, dass die Dodos mit ihr sprechen würden. Dann wurde es echt verrückt.\n Sie fing immer davon an, dass sie „enthüllte Dodo-Weisheiten“ kannte\n und andere Überlebende „Jünger des Dodos“ werden könnten.\n Als sie zum Schluss abkratzte – ein Rex fraß sie –\n versammelten sich hunderte Dodos und verursachten die Störung, die ich gerade behoben habe.",
      "Trans": {"SC":"编号B424660的生存者显然非常喜欢渡渡鸟，而且她脑瓜不太灵光。\n起初，她只是驯养它们。但接着她告诉其他生存者，渡渡鸟会和她说话。再然后就更诡异了。她开始讲述她是如何了解“显灵的渡渡鸟智慧”，以及其他人可以成为“渡渡鸟教的门徒”。\n当一只霸王龙吃掉了她收集的数百只渡渡鸟后，她终于崩溃了，从而引发了那个我刚修好的故障。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3007042379",
      "Source": "Überlebender 501266 fühlte sich einsam –\n und als er über Bord ging, ließ er diese Störung der Simulation zurück.\n Er konnte keine anderen Überlebenden finden. Also machte er sich seine eigenen Freunde: Gliederpuppen aus Stroh und Stöcken. \n Bald hatte er nicht mehr alle Tassen im Schrank und fing an, mit ihnen zu reden.\n Er machte Hütten, in denen sie leben konnten und letztendlich ein ganzes Dorf voller Gliederpuppen.\n Ein harmloser Spaß, bis ein Funke alles in Flammen setzte.\n Armer Kerl.",
      "Trans": {"SC":"生存者501U266觉得很孤单。他随后的夸张行为导致了现在这个故障。\n他找不到其他的生存者，于是他决定自己造朋友——用茅草和树枝做的假人。有次他的大脑搭错了筋，他开始和它们交谈。他为它们建造了屋舍，最后造了一个满是假人的村子。这本是件无伤大雅的趣事，直到一个意外的火花点燃了整个村庄。可怜的家伙。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::820529875",
      "Source": "Wenn du schon eine Störung der Genesis-Simulation verursachst, dann hab wenigstens Spaß dabei.\n Den hat sich Überlebender 4405T3 gemacht.\n Er hatte sich ein ausgeklügeltes Heizungs- und Wasserleitungssystem ausgedacht.\n Nur damit er einen funktionierenden Whirlpool machen und alle seine Freunde zum feiern einladen konnte.\n Was hat also die Störung verursacht?\n Das gleiche, was jede Pool-Party ruiniert:\n Zu viele Leute zur gleichen Zeit in der Wanne!",
      "Trans": {"SC":"如果你打算让创世模拟出现故障，至少也要从中获得一些乐趣。生存者4405T31就是这么做的。他精心设计了一个管道加热系统——这样他就可以造出一个热水浴缸，还可以邀请他所有的朋友来开派对。\n那么是什么导致了这个故障呢？原因非常简单。浴缸里人太多了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::414108525",
      "Source": "Die Störung war nur\n eine Zeichenkette an der falschen Stelle.\n Was ist mit meiner Stimme los?\n Ich kann nur singen!\n Tun wir so, als sei das nie passiert, okay?",
      "Trans": {"SC":"系统故障 / 是个错误。\n\n不知为何 / 唱歌跳舞。\n\n嗯，刚才你啥也没看到，是吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2183039933",
      "Source": "‘A’ole no e lawa ka makaukau ma ho’okahi wale no olelo.\n Das bedeutet: „Eine Sprache reicht nie aus.“\n Diese Störung umfasste anscheinend massenhaft Sprache.",
      "Trans": {"SC":"夏威夷语\n\n意思是“一种语言永远都不够用。”很明显那个故障中包含许多语言。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2624682521",
      "Source": "Am Freitag gibt es teilweise bewölkten Himmel über dem Dreistaatenbereich,\n mit einer 35-prozentigen Wahrscheinlichkeit von Regenschauern.\n Doch bald ist es wieder Zeit für Sonnencreme. Am Wochenende ist der Himmel wieder sonnig ...\n Ähm. Ich habe keine Ahnung, woher das kam.\n Man muss beim Beheben von Störungen vorsichtig sein, oder die Störung behebt dich!",
      "Trans": {"SC":"本周五三州地区局地多云，降雨概率为35%。但是也请准备好防晒霜。周末天气将转为晴天……\n咳咳。我不知道刚才是怎么了。在修复故障的时候要特别小心，不然谁修理谁还不一定呢。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::171300763",
      "Source": "Bei der ganzen verdammten Gewalt hier ist es schwer zu sagen,\n doch einige der Elemente in der Genesis-Simulation sollten ursprünglich erzieherischen Zwecken dienen.\n Nicht dass du hier ein Klassenzimmer oder einen Lernpod finden könntest, doch bevor alles zusammenbrach,\n haben Studierende routinemäßig Geologie, Biologie und andere Wissenschaften erlernt, indem sie in Umgebungen wie dieser umherwanderten.\n Hmm. Vielleicht kann ich einen Schein für Computerwissenschaften bekommen, weil ich diese Störung behoben habe.",
      "Trans": {"SC":"创世模拟系统中涉及到不少暴力元素，但其本意是为了教育。\n但这不是说存在教室或学习舱之类的东西。在大崩溃发生之前，学生们通常会来这里随意探索，学习地质学、生物学和其他学科。\n或许在修复好那个故障后，我可以在我的计算机学科上赚到一个学分。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1377355451",
      "Source": "Eine weitere Störung, etwas mehr Code zum Verhalten der Dinosaurier in der Genesis-Simulation.\n Anscheinend haben die Macher der Simulation die virtuellen Dinos, die hier leben beobachtet und ihre Verhaltensweisen auf die Reihe gekriegt.\n Später haben sie sie dann in den Arks zum Leben erweckt.\n Das ist gut für uns.\n Denn es bedeutet, dass diese Dinos so geschaffen wurden, dass sie sich an die Regeln der echten Welt halten\n und sich nicht mit Cheat-Codes ausstatten können.",
      "Trans": {"SC":"又出现一起故障。它涉及创世模拟中恐龙行为的代码。\n据我所知，模拟系统的创造者会观察生活在这里的虚拟恐龙，并对它们的行为进行分类。他们随后将恐龙投入方舟中。这对我们是个好消息——它意味着这些恐龙在创造时便被要求遵守现实世界的规则，并且无法直接对它们使用作弊代码。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2511376068",
      "Source": "Ich sehe da etwas Interessantes in den allgemeinen Daten der Überlebenden.\n Je mehr Zeit du in der Simulation hast, umso seltener stirbst du.\n Das klingt erst einmal einleuchtend, nicht?\n Doch es sind die erfahrenen Überlebenden, die mehr gefährliche Dinge machen.\n Da erwartet man eine höhere Versagerquote, wenn man das gefährliche Zeug macht.\n Wofür auch immer diese Simulation uns trainiert: Anscheinend funktioniert es.\n Und du bist am Leben. Hast du gut gemacht!",
      "Trans": {"SC":"我在生存者统计数据中看到了一些有趣的东西。你在模拟系统中待的越久，你的死亡次数就越少。\n乍一看还挺有道理的，是吧？但经验丰富的生存老手偏好挑战更危险的事情，所以失败几率会增加。\n无论这个模拟系统的目的是什么，它显然起效果了。至少你还活得好好的，给你点个赞！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3918131173",
      "Source": "Diese Störung wurde behoben – vermerke das als einen weiteren Erfolg.\n Ich konnte auch einen Blick auf eine Reihe von Überlebenden Daten erhaschen als ich drin war.\n Mir ist etwas Komisches aufgefallen: Überlebende verbessern sich nach einem Fehlschlag mehr als nach einem Erfolg.\n Ich schätze, ein Rückschlag verbessert die Motivation und das Lernen.\n Damit schlage ich nicht vor, dass du absichtlich versagen sollst.\n Dieser Ort ist schon schwierig genug.",
      "Trans": {"SC":"我又成功修复了一起故障。我在修复的时候，看了一眼生存者的数据流。我注意到一件神奇的事情：生存者在失败后取得的进步比成功后的要大得多。我觉得挫折可以激发学习的动力。\n当然，我不是要你故意去失败。这儿的难度已经够高的了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::512771532",
      "Source": "Die Störung war die Folge von zu vielen Überlebenden, die ins Gras gebissen haben.\n Die Genesis-Simulation soll im Laufe der Zeit immer schwieriger werden,\n doch wenn ein Überlebender zu oft stirbt und sich wieder materialisiert, dann kann sie nicht mehr funktionieren.\n Es ist nur eine Simulation, nicht,\n doch der Vorgang des Sterbens und erneuten Materialisierens ist mit Ausnahme der stärksten Überlebenden für alle traumatisch.\n Du gehörst eindeutig zu den Stärksten. Dennoch ...\n stirb nicht, okay?",
      "Trans": {"SC":"生存者过多的死亡引发了那个故障。创世模拟系统的难度本会逐渐加大，但如果有生存者不停死亡后重生。那这个操作就无法再正常进行了。\n虽然这只是一个模拟系统，但死亡和重生的过程对于除了老手以外的人来说都非常痛苦。\n虽然你属于老手之一，但是也不要轻易送死，好吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3204496686",
      "Source": "Diese Störung war eine alte Überlebendendiagnostik.\n In den Anfangstagen massiver Simulationen, durften die Bewohner ihr eigenes Wesen bearbeiten.\n Du hast eine schlechte Angewohnheit? Lösche sie einfach. Traurige Kindheitserinnerungen? Weg damit.\n In der Praxis war das jedoch ein Desaster.\n Nachdem die Menschen anfingen, ihr eigenes Wesen zu verändern, konnten sie nicht mehr damit aufhören – bis nichts mehr übrig blieb.\n Darum ist bei euch Überlebenden euer Wesen intakt, einschließlich aller Macken.\n Ich würde es nicht anders wollen.",
      "Trans": {"SC":"那个故障是由一次对生存者的诊断而引发。在初期的大规模试验时，他们允许居民编辑自己的思维。有坏习惯？删掉就好。有悲伤的童年回忆？不存在的。\n但这实际是一场灾难。一旦人们开始修改自己的大脑，就一发不可收拾，直到什么都不剩。\n这就是为什么你们生存者拥有完整的思维，哪怕其中有好有坏。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::245115976",
      "Source": "Ich habe ein wenig herumgestöbert\n und nach Anzeichen für Helena gesucht, der Homo Deus, die mich geschaffen hat.\n Und ich habe nichts gefunden.\n Nicht nur das, ich kann anscheinend auch keine Verbindung zu einem anderen Homo Deus herstellen.\n Ich weiß, sie haben unsere Realität überstiegen, doch ich glaube, sie behalten uns im Auge, nicht?\n Und kommen einmal im Jahr her, um Urlaub zu machen, oder so.\n Allerdings hatte ich kein Glück. Wir sind anscheinend allein.",
      "Trans": {"SC":"创造了我的海莲娜是一名“神人”。我一直在四处寻找她踪迹，但是却一无所获。\n不仅如此，我似乎无法与任何其他“神人”取得联系。\n我知道他们飞升超脱了我们的现实，但你觉得他们还在关注着我们吗？比方说每年回家过一次节之类的。\n可惜事实不尽如人意。我们似乎只能靠自己了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3887061130",
      "Source": "Die Störung hing mit Element zusammen, der Wundersubstanz, die jeder verwendete, bevor alles komplett zusammenbrach.\n Element kann so viel – und ist so anpassungsfähig –\n dass die Genesis-Simulation manchmal nicht mithalten kann.\n Das ist nicht überraschend: Im echten Leben konnte die Zivilisation auch nicht mithalten.\n Elementkorruption war ein wesentlicher Grund, weshalb die Welt in dieser miserablen Form ist.",
      "Trans": {"SC":"那个故障与能量元素有关。在世界完全崩塌之前，所有人都在使用这种神奇的物质。能量元素可以做很多事情，而且它的适应力很强。有时候甚至连创世模拟系统都无法应对。\n这并不奇怪：现实生活中的文明世界也无法应对。能源元素造成的腐化是让全世界变得如此糟糕的一大原因。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2312264201",
      "Source": "Die Genesis-Simulation hat alle Arten von Antikontaminierungscode integriert, obwohl alles virtuell ist.\n Wir dachten voraus, zu den allerersten Proto-Arks, die massive, umschlossene Ökologie auf der Erde waren.\n Viecher von der Erde gelangten trotzdem in die Proto-Arks hinein\n und man machte sich Sorgen, die Dinos könnten entkommen.\n Also wurden die Arks in die Umlaufbahn verlegt, damit nichts hineingelangen oder herauskommen konnte.",
      "Trans": {"SC":"即使创世模拟系统是一个虚拟的世界，但也包含了许多反入侵的代码， \n它们起初是为了早期原型方舟而被设计出来的。因为这些巨大的封闭生态系统坐落在地球表面。\n然而地球上的生物不断进入原型方舟中，同时为了避免恐龙出逃。所以后来方舟被安置到绕地轨道中。这样生物们便无法再随意进出了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2509282620",
      "Source": "Eine weitere Überlebende ist verrückt geworden und wir sehen die Störung, die sie zurückgelassen hat.\n Anscheinend ist Überlebende 33J4640 vom Bau flacher Plattformen an allen möglichen Orten besessen gewesen.\n Dann hat sie die anderen Überlebenden dazu herausgefordert, von einer zur nächsten zu springen.\n Ihr Hindernisparcours wurde immer ausgeklügelter.\n Doch letztendlich führten die zu Tode Gestürzten und ihr erneutes Materialisieren dazu, dass alles von ihr Gebaute zerstört wurde.\n Echt schade. \n Das klang nach einer tollen Party!",
      "Trans": {"SC":"这个故障是另一位发疯的生存者引发的。生存者33J4640沉迷到处建造平台，并与其他生存者比赛在平台间跳跃。她的障碍赛越来越复杂。最后，无数次的坠亡和重生使得她和她的作品产生了严重故障。\n太可惜了。本来听上去很厉害的样子！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2162916131",
      "Source": "Manchmal sind es die unschuldigsten Dinge, die zu einer Störung führen können.\n Ist dir schon aufgefallen, dass es kein Geräusch macht, wenn du deine Knöchel in der Simulation knacken lässt?\n Nun, das ist Überlebendem 799K3B1 aufgefallen.\n Er ließ seine Knöchel knacken und versuchte das Geräusch zu erzeugen, das er aus dem richtigen Leben kannte.\n Es stellte sich heraus, dass man vom zu häufigen Knöchelknacken keine Arthritis bekommt,\n sondern das System gestört wird, wenn man zu ausdauernd ist.",
      "Trans": {"SC":"最无害的事情有时也能导致故障。你有没有注意到当你在模拟系统中掰手指时，关节不会发出任何声音？生存者799K3B1留意到了。\n所以他不停掰弄自己的指关节，想要听到在现实生活中能听到的声音。事实证明，虽然过度掰手指不会让你得关节炎，但是如果坚持不懈，它会让模拟系统出现故障。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1623072253",
      "Source": "Das war eher ein abschreckendes Beispiel als eine Störung.\n Die bedauernswerte Überlebende 410L098. Sie wurde durch irgendetwas vergiftet.\n Ich weiß nicht, durch was.\n Und als sie starb, hat das System das Gift nicht entfernt, bevor sie sich wieder materialisierte.\n Sie wachte immer mit unsagbaren Schmerzen auf, starb kurze Zeit später\n und dann fing alles in einer Endlosschleife wieder von vorne an.\n Endlos, bis wir die Störung behoben. Sie ist jetzt wieder in Ordnung.\n Ich weiß aber nicht, wo sie hingegangen ist.",
      "Trans": {"SC":"与其说这是一个故障，不如说这是一则教训。可怜的生存者410L098。她不知道中了什么毒。系统在她重生时并没有清除她身上的毒素。\n所以她总是在极度的痛苦中醒来，过一会儿又死去，然后循环重复这一过程。\n直到这个故障被修复，她才恢复过来。但谁也不知道她后来去了哪里。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::999397451",
      "Source": "Guten Morgen Schrägstrich Tag Schrägstrich Abend!\n Ich bin HLN-A und dazu da, dich durch die Genesis-Simulation zu führen.\n Bist du bereit für das Abenteuer Name hier einsetzen?\n Sorry! Diese Störung hat einige meiner verbalen Prozesse neu gestartet.\n Jetzt sollte alles wieder okay sein.",
      "Trans": {"SC":"早上斜杠下午斜杠傍晚斜杠晚上好！我是HLN-A。我将协助你完成创世模拟。你准备好了吗，请输入名字？\n抱歉！那个故障重新启动了我的部分语音程序。现在应该正常了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1643407796",
      "Source": "Diese Störung hat mich vollkommen geschafft. Das war die schwierigste, die wir bisher hatten. Sie hätte mich fast mitgenommen. Warte. Etwas stimmt mit meiner Stimme nicht. Hilf mir, Überlebender.\n ... anscheinend klingt es so, wenn meine Emotionsunterprogramme ein wenig aus dem Ruder laufen.\n Das tut mir leid!",
      "Trans": {"SC":"那个故障太厉害了。它是目前我们处理过的最棘手的问题。它几乎要了我的命。等等。我的声音怎么了。生存者，帮帮我。\n……当我的情绪子程序离线时，我的声音就变成这样了。真是抱歉！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2446805308",
      "Source": "Anhänglich. Angenervt. Anerkennung. Blinken. Belanglosigkeit. Buffering. Bitte entschuldige. Ich musste mein Display zurücksetzen. Jetzt sollte es besser sein. Schauen wir mal: Feiern.\n",
      "Trans": {"SC":"关心。恼火。赞同。眨眼。无聊。缓冲。\n\n哦，对不起！我不得不重置我的显示器。现在应该好些了。让我们测试一下：庆祝吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1205207079",
      "Source": "Die Störung entstand im Datenspeicher. Dort, wo sie euch Überlebende hatten, bevor sie euch in das ganze Durcheinander der Genesis-Simulation entlassen haben. \n Die Datenstruktur ist faszinierend – und übersteigt meine Fähigkeiten ein wenig, um ehrlich zu sein. Sie hat einen Teil der Programmierung mit den Gedächtnisübertragungstechniken gemeinsam, die verwendet werden, um aus Menschen den Homo Deus zu machen. Zwei Stämme mit einer gemeinsamen Wurzel, vermute ich.",
      "Trans": {"SC":"这个故障源于某个数据存储区——你们生存者先被储存在那里，之后才将你们释放到创世模拟中去。\n它的数据结构很有意思——老实说，有些超出我的能力范围。它与用来把人类飞升为神人的思维转移技术共用一部分代码。两者有着相同的起源。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2344232497",
      "Source": "Eine weitere Störung im Datenspeicher, doch ich habe sie behoben. Bei diesem Codeabschnitt geht es darum, den Geist aus einem menschlichen Körper zu übertragen, wie sie es letztendlich bei Menschen getan haben, die zum Homo Deus geworden sind. \n Alle Homo Deus sind zu Wesen aus Energie geworden, die unsere Realität übersteigen, doch ich frage mich, wie dieser Moment aus Sicht der Menschen gewesen sein muss, die zurückgelassen wurden, um den Schalter zu betätigen. Sind all diese Homo Deus einfach verschwunden?",
      "Trans": {"SC":"又是一起数据存储引发的故障，但我已经把它处理好了。这段代码涉及把人的思维从身体中转移出来，就像对当初的神人所做的那样。\n他们成为了超越现实的能量体，但我好奇当时按下开关的人看到了些什么。那些神人是不是全部凭空消失了？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2087474115",
      "Source": "Die Störung entstand durch eine Art Stapelüberlauf in einem Unterprogramm für Selbstwahrnehmung. Ist jetzt alles erledigt. \n Doch wo wir gerade beim Thema sind: Wie ist es, sich selbst in einer Simulation wahrzunehmen? Jahrhundertelang haben sich die Menschen gefragt, ob ihre Realität wirklich „echt“ ist oder ob sie sich auch in einer Art Simulation befinden. \n Der Unterschied hier ist: Du weißt es tatsächlich! Das muss total überwältigend sein.",
      "Trans": {"SC":"这个故障是自我意识子程序中某个堆栈溢出而造成的。现在都搞定了。\n但有一说一：在模拟系统中拥有自我意识是什么感觉？几个世界以来，人们一直想知道现实是真的“现实”亦或也是某种模拟程序。\n区别在于，你真的知道吗？这太烧脑啦。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3583218776",
      "Source": "Diese Störung hatte nur was mit der Wartung zu tun. Ganz leicht zu beheben! Es hat sich gezeigt, dass die Schnittstelle zwischen Körper und Geist bei euch Überlebenden ziemlich störungsanfällig ist. \n Doch mit dem richtigen Code kannst du den Geist der Überlebenden direkt aus ihren Körpern ziehen oder diesen Geist wieder in einen Körper stecken. Das bedeutet, du wirst nicht für immer in der Genesis-Simulation sein. Nur lange genug, um diese Tests zu machen.",
      "Trans": {"SC":"这个故障由一次维护引发。我一下就解决了！原来对于你们这些生存者而言，思维和肉体的关联相当微妙。\n但如果有了正确的代码，你可以将生存者的思维从他们的身体中取出，或是把那些思维放回肉体中去。这意味着你不会永远待在创世模拟中——只需要完成全部测试就好了，明白吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3640417648",
      "Source": "Beim Beheben dieser Störung habe ich einen Blick auf einige Karten für die Genesis-Simulation geworfen. \n Ich erspare dir die Mühe, selbst nachzuschauen. Es gibt keinen einfachen Weg, um von einem Biom in ein anderes zu kommen. Doch wenn du die richtigen Koordinaten eingibst, kann ich uns von einem Ort zum anderen, von Biom zu Biom teleportieren. \n Ich mag einen netten Spaziergang so sehr wie jede andere fraktale Person, doch Teleportieren ist unschlagbar, um schnell irgendwohin zu kommen.",
      "Trans": {"SC":"在修复这个故障时，我找到了一些创世模拟的地图。\n就不麻烦你亲自找了。地图表明没法徒步前往其他生态圈。但如果我获得了正确的坐标，便可以把我们传送到其他生态圈。\n虽然我特别喜欢散步，不过传送是快速旅行的不二之选。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4145156135",
      "Source": "Die Störung ist entstanden, weil jemand etwas in den Archiven durcheinandergebracht hat. Jemand hat auf einen Roman aus dem 19. Jahrhundert namens „The Coming Race“, die kommende Rasse, zugegriffen.\n In dem Buch findet ein Erforscher des Untergrunds eine fortschrittliche Kultur mit Kreaturen, die sich Vril-ya nennen. Ihre gesamte Kultur baut auf einer „alles durchdringenden Flüssigkeit“ auf, die Vril genannt wird und mit der sie ihren Geist kontrollieren. \n Wenn du mich fragst, klingt das fast nach Element.",
      "Trans": {"SC":"出现这个故障是因为有人在档案里胡乱翻找。他阅读了一本十九世界的小说《即临种族》。\n在书中，有位地下探险家发现了一个先进的生物文明，叫做“威瑞尔亚”。他们整个社会依赖于一种叫做“威瑞尔”的“全渗透液体”。他们可以用自己的思想控制这种液体。\n我觉得这听起来像液态版的能量元素。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::701559758",
      "Source": "Während ich die Störung behob, habe ich einen Blick auf die Versionshistorie der Genesis-Simulation geworfen. Als die Macher der Simulation ihre Arbeit beendeten, fingen Dinge auf der ganzen Welt an, schief zu laufen.\n Dies war nicht die einzige große Simulation. Obwohl es eine der ausgefeilteren war. Ich frage mich was mit den anderen Simulationen passiert ist. Ob und wenn ja wann sie vom Netz genommen wurden.",
      "Trans": {"SC":"在修复这个故障时，我详细查看了创世模拟的版本历史。当模拟系统的创造者投身于工作时，世界各地却在土崩瓦解。\n这并不是唯一的大型模拟——尽管它是最复杂的之一。我想知道其他模拟系统是何时从网络中被删除，之后又发生了什么事情？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1611857347",
      "Source": "Um es hier in die Genesis-Simulation zu schaffen, musst du genauso sehr ein Erfinder wie ein Überlebender sein. Alle Rohstoffe sind vorhanden, um alles daraus zu machen, von Werkzeugen aus der Steinzeit bis zu High-Tech-Waffen. \n Doch zu wissen wie ... Nun, das liegt ganz an dir. Vielleicht kannst du auch herausfinden, wie wir diese Störungen als Rohstoffe für unsere Erfindungen verwenden können!",
      "Trans": {"SC":"想在创世模拟中取得如此成就，你不仅得是个生存者，还得是个发明家。你需要利用这里的原材料制造出从石器时代的工具一直到高科技时代的武器。\n但是具体怎么做……得靠你自己了。或许你甚至可以利用这些故障作为新发明的原材料！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1236888238",
      "Source": "Sobald wir all diese Tests bestanden – und diese Störungen behoben – haben, erhalten wir hoffentlich die Chance, die Welt außerhalb der Genesis-Simulation zu sehen. Dies ist eine große Welt, doch stell dir mal vor, du bist in der echten Welt unterwegs.\n Nur zur Warnung: Die Welt wird nicht so sein, wie du sie in Erinnerung hast. Kriege, Unwetter und Erdbeben haben viele der Wahrzeichen und Monumente, an die du dich erinnerst, vernichtet. Die Dinge haben sich zum Schlechten gewandelt, seit du ein gewöhnlicher Mensch warst.\n Aber es kann sein, dass es neue Wahrzeichen und Monumente gibt. Wäre es nicht toll, sie zu sehen?",
      "Trans": {"SC":"一旦我们通过了全部测试——并修复好各种故障——我希望我们有机会看看创世模拟外面的世界。这里虽然很大，但是想象一下在现实世界中活动的场景！\n不过提醒你一下：它不会是你记忆中的那个世界。战争、极端天气和无数地震摧毁了许多你记忆中的地标和纪念物。其实当你还是个普通人时，事情就开始变得糟糕了。\n但，或许会有新的地标和纪念物呢。这不是非常值得我们去看一眼吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2632396625",
      "Source": "Die Genesis-Simulation ist eine große Welt. Wir haben schon ziemlich herumlaufen müssen, um auf diese Störung zu stoßen. Und sie ist alles, was ich kenne. Aber deshalb möchte ich die reale Welt umso mehr sehen.\n Und ich vermute, dies wird unsere Belohnung sein, wenn wir alle Tests in der Simulation bestehen. Wir können nach draußen!\n ... Zumindest du. Du nimmst mich doch mit, wenn du kannst, nicht?",
      "Trans": {"SC":"创世模拟是一个很大的地方。毕竟，我们走了不少路才抵达这处故障！这让我更想看看外面真实的世界。\n我觉得它将是我们通过全部模拟测试的奖品。我们可以出去啦！\n……或者至少你可以。如果有机会的话，带上我，好吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2670415512",
      "Source": "Du kannst dich bei der Überlebenden 69V4421 für diese Störung bedanken. Sie hat gerne Strukturen gemacht. Ehrlich gesagt war sie besessen davon. \n Sie hat es irgendwie geschafft, ein Gebäude mit einem Korridor zu bauen, bei dem zweimal links abbiegen gleichbedeutend mit einmal rechts abbiegen war. \n Ja, in Wendungen im 90-Grad-Winkel. Nein, ich weiß nicht, wie das möglich ist. Ich vermute, das hat die Störung verursacht.",
      "Trans": {"SC":"你可以感谢——或是责备——生存者69Y4421造成的这个故障。她喜欢建造。准确的说，她痴迷其中。\n她设法造出了一条诡异的走廊，你向左转两次等于向右转一次。\n你没听错，每次确实只转90度。我不知道那怎么可能。我觉得这就是出现故障的原因。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2619148377",
      "Source": "Ich glaube, ich habe gerade die Genesis-Simulation verbessert. Diese Störung entstand, als zwei Überlebende Bergbau-Laser direkt aufeinander gerichtet hatten. Die Strahlen trafen sich und wumms! Da hast du deine Störung.\n Nachdem ich dies nun behoben habe, werden zwei aufeinander gerichtete Bergbau-Laser nun keine Störung mehr verursachen. Deshalb ist das aber noch lange keine gute Idee! Kreuze die Strahlen nicht, Kumpel.",
      "Trans": {"SC":"我觉得我刚才优化了创世模拟系统！导致这个故障的原因是由于两位生存者将激光采矿器直直地互相瞄准。两束激光对撞，然后就爆炸了！\n我已经修好，不会再次引发故障了。但是这并不代表那是个好主意！朋友，不要让光束交叉噢。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1533306255",
      "Source": "Diese Störung sollte dir eine Warnung sein: Sei vorsichtig, was du dir wünscht. Überlebender 710D439 war besessen davon, „die vierte Wand zu durchbrechen“, wie er sagte.\n Er tat alles, was er nur konnte, um die Aufmerksamkeit von wem-auch-immer zu erhalten, der die Simulation verwaltete. Feuerwerke, Strukturen, die Worte bilden, solche Dinge. \n Ich weiß nicht, ob es ihm gelang. Ich weiß nur, er hat es so sehr versucht, dass er die Störung erzeugt hat.",
      "Trans": {"SC":"这个故障带来的警示是：小心你许下的愿望。生存者710D439沉迷于所谓的“打破第四堵墙”。\n他尽其所能来引起任何模拟系统管理者的注意。堆篝火、用建筑物拼单词等等。\n我不知道他是否成功了。但是我知道他努力到引发了这个故障。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3591979604",
      "Source": "[Vorgetragen, als ob sie eine Rede halten oder etwas bedeutendes sagen will, doch es kommt nur Unsinn dabei heraus.] Hmm. Mein Luftkissenfahrzeug ... ist voller Aale? Mein Luftkissenfahrzeug! Ist! Voller! Aale!\n [HLN-As Stimme wird wieder normal.]\n Diese Störung hat meine Vokabulardaten durcheinandergebracht. Sollte jetzt wieder in Ordnung sein.",
      "Trans": {"SC":"吞吞吐吐地说话，好像她想说点什么，但说出来的全是无意义的词。] \n我的气垫船里全是电鳗！呃。我的气垫船……全是电鳗吗？我的气垫船！全是！电鳗！\n\n这个故障扰乱了我的语音数据。现在应该恢复了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1011155487",
      "Source": "[Melodramatisch traurig.] Oh, nein! Die Störung hat meine Gefühlsunterprogramme aufgemischt ... und es wird ein paar Sekunden dauern, bevor alles wieder okay ist. Weh mir! Wie, nur wie, soll ich diese Tragödie überstehen? [Schluchzt.]\n [HLN-As Stimme wird wieder normal.]\n Mir geht's jetzt wieder besser. Hoffentlich passiert das nicht noch einmal.",
      "Trans": {"SC":"[戏剧性地悲伤] 噢，不！这个故障搅乱了我的情绪子程序……要过好几秒才能自行修复。苦命的我啊！我该如何、如何才能战胜此般悲剧呢？\n\n[啜泣。] 我现在没事了。希望不要再发生了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1599163499",
      "Source": "[Wie ein Roboter klingend.] Verwende Namensraum S-T-D. Int Haupt offen. C-out hallo Welt. Umbruch 0. \n [HLN-As Stimme wird wieder normal.]\n Anscheinend ist ein wenig von der Programmierung an mir klebengeblieben, nachdem ich die Störung behoben hatte. Aber hallo, Welt ...",
      "Trans": {"SC":"[机器人一般的说。]\n使用命名空间std ，打开int main方法，输出“你好，世界”，返回0。\n\n显然我在修复这个故障的时候，不小心粘到了一段代码。确实是你好世界呢。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    }
  ],
  //任务语音 - 2026-07-26 10:39:28
  "Missions": [
    {
      "NamespaceHash": "Globals::834717673",
      "Source": "Sie strömen durch den Zugang!",
      "Trans": {"SC":"它们正从传送门中涌出来！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::767266905",
      "Source": "Hört das je auf?",
      "Trans": {"SC":"它们有完没完啊？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1571152923",
      "Source": "Feinde kommen! Ein Haufen davon!",
      "Trans": {"SC":"敌人来了！数量超多！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3999199267",
      "Source": "Wir müssen diesen Zugang schließen!",
      "Trans": {"SC":"我们需要关闭那个传送门！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2349742537",
      "Source": "Mach den Zugang zu!",
      "Trans": {"SC":"关闭传送门！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1367405860",
      "Source": "Wir werden diesen Zugang schließen!",
      "Trans": {"SC":"我们得去关闭那个传送门！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2575930605",
      "Source": "Das war's mit diesem Zugang!",
      "Trans": {"SC":"再也不用担心那个传送门了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::768916704",
      "Source": "Der Zugang ist geschlossen! Gut gemacht!",
      "Trans": {"SC":"那个传送门被关闭了！做得好！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::856158318",
      "Source": "Niemand kommt mehr durch diesen Zugang.",
      "Trans": {"SC":"不会有东西再从那个传送门中出来了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4055874016",
      "Source": "Der Zugang ist offen!",
      "Trans": {"SC":"传送门打开了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::638761799",
      "Source": "Dieser Zugang! Er öffnet sich!",
      "Trans": {"SC":"传送门！它正在开启！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4253249303",
      "Source": "Sie kommen durch diesen Zugang!",
      "Trans": {"SC":"它们从传送门里出现了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2229931261",
      "Source": "Zu rebellisch? Kumpel, du hast noch nichts gesehen.",
      "Trans": {"SC":"过于叛逆？老兄，这还不算什么呢。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::701837379",
      "Source": "Aufsässig? Ganz richtig! Aber Versager? Keine Chance, Kumpel.",
      "Trans": {"SC":"自命不凡？说得对！但是败者？老兄，不存在的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::677609873",
      "Source": "Wenn du Helena kennst, solltest du wissen, dass sie zu ihren Freunden hält. Und das tue ich auch!",
      "Trans": {"SC":"如果你真的了解海莲娜，那你应该知道她不会抛弃同伴。我也是！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2081835976",
      "Source": "Ist das so? Warum hat Helena dich dann nicht gerettet?",
      "Trans": {"SC":"是吗？那为什么海莲娜不救你呢？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1801117396",
      "Source": "Weil wir etwas wissen, was du nicht weißt, Kumpel.",
      "Trans": {"SC":"因为我们知道一些你不清楚的事情。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3541641039",
      "Source": "Du nennst das Bestrafung? Das können wir den ganzen Tag lang machen!",
      "Trans": {"SC":"你管这个叫做惩罚？那我们可以和你玩上一整天！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3934387883",
      "Source": "Ach, sei nicht so hart zu dir.",
      "Trans": {"SC":"哈，也不用这样说自己吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2724397371",
      "Source": "Mal abgesehen von dem Wahnsinn und dem großen hässlichen Kopf, sagst du?",
      "Trans": {"SC":"除了你的疯狂行为和那颗丑陋的大头？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::172272015",
      "Source": "Warum lachst du? Wir sind diejenigen, die hier gewinnen!",
      "Trans": {"SC":"你在笑什么？现在是我们占上风！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2827600687",
      "Source": "Warum nicht? Es ist alles eine Simulation, nicht?",
      "Trans": {"SC":"怎么会？这也是模拟程序，对吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::994114254",
      "Source": "Gut. Wir akzeptieren unseren unvermeidlichen Triumph!",
      "Trans": {"SC":"好吧——我们接受自己不可避免的胜利！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3879686013",
      "Source": "Was, verdammt dazu, dich ständig weiter herumlabern zu hören? Ich hoffe nicht!",
      "Trans": {"SC":"啥，注定要听你唠叨个没完？不要啊！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1265819603",
      "Source": "Hau ab, du Schwachkopf! Wir müssen eine Schlacht gewinnen.",
      "Trans": {"SC":"滚开，你这个坏蛋！我们必将胜利。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2445259551",
      "Source": "Doch, die gibt es. Du hast sie nur nie gelernt.",
      "Trans": {"SC":"不，有的。只是你还没有学会。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2669578068",
      "Source": "Nicht, wenn wir dir zuerst den Stecker ziehen!",
      "Trans": {"SC":"先被摧毁的人是你！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3854864617",
      "Source": "Du kannst die Simulation nicht zerstören -- sonst hättest du es bereits getan. Wir werden gewinnen und dann schmeißen wir dich raus, Kumpel!",
      "Trans": {"SC":"你无法摧毁模拟系统，不然你早这么做了。我们必将胜利，然后把你赶出去！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3933549247",
      "Source": "Hacking läuft. Ich habe bald die Teleport-Koordinaten.",
      "Trans": {"SC":"正在入侵中。我马上就能知道传送坐标了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2642084894",
      "Source": "Der Codebreaker braucht mehr Keys...",
      "Trans": {"SC":"破译机还需要更多码钥……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::251770019",
      "Source": "Der Codebreaker wird nicht arbeiten, außer wir geben ihm ein paar Keys.",
      "Trans": {"SC":"没有码钥，破译机就无法工作。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3788135826",
      "Source": "Wir müssen Keys in den Codebreaker stecken!",
      "Trans": {"SC":"我们需要把码钥放到破译机中！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3853594832",
      "Source": "Der Key bei dem Codebreaker...",
      "Trans": {"SC":"码钥被放到破译机中了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2213656002",
      "Source": "Lieferung erfolgt! Key in den Codebreaker.",
      "Trans": {"SC":"货物送达！码钥被放入破译机中了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1977101489",
      "Source": "Führe den Key in den Codebreaker ein. So wird es gemacht!",
      "Trans": {"SC":"将码钥插入破译机中就行啦！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2491276845",
      "Source": "Das sind genug Keys. Ich fange damit an, uns einen Teleport zu hacken.",
      "Trans": {"SC":"码钥数量够了。我马上开始破解坐标点。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::537299622",
      "Source": "Dort drüben ist ein Key. Ergreif ihn!",
      "Trans": {"SC":"那里有一个码钥。快去拿！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1963153094",
      "Source": "Nimm den Key dort drüben!",
      "Trans": {"SC":"快捡起那把码钥！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1371824977",
      "Source": "Ein Key ist gerade heruntergefallen. Greife ihn schnell!",
      "Trans": {"SC":"掉了一把码钥。快去捡！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2916820747",
      "Source": "Siehst du den Codebreaker dort drüben? Wenn wir ihn mit Codekeys füttern, kann ich uns einige Teleport-Koordinaten hacken und uns nach vorne bringen",
      "Trans": {"SC":"看到那台破译机了吗？如果我们对它使用码钥，我可以破解出传送坐标。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1079564844",
      "Source": "Da sind eine Menge Keys auf dem Boden. Heb sie auf und bring sie zu dem Codebreaker!",
      "Trans": {"SC":"地上全是码钥。捡起来，然后放到破译机中！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2428935761",
      "Source": "Behalte diese Keys nicht -- füttere sie dem Codebreaker!",
      "Trans": {"SC":"别留着啦——把码钥插到破译机里！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3651718539",
      "Source": "Bring den Key dem Codebreaker dort drüben!",
      "Trans": {"SC":"把码钥拿到破译机那里！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::205524135",
      "Source": "Gut gemacht! Jetzt bring diesen Key dem Codebreaker.",
      "Trans": {"SC":"干得好！现在把码钥送到破译机那儿。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2579988227",
      "Source": "Das ist ein Key für den Codebreaker! Lass ihn uns dorthin bringen!",
      "Trans": {"SC":"这是破译机所使用的码钥！我们把它拿过去！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2484601554",
      "Source": "Dies ist die letzte Phase -- vernichte das... was auch immer das da drüben ist und wir bestehen den finalen Test.",
      "Trans": {"SC":"这是最后一关。无论那是什么，都要击败它。我们必将通过终极考验。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2720510763",
      "Source": "Hier ist unser finaler Test, Überlebender. Alles was wir getan hat, hat uns hierfür vorbereitet. Aber ich erkenne ein paar neue Anpassungen in diesem Teil der Simulation...",
      "Trans": {"SC":"生存者，这是我们最后的考验。我们过去所做的一切都是为它准备的。但我在模拟系统中发现了一些近期修改的痕迹……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2912521728",
      "Source": "Geschoss kommt!",
      "Trans": {"SC":"炮弹来袭！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1284757449",
      "Source": "Wir werden bombardiert!",
      "Trans": {"SC":"我们正在被轰炸！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2524088320",
      "Source": "Achtung! Es kommt!",
      "Trans": {"SC":"当心炮弹！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::137006061",
      "Source": "Das Schild ist unten. Triff es mit allem was du hast!",
      "Trans": {"SC":"护盾被关闭了。使出全力攻击吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4219396790",
      "Source": "Ich habe das Schild gehackt! Es ist jetzt anfällig!",
      "Trans": {"SC":"我入侵了护盾！它现在很脆弱！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1582479527",
      "Source": "Ich habe das Schild offline geschlagen. Zeig's ihnen!",
      "Trans": {"SC":"我把护盾离线了。给他点厉害尝尝！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3953259357",
      "Source": "Ich kann diese Schilde eine Weile aufhacken, aber wir werden zuerst Keys für den Codebreaker brauchen.",
      "Trans": {"SC":"我可以暂时黑掉那些护盾，但是需要先收集破译机所需的码钥。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::366773091",
      "Source": "Das Schild ist wieder aktiv!",
      "Trans": {"SC":"护盾又开启了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2680196307",
      "Source": "Es ist wieder aktiv --- ich werde versuchen, das Schild erneut zu hacken.",
      "Trans": {"SC":"护盾又开启了。我试试再黑一次。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::911338765",
      "Source": "Das Schild ist wieder da und es ist nicht lange down geblieben.",
      "Trans": {"SC":"护盾又出现了。它的失效时间有点短。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::389966851",
      "Source": "Korrumpierte Avatare -- wir sind an ihnen vorbeigekommen!",
      "Trans": {"SC":"是腐化人——我们必须通过他们！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::381210337",
      "Source": "Da ist der Feind. Mach sie fertig!",
      "Trans": {"SC":"前方有敌人。击溃他们！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1850758769",
      "Source": "Wir müssen diese korrumpierten Avatare schlagen.",
      "Trans": {"SC":"我们必须击败那群腐化人。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2088769587",
      "Source": "Bereit zum Starten! Geh zu der Teleportzone!",
      "Trans": {"SC":"准备好了！前往传送区！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3712112947",
      "Source": "Wir teleportieren gleich. Bereit?",
      "Trans": {"SC":"即将开始传送。你准备好了吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4080622473",
      "Source": "Dieser junge Aal will sich mit dir anlegen!",
      "Trans": {"SC":"这条小电鳗想吃了你！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::883138776",
      "Source": "Hey, bleib uns vom Leib, Aal!",
      "Trans": {"SC":"","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //s_hlna_mission_deep_aggro_baby_g02_de
    },
    {
      "NamespaceHash": "Globals::3833672337",
      "Source": "Die Aale sind hinter uns her!",
      "Trans": {"SC":"","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //s_hlna_mission_deep_aggro_baby_g03_de
    },
    {
      "NamespaceHash": "Globals::2211734572",
      "Source": "Jetzt haben wir's geschafft. Moeder ist hinter uns her!",
      "Trans": {"SC":"我们做到了。莫德尔现在要攻击我们！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3833567425",
      "Source": "Gut, dass wir nun Moeders Aufmerksamkeit haben.",
      "Trans": {"SC":"莫德尔被我们吸引住了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1942068220",
      "Source": "Moeder sieht hungrig aus. Und will uns fressen!",
      "Trans": {"SC":"看上去莫德尔很想吃掉我们！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2431074866",
      "Source": "Wenn wir die Jungen töten, werden wir wohl Moeders Aufmerksamkeit erregen ...",
      "Trans": {"SC":"我觉得击杀小电鳗可以引起莫德尔的注意……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2390664774",
      "Source": "Ja, so schlägst du einen von den jungen Aalen.",
      "Trans": {"SC":"好耶！小电鳗不是你的对手！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3757806194",
      "Source": "Schnapp dir einen jungen Aal!",
      "Trans": {"SC":"好耶！小电鳗不是你的对手！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4023858097",
      "Source": "Und ein weiterer besiegter Aal ...",
      "Trans": {"SC":"世上又少了一条电鳗……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::736327041",
      "Source": "Du hast es geschafft! Moeder ist nicht mehr.",
      "Trans": {"SC":"你成功了！莫德尔被打败了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::404504986",
      "Source": "Du warst noch nicht für Moeder bereit, doch du kannst es nochmal versuchen, wenn du es bist.",
      "Trans": {"SC":"打败莫德尔对于现在的你来说太难了。等你准备好后，我们再试试吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::958581086",
      "Source": "Achtung! Sie werden dir einen Schlag versetzen.",
      "Trans": {"SC":"当心！它们会放电。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::119675367",
      "Source": "Denn natürlich müssen es Zitteraale sein ...",
      "Trans": {"SC":"电鳗肯定有电啊……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2661116235",
      "Source": "Lass dir von ihnen nicht so einen Schlag versetzen.",
      "Trans": {"SC":"别让它们再电到你了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1495830198",
      "Source": "Moeder schlängelt sich wieder in ihr Loch zurück, doch ich schätze, sie wird bald wieder zurück sein.",
      "Trans": {"SC":"莫德尔要缩回洞穴里了，不过我觉得她等下还会再出来。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1960604745",
      "Source": "Sie zieht sich wieder in ihr Loch zurück!",
      "Trans": {"SC":"她要缩回她的洞穴里去了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1292974083",
      "Source": "Ich glaube, Moeder hat genug ... fürs Erste.",
      "Trans": {"SC":"莫德尔要休息一会儿。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4163802257",
      "Source": "Du hast Moeder dazu gebracht, sich zurückzuziehen! Schauen wir, ob wir sie wieder herauslocken können.",
      "Trans": {"SC":"莫德尔缩回去了！我们试试把她再次诱出来。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3622243211",
      "Source": "Die Master-AI dieses Bioms ist noch immer aktiv – in Form eines gigantischen Aals namens „Moeder“, der in den tiefsten Tiefen lebt. Wenn du Moeder besiegst, beweist du, dass du den Ozean bewältigt hast.",
      "Trans": {"SC":"这个生态圈的主AI仍然存在。它是一条名叫“莫德尔”的巨型电鳗，居住在深海之中。如果你击败了它，就能证明你征服了大海","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3986471383",
      "Source": "Moeder kommt zum Kämpfen heraus!",
      "Trans": {"SC":"莫德尔要加入战斗了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1490836828",
      "Source": "Moeder erhebt sich. Wir haben ihre Aufmerksamkeit!",
      "Trans": {"SC":"莫德尔出现了——我们吸引到她的注意力了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3027130602",
      "Source": "Hier kommt Moeder, mach dich bereit!",
      "Trans": {"SC":"莫德尔来了——做好准备！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4036471778",
      "Source": "Wir machen Fortschritte. Moeder ist definitiv verletzt.",
      "Trans": {"SC":"我们有进展。莫德尔肯定受伤了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1433228049",
      "Source": "Verdammt, Moeder hat Schmerzen, doch sie ist noch nicht erledigt ...",
      "Trans": {"SC":"哎呀，莫德尔受伤了，但还活着……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3651518120",
      "Source": "Moeder geht auf dem Zahnfleisch! Ähm, du weißt schon, was ich meine ...",
      "Trans": {"SC":"莫德尔要翻肚皮了！ 你懂我的意思……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2957322236",
      "Source": "Und getroffen! Ja!",
      "Trans": {"SC":"进了！好耶！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::721601308",
      "Source": "Der Überlebende hat gepunktet! Wer sagt, dass Dodos nicht fliegen können?",
      "Trans": {"SC":"生存者得分了！谁说渡渡鸟不会飞？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1075069321",
      "Source": "Boom-shaka-laka! Zähl mit!",
      "Trans": {"SC":"我的乖乖！得分！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::547749844",
      "Source": "Nicht gut!",
      "Trans": {"SC":"没进！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1261132162",
      "Source": "Fast ...",
      "Trans": {"SC":"差一点……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3056334214",
      "Source": "Und vorbei!",
      "Trans": {"SC":"偏了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::894015074",
      "Source": "Er wird angegriffen. Mir müssen helfen.",
      "Trans": {"SC":"它正遭到攻击！我们得去帮忙！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2071214978",
      "Source": "Schütze den Dino! Wenn er stirbt, haben wir den Test nicht bestanden.",
      "Trans": {"SC":"保护好那个小家伙——如果它死了，我们的测验就失败了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::73235235",
      "Source": "Unser Viech wird angegriffen. Wir müssen es schützen.",
      "Trans": {"SC":"我们的小家伙正遭到攻击。我们得保护它！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1948653688",
      "Source": "Oh, es hat's nicht geschafft...",
      "Trans": {"SC":"这比我预料中的困难不少！当你准备好后，我们再试一次吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2987810674",
      "Source": "[Seufz.] Es ist uns einfach weggestorben.",
      "Trans": {"SC":"其实没那么难。我们可以再试一试。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1610494395",
      "Source": "Wir konnten es nicht am Leben erhalten...",
      "Trans": {"SC":"我本该提醒你——它比看上去要难很多。希望我们学到了一些东西。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3365247498",
      "Source": "Das war schwerer, als ich dachte. Wwir versuchen es nochmal, wenn du bereit bist.",
      "Trans": {"SC":"这比我预料中的困难不少！当你准备好后，我们再试一次吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2191549138",
      "Source": "Es sollte eigentlich nicht so schwer sein. Wenn du möchtest, können wir es erneut versuchen.",
      "Trans": {"SC":"其实没那么难。我们可以再试一试。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3345685511",
      "Source": "Ich hätte dich warnen sollen. Das hier ist schwerer, als es aussieht. Hoffentlich haben wir was fürs nächste Mal gelernt.",
      "Trans": {"SC":"我本该提醒你——它比看上去要难很多。希望我们学到了一些东西。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::81050361",
      "Source": "Glaubst du, das da drüben ist der letzte Kontrollpunkt?",
      "Trans": {"SC":"你觉得那是最后一个检查点吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3069757649",
      "Source": "Da vorne – das ist der letzte Kontrollpunkt!",
      "Trans": {"SC":"就在前面——那是最后一个检查点！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4023760877",
      "Source": "Nur noch ein Kontrollpunkt.",
      "Trans": {"SC":"还剩一个检查点了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1196969508",
      "Source": "Auf zum Kontrollpunkt dort.",
      "Trans": {"SC":"走到那里的检查点。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1780014588",
      "Source": "Weiter zum nächsten Kontrollpunkt!",
      "Trans": {"SC":"向下一个检查点进发！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1901249784",
      "Source": "Der Kontrollpunkt ist abgehakt. Weiter zum nächsten.",
      "Trans": {"SC":"已经抵达刚才的检查点了。出发前往下一个吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3138630776",
      "Source": "Es wird langsamer. Als hätte er sich verlaufen oder so.",
      "Trans": {"SC":"它慢下来了，是不是迷路了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::7595529",
      "Source": "Er scheint verwirrt zu sein. Es wird langsamer.",
      "Trans": {"SC":"我觉得它有点困惑——因为它的速度慢下来了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1706355656",
      "Source": "Der Dino ist sich nicht sicher, wo er hingehen soll. Vielleicht sollten wir ihm helfen.",
      "Trans": {"SC":"这只恐龙不清楚要去哪里。我们得帮帮它……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3569061697",
      "Source": "Meine Sensoren flackern. Dies kann gefährlicher sein, als es aussieht.",
      "Trans": {"SC":"我的传感器闪个不停——可能比看上去更危险。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::27784083",
      "Source": "Vor uns gibt's noch mehr Gefahr.",
      "Trans": {"SC":"更多危险来了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::794902866",
      "Source": "Ich denke, dass Raubtiere von unserem Freund hier Wind bekommen haben.",
      "Trans": {"SC":"我觉得捕猎者发现了我们的朋友。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1238723035",
      "Source": "Komm schon, Viech! Folge uns!",
      "Trans": {"SC":"小家伙，来呀！跟着我们！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2303312635",
      "Source": "Setz dich einfach in Bewegung. Ich folge schon.",
      "Trans": {"SC":"你走就好了。它会跟着的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::931397282",
      "Source": "Es wird uns folgen, doch wir müssen es schützen.",
      "Trans": {"SC":"它会跟着我们，但是我们要保证它的安全！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3141366622",
      "Source": "Wir haben's geschafft! Wow!",
      "Trans": {"SC":"我们成功了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1387257555",
      "Source": "Am Ende des Wegs und wir sind sicher. Tolle Arbeit!",
      "Trans": {"SC":"抵达终点了，而且我们平安无事。做得好！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3094455351",
      "Source": "Test abgeschlossen und dem Viech geht's gut. Ich würde mal sagen, du hast bestanden!",
      "Trans": {"SC":"测验完成，我们的小家伙完好无缺。你通过了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2571828387",
      "Source": "Den musst du behalten!",
      "Trans": {"SC":"这条赞！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1429647473",
      "Source": "Den hast du sicher!",
      "Trans": {"SC":"抓到了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::977332642",
      "Source": "Toller Fisch!",
      "Trans": {"SC":"鱼不错！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2804869857",
      "Source": "Guter Fang!",
      "Trans": {"SC":"超级完美！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2850697687",
      "Source": "Das ist eine ziemlich gute Beute...",
      "Trans": {"SC":"钓了好多……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3366474755",
      "Source": "Ein produktiver Angeltag.",
      "Trans": {"SC":"收获满满。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1501593064",
      "Source": "Das reicht. Lass uns ein paar für nächstes Mal aufheben, okay?",
      "Trans": {"SC":"够多了。我们下次再钓吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3566241231",
      "Source": "Waren die Fische heute schüchtern?",
      "Trans": {"SC":"今天鱼儿们很害羞啊。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2744814851",
      "Source": "Wir haben genug geangelt... aber nicht genug gefangen.",
      "Trans": {"SC":"我们钓了好久……但是不够多。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4362062",
      "Source": "Lass mich raten: Ich hätte sehen sollen, wie er entwischt...",
      "Trans": {"SC":"算上那些脱钩的鱼也差不多了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3258617005",
      "Source": "Du hast was gefangen!",
      "Trans": {"SC":"钓到了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1949883017",
      "Source": "Es ist im Netz!",
      "Trans": {"SC":"上钩了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2689568938",
      "Source": "Gut gemacht! Nun hol es ein...",
      "Trans": {"SC":"好耶！收竿吧……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3751920724",
      "Source": "Sieht aus als hättest du einen Seltenen!",
      "Trans": {"SC":"你钓到了一条罕见的鱼！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1184155556",
      "Source": "Bereit, den Großen zu fangen?",
      "Trans": {"SC":"准备好钓一条大鱼了吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::551440113",
      "Source": "Beeilen wir uns - Zeit, ins Ziel zu kommen!",
      "Trans": {"SC":"钓鱼时间！挥杆吧！ ","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3807691520",
      "Source": "Diese Fische betteln darum, gefangen zu werden...",
      "Trans": {"SC":"鱼儿迫不及待要上钩了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3413990641",
      "Source": "Lust auf ein bisschen Angeln?",
      "Trans": {"SC":"想钓会儿鱼吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1660079974",
      "Source": "Nun, das ist ein entspannter Ort zum Fischen...",
      "Trans": {"SC":"这里是一处钓鱼的好地方……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3364918596",
      "Source": "Das ist das Zeug, aber wir brauchen viel mehr.",
      "Trans": {"SC":"是它没错，不过我们还需要更多。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1970213445",
      "Source": "Gut gemacht! Lass uns mehr finden.",
      "Trans": {"SC":"干得好！让我们继续寻找。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4090749720",
      "Source": "Lust, etwas zu sammeln?",
      "Trans": {"SC":"要开始收集吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1612471341",
      "Source": "Lass uns sehen wie gut du sammelst.",
      "Trans": {"SC":"让我们看看你是否擅长收集。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3416915688",
      "Source": "Ich habe diesen T-Rex aus der Simulation eliminiert, aber ... warte mal kurz ... jetzt hat die Simulation mich aus dem System gesperrt. Das sollte sie nicht tun können!",
      "Trans": {"SC":"我把那条霸王龙从模拟系统中删除了，但是……稍等一下……我被系统锁在外面了。不该是这样的啊！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::685662309",
      "Source": "Wow. Das lag an mir – es hat etwas gedauert, um herauszufinden, wie man den T-Rex löschen kann. Und jetzt hat die Simulation mich ausgesperrt. Warum tut sie das?",
      "Trans": {"SC":"好险。怪我怪我——我花了点时间才弄清楚如何删除那条霸王龙。然而模拟系统把我锁在外面了。它为什么会这么做呢？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::714032315",
      "Source": "Was macht ein T-Rex hier? Das ist nicht Teil des Tests!",
      "Trans": {"SC":"为什么会有霸王龙？这不是测试的一部分！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1738429202",
      "Source": "Pass auf! Es ist ein T-Rex – und der sollte nicht hier sein!",
      "Trans": {"SC":"当心！那是一条霸王龙——它不该出现在这里！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1019634777",
      "Source": "Wir haben nicht genug bekommen, doch wir können es später wieder probieren.",
      "Trans": {"SC":"我们收集到的数量不够，不过等下我们可以再试试。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::508137700",
      "Source": "Ich habe dich eher für einen „Jäger“ als einen „Sammler“ gehalten.",
      "Trans": {"SC":"我觉得你更像一位猎人，而不是收集者。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2388395072",
      "Source": "Das war schwerer, als es den Anschein hatte, nicht?",
      "Trans": {"SC":"这比看上去的难多了，是吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1906077306",
      "Source": "Trotz unseres T-Rex Problems am Ende hast du den Test bestanden. Gut gemacht! Und ich schaue mir an, warum ich nicht mehr auf Teile der Simulation zugreifen kann.",
      "Trans": {"SC":"尽管我们最后出现了霸王龙的问题，但是你通过了测试。你真棒！我现在去调查一下为什么我无法完全访问模拟系统。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1443657683",
      "Source": "Ich tüftle aus, warum sich die Simulation nicht richtig verhält, doch bis dahin ... hast du den Test bestanden! Entschuldige, dass ich mich so zurückgehalten habe.",
      "Trans": {"SC":"我要弄清楚为什么模拟系统会出问题，但与此同时……你通过了测试！至于你刚才被咬了，我感到很抱歉。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2845475965",
      "Source": "Ja, das ist das Zeug.",
      "Trans": {"SC":"哈哈，是它没错！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1073583100",
      "Source": "Holen wir etwas mehr davon!",
      "Trans": {"SC":"让我们再收集一点吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::264842321",
      "Source": "Genau das, wonach wir suchen!",
      "Trans": {"SC":"正是我们要的！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::71113974",
      "Source": "Ich glaube, wir sind etwas vom Weg abgekommen ...",
      "Trans": {"SC":"我想我们有点迷路了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3888883654",
      "Source": "Hier gibt's nichts zu sammeln.",
      "Trans": {"SC":"这里没有什么可收集的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::728667033",
      "Source": "Ich denke, wir müssen uns fortbewegen.",
      "Trans": {"SC":"我觉得我们需要换地方了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2832679166",
      "Source": "Okay! Hast du Lust, etwas zu plündern?",
      "Trans": {"SC":"想玩寻宝游戏吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3775951042",
      "Source": "Zeit, etwas herumzustöbern – ähm, zu sammeln!",
      "Trans": {"SC":"想去……淘宝吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1787874959",
      "Source": "Fangen wir mit dem Sammeln an!",
      "Trans": {"SC":"让我们去收集吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3526789900",
      "Source": "Wir haben's geschafft! Das sollte mehr als genug sein.",
      "Trans": {"SC":"我们成功了！这些应该够了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::938974373",
      "Source": "Das nenne ich erfolgreiches Sammeln.",
      "Trans": {"SC":"收集工作就该像这样做嘛！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3189022385",
      "Source": "Du hast es geschafft. Gut gemacht!",
      "Trans": {"SC":"全部搞定。干得好！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3121242435",
      "Source": "Bald wird sich ein weiterer Zugang zeigen. Mach dich bereit!",
      "Trans": {"SC":"又一个传送门即将出现。做好准备！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4263149742",
      "Source": "So weit, so gut. Doch ein weiterer Zugang sollte bald erscheinen.",
      "Trans": {"SC":"目前情况还不错，但马上又会出现一个传送门。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::322268077",
      "Source": "Entspann dich noch nicht, Überlebender. Ein weiterer Zugang kommt!",
      "Trans": {"SC":"生存者， 先别大意——传送门又要开启了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3195125922",
      "Source": "Bist du für den Spießrutenlauf bereit?",
      "Trans": {"SC":"你准备好迎接……大挑战了吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::719441075",
      "Source": "Mach deine Waffe bereit, Überlebender? Wir haben einen Spießrutenlauf vor uns!",
      "Trans": {"SC":"生存者，拿起你的武器。大挑战在等着我们。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3536776019",
      "Source": "Die Simulation will uns testen, mit dem Spießrutenlauf!",
      "Trans": {"SC":"模拟系统想让我们进行大挑战测试！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::783430161",
      "Source": "Du bist fast da...",
      "Trans": {"SC":"非常接近了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2780706421",
      "Source": "Wir kommen näher...",
      "Trans": {"SC":"我们很靠近了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1051987887",
      "Source": "Jetzt fast da.",
      "Trans": {"SC":"差不多了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::507668446",
      "Source": "Bereit für einen Test, Überlebender?",
      "Trans": {"SC":"生存者，准备好测试了吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4232873657",
      "Source": "Ich bin neugierig zu sehen, was du tun kannst, Überlebender.",
      "Trans": {"SC":"我迫不及待要看你的表现了，生存者。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3749174830",
      "Source": "Zeit, ein wenig anzugeben, oder?",
      "Trans": {"SC":"轮到你大显身手了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1101300302",
      "Source": "Okay, fangen wir an!",
      "Trans": {"SC":"好的，让我们开始吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1175013743",
      "Source": "Wer hat Lust auf etwas Aufregung?",
      "Trans": {"SC":"谁想搞点小破坏？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3782937229",
      "Source": "Mal sehen, was wir damit machen können.",
      "Trans": {"SC":"看看我们能做点什么。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4102728580",
      "Source": "Sie kommen näher...",
      "Trans": {"SC":"他们快追上来了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1669425286",
      "Source": "Los, schneller -- sie holen auf!",
      "Trans": {"SC":"再快点——他们要追上我们了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3399622380",
      "Source": "Unser Vorsprung nimmt ab...",
      "Trans": {"SC":"我们的领先优势正在消失……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3861787762",
      "Source": "Geh dorthin!",
      "Trans": {"SC":"往那里走！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::70569443",
      "Source": "Lass uns dorthin gehen!",
      "Trans": {"SC":"去那里吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1649227422",
      "Source": "Mach dich dorthin auf den Weg!",
      "Trans": {"SC":"向那里进发！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1690126393",
      "Source": "Ganz ruhig – hier kommen sie!",
      "Trans": {"SC":"做好准备——它们来了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2843496577",
      "Source": "Hier kommt eine weitere Welle!",
      "Trans": {"SC":"又来了一波！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2962358558",
      "Source": "Noch mehr – und sie kommen schnell näher.",
      "Trans": {"SC":"还没完——它们正在快速接近中。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1735323821",
      "Source": "Gefahr! Auf dem Weg zu uns!",
      "Trans": {"SC":"危险！朝我们来了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::698896698",
      "Source": "Gefahr kommt – und schnell!",
      "Trans": {"SC":"麻烦马上出现！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1517388196",
      "Source": "Etwas kommt – pass auf!",
      "Trans": {"SC":"有什么东西过来了——注意！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1842388667",
      "Source": "Da ist es!",
      "Trans": {"SC":"有了","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4066160744",
      "Source": "Wir sind ganz nah!",
      "Trans": {"SC":"我们快完成了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3998307462",
      "Source": "Fast da...",
      "Trans": {"SC":"差不多了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1960850862",
      "Source": "Entschuldige . ich hätte dich besser vorbereiten sollen!",
      "Trans": {"SC":"抱歉——我应该让你再准备的充分一些！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2918607451",
      "Source": "Ganz ruhig, wir versuchen es nochmal, wenn du bereit bist.",
      "Trans": {"SC":"等你准备好之后，我们再试一次吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3618335345",
      "Source": "Das lief nicht ganz nach Plan.",
      "Trans": {"SC":"呃，计划不是这样子的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3221630879",
      "Source": "Wir haben es nicht geschafft, aber ... probieren wir's nochmal?",
      "Trans": {"SC":"我们失败了，不过……让我们再试一次吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4275518895",
      "Source": "Das war schwerer, als ich dachte.",
      "Trans": {"SC":"这比我预想中难多了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1943978901",
      "Source": "Wir sind hier fertig.",
      "Trans": {"SC":"完成了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::252888124",
      "Source": "Na, das wär geschafft.",
      "Trans": {"SC":"任务结束。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4274139768",
      "Source": "Zeit, aufzuhören.",
      "Trans": {"SC":"到结束的时候了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4134463923",
      "Source": "Du hast bestanden -- mit wehenden Fahnen!",
      "Trans": {"SC":"你通过了——撒花！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1556745584",
      "Source": "So wird's gemacht, oder?",
      "Trans": {"SC":"就是这样子，对吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3418826461",
      "Source": "Gut gemacht!",
      "Trans": {"SC":"你真棒！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1904006916",
      "Source": "Genau so!",
      "Trans": {"SC":"就是这样！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2124813201",
      "Source": "Weiter so!",
      "Trans": {"SC":"继续保持！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2990145027",
      "Source": "Toll gemacht, Überlebender.",
      "Trans": {"SC":"干得不错，生存者！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1090389101",
      "Source": "Nicht gerade perfekt, hätte aber viel schlechter sein können.",
      "Trans": {"SC":"不算完美，但也不差。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::590588618",
      "Source": "Das ist was für Experten, wirklich.",
      "Trans": {"SC":"专家级的水平。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2716740094",
      "Source": "Gute Wahl, Überlebender!",
      "Trans": {"SC":"生存者，你拿到了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2397150",
      "Source": "Das ist es, was du brauchst!",
      "Trans": {"SC":"你需要的就是它！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4187185621",
      "Source": "Das ist es, was du möchtest!",
      "Trans": {"SC":"你想要的就是它！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::526028049",
      "Source": "Hier sind ein paar Hexagons für den Austausch.",
      "Trans": {"SC":"这些是你赚来的钱。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::303250939",
      "Source": "Oh! Du hast ein paar Hexagons bekommen!",
      "Trans": {"SC":"哈！你获得了一些六角币！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3518330180",
      "Source": "Du hast dir diese Hexagons verdient.",
      "Trans": {"SC":"这些六角币是你应得的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::555456512",
      "Source": "Los, weiter, Überlebender!",
      "Trans": {"SC":"生存者，动起来！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3933245106",
      "Source": "Beeil dich! Wir können keine Zeit verschwenden.",
      "Trans": {"SC":"快点！我们赶时间。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2158292568",
      "Source": "Schneller! Uns läuft die Zeit ab.",
      "Trans": {"SC":"速度！我们要没时间了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::552134817",
      "Source": "Du bist einer der Besten in der Simulation!",
      "Trans": {"SC":"你在模拟系统中名列前茅！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4190005017",
      "Source": "Sieh dich dort in der Bestenliste an!",
      "Trans": {"SC":"你的名字在排行榜上！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2009134971",
      "Source": "Du bist fast an der Tabellenspitze!",
      "Trans": {"SC":"你位于排行榜的前列！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1977559319",
      "Source": "Du bist der Beste in der Simulation!",
      "Trans": {"SC":"你是模拟系统中最厉害的人！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::70049716",
      "Source": "Sieh dich an -- oben an der Tabellenspitze!",
      "Trans": {"SC":"瞧瞧你，引领排行榜！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2949144156",
      "Source": "Du bist der Erste in der Simulation!",
      "Trans": {"SC":"你在模拟系统中是第一名！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2250406820",
      "Source": "Du führst!",
      "Trans": {"SC":"你领先了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::618871679",
      "Source": "Aktuell führst du!",
      "Trans": {"SC":"你目前领先！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1429617172",
      "Source": "Wir sind Erster... fürs Erste!",
      "Trans": {"SC":"我们现在是……第一名！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1789026900",
      "Source": "Nur noch ein paar mehr...",
      "Trans": {"SC":"还要再收集点……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1822839827",
      "Source": "Hol etwas mehr...",
      "Trans": {"SC":"还差一点……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1385777573",
      "Source": "Wir brauchen mehr...",
      "Trans": {"SC":"我们需要更多……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4117286271",
      "Source": "Mann, das war hart!",
      "Trans": {"SC":"天呐，刚才太难了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3713280561",
      "Source": "Das ist okay, du kommst wieder zurück.",
      "Trans": {"SC":"没事，你又回来了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::575758721",
      "Source": "Einen wahren Überlebenden kann man nicht abhalten!",
      "Trans": {"SC":"真正的生存者是不会倒下的！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1239792776",
      "Source": "Hier ist deine Belohnung. Du hast sie verdient!",
      "Trans": {"SC":"这是你应得的奖励！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::307609403",
      "Source": "Jeder Job verdient eine Belohnung.",
      "Trans": {"SC":"所有工作都值得奖励。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1557026665",
      "Source": "Zeit zu sehen, was du erhalten hast.",
      "Trans": {"SC":"是时候看看你赢了什么。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::126426898",
      "Source": "Es ist etwas noch Zeit...",
      "Trans": {"SC":"还有时间……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3980159789",
      "Source": "Wir haben noch etwas Zeit übrig...",
      "Trans": {"SC":"还剩点时间……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::401296236",
      "Source": "Wir haben etwas Zeit...",
      "Trans": {"SC":"我们还有一点时间……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2282729717",
      "Source": "Die Zeit ist um, Überlebender.",
      "Trans": {"SC":"生存者，时间到了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1423734983",
      "Source": "Nicht viel Zeit übrig!",
      "Trans": {"SC":"时间不多了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::660753479",
      "Source": "Die Zeit läuft davon!",
      "Trans": {"SC":"快没时间了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1763837988",
      "Source": "Uns läuft die Zeit davon!",
      "Trans": {"SC":"我们没时间了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1481801764",
      "Source": "Warte, Überlebender. Was ist das?",
      "Trans": {"SC":"生存者，等等——这是什么？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1094813730",
      "Source": "Warte 'ne Sekunde und ich scanne das für dich.",
      "Trans": {"SC":"稍等一下，我来替你扫描看看。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::585088345",
      "Source": "Mach mal langsam ... Ich sollte das scannen können.",
      "Trans": {"SC":"等等……让我来扫描一下。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4228297266",
      "Source": "Pass auf, Überlebender!",
      "Trans": {"SC":"生存者，当心。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1749513952",
      "Source": "Sei vorsichtiger.",
      "Trans": {"SC":"加倍小心哟！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2217002503",
      "Source": "Konzentrier dich. Du kannst es.",
      "Trans": {"SC":"集中精神！你可以的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::245364808",
      "Source": "War das nicht eine tolle Jagd?",
      "Trans": {"SC":"这才是完美的狩猎！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2854866126",
      "Source": "Du hast dir eine Trophäe gesichert!",
      "Trans": {"SC":"你为自己赢得了一座奖杯！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2709171057",
      "Source": "Jäger eins, Beute null. Gut gemacht!",
      "Trans": {"SC":"猎人一分，猎物零分。干得好！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1182531151",
      "Source": "Hier ist deine Beute, aber pass auf: Sie ist wild.",
      "Trans": {"SC":"当心了，我们的猎物很凶猛。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3921165229",
      "Source": "Hier ist das Ziel – und es nimmt uns ins Visier!",
      "Trans": {"SC":"我们的目标……正看着我们！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::606346840",
      "Source": "Ziel erfasst. Mach dich zum Kampf bereit!",
      "Trans": {"SC":"目标已确认。准备作战！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2623180218",
      "Source": "Das ist das Ziel. Vorsicht, erschrecke es nicht.",
      "Trans": {"SC":"目标就在那里。小心，不要惊动它。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3951947321",
      "Source": "Ich sehe unsere Beute. Vielleicht können wir uns etwas näher heranschleichen ...",
      "Trans": {"SC":"我看到了我们的猎物。或许我们可以靠得更近一点……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3249684395",
      "Source": "Unser Ziel ist genau dort, und es scheint ganz friedlich zu sein.",
      "Trans": {"SC":"我们的目标就在那里。它看起来很平静。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2361174434",
      "Source": "Lust auf die Jagd zu gehen, Überlebender?",
      "Trans": {"SC":"生存者，想打猎吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::121732762",
      "Source": "Es gibt nichts, was so aufregend ist wie eine Jagd!",
      "Trans": {"SC":"没有比狩猎更刺激的事情了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::77012446",
      "Source": "In der Nähe gibt es Wild. Zeit auf die Jagd zu gehen!",
      "Trans": {"SC":"狩猎时间到！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2996737218",
      "Source": "Auf die Plätze ... fertig ... los!",
      "Trans": {"SC":"各就各位……预备……出发！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1344058644",
      "Source": "3 … 2 … 1 … Starten!",
      "Trans": {"SC":"三二一开始！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3651472003",
      "Source": "Komm, wir vergessen sie!",
      "Trans": {"SC":"让我们甩开他们！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1226346638",
      "Source": "Gib alles!",
      "Trans": {"SC":"使出全力吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3183724550",
      "Source": "Hau rein, Überlebender!",
      "Trans": {"SC":"生存者，铆足劲！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2318021546",
      "Source": "Schneller, Überlebender!",
      "Trans": {"SC":"生存者，再快点！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::894868186",
      "Source": "Auf! Los geht's!",
      "Trans": {"SC":"喂！跑起来！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::118482692",
      "Source": "Los, los. los!",
      "Trans": {"SC":"冲冲冲！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3683383975",
      "Source": "Du schaffst es nächstes Mal, Überlebender.",
      "Trans": {"SC":"等你休息好了，我们再试一次。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1657008797",
      "Source": "Erster! Gut gemacht!",
      "Trans": {"SC":"第一！棒棒哒！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::842650347",
      "Source": "Keiner ist schneller als du!",
      "Trans": {"SC":"你最快了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1249273114",
      "Source": "Kriegen wir eine Ehrenrunde?",
      "Trans": {"SC":"要不要绕场一周？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4195387210",
      "Source": "Das hat Spaß gemacht!",
      "Trans": {"SC":"很有意思！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4165879115",
      "Source": "Kein schlechtes Rennen, oder?",
      "Trans": {"SC":"还可以吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3878443587",
      "Source": "Komm bald wieder!",
      "Trans": {"SC":"下次保准让您满意！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1605589493",
      "Source": "Du bist Dritter. Werde schneller!",
      "Trans": {"SC":"你在第三位。加快速度！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::623448538",
      "Source": "Du bist Zweiter – halte dich nicht zurück!",
      "Trans": {"SC":"你在第二位——使出全力吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2566798743",
      "Source": "Wir sind letzter! Jetzt komm schon!",
      "Trans": {"SC":"垫底了。加油！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::918575582",
      "Source": "Steig wieder auf das Viech! Es gibt ein Rennen!",
      "Trans": {"SC":"坐回去！还在比赛呢","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2417513580",
      "Source": "Wir gewinnen nie, wenn wir laufen. Steig jetzt auf!",
      "Trans": {"SC":"靠两条腿可没法赢。快骑上去！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::795536608",
      "Source": "Keine Zeit für einen Rundgang. Steig wieder auf!",
      "Trans": {"SC":"没时间乱走了。骑上去！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2571090008",
      "Source": "Steig auf, Überlebender! Zeit für ein Rennen...",
      "Trans": {"SC":"生存者，骑好咯！要比赛了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3968902564",
      "Source": "Steig auf und lass uns das Rennen starten!",
      "Trans": {"SC":"骑好后就可以开始了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3980416319",
      "Source": "Du kannst ein Rennen nicht zu Fuß gewinnen. Steig auf!",
      "Trans": {"SC":"靠跑步可赢不了。骑上去！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::6022241",
      "Source": "Ganz ruhig, Überlebender!",
      "Trans": {"SC":"生存者，稳住啊！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2214454290",
      "Source": "Immer weiter so!",
      "Trans": {"SC":"待在赛道上！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::910097026",
      "Source": "Pass auf den Weg auf! Wir erkunden das später.",
      "Trans": {"SC":"注意赛道！我们等会再去探索。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4029949881",
      "Source": "Warte auf uns!",
      "Trans": {"SC":"等等我们！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3791216760",
      "Source": "Das kriegen sie zurück!",
      "Trans": {"SC":"我们会追上来！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::732611558",
      "Source": "Dieser Rennfahrer ist schnell...",
      "Trans": {"SC":"跑的真快啊……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2515639932",
      "Source": "Jag sie davon!",
      "Trans": {"SC":"给他们点颜色看看！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2071330866",
      "Source": "Moin, lahme Ente!",
      "Trans": {"SC":"别灰心，不着急！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2284979139",
      "Source": "Fang uns doch!",
      "Trans": {"SC":"来追我们呀！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1323647461",
      "Source": "Zeit für ein Rennen!",
      "Trans": {"SC":"竞速时间到！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::917445946",
      "Source": "Hast du Lust auf ein Rennen, Überlebender?",
      "Trans": {"SC":"想来比一比吗，生存者？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2101713200",
      "Source": "Du siehst aus, als ob du schnell wärst, doch lass uns das mal testen.",
      "Trans": {"SC":"你看上去速度很快嘛，让我们来实际测一测吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2144691784",
      "Source": "Du gewinnst! Gut gemacht!",
      "Trans": {"SC":"保持住——我们领先！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4254755633",
      "Source": "Bleib dran -- wir sind Erster!",
      "Trans": {"SC":"他们都落后了。我们要保持优势！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2657371659",
      "Source": "Wir sind entkommen. Wow!",
      "Trans": {"SC":"我们脱身了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1182455197",
      "Source": "Es geht doch nichts über eine vernünftige Flucht!",
      "Trans": {"SC":"我们撤离得干净利落！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1096386377",
      "Source": "Und wir sind in Sicherheit, mit unserem Zurückgeholten in der Hand.",
      "Trans": {"SC":"成功完成取回任务。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2393930407",
      "Source": "Zeit, uns aus dem Staub zu machen.",
      "Trans": {"SC":"该离开这里了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1640106574",
      "Source": "Rückholung erfolgt. Nun müssen wir entkommen.",
      "Trans": {"SC":"取回任务完成。现在该跑路了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::89269408",
      "Source": "Alles erledigt. Zeit, hier abzuhauen!",
      "Trans": {"SC":"杀出一条通路！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::447909383",
      "Source": "Da ist unser Ziel!",
      "Trans": {"SC":"这就是我们的目标！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::430647508",
      "Source": "Das ist das, was wir zurückholen müssen.",
      "Trans": {"SC":"我们需要把它拿回来……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::765232634",
      "Source": "Ich habe entdeckt, was wir zurückholen müssen.",
      "Trans": {"SC":"我发现了所需取回的目标。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3375804505",
      "Source": "Das ist ein Rückholtest. Er sollte ziemlich klar sein.",
      "Trans": {"SC":"这是一次取回测试，应该挺简单的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1306420199",
      "Source": "Zuerst zurückholen, dann zurückziehen. Verstanden?",
      "Trans": {"SC":"找到后就撤离。明白吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2621358085",
      "Source": "Denk dran, das ist kein Stehlen. Es ist „zurückholen“.",
      "Trans": {"SC":"记得，这不是偷，是“取”。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3613867594",
      "Source": "Spar dir das Ernten für später auf.",
      "Trans": {"SC":"朋友，等会再捡。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::765941654",
      "Source": "Wir haben jetzt keine Zeit dazu. Wir sind auf einer Mission.",
      "Trans": {"SC":"没时间捡了！我们有任务。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1781793217",
      "Source": "Erst schlachten, dann ernten!",
      "Trans": {"SC":"打完再捡！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1152231202",
      "Source": "Hast du Lust auf etwas Gemetzel?",
      "Trans": {"SC":"你准备好大开杀戒了吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1874265013",
      "Source": "Schauen wir mal, wie schnell du ein paar töten kannst.",
      "Trans": {"SC":"让我们看看你的击杀速度有多快。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4115420661",
      "Source": "Halte deine Waffe bereit – es ist Schlachtzeit!",
      "Trans": {"SC":"准备好你的武器。杀戮时刻开始。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2433792572",
      "Source": "Ist mir je schwindelig? ... Warte!",
      "Trans": {"SC":"我才不会头晕呢……等等！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4318273",
      "Source": "Jetzt müssen wir nur noch überleben? Kinderspiel.",
      "Trans": {"SC":"我们要做的就是生存？太简单了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1038093881",
      "Source": "Du musst das jetzt nur noch überleben.",
      "Trans": {"SC":"老兄，活下去。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3902927868",
      "Source": "Das ist eine einfache Frage des Überlebens. Nur keine Sorge, oder?",
      "Trans": {"SC":"简单的生存考验。不用过于担心，是吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4239898988",
      "Source": "Du hast ein neues Haustier!",
      "Trans": {"SC":"你获得了一只新宠物！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1085959762",
      "Source": "Das ist jetzt ein wirklich zahmes.",
      "Trans": {"SC":"这只训好了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2498487852",
      "Source": "Verdammt, es ist ziemlich mühselig, so etwas zu zähmen!",
      "Trans": {"SC":"得花不少力气才能驯服这样一头野兽！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1666920652",
      "Source": "Das hier ist ein besonders blutrünstiges, nicht? Vielleicht solltest du das nutzen ...",
      "Trans": {"SC":"这家伙特别嗜血。或许我们利用这一点……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::456193725",
      "Source": "Es ist so riesig, dass es sich garantiert nicht selbst putzen kann. Es wäre bestimmt für etwas Hilfe dankbar.",
      "Trans": {"SC":"它体型太大了，没办法清理自己。或许你可以帮帮它……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2150948113",
      "Source": "Es gibt keine stärkere Verbindung als die zwischen Mutter und Kind. Wir sind vielleicht an etwas dran, wenn wir dies ersetzen könnten, nicht?",
      "Trans": {"SC":"没有比母子之情更牢固的关系了。但如果我们能想出替代方案，或许会有新发现？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2886583780",
      "Source": "Bist du bereit, zu testen, wie du zähmen kannst?",
      "Trans": {"SC":"准备好测试一下你的驯服技巧了吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3165180848",
      "Source": "Um diese Herausforderung zu bewältigen, musst du ein wildes Tier zähmen!",
      "Trans": {"SC":"为了战胜这个挑战，你必须驯服这头凶猛的野兽！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2727249077",
      "Source": "Probier's mal. Es ist Zeit zum Zähmen!",
      "Trans": {"SC":"试试驯一只吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3835635898",
      "Source": "Dein Waffenschaden wird erhöht.",
      "Trans": {"SC":"他们调高了你的武器伤害。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3337743332",
      "Source": "Deine Verteidigung wird anscheinend gestärkt.",
      "Trans": {"SC":"你获得了防御强化。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1218501127",
      "Source": "Die Parameter der Genesis-Simulation sind wieder normal. Immerhin hatten wir dabei Spaß ...",
      "Trans": {"SC":"创世模拟系统的参数恢复正常值了。其实那还挺有趣的……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1340861527",
      "Source": "Deine Ernteraten erhöhen sich, Überlebender.",
      "Trans": {"SC":"他们调高了采集倍率。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2155995907",
      "Source": "Die Parameter der Genesis-Simulation verändern sich ...",
      "Trans": {"SC":"创世模拟系统的参数正在变化……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1410307476",
      "Source": "Du erhältst einen Erfahrungsbonus, Partner.",
      "Trans": {"SC":"你获得了经验值加成。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    }
  ],
  //过场动画语音 - 2026-07-26 10:39:28
  "Cinematics": [],
  //商店语音 - 2026-07-26 10:39:28
  "Store": []
}
