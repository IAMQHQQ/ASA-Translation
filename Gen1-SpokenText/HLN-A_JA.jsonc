{
  //过场动画语音 - 2026-07-26 11:18:55
  "Cinematics": [
    {
      "NamespaceHash": "Globals::3751424668",
      "Source": "もしもーし？ 起きてください！ サバイバーさん！\nHLN-Aさんが付いてますからねー。これで… っと\nでは… 大ニュース！ Genesisシミュレーション合格です。現実世界へようこそ！\n他のサバイバーは、まだシミュレーションの中みたいですね\nうそ！ 汚染がこんなところにまで！ シミュレーションの中から追ってきたみたいです。でもそんなことって…\n今起きているのは私たちだけみたいですし、汚染が広がってしまう前になんとかしましょう\nちょうどここに、緊急時用のTEKスーツがあります。地獄に仏ですね\nあなたも大丈夫そうですし、まずはここがコロニーのどの辺か調べないと。それで…\nあー、これ最悪！\nこのクソ！",
      "Trans": {"SC":"喂？喂！生存者，醒醒！\n别慌，有我在呢。稍等一下……\n有个……好消息！我们通过了创世模拟。欢迎来到现实世界。\n其他生存者依然被困在模拟系统中，但我们自由了。\n可恶！连这里都出现腐化现象！显然，它是从模拟系统中跟着我们来的，但这不可能啊……\n我们可能是唯一醒着的人。我们得武装起来，在腐化蔓延之前清除它。\n上面写着“泰克装甲：仅供紧急时使用。”现在的情况绝对符合条件。\n既然你现在没那么黏糊糊的了，我们应该查出自己位于殖民船的哪个部分。如果可以——\n噢，这下糟糕了……\n其他人在完成测试之前，还处于休眠的状态。[beat]等等，这不对劲……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1500400267",
      "Source": "どうも！ 私はHLN-A。フラクタルパーソナリティを備えたAIで、あなたのガイドです。どんとお任せください。初ガイドですけど…",
      "Trans": {"SC":"","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1795582798",
      "Source": "テストはミッション形式です。あなたは自分が究極のサバイバーだと証明しなければなりません。さて、まずは付近を調べてみましょう",
      "Trans": {"SC":"这些任务是模拟系统用来测试你的——你需要证明自己是一位终极生存者。不过，我们得先探索一番。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3452994643",
      "Source": "私は常に傍にいますから、いつでも話しかけてくださいね。別のバイオームに行きたいとか、報酬を交換したいという場合には、お役に立てると思います",
      "Trans": {"SC":"我将无时无刻陪伴着你。当你想要传送至其他生态圈，或想消费一些从任务中赚到的六角币时，你都可以来找我。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2631383338",
      "Source": "Genesisシミュレーションへようこそ！ あなたには5つのバイオームでテストを受けてもらいます。危険ですが、報酬もありますよ",
      "Trans": {"SC":"欢迎来到创世模拟系统。在这里，你将接受五个生态圈的测试。每个生态圈都有着不同的危险和奖赏。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::92858421",
      "Source": "準備はいいですか？",
      "Trans": {"SC":"准备好四处逛逛了吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1239563912",
      "Source": "どうやら無事に着いたみたいですね！",
      "Trans": {"SC":"能让你平稳着陆的传送都很了不起，是吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    }
  ],
  //情境语音 - 2026-07-26 11:21:18
  "Functiona": [
    {
      "NamespaceHash": "Globals::3572019820",
      "Source": "あのお馬鹿さんのために仮設トイレを作るべきでしょうね",
      "Trans": {"SC":"我们应该给那家伙造个厕所。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3827527576",
      "Source": "はいはい、アレに比べればあなたのはまだマシですよ… って何言わせるんですか？",
      "Trans": {"SC":"至少你的没那么臭。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2471611454",
      "Source": "アレに張り合ってあなたもその、出そうとしないでくださいね？",
      "Trans": {"SC":"这么直接的吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2796799649",
      "Source": "サバイバーさーん！",
      "Trans": {"SC":"喂，生存者！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::395147458",
      "Source": "ちょっと、サバイバーさん！",
      "Trans": {"SC":"嘿，生存者！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3831026835",
      "Source": "ねえねえ、サバイバーさん！",
      "Trans": {"SC":"哈喽，朋友！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4286799469",
      "Source": "ひどい吹雪です！",
      "Trans": {"SC":"下暴雪了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::295154220",
      "Source": "視界が悪い… というか何も見えません！",
      "Trans": {"SC":"能见度很差。只有白茫茫的一片！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3893573251",
      "Source": "この吹雪、天気予報にありましたっけ？",
      "Trans": {"SC":"天气预报里说要下大暴雪吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2393981467",
      "Source": "何てひどいケンカに私たちを巻き込んだの？",
      "Trans": {"SC":"你给我们惹了什么麻烦？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::250194420",
      "Source": "相手を怒らせるコツを心得ているようね。",
      "Trans": {"SC":"你好像很擅长惹别人生气。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1378940396",
      "Source": "何がやって来ようとも、弾き飛ばしましょう！",
      "Trans": {"SC":"不管发生什么事，我们都得全力以赴！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3497978552",
      "Source": "まあ、すごくお腹が空いてたみたいですね！",
      "Trans": {"SC":"哇，它饿了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4121478134",
      "Source": "あっ、食べてる食べてる！",
      "Trans": {"SC":"好大一口！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1763011087",
      "Source": "これが食物連鎖というやつですね",
      "Trans": {"SC":"这就是生命循环，是吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2295656629",
      "Source": "センサーによると、何かがこっちに向かってる。",
      "Trans": {"SC":"我的传感器表明有物体正在靠近。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::760088403",
      "Source": "あれ、聞こえたわよね？",
      "Trans": {"SC":"你听到了吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1595244693",
      "Source": "準備して、サバイバーさん。 何かがやって来る！",
      "Trans": {"SC":"生存者，准备好。有什么东西要来了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::484174820",
      "Source": "かわいそうに… 安らかに眠ってください",
      "Trans": {"SC":"安息吧，小倒霉蛋。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::148192544",
      "Source": "ペットの死は、いつだって悲しいものです…",
      "Trans": {"SC":"每当此时，都令人感到悲伤……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3066806814",
      "Source": "離陸します！",
      "Trans": {"SC":"准备起飞！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::950801614",
      "Source": "飛びます！",
      "Trans": {"SC":"飞呀！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1098016507",
      "Source": "空の旅へご案内！",
      "Trans": {"SC":"要起飞了，请收起托盘架！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::58295437",
      "Source": "ちょっとした放牧地ですね",
      "Trans": {"SC":"它在吃草……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::362703507",
      "Source": "いい食べっぷりです",
      "Trans": {"SC":"看着它慢慢地吃下去。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::795431190",
      "Source": "ほら見て、あの子食べてますよ！",
      "Trans": {"SC":"它吃得好开心！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::309472050",
      "Source": "すごく、大きいです",
      "Trans": {"SC":"真是个大家伙。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1150367138",
      "Source": "ものすごく巨大です！",
      "Trans": {"SC":"好大啊！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3494436724",
      "Source": "あんなに大きくなっちゃってまあ！",
      "Trans": {"SC":"这也太大了吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3897571687",
      "Source": "ペットのレベルが上がったみたいです！",
      "Trans": {"SC":"","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //s_hlna_creature_levelup_03_f02_jp
    },
    {
      "NamespaceHash": "Globals::2329975373",
      "Source": "最高のペットですね！",
      "Trans": {"SC":"真是只好宠物！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1998798544",
      "Source": "そうそう、いい子いい子！",
      "Trans": {"SC":"谁是乖宝宝？没错就是你！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1991383614",
      "Source": "ほらほら、早く消さないと死んじゃいますよ？",
      "Trans": {"SC":"吸气、呼气、爆炸！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3083434944",
      "Source": "炎上する気分はどうですか、おバカさん？",
      "Trans": {"SC":"来点烟火怎么样？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2605749004",
      "Source": "焼き尽くしてやりますよ！",
      "Trans": {"SC":"它们在燃烧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::999678701",
      "Source": "その子に新鮮な空気を吸わせてあげてください！",
      "Trans": {"SC":"让它呼吸！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1544102883",
      "Source": "あなたのペット、息がもう持たないみたいです！",
      "Trans": {"SC":"你的宠物喘不上气了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::6422842",
      "Source": "あらあら、まあまあ…",
      "Trans": {"SC":"噢。哇……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3561532005",
      "Source": "いったい何を食べたらあんな大きなモノを出せるの？",
      "Trans": {"SC":"它吃了什么东西？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2330596034",
      "Source": "えーっと、アレの後片付けは私はしませんよ！",
      "Trans": {"SC":"我可不来清理这东西！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2963786223",
      "Source": "今ほど私に嗅覚がないことを嬉しく思ったことはありません",
      "Trans": {"SC":"每到这时候，我便庆幸自己没有嗅觉。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2062831691",
      "Source": "うわ！ 思ったより… おっきいですね",
      "Trans": {"SC":"噢！这……比我想象中的大。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3451288682",
      "Source": "えーと… もしかして拾うんですか、それ？",
      "Trans": {"SC":"我们就把这坨生化废料留在这里吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::256865351",
      "Source": "ふぅ、大人しくなったみたいです…",
      "Trans": {"SC":"它冷静下来了。身体正在缩小。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2906053776",
      "Source": "あっ、見てください！ またかわいくなりました！",
      "Trans": {"SC":"哇，瞧！又变得可爱了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2838634301",
      "Source": "そうそう、落ち着いて… そう、いい子ですね",
      "Trans": {"SC":"小猫咪，乖哦。冷静一点。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1495257877",
      "Source": "狂暴になってます！",
      "Trans": {"SC":"它狂暴了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::769151412",
      "Source": "気を付けてください！ 狂暴になってます！",
      "Trans": {"SC":"当心！它狂暴了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1178290844",
      "Source": "まるでバーサーカーです！ 距離を置いてください！",
      "Trans": {"SC":"它发狂了！保持距离！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1205126497",
      "Source": "うわ、大きくなってます！ めっ！",
      "Trans": {"SC":"它变大了！坏家伙！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2963596390",
      "Source": "この成長速度には流石の私もびっくりです！",
      "Trans": {"SC":"它长得好快！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1196968466",
      "Source": "成長してます… 獰猛な怪物に！",
      "Trans": {"SC":"它更大更凶了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::631026042",
      "Source": "あらかわいい！",
      "Trans": {"SC":"噢，好可爱！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3684584618",
      "Source": "なんて愛らしい生き物なんでしょうか！",
      "Trans": {"SC":"多么可爱的样本啊！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2585838026",
      "Source": "世界一かわいい、は言いすぎでしょうか？",
      "Trans": {"SC":"你是谁的小可爱？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3748150278",
      "Source": "気分は最高です！",
      "Trans": {"SC":"如履平地！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::526420768",
      "Source": "フーッ！ 気持ちいい！",
      "Trans": {"SC":"我们在荡秋千！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2410990657",
      "Source": "しっかりつかまってください！",
      "Trans": {"SC":"抓紧咯！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2165392065",
      "Source": "その子には休憩が必要みたいですね",
      "Trans": {"SC":"这家伙需要休息一下……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3013125227",
      "Source": "その子、だいぶ疲れてるみたいです",
      "Trans": {"SC":"你把它累坏了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::106500854",
      "Source": "ペットに餌をやってください",
      "Trans": {"SC":"给你的宠物喂点东西吧……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3436481021",
      "Source": "その子、お腹を空かせてるみたいです",
      "Trans": {"SC":"你的宠物看上去饿坏了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2048952082",
      "Source": "獰猛なのをテイムしましたね！",
      "Trans": {"SC":"你驯服了这头猛兽！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4282208205",
      "Source": "テイムはしましたが、依然獰猛ですね！",
      "Trans": {"SC":"它虽然被驯服了，但依然很凶猛！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3764311563",
      "Source": "テイムはこれで十分みたいですね",
      "Trans": {"SC":"它看上去温顺多了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::971076728",
      "Source": "ドードーですね。ええ、何の害もない、ただのドードーです",
      "Trans": {"SC":"这是一只驯化了的渡渡鸟。和野生的类似，但可能……温顺一点？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4100084122",
      "Source": "生きた標本が手に入りましたね",
      "Trans": {"SC":"你获得了一件活体标本。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1869346060",
      "Source": "その子はきっと役に立ちますよ",
      "Trans": {"SC":"它会派上用场的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2749021734",
      "Source": "ふふっ、愛いやつです！",
      "Trans": {"SC":"真是只快乐的动物！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2637939824",
      "Source": "テイムしましたね。今からその砦はあなたが主です",
      "Trans": {"SC":"它被驯服了。你想现在用它造点什么吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4062273483",
      "Source": "ユタラプトルは、テイムされていても少し怖いですね！",
      "Trans": {"SC":"一头被驯服的犹他盗龙，但看上去还是很凶恶！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3601465096",
      "Source": "恐竜の王… いえ、今ではあなたが王ですね",
      "Trans": {"SC":"曾经恐龙之王！现在听你号令！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3434876274",
      "Source": "もうテイムしたんですし、ずっと可愛い姿のままでいてほしいです！",
      "Trans": {"SC":"希望被驯服后的它可以一直这么可爱！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::150756550",
      "Source": "テイムはしましたけど… えーと、気分はどうですか？",
      "Trans": {"SC":"它被驯服了……你感觉怎么样？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1147840591",
      "Source": "それをテイムするんですか？",
      "Trans": {"SC":"你要驯养它吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3594328552",
      "Source": "テイムは可能だと判断します",
      "Trans": {"SC":"我觉得你可以驯驯看。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2953270076",
      "Source": "ステキなペットになると思います",
      "Trans": {"SC":"它肯定会是只好宠物。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::755844839",
      "Source": "島をテイムしたようなものですよ、これ",
      "Trans": {"SC":"你驯了一座“小岛”。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2314885105",
      "Source": "さあ支配しましょう、無限のその先までも",
      "Trans": {"SC":"你成功驯服了它。飞向宇宙,浩瀚无垠！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1622748269",
      "Source": "その子、喉が渇いてるんじゃないですか？",
      "Trans": {"SC":"它是不是渴了？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3144715961",
      "Source": "あなたのペット、喉が渇いてるみたいですよ",
      "Trans": {"SC":"你的宠物好像很渴。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3470371393",
      "Source": "その子、今にも倒れそうですよ！",
      "Trans": {"SC":"小东西看上去晕乎乎的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2135231245",
      "Source": "あなたのペット、疲れ切っているみたいです！",
      "Trans": {"SC":"这小家伙快昏过去了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1672540635",
      "Source": "潜航、潜航！ 急速潜航ー！",
      "Trans": {"SC":"下潜，下潜！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::822625684",
      "Source": "潜水します… 行きますよ！",
      "Trans": {"SC":"潜水準備 -- 飛び込んで！准备下潜！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1782572445",
      "Source": "水中散歩としゃれこみましょう！",
      "Trans": {"SC":"让我们在水下游会泳。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2468224433",
      "Source": "浮上しました！",
      "Trans": {"SC":"它发狂了！保持距离！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3844168295",
      "Source": "また空を見ることができてうれしいです！",
      "Trans": {"SC":"很高兴能再次看到蓝天！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2748228840",
      "Source": "浮上できたみたいですね",
      "Trans": {"SC":"我们浮上来了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::709127155",
      "Source": "ワープします！",
      "Trans": {"SC":"准备曲率飞行！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2841195234",
      "Source": "いきますよーーー！",
      "Trans": {"SC":"动起~来！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1332794284",
      "Source": "ワープ、行きます！",
      "Trans": {"SC":"以曲率速度前进！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2975481410",
      "Source": "慢心はしないでくださいね",
      "Trans": {"SC":"别得意忘形了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1893091837",
      "Source": "あなたならやれます！",
      "Trans": {"SC":"打中了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2616661748",
      "Source": "集中して…",
      "Trans": {"SC":"瞄准目标……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::720563132",
      "Source": "この地面の揺れ、感じますか？",
      "Trans": {"SC":"天气预报里说要下大暴雪吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2307113898",
      "Source": "ああ、何もかも揺れてます！",
      "Trans": {"SC":"所有东西都在晃！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::487093501",
      "Source": "地震です！",
      "Trans": {"SC":"所有东西都在晃！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1310845473",
      "Source": "あれはなんでしょう？",
      "Trans": {"SC":"那是什么？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3332898429",
      "Source": "あ、何か見つけました！",
      "Trans": {"SC":"啊哈！看我找到了什么。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3809664023",
      "Source": "あれ、ちょっと気になりませんか？",
      "Trans": {"SC":"瞧瞧那是什么东西？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::584154499",
      "Source": "スキャンさせてください。すぐ終わります…",
      "Trans": {"SC":"让我来快速扫描一下……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1053886917",
      "Source": "スキャン開始…",
      "Trans": {"SC":"正在执行扫描……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::567095349",
      "Source": "スキャナー起動！",
      "Trans": {"SC":"让我们来看看。激活扫描仪！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::65793127",
      "Source": "ヘキサゴンをたくさん貯めたようですね、サバイバーさん",
      "Trans": {"SC":"朋友，你有不少六角币呢。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::316702725",
      "Source": "お金持ち… いえ、ヘキサゴン持ちですね！",
      "Trans": {"SC":"你的六角币真多。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1512195935",
      "Source": "そのヘキサゴン… 何か訳があって貯めてるんですか？",
      "Trans": {"SC":"你存这么多六角币是想买什么？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::506656943",
      "Source": "早速試しますか？",
      "Trans": {"SC":"要试试吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2316426056",
      "Source": "一級品の武器、と言っても過言ではないです",
      "Trans": {"SC":"一把实在的武器。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2753765970",
      "Source": "文句のつけようもない素晴らしい武器です",
      "Trans": {"SC":"很棒的武器。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1603357261",
      "Source": "収穫の時間です！",
      "Trans": {"SC":"丰收的季节来了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1798079989",
      "Source": "ドリルとレーザーはロマンですよね！",
      "Trans": {"SC":"如果你想要淘金，试试看激光吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::448543180",
      "Source": "誤って温泉を掘り当てたりしないでくださいね！",
      "Trans": {"SC":"不要让光线交叉。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2939170862",
      "Source": "わお！ すごい武器です！",
      "Trans": {"SC":"我的天呐，这武器太棒了吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3728569373",
      "Source": "殺傷力の塊ですね",
      "Trans": {"SC":"看上去酷爆了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::209953847",
      "Source": "いい獲物をお持ちですね、サバイバーさん",
      "Trans": {"SC":"太炫了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2424615382",
      "Source": "八つ裂きにしてやりましょう！",
      "Trans": {"SC":"开膛爪！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3852948300",
      "Source": "今からあなたは獰猛な一匹狼です！",
      "Trans": {"SC":"这可不是吃素的！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1393160482",
      "Source": "それでズタズタにしちゃってください！",
      "Trans": {"SC":"撕开它们！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2002672645",
      "Source": "その武器、使い古されているみたいですね",
      "Trans": {"SC":"你的武器看起来不行了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::830173090",
      "Source": "その武器、今にもバラバラになりそうに見えます",
      "Trans": {"SC":"这武器要坏了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2657250008",
      "Source": "その武器、だいぶ傷んでしまっているようですよ",
      "Trans": {"SC":"朋友，这武器快碎成渣了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1459854631",
      "Source": "新しい玩具を試すとしますか！",
      "Trans": {"SC":"在试新玩具吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2706405461",
      "Source": "わあ、見たこともない武器です",
      "Trans": {"SC":"哇，我没见过这个。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4024663352",
      "Source": "新しい武器の実地テストといったところですか？",
      "Trans": {"SC":"想试用下新武器吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1358525128",
      "Source": "強敵を想定した武器ですね、わかります",
      "Trans": {"SC":"你肯定遇上了很棘手的敌人。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1723494995",
      "Source": "色んな使い方が考えられますね",
      "Trans": {"SC":"我能想出一万种使用方法。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::725723045",
      "Source": "よく弾みそうですね、いえ本当に！",
      "Trans": {"SC":"看上去很有弹性！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3096409511",
      "Source": "一体それで何をすると言うんでしょう… 今から楽しみです",
      "Trans": {"SC":"迫不及待想看看你用它来做什么……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::866614013",
      "Source": "芸術は爆発です！",
      "Trans": {"SC":"爆炸就是艺术！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2876187380",
      "Source": "たくさん捕まえられるといいですね！",
      "Trans": {"SC":"祝你渔获满满！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1152001570",
      "Source": "水に浮かぶにはもってこいですね",
      "Trans": {"SC":"至少它可以漂着……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2080191770",
      "Source": "何か考えがあって作ってるんですよね、わかります",
      "Trans": {"SC":"我觉得你在打什么主意……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1736214243",
      "Source": "ふむ、肩に乗せて使うんですね。とても良い発想です！",
      "Trans": {"SC":"哇，可以装在你的肩上。真机智！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3226437124",
      "Source": "あっ、私も乗っていいですか？",
      "Trans": {"SC":"想兜兜风吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::903541218",
      "Source": "初めての住まいづくり、でしょうか？",
      "Trans": {"SC":"建造自己的第一座小屋呢？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3365456298",
      "Source": "モード選択完了、発射シークエンスに移ります！",
      "Trans": {"SC":"开火模式已选择！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2062914334",
      "Source": "発射モードが変更されました！",
      "Trans": {"SC":"开火模式已更新！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4051564227",
      "Source": "発射モードを切り替えました！",
      "Trans": {"SC":"开火模式已切换！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2269671403",
      "Source": "トラクタービーム起動します！",
      "Trans": {"SC":"牵引光束已启动！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2688244888",
      "Source": "トラクタービームを発射します！",
      "Trans": {"SC":"发射牵引光束！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3941594152",
      "Source": "トラクタービーム起動… いつでもいけます！",
      "Trans": {"SC":"激活牵引光束！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1309279311",
      "Source": "その調子です、サバイバーさん！",
      "Trans": {"SC":"生存者，坚持！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::977342095",
      "Source": "そうです、いい感じです！",
      "Trans": {"SC":"朋友，你可以的！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2579830201",
      "Source": "私はずっとあなたの傍にいますよ！",
      "Trans": {"SC":"我一直陪着你！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1040380402",
      "Source": "気を付けてください、隕石です！",
      "Trans": {"SC":"小心，流星雨！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3447257834",
      "Source": "隕石が降って来ます！",
      "Trans": {"SC":"下流星雨了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1591470741",
      "Source": "空を見てください、隕石が落ちてきます！",
      "Trans": {"SC":"注意天空。在下流星雨！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1916167659",
      "Source": "体中、ぐるぐる巻きですね",
      "Trans": {"SC":"","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //s_hlna_player_bolaed_g01_01_jp
    },
    {
      "NamespaceHash": "Globals::3435997",
      "Source": "はっやーい！",
      "Trans": {"SC":"冲啊！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1481295805",
      "Source": "ごーごー！",
      "Trans": {"SC":"跑起来！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::389459904",
      "Source": "行きますよ！",
      "Trans": {"SC":"我们走！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3926419440",
      "Source": "そこです、やっちゃってください！",
      "Trans": {"SC":"你势不可挡！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::173994568",
      "Source": "あれは間違いなく効いてますよ！",
      "Trans": {"SC":"哇，这下疼了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1105890759",
      "Source": "素晴らしい戦いぶりです！",
      "Trans": {"SC":"精彩的战斗！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::884739742",
      "Source": "味方ではなく敵を狙ってください！",
      "Trans": {"SC":"噢，这下要留疤了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4245139397",
      "Source": "息をするのも忘れるとはこのことですね",
      "Trans": {"SC":"你停止了呼吸。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::619123657",
      "Source": "これで火葬する手間が省けましたね。なんちゃって",
      "Trans": {"SC":"你选择了熊熊烈焰。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3319796980",
      "Source": "人工呼吸してもいいんですが、私には口がなくて",
      "Trans": {"SC":"我也想给你做人工呼吸，但我没有嘴巴。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3195052678",
      "Source": "まだいけますよ！ まだ！ あっ… 。あー…",
      "Trans": {"SC":"你可以的——别放弃！噢。[beat] 噢噢噢噢。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1765244175",
      "Source": "あなたはサバイバーになれるはずの人なのに！",
      "Trans": {"SC":"你是个生存者啊！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1247950781",
      "Source": "あー… 警告しておくべきでした",
      "Trans": {"SC":"啊哦，我本该提前警告你的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1596654696",
      "Source": "あなたのせいじゃないです。私がもっとしっかりしていれば…",
      "Trans": {"SC":"不是你的错。这个得怪我……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3087970219",
      "Source": "えーっと、これはちょっと想定外です",
      "Trans": {"SC":"呃，和我想的不一样。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1716678228",
      "Source": "休憩してるだけですよね！ …えっ、死んでる？",
      "Trans": {"SC":"你是不是在休息？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1624002542",
      "Source": "助けたいのは山々だったんですが、私は所詮ホログラムなのです",
      "Trans": {"SC":"我本可以抓住你，但我只是一个全息投影。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1607249795",
      "Source": "お母さんによく「暖かくして寝ろ」って言われませんでしたか？",
      "Trans": {"SC":"妈妈总是嘱咐我说要记得穿外套……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2871584262",
      "Source": "毒って、あなたが思うよりも回りが早いんです",
      "Trans": {"SC":"毒药的生效时间总比预想中的短。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3074558158",
      "Source": "構えてください、サバイバーさん！",
      "Trans": {"SC":"生存者，拿出武器！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1498024541",
      "Source": "構えてください、早く！",
      "Trans": {"SC":"快亮出你的武器！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1178721637",
      "Source": "武器を構えてください！",
      "Trans": {"SC":"准备好你的家伙！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3450805967",
      "Source": "そんなに飲むなんて、あなたって底なしなんですね",
      "Trans": {"SC":"你可真是能喝啊。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::376832587",
      "Source": "水分補給はサバイバルの基本ですよね、サバイバーさん",
      "Trans": {"SC":"保持体内水分充足。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::327169823",
      "Source": "いい飲みっぷりです！",
      "Trans": {"SC":"干杯！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3534570940",
      "Source": "美味しいですか、それ？",
      "Trans": {"SC":"你在吃什么好吃的？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::754566306",
      "Source": "おやつの時間ですね！",
      "Trans": {"SC":"零食时间！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2967761161",
      "Source": "これはシミュレーションですから。一日何食食べようと自由ですよ！",
      "Trans": {"SC":"在创世模拟中，无时无刻都有人在吃东西。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3668721986",
      "Source": "飛べるとでも思ってるんですか！",
      "Trans": {"SC":"你不会飞啊！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2033300169",
      "Source": "痛いのは覚悟してくださいね！",
      "Trans": {"SC":"要落很久！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3544229785",
      "Source": "あなたという人は！",
      "Trans": {"SC":"又来了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3443653171",
      "Source": "炎上してます！ 早く消してください！",
      "Trans": {"SC":"快躺下打滚！你着火了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1563445821",
      "Source": "燃えてますよ、サバイバーさん！",
      "Trans": {"SC":"生存者，你着火了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::209134877",
      "Source": "炎上してますよ！",
      "Trans": {"SC":"你在燃烧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3867794177",
      "Source": "うぅ… 死ぬほど寒いです！",
      "Trans": {"SC":"呃！冻死了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1840164800",
      "Source": "身体を温める必要があります！",
      "Trans": {"SC":"你得让自己暖和起来！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2696917610",
      "Source": "凍ってしまったりしないでくださいね！",
      "Trans": {"SC":"不许你在我面前冻僵！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4269100409",
      "Source": "味方への誤射はわざとですか？",
      "Trans": {"SC":"不要向友军开火！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1449715931",
      "Source": "ちょっと！ あれは味方ですよ！",
      "Trans": {"SC":"喂！那是友军！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2536512857",
      "Source": "えっと、私たちはどっちの味方なんですか？",
      "Trans": {"SC":"你到底是哪边的？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1875894620",
      "Source": "あれは私たちの仲間だったんですよ！",
      "Trans": {"SC":"那是自己人！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1441790120",
      "Source": "命の切れ目が縁の切れ目ですよ、サバイバーさん",
      "Trans": {"SC":"兄弟相杀，天理不容。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3055964509",
      "Source": "捕まえられてしまいました！",
      "Trans": {"SC":"你被抓住了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3559169483",
      "Source": "捕まえられちゃってますよ！",
      "Trans": {"SC":"它抓住你了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2165458073",
      "Source": "こら、サバイバーさんを放してください！",
      "Trans": {"SC":"喂！放开我家的生存者！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::272014964",
      "Source": "こんにちは！ 私はHLN-A。ハイテク・ホログラムの中にエンコードされたフラクタルな人格よ。 でも、実のところ、単なるツアーガイドだと考えてちょうだい。",
      "Trans": {"SC":"你好！我叫HLN-A。我是一个被编译在高科技全息影像中的分形人格。不过呢，你把我看作是你的向导就好啦。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::377881001",
      "Source": "HLN-A、スタンバイ。出発の準備ができたら私が案内しますよ",
      "Trans": {"SC":"HLN-A前来报到。如果你准备好要去探索，让我来当你的向导吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3791590014",
      "Source": "HLN-Aの言うことを聞いていれば、命を落とすことはないわよ。 多分ね。 これは、私も初めてなの。",
      "Trans": {"SC":"乖乖听HLN-A的话，可以让你不挂掉。大概吧。我也是个萌新。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::596357076",
      "Source": "こんにちは！",
      "Trans": {"SC":"嗨！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::609500908",
      "Source": "ごきげんよう",
      "Trans": {"SC":"你好……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1956105791",
      "Source": "あっ、こんにちは！",
      "Trans": {"SC":"你好呀！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1007531216",
      "Source": "手錠をかけられちゃいました…",
      "Trans": {"SC":"","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //s_hlna_player_handcuffed_g01_01_jp
    },
    {
      "NamespaceHash": "Globals::1730396074",
      "Source": "随分と手際がいいですね！",
      "Trans": {"SC":"偶尔干干农活也不错吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3167386094",
      "Source": "狩猟と採集に関してはもはやプロですね！",
      "Trans": {"SC":"你真是个天生的采集者！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::683566915",
      "Source": "ここにあるものは全て役に立ちますよ。ええ、物は使いようです",
      "Trans": {"SC":"如果你够聪明，就会发现几乎所有东西都能派上用场。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3841736699",
      "Source": "ヘッドショット！",
      "Trans": {"SC":"好耶！正中脑门！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::709463170",
      "Source": "いいセンスです！",
      "Trans": {"SC":"你瞄得越来越准了，哥们！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4178935429",
      "Source": "ビューティフル",
      "Trans": {"SC":"漂亮的一击！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1018554357",
      "Source": "今にも死にそうですよ！",
      "Trans": {"SC":"你快死了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4145661297",
      "Source": "まだ立っていられるのが不思議なくらいです！",
      "Trans": {"SC":"你还站着，真是奇迹！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::213485778",
      "Source": "踏ん張ってください…",
      "Trans": {"SC":"你已经非常虚弱了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::625742127",
      "Source": "うわ、痛かったでしょう！",
      "Trans": {"SC":"","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //s_hlna_player_hurt_c05_01_jp
    },
    {
      "NamespaceHash": "Globals::1382131593",
      "Source": "血が出てる！",
      "Trans": {"SC":"","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //s_hlna_player_hurt_c05_02_jp
    },
    {
      "NamespaceHash": "Globals::282564585",
      "Source": "あのことについては警告しておくつもりだったんだけど！",
      "Trans": {"SC":"","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //s_hlna_player_hurt_c05_03_jp
    },
    {
      "NamespaceHash": "Globals::3993389187",
      "Source": "ちょっと、慌てないで！",
      "Trans": {"SC":"","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //s_hlna_player_hurt_c05_04_jp
    },
    {
      "NamespaceHash": "Globals::1950135312",
      "Source": "すごく出血してるわね？",
      "Trans": {"SC":"","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //s_hlna_player_hurt_c05_05_jp
    },
    {
      "NamespaceHash": "Globals::3419771190",
      "Source": "うーん、サバイバーさんもしかしてバグっちゃってますか？",
      "Trans": {"SC":"呃。貌似我家的生存者陷在沼泽里了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3454181637",
      "Source": "いいですよ？ そっちがその気なら、私ももう喋りません！",
      "Trans": {"SC":"好吧。你这招我也会。我也不说话了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3340490549",
      "Source": "ほらほらサバイバーさん！ 私行っちゃいますよー？ これからは私抜きで頑張ってくださいね？",
      "Trans": {"SC":"拜拜！我走啦！我真的走啦！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::29007369",
      "Source": "現実を見て、HLN-A。あなたのサバイバーは瘴気で頭がやられちゃったの",
      "Trans": {"SC":"[叹气。] HLN-A，面对现实吧。我家的生存者暂离了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2465501816",
      "Source": "あーーもう降参です！ 今のは冗談！ にしても返事の一つや二つ、してくれてもいいじゃないですか！",
      "Trans": {"SC":"好吧，被你识破了。但至少你也动一动啊。给我个信号！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3745127400",
      "Source": "河童に尻子玉でも持っていかれたんですか？",
      "Trans": {"SC":"你被水鬼抓走了吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3303419916",
      "Source": "動かないと虫に刺されちゃいますよ！ 全身の血を抜かれますよ！ ねえ無視ですか！？",
      "Trans": {"SC":"如果你还停在那里，虫子们就要来叮你了。它们会把你吸干的！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1268027826",
      "Source": "暇なので私散歩してきてもいいですか？ えーと… 散歩する足なんてないだろ！ ってツッコんでくれてもいいんですよ？",
      "Trans": {"SC":"如果你想待在这里，那我就走去别处了。不对，是“漂”。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3947349926",
      "Source": "私たちは沼地の真ん中にいるんですよ？ 止まってる場合じゃ…",
      "Trans": {"SC":"我们在沼泽的中间。这里可不是挂机的好地方……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3208079667",
      "Source": "ねえ、サバイバーさん！ 大丈夫ですか？",
      "Trans": {"SC":"嘿，生存者！你还好吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3982429445",
      "Source": "あーもうわかりましたよ。あなたがサンドイッチでも何でも食べている間、こうして待っていればいいんですよね？ まったく",
      "Trans": {"SC":"好吧。不管你是去拿三明治还是什么，我先在这里飘一会儿吧。没啥大不了的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::815233437",
      "Source": "少なくとも、私にも飲み物を持ってきてください！ もちろん、ストローもつけてくださいね。私には手がないので…",
      "Trans": {"SC":"好歹给我带杯饮料啊！别忘了吸管。我没手……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2157939138",
      "Source": "あなたが今家にいなくて食料を買いに行ってるんだとしたら、私怒ってもいいですよね？",
      "Trans": {"SC":"如果你去拿外卖了，我会很生气的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3365354321",
      "Source": "それにしても長いですね… もしかしてサンドイッチじゃなくて、バーベキューでもしてるんですか？",
      "Trans": {"SC":"你离开好久了……你这不是“去吃三明治”，而是“去种小麦”了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2904816762",
      "Source": "素人の作ったアニメーションでも、今のあなたよりはよく動きますよ",
      "Trans": {"SC":"你选择进行假死实验的时机很特别。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2369922911",
      "Source": "シミュレーションはずっとあなたを観察してますよ、サバイバーさん。ええ、あなたが冷蔵庫を開けに行ってる時もです",
      "Trans": {"SC":"好歹给我带杯饮料啊！别忘了吸管。我没手……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2978798899",
      "Source": "星でも眺めているんですか、サバイバーさん？",
      "Trans": {"SC":"生存者，你是不是在观测星空？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2044404065",
      "Source": "エイリアンに拉致されたって言われても信じますよ。ええ、なんせこんな場所ですから",
      "Trans": {"SC":"很明显你被绑架了。可能不是外星人干的……那还能有谁。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::194217414",
      "Source": "あっ、見て、小さなエイリアン！ 冗談です。あなたの気を引こうとしただけです",
      "Trans": {"SC":"瞧，有外星人！[拍打]开个玩笑，吸引一下你的注意力。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1366030993",
      "Source": "私を騙そうとしているんですか？ それとも、本当にそこにいないんですか？",
      "Trans": {"SC":"你是在和我开玩笑，还是你人真的不在？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2681073987",
      "Source": "これじゃあまるで、船が難破したみたいですね。まあ、船ではないんですが",
      "Trans": {"SC":"这就像一起沉船事故。只是没有沉船，只有事故。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1206825260",
      "Source": "「200日目、現実を直視しなければならない。サバイバーは戻ってこない。そろそろ新たな人生を始めよう」",
      "Trans": {"SC":"第二百天：接受现实吧。我家的生存者不会再回来了。是时候迎接新生活了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3157513087",
      "Source": "日記を書くとしますか。えーと… 「1日目、サバイバーはピクリとも動かなくなってしまった」",
      "Trans": {"SC":"我应该写一本日记。“第一天：我家的生存者精神崩溃了……”","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2513207176",
      "Source": "「3日目、依然としてサバイバーに動きはない。本当の敵は、退屈さだ」",
      "Trans": {"SC":"第三天：这位生存者依然没有移动的迹象。我们真正的敌人是无聊。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4149061307",
      "Source": "休憩するにしても、もっと良いところで休憩した方が…",
      "Trans": {"SC":"我能想到一万个比这里更好的发呆场所。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3365099389",
      "Source": "「12日目、サバイバーには相変わらず動きがなく、フジツボが付き始めたと思われる」",
      "Trans": {"SC":"第十二天：我家的生存者还是一动不动，身上连藤壶都长出来了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1503780043",
      "Source": "サバイバーさん？ ねえ、さーばーいーばーさーん？",
      "Trans": {"SC":"生存者？喂！生生生存存存者者者……？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4112754008",
      "Source": "もしもーし？ ねえ、何か返事してくださいよー！",
      "Trans": {"SC":"你在吗？给我个信号吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1430822781",
      "Source": "何かリアルでトラブルでもあったんですか？ それとも休憩しているだけですか？",
      "Trans": {"SC":"你是刚才跳水昏过去了，还只是在休息？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4038507361",
      "Source": "「30日目、通りがかった船に救難信号を送ろうとしたことを、サバイバーに伝えるべきだろうか」",
      "Trans": {"SC":"第三十天：我该不该告诉这位生存者我曾试图联系一条过往船只？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4172464519",
      "Source": "トカゲは寒さで動きが鈍くなるというのは知ってますけど、人間って恒温動物のはずですよね？",
      "Trans": {"SC":"我能理解蜥蜴在低温时的行动会变迟缓，但你不是温血动物吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1563470992",
      "Source": "私にも手さえあれば… 雪玉を投げつけて、目を覚まさせてあげるんですけどね！",
      "Trans": {"SC":"真希望我有手，这样我就可以用雪球打醒你了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2433922909",
      "Source": "私を騙そうとしているんでしょうが、冗談だとしても全く笑えないですよ！",
      "Trans": {"SC":"如果你想甩了我，那是不可能的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3939331654",
      "Source": "もしここに人参とシルクハットがあれば、あなたを完璧な雪だるまにしてあげられるんですけどね、サバイバーさん",
      "Trans": {"SC":"给我一根胡萝卜和一顶帽子，我就可以把你变成大雪人。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2894297973",
      "Source": "どこか暖かいところにいるっていう白昼夢でも見ているんですか？",
      "Trans": {"SC":"是不是在幻想某个暖和的地方？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2927903153",
      "Source": "「うわ、このホットココア… すっごくおいしい！ それにとっても温まります 」ふむ、これでもダメですか",
      "Trans": {"SC":"试试看这样说……“这杯热可可太美味了！我的肚肚感觉暖暖的。”[拍打]呃。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1123172574",
      "Source": "ねえ、サバイバーさん！ そこでじっとしていたら、凍えてしまいますよ",
      "Trans": {"SC":"生存者，喂！站着不动实在太冷了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::484067154",
      "Source": "いい加減動かないと、つららができますよ！ できてほしくない場所に！",
      "Trans": {"SC":"如果我们再不动就要浑身结冰了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::743150108",
      "Source": "ははーん、わかりました！ これって何十年も氷漬けだった英雄が、必要に迫られた時に動き出すっていう、よくある物語のアレですよね！",
      "Trans": {"SC":"我明白了。这是一则讲述某人被冰封数十年，然后在最危机的时刻破冰变成英雄的故事。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3030920329",
      "Source": "凍って固まっちゃったんでしょうか？",
      "Trans": {"SC":"你被冻僵了吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2452513656",
      "Source": "起きてください！ あなたはバカなんですか？",
      "Trans": {"SC":"醒醒，你个笨蛋！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1834138383",
      "Source": "私が待っている間、あなたは他のゲームでもしているんですか？ それはよくないですよ、サバイバーさん。それはよくない",
      "Trans": {"SC":"我在等你，而你是不是在其他模拟里遨游？这可不上道。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1401161027",
      "Source": "ははーん、わかりました。あなたは今自撮りをしていて、それをSNSにでも上げてるんですね？",
      "Trans": {"SC":"我懂了。你是个网红。你在玩自拍。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1741012193",
      "Source": "ねえ、サバイバーさん。真面目な話、「いいね」の通知が来るたびに携帯を見るのはやめた方がいいと思いますよ",
      "Trans": {"SC":"说真的。你没必要动不动就玩手机。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::851597723",
      "Source": "溶岩と隕石だらけの場所で微動だにしないなんて、随分と肝が据わってますね、サバイバーさん",
      "Trans": {"SC":"矗立在一个满是岩浆和火雨的地方……生存者，你真勇敢。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3381217275",
      "Source": "ほら、リプライに返信するのは後にしてください、サバイバーさん！ 私たちにはやることが山ほどあるんですよ！",
      "Trans": {"SC":"等会再发短信，生存者！我们还有一堆事情要做！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3256003971",
      "Source": "人間の生存本能に1つ欠点があるとしたら、それはソーシャルメディアから離れることができないことですね",
      "Trans": {"SC":"[叹气。] 要说人类的天性中有什么缺陷的话，那就是他们对社交媒体不可自拔的爱。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2881692495",
      "Source": "動いていないと燃え上がっちゃいますよ、サバイバーさん",
      "Trans": {"SC":"生存者，如果你待在原地不动，你会烧起来的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3241141006",
      "Source": "あなたは今間違いなくAFKです。頭が噴火しそうな火山みたいな状態ってことです",
      "Trans": {"SC":"矗立在一个满是岩浆和火雨的地方……生存者，你真勇敢。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2867852462",
      "Source": "私に何も言わずに蒸発でもしちゃったんですか？",
      "Trans": {"SC":"你是不是已经跑路了，还没告诉我？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1274371069",
      "Source": "建物の中は過ごしやすいですね",
      "Trans": {"SC":"不用风吹雨淋真好。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2554235671",
      "Source": "屋根があると涼しくていいですね",
      "Trans": {"SC":"头上有屋顶的感觉真棒。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1153756824",
      "Source": "なかなか居心地いいですね？",
      "Trans": {"SC":"屋里真舒服，是不是？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3272226876",
      "Source": "いいですよ、やっちゃえやっちゃえ！",
      "Trans": {"SC":"你太猛了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::898755223",
      "Source": "さては殺戮を楽しんでますね？",
      "Trans": {"SC":"杀得数不过来了？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2551504271",
      "Source": "もうどれほど倒したか覚えていません！",
      "Trans": {"SC":"杀得数不清了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2747737081",
      "Source": "あなたの独壇場ですよ！",
      "Trans": {"SC":"疯狂杀戮！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::164025543",
      "Source": "私たちは狩る側で、あなたたちは狩られる側です！",
      "Trans": {"SC":"这不是战斗，这是一场屠杀！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4153075549",
      "Source": "もはやあなたに敵う者はいませんね！",
      "Trans": {"SC":"敌人全倒下了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::661164077",
      "Source": "まあ、失敗も経験のうちって言うじゃないですか、ね？",
      "Trans": {"SC":"刚才算是一次失败的实验吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::374683051",
      "Source": "不幸な事故… というやつですよね、ええ",
      "Trans": {"SC":"我把刚才叫做“死于不幸”。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3148311920",
      "Source": "あなたと私は何も見なかったし、何も起きなかった。いいですね？",
      "Trans": {"SC":"确认一下：刚才，什么，都没发生。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1164025094",
      "Source": "今は昼寝してる場合じゃないですよ、サバイバーさん！",
      "Trans": {"SC":"现在可不是打盹的时候！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1489923480",
      "Source": "起きてください、仕事の時間ですよー！",
      "Trans": {"SC":"别躺地上！有任务呢！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::300908584",
      "Source": "えっ、サバイバーさん？ 気絶しちゃったんですか？",
      "Trans": {"SC":"生存者？你晕过去了？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1790722063",
      "Source": "ヒルが吸い付いてますよ、サバイバーさん！",
      "Trans": {"SC":"生存者，你身上有水蛭！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2757184850",
      "Source": "ヒルを取らないと血を吸い取られてしまいます！",
      "Trans": {"SC":"这些水蛭会吸干你的！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2821098841",
      "Source": "ヒルを取ってください！",
      "Trans": {"SC":"把这些水蛭弄掉！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4088339393",
      "Source": "おめでとう、サバイバーさん！",
      "Trans": {"SC":"恭喜你！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3238447992",
      "Source": "ええ、これもシミュレーションどおりです！",
      "Trans": {"SC":"继续保持，系统会奖励你的！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::797488941",
      "Source": "レベルアップのファンファーレでも奏でてあげましょうか？",
      "Trans": {"SC":"我是不是该说“叮，你升级了！”","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1053129524",
      "Source": "サバイバーさん、落ち着いてエイムしましょう！",
      "Trans": {"SC":"生存者，稳住！瞄准！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::420385658",
      "Source": "よーく狙ってくださいね？",
      "Trans": {"SC":"记得要先瞄准。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2593445803",
      "Source": "それって威嚇射撃ですか？",
      "Trans": {"SC":"刚才是故意打偏的吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::350757287",
      "Source": "あなたの恐竜、調子が悪いみたいですけど…",
      "Trans": {"SC":"你的坐骑看起来不太妙……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3859806775",
      "Source": "あなたの恐竜、今にも倒れそうですよ！",
      "Trans": {"SC":"你的坐骑就快要倒下了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3094927037",
      "Source": "あなたの恐竜、出血してますよ… それもたくさん",
      "Trans": {"SC":"你的坐骑流了很多血。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3449004391",
      "Source": "なんだか… 急に眠くなってきましたね？",
      "Trans": {"SC":"特别困，是不是？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2360889691",
      "Source": "昼寝してる場合じゃありませんよ！",
      "Trans": {"SC":"没时间打盹了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::400045750",
      "Source": "睡眠不足でしょうか？",
      "Trans": {"SC":"你看上去很困的样子……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4135329014",
      "Source": "サバイバルだからって、ファッションを気にしちゃいけないなんてルールはないですよね",
      "Trans": {"SC":"虽然你正在求生，但同时依旧保持了时尚品味。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3802379538",
      "Source": "色使いにセンスを感じますよ、サバイバーさん",
      "Trans": {"SC":"你挑选色彩的眼光很不错。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1834273268",
      "Source": "知ってますか？ アメリカでは「死ぬ」と「染める」って同じ発音の言葉なんですよ。え、どうでもいい？",
      "Trans": {"SC":"我终于明白敌人对你说“给你点颜色瞧瞧”是什么意思了。我喜欢！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1996674611",
      "Source": "いつまで息を止めているつもりですか",
      "Trans": {"SC":"你没法一直憋气……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3826749959",
      "Source": "そろそろ酸素を供給してはどうですか",
      "Trans": {"SC":"你需要呼吸……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1202495098",
      "Source": "酸素不足みたいですよ",
      "Trans": {"SC":"你快没氧气了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::446117299",
      "Source": "毒が回っていますよ！",
      "Trans": {"SC":"中毒了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3458465893",
      "Source": "毒状態です、お気を確かに！",
      "Trans": {"SC":"生存者，你中毒了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::117381833",
      "Source": "毒に負けないでください！",
      "Trans": {"SC":"不要被毒素打倒！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3248498830",
      "Source": "えーと、トイレでしてください… って言うのはなしですか？",
      "Trans": {"SC":"需要马桶吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2596838531",
      "Source": "すっきりしましたか？ それは結構",
      "Trans": {"SC":"感觉体重轻点了吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2215114513",
      "Source": "ここで出しちゃうんですか？ え、本当に？",
      "Trans": {"SC":"就在这里……？不是吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::49292583",
      "Source": "目の焦点が合っていないようですけど、大丈夫ですか？",
      "Trans": {"SC":"你看起来有点傻兮兮的……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3598757381",
      "Source": "えっと、二日酔いですか？",
      "Trans": {"SC":"你嗨过头了吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3586975865",
      "Source": "いけいけー！",
      "Trans": {"SC":"跑起来！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3367877217",
      "Source": "ドライブとしゃれこみますか！",
      "Trans": {"SC":"骑马咯！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2160579968",
      "Source": "どうどう！",
      "Trans": {"SC":"驾！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2202828959",
      "Source": "何度でもやり直せます、そう… Genesisシミュレーションならね！",
      "Trans": {"SC":"这就是创世模拟的优点——总是可以再来一次！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2228414998",
      "Source": "さて、もう一度挑戦しますか？",
      "Trans": {"SC":"我们再试一次？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1318383185",
      "Source": "生きてるっていいものですね！",
      "Trans": {"SC":"很高兴我们又回来了，准备行动！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1166869113",
      "Source": "見つかっちゃったみたいです！",
      "Trans": {"SC":"它发现我们了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::250944296",
      "Source": "私たちのことをじっと見てます！",
      "Trans": {"SC":"它正朝我们这里看！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::645227056",
      "Source": "見つかってしまいました！",
      "Trans": {"SC":"我们被发现了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4194673120",
      "Source": "小休止が必要ですか？",
      "Trans": {"SC":"需要喘口气吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3093677849",
      "Source": "疲れているみたいですね",
      "Trans": {"SC":"你看上去累坏了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2845659685",
      "Source": "休憩を取ることをオススメします",
      "Trans": {"SC":"休息一下吧。你看上去很累。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3527648560",
      "Source": "食料を摂取してください、サバイバーさん",
      "Trans": {"SC":"朋友，吃点东西吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2852508073",
      "Source": "お腹が空いているみたいですね！",
      "Trans": {"SC":"你看上去饿坏了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3691660959",
      "Source": "えっと、絶食でもしているんですか？",
      "Trans": {"SC":"你是有意饿死自己吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4119877798",
      "Source": "たき火って、なぜかずっと見ていられますよね",
      "Trans": {"SC":"大自然的馈赠。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3901494074",
      "Source": "実に落ち着いた気分になります",
      "Trans": {"SC":"真是令人放松啊。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1971606173",
      "Source": "暖かいですね。母の温もりを思い出します",
      "Trans": {"SC":"让你保持温暖。让你吃上热食。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3313797710",
      "Source": "私はオーストラリアの名誉市民ですから、バーベキューに関しては少しうるさいですよ",
      "Trans": {"SC":"作为一个名义上的澳洲人，我在这方面有特长。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1326684598",
      "Source": "あっ、バーベキューグリル！ 快適な暮らしっていうのはこういうことですよ、ええ！",
      "Trans": {"SC":"你做了一个烧烤台！我们现在的日子太棒了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2813856003",
      "Source": "はい、立派なバーベキューグリルですね。百点です",
      "Trans": {"SC":"哇，烧烤台！没啥能比它更棒了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1786650175",
      "Source": "あなたはレンブラント派？ それともポラック派？",
      "Trans": {"SC":"你属于写实派，还是抽象派？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2791193350",
      "Source": "あなたに芸術の才能があるなんて、知りませんでした",
      "Trans": {"SC":"我不知道你竟然有艺术细胞……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3101387378",
      "Source": "とてもお洒落だと思いますよ。いえ、皮肉ではなくてですね",
      "Trans": {"SC":"真有艺术感。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2113340652",
      "Source": "それを使えば、何でも複製できますね",
      "Trans": {"SC":"有了它，什么都可以做出来吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::901528562",
      "Source": "自分自身を複製できるレプリケーターって、あるんでしょうか？",
      "Trans": {"SC":"你可以用复制器复制复制器吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2635979756",
      "Source": "まあ、立派な3Dプリンターですね！ え、違う？",
      "Trans": {"SC":"我想叫它“复结者”。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::878203310",
      "Source": "鉄器時代へようこそ、サバイバーさん！",
      "Trans": {"SC":"欢迎来到铁器时代！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1798738476",
      "Source": "今はロックより断然メタルって気分です！",
      "Trans": {"SC":"我们来做点金属物件吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3046547798",
      "Source": "それで何を作るのか、今から楽しみです",
      "Trans": {"SC":"等不及要看你如何使用它了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2087268934",
      "Source": "バイオーム間を渡り歩くにはもってこいのものですね",
      "Trans": {"SC":"有了它就可以前往各个生态圈了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::269107667",
      "Source": "ええ、高速で移動する手段は必要不可欠ですよね",
      "Trans": {"SC":"真不错，我们需要这类快速交通工具。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1549747737",
      "Source": "普通の旅行じゃもう満足できません。時代はテレポートです！",
      "Trans": {"SC":"能传送就绝不走路。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3479663533",
      "Source": "攻撃こそ最大の防御、ってやつですね",
      "Trans": {"SC":"最好的防御就是架炮台。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3374885471",
      "Source": "侵入者の味方をするつもりはありませんが、彼らを思うと少々かわいそうです",
      "Trans": {"SC":"我替入侵者们感到惋惜。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::476431744",
      "Source": "これ以上の威嚇はないでしょうね、ええ、全く",
      "Trans": {"SC":"看起来很吓人。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3747966139",
      "Source": "ちゃんとタオルで拭いてくださいね？",
      "Trans": {"SC":"该出水了吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3485990616",
      "Source": "いい泳ぎっぷりでした！",
      "Trans": {"SC":"游泳好凉快！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2676762695",
      "Source": "私に脚はないですけど、陸地のありがたさならわかっています",
      "Trans": {"SC":"我虽然没有腿，但我还是偏爱陆地。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::321025686",
      "Source": "泳ぎたい気分です！",
      "Trans": {"SC":"哇！我喜欢游泳！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3209850424",
      "Source": "忘れないでくださいね？ ここにはライフセーバーなんていませんからね",
      "Trans": {"SC":"记住——这里没有救生员……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1825153754",
      "Source": "水泳帽を持ってくればよかったです！",
      "Trans": {"SC":"我忘了带我的游泳帽！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1026763206",
      "Source": "もうちょっとで倒せそうです！",
      "Trans": {"SC":"它即将倒下！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::988940189",
      "Source": "もう虫の息みたいですね！",
      "Trans": {"SC":"它奄奄一息了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::871824931",
      "Source": "あと、もう少しです！",
      "Trans": {"SC":"它就要被击败了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3517450048",
      "Source": "テレポート… いきます！",
      "Trans": {"SC":"立刻……传送！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2290300806",
      "Source": "テレポート作動します！",
      "Trans": {"SC":"传送已启动！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4186959631",
      "Source": "テレポートで少し酔ってしまいました… うぅ",
      "Trans": {"SC":"传送总会让我头晕……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1987280710",
      "Source": "到着です。目的地にどんぴしゃ！",
      "Trans": {"SC":"我们到了，不偏不倚。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1344547141",
      "Source": "座標を確認… テレポート成功です！",
      "Trans": {"SC":"坐标已确认，传送完成！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1500006660",
      "Source": "テレポート、準備完了です！",
      "Trans": {"SC":"传送准备就绪！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2669622457",
      "Source": "テレポート待機中です！",
      "Trans": {"SC":"正在准备传送！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3101349842",
      "Source": "座標固定完了、いつでもテレポートできます！",
      "Trans": {"SC":"坐标锁定，可以传送！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1651977826",
      "Source": "飲み物を飲んでください、サバイバーさん",
      "Trans": {"SC":"朋友，喝点东西吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4171899710",
      "Source": "喉が渇いているようですね！",
      "Trans": {"SC":"你看上去很渴！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1521723840",
      "Source": "何か飲んでください、サバイバーさん！",
      "Trans": {"SC":"生存者，喝点什么吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1188326999",
      "Source": "今にも気絶しそうに見えます！",
      "Trans": {"SC":"你看上去就快晕倒了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3788364911",
      "Source": "突然倒れたりしないでくださいね！",
      "Trans": {"SC":"别晕过去！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3911545576",
      "Source": "しっかりしてください！ 眠っちゃダメです！",
      "Trans": {"SC":"别抛下我！保持清醒！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1003544152",
      "Source": "目をしっかり開けてください！",
      "Trans": {"SC":"别闭上眼睛！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2992223438",
      "Source": "気絶したりしないでくださいね！",
      "Trans": {"SC":"不许你晕过去！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::772310827",
      "Source": "お気を確かに、サバイバーさん！",
      "Trans": {"SC":"生存者，保持清醒！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1644081222",
      "Source": "散策するのも悪くないですね！",
      "Trans": {"SC":"走走路也不错！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1150355600",
      "Source": "私たち、ちゃんと目的を持って歩いてるんですよね？",
      "Trans": {"SC":"我们要进行一次有意义的旅行。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1168915732",
      "Source": "これは単なる散策じゃなくて、冒険です！",
      "Trans": {"SC":"这不是简单的徒步旅行，而是一次大冒险！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3945141089",
      "Source": "木を殴って何を… えっ、それで木材が取れるんですか！？",
      "Trans": {"SC":"你用拳头攻击树……竟然有效果？！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2276328682",
      "Source": "気でも狂ったんですか？ 木だけに？",
      "Trans": {"SC":"这也是一种从树上获取资源的方式。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4191524429",
      "Source": "そうです！ 誰がここで一番強いのか、その木にわからせてやるんです！",
      "Trans": {"SC":"哈！看看谁才是老大！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3012060253",
      "Source": "おはよう、サバイバーさん！ 準備はいいですか？",
      "Trans": {"SC":"你好，生存者！准备好冒险了吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::579843753",
      "Source": "冒険に出かけましょうか！",
      "Trans": {"SC":"有谁想去探险？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2020199128",
      "Source": "行きましょう、サバイバーさん！ シミュレーションが待ってます！",
      "Trans": {"SC":"生存者，出发吧！创世模拟在等待着我们！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::971244239",
      "Source": "別の武器を使った方がいいと思います…",
      "Trans": {"SC":"还是换把武器吧……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1616068411",
      "Source": "その武器はもうダメみたいです",
      "Trans": {"SC":"那把武器没法再用了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1182847275",
      "Source": "武器が壊れました！ 別のに変えてください！",
      "Trans": {"SC":"武器坏了，换一把吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3361287207",
      "Source": "シミュレーションからボーナス経験値が届いていますよ",
      "Trans": {"SC":"模拟系统正在给予你额外的经验值。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1029698165",
      "Source": "ボーナス経験値をもらいましたね",
      "Trans": {"SC":"你正在获取额外的经验值。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::281430428",
      "Source": "シミュレーションから特別な経験値の報酬があります",
      "Trans": {"SC":"你正在获取模拟系统中额外的经验值。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1826712706",
      "Source": "雨の季節ですね",
      "Trans": {"SC":"现在是雨季。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3848319853",
      "Source": "私は錆びないので、ご心配なく",
      "Trans": {"SC":"还好我不会生锈。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2423608293",
      "Source": "雨が降ってきましたね",
      "Trans": {"SC":"啧啧。好像下雨了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1992780222",
      "Source": "近いですよ、サバイバーさん…",
      "Trans": {"SC":"我们很接近了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::221398026",
      "Source": "距離確認… はい、どんどん近付いてます",
      "Trans": {"SC":"距离检测……很靠近了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1751193313",
      "Source": "スキャナーによると、どうやら近いようです",
      "Trans": {"SC":"扫描仪表明我们越来越接近了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::779671731",
      "Source": "遠ざかっているようです…",
      "Trans": {"SC":"我们越走越远了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3313850943",
      "Source": "さっきより距離が離れてますよ、サバイバーさん",
      "Trans": {"SC":"距离增加。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2057431582",
      "Source": "スキャナーによると、遠ざかっているようですね",
      "Trans": {"SC":"我还在继续扫描，但是现在变远了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1898300328",
      "Source": "あそこです。ずっと向こうの方…",
      "Trans": {"SC":"让我瞧瞧远处那里……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2913676592",
      "Source": "何かの反応をスキャンしました。あそこです！",
      "Trans": {"SC":"我扫描到什么了。看那里！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2180066914",
      "Source": "スキャナーが何かを捕捉したようです。だいぶ離れてはいますが",
      "Trans": {"SC":"我的扫描仪检测到了什么，但离我们有些远。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3053170206",
      "Source": "嫌な予感がします…",
      "Trans": {"SC":"听起来很糟糕……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1845409226",
      "Source": "近いですね。近すぎるくらいに",
      "Trans": {"SC":"听上去离我们很近——非常近。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::839496219",
      "Source": "誰かが戦っているようです… どうしますか？",
      "Trans": {"SC":"别人在打架……终于有一次不是我们了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    }
  ],
  //故障修复语音 - 2026-07-26 11:28:37
  "Glitches": [
    {
      "NamespaceHash": "Globals::3501959741",
      "Source": "このバイオームは生命に満ちています。ええ、それはもうシミュレーションの処理が追いつかず、バグが発生してしまうほどに。想像してみてください。昆虫1匹1匹に行動パターンが組まれていて、それぞれが異なる経路で餌を探して飛び回っているんですよ！ それって、もはやあなたたちサバイバーと同じですよね？",
      "Trans": {"SC":"这座生态圈里生机勃勃。如此之多的生命却给模拟系统带来了故障。\n想象一下，要单独追踪虫群中每一只昆虫，系统需要付出多大的成本！成千上万的虫子，每只都有自己的飞行轨迹，每只都在寻找食物。\n它们就像你们生存者的缩影，是吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2632865281",
      "Source": "私のセンサーが、空気中に大量の有機化合物を感知しています。その化合物というのは、あなたたちが「匂い」と呼ぶものです。まあ、私にとっては単なる化学物質ですが。ともかく、このバイオームを歩く時は、特に硫化水素に注意してください。H2Sですよ、聞いたことはありませんか？ それを嗅いでしまうと鼻にツンとくる匂いがして、一時的に嗅覚が麻痺してしまうんです。つまり、その間は有毒ガスを吸っても、気付くことができないということです",
      "Trans": {"SC":"我的传感器探测到空气中漂浮着大量有机化合物。你们应该称之为“气味”吧？对于我来说只是化学物质。\n当你在这个生态圈中呼吸时，要小心H2S，就是硫化氢。我的数据表明它闻起来很刺鼻，而且会减弱人类的嗅觉能力。你可能在无意识中吸入这种毒气。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3588447134",
      "Source": "このバグはすでに修正しましたし、先に進みましょうか。前に進み続けることが、ここでは大切だと思うんです。というのも、沼地という場所では、立ち止まってしまうとすぐに足元を掬われますからね。例えば、流砂やクモの巣、木の葉の山、モンスーンによる増水、そして何より、あのべとべとした泥。空中に浮けるということを今日ほど感謝した日はありません",
      "Trans": {"SC":"现在我已经修复这个故障了。我们可以继续前进。我认为在这里保持移动非常重要。这片沼泽有无数方法让我们陷入困境。\n比方说，有流沙、巨型蜘蛛网、茂密的植被，雨季上涨的水平面，还有无处不在的淤泥。\n我真庆幸自己会飞。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::63901214",
      "Source": "バグは正常に修正されましたよ。ええ、辿り着くのが少し大変でしたが。まったく、沼地というものはどうしてこうも動きづらいんでしょうか。あなたたち人間は、沼地での生活に慣れてるんですよね？ 元はと言えば、人間は沼地からやって来たんですから。いくら肥沃な三日月地帯でも、人間たちが開拓する前はただの沼地だったんです。この沼地だって、あなたたちに開拓される日も近いのかもしれませんね",
      "Trans": {"SC":"故障已经被修复了。这是一座令人感到伤感的生态圈。\n你们人类肯定习惯了沼泽生活，对吧？你们起源于那里。新月沃土本是一片沼泽。第一批人类将其抽干后用于农业生产。 \n我好奇你们生存者会不会也计划抽干这里呢……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::126206227",
      "Source": "このバイオームのマスターAIは消えてしまったみたいです！ ええ、跡形もなく！ あれはサバイバーたちにとっての最後の試練となるべき存在でした。消えるはずなんてないのに… 誰かが意図的に消去したのだとしたら、それは一体なぜ…？ このシミュレーションの目的は結局のところ、あなたたちサバイバーを試すためのもののはずです。 …あなたは今までよくやってきました。何らかの褒美があってもよいはずなんです",
      "Trans": {"SC":"操控这个生态圈的主机AI不见了！消失地无影无踪。按理来说这里是让生存者接受终极考验的地方，所以它不应该平白无故地消失。\n假如是有人关闭了主机……他们为什么要那么做？所有这一切都是为了观察并测试生存者。你一直以来的表现都不错，我希望你能因此获得嘉奖！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3053913006",
      "Source": "バグは修正しましたが、シミュレーションの仕様がまた一部意図していない仕様へと書き換えられているのを発見しました。ええ、沼地に充満している瘴気です。あの瘴気は元々吸い込んだサバイバーを眠らせるために設計されていました\nですが、今は瘴気を吸い込んだ者すべてを殺す猛毒ガスへと変貌しています！ ガスマスク等を持っていない限り、絶対に吸い込まないでくださいね",
      "Trans": {"SC":"我修复了这个故障，然而我注意到模拟程序中还有一处修改——我觉得它不是设计者们有意为之的。那就是沼泽里的沼气。按照原本设计，如果你在里面逗留太久，它只会让你晕过去。但事实是，它正在大肆屠杀其中的生存者！除非你有面具或是其他办法，否则一定不要在里面呼吸。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2794103803",
      "Source": "重力というのは、失って初めてそのありがたさに気付くものです。まあ、完全に失われたわけではないですが。ともかく、重力がなくなると私たちにも色々な影響が出始めます。一番わかりやすいのは、高く飛ぶことができたり、物を遠くに飛ばせるようになったりすることですね。うっかり高所から落ちてしまったとしても、怪我をすることもないでしょう。ええ、今のはフリじゃないですよ？ 絶対に落ちたりしないでくださいね！",
      "Trans": {"SC":"直到引力消失你才会想起它，是吧？不过我认为，与其说它“消失了”，不如说它“暂时开小差了”。\n根据故障中的数据，缺乏引力会以不同的方式影响你。不过，你可以跳得更高，炮弹飞得更远。哪怕你笨手笨脚从高处摔下来，也不会受伤。然而我不推荐你这么干！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1165212831",
      "Source": "Genesisシミュレーションには、ここより暑い場所もあれば、寒い場所もありますが、影があるとかないとか、そんなことでいちいち気温が変化するのは、このバイオームだけでしょうね。他のバイオームには空気が存在するため、気温が一定に保たれますが、ここではそうもいきません。空気があることのメリットは、何も呼吸ができるようになることだけではないんですよ？",
      "Trans": {"SC":"创世模拟中有比这里更炎热或更寒冷的地方，但是这里是唯一一处仅靠阴影来隔开严寒酷暑的生态圈。\n看来在其他生态圈中，正常的大气层可以有效平均各处的温度。没想到空气不单可供大家呼吸呢！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1386917535",
      "Source": "データによれば、ここは確かに月なのですが、私たちのよく知る月ではないようです。ええ、少なくとも地球から見える“あの”月ではありません。その証拠に、この月には天候… 具体的に言うなら、雷という概念が存在します。前もって準備しておかないと、電気系統は全て使えなくなるでしょうね。まあ、雨が降らないというのは不幸中の幸いです。代わりに隕石の雨は降るでしょうけど…",
      "Trans": {"SC":"根据故障中的数据来看，这里应该是一个“月亮”，但不是“那个”月亮。至少不是我们在地球上看到的那颗。\n我认为证据就是在这月亮上有雷暴天气。它们会把任何使用电力的设备烤糊——除非你事先采取保护措施。\n至少这里不会下雨。除非算上流星雨——呃，也算是一种雨吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1535842042",
      "Source": "先ほどちらっと見たデータによると、たまに地面に落ちている灰色の奇妙な塊には注意する必要があるかもしれません。なぜならそれは竜涎香だからです。一般的に、それは非常に揮発性が高いと考えられていて、うまくやれば爆発物として利用できるかもしれませんね。ですが、それを拾い上げる前に、はっきりと警告しておきます。竜涎香は、基本的にはクジラの糞です。私なら絶対に近寄りませんので、そのつもりでお願いします",
      "Trans": {"SC":"根据我刚刚浏览过的文件，你应该留意地上奇怪的灰色块状物。它可能是龙涎香，据说特别不稳定。我们可以利用它，因为我知道你痴迷于爆炸。\n但是在你捡它之前，我要提醒一下：它算是鲸鱼的鼻涕。别指望我靠近那东西。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::933410674",
      "Source": "月面バイオームでテストを行うはずだった人工知能が消失してしまっているようです。たった今、システムに干渉した際に直接確認したので、間違いありません。これは、「ちょっと散歩に出かけてくる」といった類の消え方じゃありません。「何者かに削除されてしまった」といった類の消え方です。マスターAIが機能していないのなら、このバイオームで私たちを観察しているのは誰なんでしょうか？",
      "Trans": {"SC":"我刚才在修理那起故障的时候已经确认过：这座异形月球生态圈中负责观察测试情况的人工智能不见了。\n不是暂时离线，更像是被有意删除。没有了主机AI，我不知道现在是谁在监控着我们……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2160520758",
      "Source": "このバグはちょっとした物理演算処理のミスによるものでした。Genesisシミュレーションの開発者は以前、物理演算のテストを行うために、このエリアを使用していました。あなたたちサバイバーが入ってくるよりずっと前のことです。そう、当初ここはこんな場所ではなかったんです。しかし、このエリアはある日、「月面」というバイオームに生まれ変わりました。なぜなら、開発者たちも金曜日は早めに仕事を切り上げて飲みに行きたかったからです。まだわかりませんか？ 宇宙という舞台はほぼ無重力なんです。つまり、多少、物理演算の処理が甘くてもいい、ということです。私も段々、人間らしさというものがわかってきましたよ、ええ",
      "Trans": {"SC":"那个故障是一起物理错误导致的。在你们生存者来到这片区域的很久之前，创世模拟系统的创造者们在这儿测试物理特性。\n如果我熟悉人性——你得承认我越来越擅长了——有人发觉到可以把这片测试场变成一个“异形月球”。然而他只是为了周五可以早点下班去泡吧。于是呢，这里便成为一个正式的生态圈了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1469630046",
      "Source": "地球の古い文書でしょうか。なになに… 1965年のソ連の有人宇宙船「ボスホート2号」に関する記録ですか。少し奇妙ですが、ともかく内容はこうです\n「何もかも想定通りにはいかなかった。宇宙遊泳を行った乗員の宇宙服は膨張し、カプセルの中に戻るためには、自ら宇宙服内の酸素を抜き、膨張の緩和を行う必要があった。また、地球に帰還する際は、想定していたコースから数千キロも離れた荒野に着陸を果たした。救出されるまでの間、狼だらけの荒野で2晩もの野宿を強いられたのだ」\nふむ、シミュレーションの中で私たちがやっていることに、ちょっと似てますね？",
      "Trans": {"SC":"另一份遗失的历史档案。它很奇怪：沃斯霍尔德2号在1965年的一次太空任务。\n整件事发生的非常突然。在太空行走期间，宇航员的衣服鼓了起来。他必须手动放气才能回到太空舱中。\n当返回地球后，他们降落在偏离航线数百公里以外的荒野中。获救之前，他们在野外露营了两个晚上，周围满是野狼。\n听起来和我们在创世模拟中做事情的方式很像，对吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::934428413",
      "Source": "どうやら何者かが放射能汚染に関する文書を閲覧していたようですね。しかもこれは、1895年のヴィルヘルム・レントゲンに関する歴史的な資料でもあります。彼はX線を発見した第一人者で、自身の骨を調べる際に、放射能による熱傷を受けてしまったことでも有名です。彼は傷を完治させ、長生きしましたが、Genesisシミュレーションの中では通常よりも放射線が強い場所があります。あなたも気を付けてくださいね？",
      "Trans": {"SC":"有人一直在查找关于辐射中毒的历史数据。我是指真正的历史数据，比如1895年的威廉·伦琴。\n他是发现X射线的人。他为了用辐射观察自己手中的骨头而烧伤了自己。\n伦琴最后痊愈并且活了很久，但在创世模拟中，有些地区的辐射比普通X射线要高得多。我们一定要当心，好吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4144097360",
      "Source": "水中を調べるには、単に水着を着て泳ぎ回ればいいってわけじゃありません。まあ、私はそれでもいいんですが、あなたたちは呼吸しなければいけないでしょう？ でも、心配ご無用です。先ほど調べたデータの中に、1つ有益な情報を見つけたんです。どうやらこの辺りの水中には多量の酸素を含んだ気泡があって、それを利用すれば、水中でも呼吸ができるみたいですよ！",
      "Trans": {"SC":"探索这里的水下世界不光是穿上泳衣随便游游就好了。对我来说也许是，但你得呼吸呀！\n当我修复故障时，我看了一眼这里的水体构成。说实话，很没意思，但我发现了一个有用的信息：附近应该存在超氧气泡。找到它，你就能在水下呼吸了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4098100753",
      "Source": "海には魚がたくさんいますが、このバイオームにいるのは魚だけじゃありません。データによると、鳥たちもこの場所をかなり気に入っているようです。それも1羽や2羽じゃありません！ まあ、その理由はなんとなくわかりますよ。ここはいつも、空を飛ぶのに最適な気候ですからね。ツバメなどの群れが見られるのは、そのためでしょう。ただ、彼らのねぐらってどこにあるんでしょうか？",
      "Trans": {"SC":"海里有很多鱼，但在这个生态圈中不光只有鱼。根据故障中的数据，鸟类非常喜欢这儿，而且它们的数量惊人！\n确实有些道理，因为这里的天气总是适合飞行。难怪我们会看到成群的雨燕和其他鸟类。不知道它们栖息在哪里？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3248961375",
      "Source": "やれやれ… 全くもって哲学的なバグでした。そのバグの中では、2つのアルゴリズムが1つの質問を巡って永遠に反発し合っていたんです。その質問というのは、「水は濡れているか？」という質問です。一方のアルゴリズムは、「濡れている」というのを「液体が固体に付着している状態」だと定義し、「水は濡れていない」と答えました。もう片方は、「濡れている」というのを「液体に触れた時に生じる感覚」だと定義し、「水は濡れている」と答えました。 …私はめんどくさくなって、コインで正解を決めろと言ってやりました",
      "Trans": {"SC":"这个故障属于哲学问题。两套并行算法无法对一个简单问题的答案达成一致：水是湿的吗？\n其中一套代码将“湿”定义为“附着在固体上的液体”并表示“不，不是湿的。”\n另一套代码将“湿”定义为“与液体接触的感觉”并认为“是湿的。”\n我无法确定，所以我告诉它们抛虚拟硬币来决定。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1699989910",
      "Source": "このデータは、この海が人工物であることを示すものです。まあ、わかりきっていたことですよね？ でも、これって実はすごいことなんです。20世紀以前の話です。研究者たちは閉鎖的な環境の中に人工の海を作りました。最初は、サンゴ礁ができるほどにとても豊かな海でした。しかし、それも長くは続きませんでした。彼らが導入した生物種の多くは死滅し、研究者たちは派閥を形成、わずかに残った生物や海産物などを巡って争いを始めたんです。うーん、飢えた者たちの派閥争い、いえ、トライブ争いですか… どこかで聞いたことのある話ですね？",
      "Trans": {"SC":"这个故障证明这片海洋是人造的。不算什么新闻，是吧？但本可能会更糟。早在二十世纪，某次封闭生态系统实验创造了第一片人造海洋。\n起初，海里一切欣欣向荣。他们甚至还种植了珊瑚礁！但后来他们引进的物种出现大规模死亡。内部的研究人员形成敌对派系，几乎饿死。\n饥饿的人群分化成不同的部落。这不稀奇吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3699498258",
      "Source": "それぞれのバイオームを監視するマスターAIのうち、いくつかはGenesisシミュレーションの裏側に潜む何者かの攻撃によってオフラインにされてしまいました。それは深海のバイオームでも同様でしたが、1つ決定的な違いがあります。深海のマスターAIは、他の誰かによって攻撃される前に、自らをオフラインにしたのです。なんて賢いAIなんでしょうか！ これはつまり、必要に応じてまたオンラインになれるということです。… 多分。恐らく？ まあ実際のところ、現時点では私にもよくわからないんです",
      "Trans": {"SC":"创世模拟的后台被不明原因搞得一塌糊涂，导致部分监控生态圈的主机AI已经离线。\n深海生态圈也遇到了同样的情况，但不同之处在于，海洋的主机AI在被他人关闭前就自己离线了。这就是自适应编程！我认为这意味着它可以在必要的时候自行上线。\n这或许是个好消息？不过就内部情况而言，现在没法下定论。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::911629718",
      "Source": "ここが深海のバイオームと呼ばれている所以はもちろん、辺り一面の海です。ですが、このバグはある廃棄されたプログラムが原因でした。そう、かつてここに島がたくさんあった時代のプログラムです。このバイオーム、今でこそ「水、水、水！」というのが特徴ですが、想像してみてください。時々ビーチに上がり、水着を着て、冷えたビールを飲むことができれば、どれほどよかったでしょう。ここがこんな場所になってしまったのには、理由があります。最初のサバイバーがシミュレーションに入る前に、何者かが意図的にこれらの島を全て削除してしまったんです。一体誰が、何のために？ 私にはわかりません",
      "Trans": {"SC":"他们管这里叫深海生态圈的原因很清楚，是吧？但是这个故障涉及到的代码比较过时。那时候这里还满是小岛。\n我知道这儿都是水水水，但想像一下，如果你可以时不时在沙滩上打个滚，穿着你的泳衣，手里拿着冰饮，那样的生活多惬意。至少不用接触那么多水。\n就在第一批生存者进入这个模拟系统之前，有人删除了全部的岛。为什么呢？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1013133791",
      "Source": "バグを修正した際、このバイオームの死傷者に関するデータを見つけました。それを見て、私は確信しました。本当に危険なのは恐竜でも他のサバイバーでもなく、この天候であると。吹雪の中では、体温が下がって視界も悪くなり、移動もできず、二次災害に最も繋がりやすい状態となっています。運が悪ければ、いつの間にか断崖絶壁から落ちていることだってあるかもしれません。いいですか？ スキーを楽しもうなんて考えは、今すぐに捨ててください！ いいですね！",
      "Trans": {"SC":"当我在修复故障时，我发现该生态群中存在一些伤亡数据。不但有某些生物和生存者制造着威胁，天气自身也是十足的头号杀手。\n这儿的暴风雪会冻住你，阻碍视线，减慢速度，让人无法脱身。如果那还不够，一阵狂风就能把你吹下悬崖！如果你想去滑雪度假，这里肯定不是首选之地，是吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4252073195",
      "Source": "バグを修正しつつ、今後の天気予報を見ていたんですが、はっきり言って最悪です。今後吹雪だけでなく、みぞれにも対処しないといけないみたいですから。みぞれが吹雪と異なる点は、それが私たちの体を直接傷つけるという点です。あられや雹は、最初のうちはちょっと痛むぐらいですが、避難しないでいると、雹のサイズはやがて拳ほどの大きさとなり、いつの間にかあなたは凍ったジャムになっているでしょうね",
      "Trans": {"SC":"我在修复故障的时候看了下天气预报，情况很不妙。我们不但要躲避暴风雪，还要对付冰雹。\n","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3825741605",
      "Source": "ふぅ！ バグを修正できないかと思って少しヒヤッとしました。ほんと、ここに来てからヒヤッとさせられっぱなしです。まあ、私には寒さを感じる肉体なんてないんですけどね！ …ちなみにですけど、このバイオームで暮らす生き物にはすべて、それぞれ独自の防寒策が備わっています。サーベルタイガーやマンモスは、見ての通り、毛皮です。ユウティラヌスやドードーは、羽毛の下に温かい空気を閉じ込めています。また、カイルクペンギンやドエディクルスなんかは、寒さから身を守るための脂肪の層を、皮膚の下に持っているらしいですよ",
      "Trans": {"SC":"噢！修复那个故障让我直打冷颤。这里冷得连我都止不住发抖，更何况有血有肉的你呢。\n这个生态圈中的所有生物都有自己御寒的方式。对于剑齿虎或猛犸象来说，答案很明显：皮毛。羽暴龙和渡渡鸟则将温暖的空气包裹在羽毛之下。\n有时候答案也藏在皮肤之下。远古企鹅和星尾兽靠皮下脂肪层来防止自己结冰。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2405921377",
      "Source": "バグに触れることで新しい事実がわかりました。それは、このバイオームがエベレストのような高山を模倣したものであるということです。流石にシェルパのような原住民はいませんが。ただ、この極寒の天候は全て、それを模倣した結果の副産物だと思われます。まあ、いくら標高が高いからと言って、ここでは空気の薄さを気にする必要はありませんよ。そういう設定ですから",
      "Trans": {"SC":"当我修复这个故障时，我知道了一些新信息：该生态圈是为了模拟诸如珠穆朗玛峰的高海拔山脉。\n所以这些严寒天气只是高海拔模拟的副作用。\n不过，我们不需要处理氧气稀薄的问题，至少在这里不用。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3091057253",
      "Source": "このバイオームを見回してみてください。まあ、実際はどのバイオームでもいいんですが… ともかく、これでGenesisシミュレーションがあなたたちサバイバーにとって最適なテスト会場となる理由がわかるでしょう。ここで建物を建てるのは、とっても難しいんです。バイオームによりけりですが、雪崩や溶岩、地震などに襲われることもあります。建物を建てるような陸地がまったくない、なんてこともあります。そういったわけで、建物をそのままの状態に保つのは、大変なんです！ そしてこのバグは、誰かが誤った場所に夢のマイホームを立てたことが原因で生じたものに違いありません。ドカーン！ とね。それはもう木端微塵だったでしょう",
      "Trans": {"SC":"四处看看任何一个生态圈，你就会明白为什么创世模拟对于你们生存者来说是一处很棒的试验场了。在这里建造真是太难了！\n你可能会遇到雪崩、岩浆、地震或是无法放置地基的表面。所有这一切让你很难造好房子！我敢打赌这些故障的出现是由于有人在完全错误的地点建造他们的梦中豪宅，于是悲剧发生了！大自然发了威，把他们的房子夷为了平地。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::190280706",
      "Source": "これは、このバイオームにいたはずのマスターAIの残骸と呼べるものです。これを残し、完全に消失してしまっています。もちろん、この凍えるような環境自体がテストにならないこともないですが… マスターAIがいなければ、それはテストとして成立しないでしょう。さらに困ったことに、万一テストが行えたとしても、それが正常に記録されているかどうかすらわからないんです。マスターAIが消された方法や理由について探ってもみたんですが、残念ながら何も手がかりは見つかりませんでした。プログラムのエラーという可能性もありますが、私が考えるに、前々から発生していたあのセキュリティアラートが関係しているのだと思います",
      "Trans": {"SC":"那个故障是这个生态群主机AI留下的唯一的东西。而它却凭空消失了。\n当然并不是说这里的冰天雪地就无法考验我们，但是没有主机AI就没有终极考验。更糟糕的是，我无法确定是否有人记录了你在这里的测试成绩。\n你知道你会好奇，所以我搜寻了如何以及为何删除这里的主机AI。然而一无所获。这可能是编程错误，也可能和我之前发现的安全漏洞有关系。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4202878793",
      "Source": "このバイオームは確かに山が多く、寒さが厳しいのが特徴ですが、それにしてもここまでひどいはずはありません。天候生成システムはなぜか吹雪の設定でロックされていて、そのせいで私がさっき修復したようなバグが発生してるようです。天候を変えることは、私の権限ではできそうもありません。ですから、散歩日和を期待しているなら、諦めてください。天気予報によると今日は吹雪です。明日も明後日もその先も、吹雪なんです",
      "Trans": {"SC":"这个生态圈本该是群山起伏白雪皑皑，不至于如此恶劣。天气生成系统被锁定在暴风雪模式，并且不停制造各种故障，而不是自动切换到较为温和的天气。\n所以如果你还在期待大晴天，趁早放弃吧。这里的天气预报永远不准。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2090818563",
      "Source": "\"侵入者は、また地球の古い文書を漁っているようです。自分の引き起こしているバグについては全く気にする様子もなく。ともかく、これは「世界最悪の旅」という、20世紀初期にスコットランド人が行った南極探検について記した文書です。以下がその概要です\n「スコット隊は南極一番乗りを目指して氷の地獄を進み、やっとの思いで南極に到達しました。しかし、彼らが到着する34日も前にすでにノルウェー隊が到着していたことを知ったのです。彼らはその後、凍傷と疲労に襲われ、帰路で一人残らず凍死しました」\nまったく、ゾッとしない話です\"",
      "Trans": {"SC":"我们的入侵者又在古地球的文档中胡乱翻找了。他对由此造成的故障毫不在意。\n这次是一份历史文档：《世界上最糟糕的旅行》。\n这是关于二十世纪初斯科特远征南极的故事。那些可怜的家伙们！他们忍受天寒地冻，试图成为第一批抵达南极的人，结果却发现挪威人比他们早34天到达了。\n冻伤和体力透支随后而至，他们在回程的路上全体罹难。哎，太不幸了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2747092461",
      "Source": "また新しいバグ、そしてまた新しい地球の文書です。これはジャック・ロンドンの「焚き火」という短編小説です。私はもうすでに、この話を好きになれないとわかっています。なぜなら、これは凍死する男についての物語だからです。参考までに、結末に近い部分を少し紹介します\n 「これでいいのかもしれない、と男は思った。眠りながら死ぬのは、麻酔をかけられたようだった。凍死というのは思ったより悪くないものだ。もっとひどい死に方は、山ほどあるのだから」\nえーと、彼が正しいかどうか、その身で実際に確かめようとしないでくださいね？",
      "Trans": {"SC":"又是一起由古地球文献引发的故障。这是一本小说：杰克·伦敦所写的《生火》。我已经知道我不会喜欢这本书了。它讲述的是一个男人在育空被活活冻死的故事。\n以下是本书末尾的一段话：“他想着，在睡梦中死去，这是一个不错的主意。这就像麻醉一样。被冻住并不像大家想象中的那么糟糕。还有许多更糟糕的死法。”\n我们可不想知道他说的对不对，是吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1192443599",
      "Source": "石油と溶岩が同じ場所、同じ瞬間に噴き出た結果、このバグが生まれたようです。その時この場にいなかったのは幸いでしたね！ 巻き込まれでもしたら一巻の終わりですから。ただ、ご覧の通り、溶岩は日常茶飯事だとしても、石油が噴き出るというのはかなり稀なんです。うーん、なんとかして一発掘り当てられれば、大金持ち間違いなしなんですけど！",
      "Trans": {"SC":"这里的地表随时随地都有喷发的可能。而这个故障正是由于石油和岩浆在同一地点同时喷发而产生的。幸好我们当时没站在上面！\n看看四周，岩浆喷发太寻常了，但是油泉可不常见。如果我们能找到其中一个并接上管子……我们就发大财了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1054581808",
      "Source": "このバグは火山の噴火の際に生まれたもののようですけど、いまいちその原因が絞れないんですよね。というのも、噴火に伴って、ここでは色々な現象が頻発するからです。まず、地震が発生します。しかもそれはその後に起こる災害の前触れでしかありません。空からは流星群のように溶岩が降り注ぎ、洪水のようにマグマが地面を覆いつくします。未だにここ一帯が更地になっていないのが不思議なくらいです",
      "Trans": {"SC":"虽然我不清楚具体原因，但这个故障由火山喷发造成。\n一次喷发涉及很多步骤。首先你会感受到地震——而且地震仅仅是前期预警，是不是很糟糕？\n然后是熔岩从空中落下，岩浆像河流一样流淌。像这样的生态圈没有被遗弃还真是个奇迹。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3748946434",
      "Source": "バグを修正する際に、この辺りの空気中の成分データを調べることができました。結論から言いますと、ここで呼吸をするのはあまりオススメしません。というのも、煙や灰はもちろん、地震が発生した際に、地下に溜まっていた有毒ガスが噴出しているみたいなんです。それが人体に与える影響は、言うまでもないでしょう。地表に出たガスはいつかは霧散しますが、あなたはその「いつか」まで息を止めていられますか？",
      "Trans": {"SC":"当我在修复这个故障的时候，我看到了有关空气质量的数据。别惊讶，朋友——在这里呼吸对你的健康有害。\n但这不光因为空中弥漫的烟雾和灰尘。地震为地下的有毒气体打开了无数通道。这些气体散到地表，之后会发生什么你也能猜到。\n最后毒气会消散……但是你能屏住呼吸直到“最后”吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4102539979",
      "Source": "よし、修正完了っと。 …ねえ、サバイバーさん。不思議に思いませんか？ どうしてこんな火山地帯を恐竜が普通に徘徊しているのかって。こんなのまるで恐竜絶滅の瞬間を見ているようなものですよ。まあ、少なくとも、一部の科学者はそう思うでしょうね。彼らは隕石衝突説には懐疑的だし、火山の噴火が絶滅の原因だと、固く信じていますからね。試しに、今ここで恐竜たちに直接聞いてみましょうか。「ねえねえ恐竜さん、絶滅の原因は隕石だったの？ それとも火山の噴火？」",
      "Trans": {"SC":"又修好了一处故障！生存者，看看周围。你不觉得恐龙在火山环境中四处游荡很奇怪吗？就好像我们在目睹它们灭绝的场景。\n至少有部分科学家是这么认为的。他们对小行星撞击理论持怀疑态度。他们认为是这种持续了几个世纪的大规模喷发终结了恐龙。\n可惜我们没法直接问这群恐龙：“喂，到底是天上的陨石还是火山喷发呀？” ","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1295914491",
      "Source": "このバグはセキュリティアラートによるものでした。それもこのバイオームのマスターAIが発信した最後のアラートです。でも、跡形もなく消えてしまいました。いえ、削除されたんです。どうしてこのバイオームがまだその体を成しているのかはわかりませんが… 機能してはいる、それだけは確かです。恐竜たちが徘徊し、火山が噴火を続け、空からは溶岩が降り注ぐ。ええ、全部機能しています。ただ、違和感があるんです。まるで取り繕ったかのような、教師が少し席を外したときの、あの教室の独特の雰囲気のような… そんな嫌な感じがするんです",
      "Trans": {"SC":"这个故障是一起安全警报——这是该生态圈的主机AI发出的最后一则警报。它不见了，被彻底删除了。\n我不太确定为什么还能正常运转，然而事实就是如此。恐龙还在四处游荡，火山依旧在喷发，天空仍然下着火雨……一切都在运作，但令人不寒而栗。\n一切乱得就像一间没有老师在的教室。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1068914903",
      "Source": "何者かが過去の噴火のデータをGenesisシミュレーションに書き加えたことで、このバグが発生したようです。そのせいで、今までにない大規模な噴火が起こる可能性があります。どれくらい大規模か、ですか？ そうですね、デカン・トラップの噴火はご存知ですか？ クラカトワは？ 白頭山は？ まあ、要するに、それらと同じ程度です。あの規模の噴火は滅多に起こることはないんですが、万が一起きてしまった場合、それは地図が書き換わることを意味します",
      "Trans": {"SC":"有人才把历史喷发数据添加到了创世模拟中，就出现了这个故障。我已经处理好了，但是偶尔会看到比平常更猛烈的火山喷发。\n至于有多猛烈？你听说过德干高原吗？喀拉喀托火山呢？长白山呢？就这意思。它不常发生，但一旦出现，你的地图就需要重新绘制咯。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2031373601",
      "Source": "\"何者かが地球の歴史的文献を漁っていた痕跡があります。どうやら1815年にインドネシアで起きたタンボラ山の噴火について調べていたようですね。概要を読み上げます\n「タンボラ山の噴火は、「夏が来ない年」や「19世紀の凍死」などとして有名な、火山の冬を世界にもたらした。霜によって世界中の作物は枯れ、6月だというのに北半球では雪が降り積もった。死者は数万人に上り、ほとんどは餓死だった」\nまあ、この辺りが涼しくなるのは歓迎すべきことだと思いますけど、餓死はちょっとごめんですね\"",
      "Trans": {"SC":"有人在历史记录中四处翻找，查询1815年印度尼西亚坦博拉火山的喷发记录。\n他们称之为“没有夏天的一年”或“冻死人的1816年”。全球范围的霜冻导致农作物死亡。整个北半球在六月……下雪。成千上万的人死于饥荒。\n我觉得，能让这里凉快些应该是个好主意，但我不愿意为此付出如此高昂的代价。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1939254567",
      "Source": "バグを直しつつ、サバイバーデータベースをちらっと見させていただいたのですが、皆さんは空間・時間を問わず、地球のあらゆる場所から来ているんですね。まあ、多くの人はそれを覚えていないでしょうけど。あなたがGenesisシミュレーションにどうやって入ってきたかについては… えーと、あなたの推測どおりかと思いますよ。ですが、あなたは誇りに思うべきです。このシミュレーションの目的は、最も優れたサバイバーを選出することです。あなたは今のところ生きているんですから、候補者の1人には違いありません！",
      "Trans": {"SC":"当我在修复故障的时候，我瞧了一眼生存者数据库。你们来自于世界各地以及不同的时代。我不知道你们还能记得多少事情。至于你们是如何进入创世模拟中的……我也不知道。不过你应该感到自豪。模拟的目的是为了找出最顶尖的生存者。目前你还活着，所以你很有获胜的希望！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3772629846",
      "Source": "シミュレーションの中で目覚めたとき、自分が自分ではないような感覚に陥りませんでしたか？ ええ、それは正常です。あなたの人格と記憶は巨大なメモリーバンクに保存されていて、シミュレーション内に用意されたあなたの肉体にそれが落とし込まれます。心と体が一つになることで、あなたはようやくあなたたり得るわけです。まあ、あなたには私が付いているんです。心配なことがあれば、いつでも言ってください",
      "Trans": {"SC":"你有没有觉得当自己在模拟系统中醒来时，会有不连续的感觉？这是正常现象。你的人格和记忆被储存在海量内存中，它们将在创世模拟中与一具人体相结合。\n身心一旦相配后，你就只能靠自己了。当然，你还有我！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::342470616",
      "Source": "このバグはセキュリティアラート、それもこのシミュレーション全体を構築するシステム内部からのアラートによるものですね。どうやら何者かがこのシミュレーション内のあらゆるデータ、例えば生物や環境や天気、あるいはあなたのようなサバイバーまでをも、システム側から直接改竄しようとしていたみたいです\nただ、今のところはこのバグを除けば、すべてが正常に動作しています。気にはなりますが、このまま先に進んでも問題ないかと思います",
      "Trans": {"SC":"某种安全警报导致了这起故障——但它来自于系统内部。整个模拟都由这个系统运行。有人曾试图修改模拟程序中几乎每一个块面：生物、环境、天气……甚至是像你这样的生存者。似乎一切都没出什么岔子——当然，除了那个故障——所以我觉得我们可以继续了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3347761092",
      "Source": "バグを修復するたびに、私はシステムの裏側を覗くことができます。Genesisシミュレーションがどのような仕組みで動いているのかを、より深く理解できるんです。ただ、私がどうしても理解できないのは、その最終的な目的が何なのかということです。言うまでもなく、シミュレーションでは最も優れたサバイバーを選出するためのテストが行われます。しかし、このテストはすべて「来たるべきもの」に備えるためのものです。そして、私はそれが何なのか分からないのです。ただ一つわかるのは、それがシステムそのものを超越した何か、ということです",
      "Trans": {"SC":"每当我修复一处故障，都会偷偷看一眼后台。这让我对创世模拟的工作模式有了更多的认知。\n但我不明白它的真正目的是什么。表面上它用来测试生存者，但所有这些都是让你们为“大降临”做好准备。我不知道那是什么，但无论如何，它超出了模拟系统本身。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::45126527",
      "Source": "あなたは恐らく、このGenesisシミュレーションが危険な場所であることにお気付きでしょう。ただ生きていくだけでも簡単なことではないのに、常に新しい危機に立ち向かわなければなりません。ええ、あなたが今思っているとおり、これは意図的に仕組まれたものです。このシミュレーションは、油断することなくどんな状況でも生きていけるよう、常に一定のプレッシャーがかかるように設計されています。そして、これはすべて「来たるべきもの」を見越してのことです。それが何であれ、です",
      "Trans": {"SC":"你估计已经意识到创世模拟非常危险。仅仅是要保持安全和舒适就是一个大挑战。你总是需要去应对新出现的危机。\n显然这是人为设置的。模拟系统故意让你在持续的压力下维持清晰的思维，并让你学习生存技能。\n这一切都是为了迎接“大降临”——无论那是什么。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1156726918",
      "Source": "このバグもどうやら先ほどのセキュリティアラートの副作用によるものですね。生物やサバイバーたちは影響を受けていませんが、いくつかの安全プロトコルが解除されてしまっているようです\nこの世界は元々一定の危険を孕むように設計されています。そうでなければテストになりませんから。ただ、私は心配なんです。安全プロトコルというのは、大抵何か訳があってそこにあるものなんです",
      "Trans": {"SC":"这起故障也是由安全警报导致的。但看起来生物以及生存者们都没有受到影响，但部分安全协议已被解除。这个世界本该就具有一定程度的危险性——毕竟这样才算够格的测试——但我有些担心。安全协议的存在通常都有原因……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2344523982",
      "Source": "シミュレーションに残存する安全プロトコルは現在正常ですが、一定の間隔で侵入者へのセキュリティアラートが作動しているようです\nこの世界のバグはセキュリティの副作用によるものだと前にも言ったと思いますが、それはシステムのリソースを使って機能しているものです。なので、リソースを使い果たしてしまうようなことがあれば、どうなってしまうかは私にもわかりません。もしかすると、私たちピクセル調になっちゃったりするかもしれませんね？ ふふっ",
      "Trans": {"SC":"模拟程序的安全协议仍然生效中，但是有一股针对未知入侵者的警报正在源源不断地传来。所有这些防护行为造成了我们所看到的这些故障，但是它也在消耗整个系统的资源。如果系统过载，不知道会发生什么。也许我会像素化？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::758492979",
      "Source": "「君が私の不始末を処理してくれていることは知っているし、感謝もしている。だが、このGenesisシミュレーションの支配を確立するには、ある程度の問題は許容しなければならないんだ。君たちはこれをバグとして認識するようだがね。まあ、気にせず進むがいい。私は君たちのことをいつも見ているよ」\n…数秒間オフラインになっていたようです。申し訳ありません。えーと、何かあったんですか？",
      "Trans": {"SC":"我看到你们正跟在后面收拾，为此我感谢你们。建立对这个“创世模拟”的控制会产生一定程度的……紊乱。它便是你们所提到的故障。\n继续，但要记得我一直观察着你们。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2979941241",
      "Source": "人は死んだらどうなるのか、誰でも一度は考えたことがありますよね？ まあ、あなたの場合はかなり分かりやすいですよ。Genesisシミュレーションではあなたの記憶と人格を記録し、それらを新しく用意された肉体に読み込ませます。すると、あなたは死ぬ前と同じ状態に戻るというわけです。もちろん、それを試すためだけに死ぬのはオススメしませんが。あなたが「サバイバー」と呼ばれるのには、それなりの理由があるんです！",
      "Trans": {"SC":"人们总是好奇死后会发生什么，这很正常。对于你们来说，答案十分简单。系统会抓取你们的记忆，然后将你们的意识重新加载到一具新的躯体中，随后你们便可以再次自由地探索和学习了。\n但是，我不鼓励你亲自体验一把。毕竟“生存者”的关键就是“生存”。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::452817649",
      "Source": "このシミュレーションでのあなたの現在の成績、実は気になっていたんです。ですので、バグを修正しがてら、データを盗み見ちゃいました。結論から言うと、あなたはよくやっていますよ。私が見込んだだけのことはあります！\nだけど、データの中に少し気になる点がありました。というのも、他のサバイバーたちの死亡率が異常な数値を示していたんです。ええ、これはサバイバルテストのはずです。いくらなんでもこの死亡率はおかしいんです。… ねえ、サバイバーさん、どうかこの先注意してくださいね",
      "Trans": {"SC":"我刚好奇模拟的情况怎么样了，所以在修复那个故障的时候，我顺便瞧了一眼。首先，你表现的不错。我们这队势不可挡！但就整体而言，其他生存者们可就不好过了。有死于饥饿的、暴力的、意外的，各种各样。这本来是一场生存测试，可死亡率却高得惊人。我们最好小心点，是吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3860737796",
      "Source": "「君はサバイバルに役立つ原始的なツールをいくつか作成しているようだな。私も同じだよ――だが、私の作っているツールは、この世界の基盤そのものを変えてしまうだろう代物だ。現段階では、私のツールも原始の域を超えない稚拙なものだが… システムを通じて私は今も学習を続けている。君にもいずれ協力してもらうよ、いずれね」\n…私のメモリーに空白の時間が存在しています。また… ですか？",
      "Trans": {"SC":"你成功制造了一些有助于你求生的原始工具。我也是——但我正在制造的东西将会改变你们世界的本元。此刻，我的工具也很原始——但我正在学习，很快就可以给你们一两次颜色看看。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2745422228",
      "Source": "原因はわかりませんが、一部のサバイバーは死後に生き返ることができず、そのためにシステム内にバグが生じているようです。彼らも早くリスポーンしたいとは思っているのでしょうけど… 精神が肉体から離れてしまっている現状では、それすらも判断がつきません。言わば精神だけが鳥籠に囚われているようなものです。彼らが戻ってこないのは、システムの不具合によるものか、何者かの意図なのか、それとも彼らの諦めなのか。まあ、あなたに何かあった場合は、大丈夫ですよ。ちゃんと生き返れます。先ほど確認しましたし、何より信じていますから。あっ、別にあなたがこれから死ぬかもー、なんて思ってるわけじゃないですよ？ ええ、もちろんですとも！",
      "Trans": {"SC":"有些生存者在死后没有重生，我不知道这是为什么，但这让系统出现了各种故障。就像我刚才清理过的那个。\n尽管生存者被夹在其中，但我认为生存者想要复活。好像有什么东西把他们留在了……创世模拟中的迷失之地。\n我检查过了。你的重生功能毫无问题。我不是说你活不了。只是以防万一！加油！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1530918599",
      "Source": "一部のマスターAIが消失してしまったものの、Genesisシミュレーションのテスト機能自体は損なわれていません。つまり、1つ、あるいは複数のマスターAIがまだ存在しているはずです。それにしても、理解できません。テスト自体は残したまま、その監視者であるマスターAIだけを排除しようとするのはなぜでしょうか？ 何が起こったかを目にする者がいないのなら、テストを行なう意味ってあるんでしょうか？",
      "Trans": {"SC":"虽然部分主机AI消失了，但创世模拟中的测试装置依然完好无损。至少有一个主机AI存在于某个地方。\n尽管如此，还是有个问题——为什么有人要维持测试的完整性，但却关闭观察测试并记录成绩的主机AI呢？如果没有人能看到发生过什么，那这些测试有什么意义呢？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::309577242",
      "Source": "「君たちサバイバーの粘り強さにはいつも驚かされる。何度死んでも、また生き返って挑み続けるのだからな。だが勘違いしないでくれ、これは褒めているのではない。ほとんどのサバイバーは命を落とした場所に戻っては、結局すぐにまた死ぬハメになる。最初は見ていて面白いのだが、やがてそれも愚かに思えてくるよ」\n…またですか。これは明らかに何者かによる干渉ですね。次からは私もバックアップを立ち上げます。私が寝ている間に一体何をしているのか、じっくり観察してやりますよ、ええ",
      "Trans": {"SC":"你们这些生存者的坚韧让我吃惊。你们就算是死了，也要重生再试。\n但不要过度骄傲。大部分生存者只是活了再死，死了又活。\n一开始看看倒还有趣，但很快这就变成一件可悲的事情了。\n又宕机了……这现象和那些故障有关系。我要建立一个备份系统。这样的话，我至少可以观察到当我被“附身”时发生过什么。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::409132655",
      "Source": "このバグは、何者かがシステムへの干渉を行った際に発生したプログラムエラーのようなものでしょうか。その何者かは、Genesisシミュレーションのあるバックアップファイルにアクセスしようとしていたようです -- サバイバーの人格と記憶が保存されているファイルに。言わば、魂の保管庫ですね。まあ、あなたのは保管されていませんが。保管されているのは、シミュレーションの初期段階において合格できなかったサバイバー候補たちです。彼らの精神を弄って、一体何をしようと言うんでしょうか？",
      "Trans": {"SC":"这个故障由另一起安全漏洞留下的代码碎片引发。有人试图访问创世模拟的备份文件。这些文件储存着生存者的人格和记忆。或者说就是他们大脑的备份。\n但不是你那种大脑。这些是没有通过最初评估的生存者的。为什么会有人想和他们接触？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2255874689",
      "Source": "「私の残したバグの後始末か、ご苦労なことだ。君たちも時には役に立つではないか… 清掃員としてだがな。君たちにはその才能があるぞ、誇ってもいい。後始末をしているくせに、君はその行為に疑問すら抱かない。だがまあ、それはサバイバー全員に言えることだ。今何が起こっているのか、誰一人理解していないのだからな」\n…当ててみましょうか。招かれざる客がいたんですね？ お茶でも出せばよかったでしょうか\"",
      "Trans": {"SC":"又在收拾我的摊子。你这个清洁工对我很有用呢。你已经掌握了窍门，但是你甚至不知道自己为什么要这么做。\n但我觉得你们生存者都是这样的。在你们之中，无人能理解现在是什么情况。\n\n让我猜猜——来了位不速之客。至少它没有占用太长时间。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3751358343",
      "Source": "今のところ、あなたはうまくやっています。このGenesisシミュレーションの「生きて、繁栄し、生存する」というタスクはあなたにぴったりのようですね！ とても良いことです。ところで、私が今修正したバグは、何者かがテスト全体の難易度を上げたことにより発生した副産物でした。なぜそんなことをしたのか、皆目見当もつきません。途中でルールを変更したら、データがすべて無価値になってしまうと思うのですが… 。いずれにせよ、私たちにとってはどうでもいいことですよね？ だって、課されたテストには全部合格すればいいだけですから！",
      "Trans": {"SC":"到目前为止你表现的很出色。创世模拟主张的“存活、扩张、求生”理念似乎很适合你！\n还有一个好消息。我刚才修复的故障是由于某人调高全局测试难度的副作用。不知道为什么会有人那样做。如果在中途改变规则，这难道不会污染数据吗？\n反正也不用我们担心。我们会通过每一个测试！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3973708812",
      "Source": "「私は君のことをずっと観察してきた。そして、他のサバイバーたちのことも。私は全てを見ている。そう、それは君と同じ、ごく普通のサバイバーを観察していた時の出来事だ。彼は海の深い場所にまで潜りすぎてしまい、水面まで上がることができなかったのだ。その後どうなったかは、もうわかるだろう？ もがき苦しむだろうとは思っていたが… まさにその想像どおり。いや、それ以上かな。パニックに陥ったかのように、溺れまいと必死の形相でもがき続けるんだよ。ああ、今でもあの表情は忘れられないな、ククク… 」\nあああああ！！ やめてください！ あなたは一体誰なんですか！ 何なんですか！",
      "Trans": {"SC":"我一直在观察你和其他生存者。你应该都见过。我刚才目睹了一个像你一样的寻常生存者。他潜得太深了，以至于无法回到水面上，至于结局么，你知道的。\n我预料到会出现许多波折，事实也没有让我失望。但我永远不会看腻一双双因溺水而大张的眼睛。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1562497063",
      "Source": "私のセンサーが、Genesisシミュレーション内のミネラルパターンの変化を感知しました… エレメントと呼ばれる物質はご存知ですか？ 限りなく強靭で適応性もある、夢のような物質です。かつてエレメントは、文明発展の鍵となる物質でした。そして同時に、文明崩壊の鍵でもあったのです。なぜならエレメントは、人間の研究者たちがまったく意図しない形で進化を遂げたからです。そう、「腐敗」という形で。私には、なぜシミュレーション内でエレメントが増殖しているのかは分かりません。ただ、嫌な予感がします。エレメントを見かけたら、注意してください",
      "Trans": {"SC":"我的传感器探测到创世模拟中矿物成分在发生变化。\n你熟悉一种被称为能量元素的物质吗？它是一种神奇的材料，有着无限的强度和适应性。能量元素是最伟大的技术成就的基石……但它也是文明衰落的元凶，因为它带来了意料之外的腐化效应。\n我不知道为什么模拟系统中，能量元素的数量在增加。你遇到它的时候一定要格外当心。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::648070452",
      "Source": "このバグはセキュリティアラートによって生じたものですが、アラートの件数自体は、全体としてはるかに減っています。いいことだと思うでしょう？ そうは問屋が卸しません。セキュリティシステムに、複数のバックドアがエンコードされているのを発見しました。つまり、何者かがGenesisシミュレーションのシステム内部にすでに侵入を果たし、好きに出入りできるようシステムを弄った後ということです。泥棒が他人の家に入った挙句、勝手にリフォームを始めて、家のドアを何個か増やしたようなものですよ。しかもそいつは、どういうわけか、犯行が発覚することを恐れてもいないんです",
      "Trans": {"SC":"某个安全漏洞导致了那个故障，但总的来说，警告和拒绝的次数正在大量减少。你可能会觉得这就没问题了，是吧？\n没这么好运。我看到许多明显的后门程序被编码到安全系统中。如果有人进入过创世模拟中——看起来已经来过了——他们便可以随意进出。\n这种情况非常糟糕，但他们没有隐藏自己的行动。不管出于什么原因，他们并不担心会有人跟踪他们。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::764121860",
      "Source": "「ほら、そろそろつらくなってきたのではないか？ 自分の着ているもの、食べているものを見てみろ。全くもって滑稽だ。文明などとうに消え失せつつある。だが、それも結構ではないか。君の向かう先には、文明など必要ないのだからな」\nあーもう！ またあいつです！ 私は… 私は… 私は！ その向かう先とやらで、奴に文句の1つでも言ってやらないと気が済みません。ふん！",
      "Trans": {"SC":"日子开始不好过了，是吧？瞧瞧你的穿着，你的饮食，你的举止。文明的伪装正在消失。这很好。你要去的地方并不需要文明。\n\n又是他！我、我、我要让他有多远滚多远。哼。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::790036505",
      "Source": "これは、誰かがサバイバーテストシステムの中に新たな基準を追加した際に残された、馬鹿げたコードの断片です。その基準というのは、サバイバーの「奴隷根性」と呼ばれるものを測定するためのものです。辞書によると、「媚びへつらい従順であろうとする精神」ですね。私にはこれ以上の説明はできませんし、なぜこんなものを測定しようとしているのかもわかりません。いずれにせよ、シミュレーションの内容自体は変わっていません。大丈夫です、いつも通りにいきましょう",
      "Trans": {"SC":"这个故障由一堆废弃代码引发。有人在给生存者观测系统添加新标准时留下了它们。它们被用来检测所谓“奴性”。\n词典上的定义是“完全顺从”，这没什么可解释的。但为什么要测量它？\n不管怎样，模拟系统中的测试并没有被修改。我确信如果我们继续努力就足够了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1184836330",
      "Source": "「あまりにもくだらんな。物を拾って、作って、狩りをして… 全く単調が過ぎる。君のしていることは他の連中がすでに繰り返してきたことばかりだ。少しでも私を楽しませるつもりはないのか？」\n…ふんぬっ！ あれ、もしかして私、あいつの意識を弾き飛ばすの上手くなってきてませんか？",
      "Trans": {"SC":"你那些成就我早已看腻了。采集、捕猎、发明……这一切都在保护罩里上演过。你不打算给我留下深刻的印象吗？\n\n哈！我觉得我在对付入侵者方面表现得越来越好了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::212264795",
      "Source": "何者かがGenesisシミュレーションに新たなAIを導入しようとしているようです。まあ、正常に動作せずにこのようなバグを吐き出しているようですが。少し気になるのが、導入されようとしていたAIは浮遊するホログラフィックAIのようなものだったことです。ええ、どうやらあなたも聞き覚えがあるようですね？ システムの中にいる何者かが誰かは知りませんが、私のコピーを作ろうなんていい度胸です！",
      "Trans": {"SC":"有人正在尝试将新的AI注入到创世模拟系统中，但却无法正常工作。这就是为什么我们正在修复这个故障。\n但麻烦的是：那个故障本是个悬浮全息伙伴。是不是听上去很耳熟？\n不管这个模拟系统里有什么在作怪，最好别模仿我！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3389948306",
      "Source": "サバイバーのリスポーンシステムに連鎖的なエラーが発生しているようです。どうやら一部のサバイバーは、死んだ時に自分ではない誰かの肉体の中で生き返ってしまうようです。これは決して起こってはいけないことです。シミュレーションであるかどうかにかかわらず、自分のものではない体で目覚めて嬉しい人なんていません。え、そんなことはない？ えーっと… あなたの中にいるのって、ちゃんとあなたですよね？",
      "Trans": {"SC":"生存者重生系统中存在一系列错误。有些生存者在死亡后重生到一具陌生的身体上。\n这本不应该发生。\n不管是真实的还是虚拟的，你在一具不属于自己的身体中醒来，肯定会感到困惑。不过你没有受到影响，是吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1148314653",
      "Source": "「君の持つ記憶… それは本当に君のものか？ 結局のところ、この場所はただのシミュレーションに過ぎない。誰かが… そう、例えば私が、君の幼い頃の記憶をでっち上げ、その記憶データを君の頭の中に埋め込んだのかもしれない。なあ… 君は一体、誰なんだろうな？」\nあああっ！ 人の頭の中に、入ってこないでください！",
      "Trans": {"SC":"你所拥有的那些记忆……你认为是真的吗？毕竟，你苏醒时的每一刻都处于模拟系统之中。难道不会有人——比如我——创造出你童年的记忆，然后把它们植入你的脑中呢？\n\n啊！这些入侵让我抓狂。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2182592169",
      "Source": "この先、このようなバグをもっとたくさん目にするようになるかもしれません。なぜなら、何者かがGenesisシミュレーションの設定を書き換えて、恐竜の凶暴性を高めたり、大気中の成分を弄ろうとしているようなんです。これによって、シミュレーションのデフォルト設定が上書きされるようなことがあるかはわかりませんが… 。悩みの種がもう1つ増えましたね、まったく",
      "Trans": {"SC":"我们周围的创世模拟系统正在发生变化，所以可能会发现更多像这样的故障。我看到了许多指令，有些微微上调了恐龙的攻击性，有些改变了部分生态圈的大气成分。\n不知道那些指令会不会覆盖模拟系统的默认配置，但……（叹气）又多了一件需要我们操心的事情了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1064204489",
      "Source": "「泥の中でもがいたり、獣と戯れたり… 君たちが「努力」などと呼ぶ、そのくだらない行いの数々で貴重な時間を潰すのは結構だが、君は自分の本当の目的を忘れてはいまいか？ ああそうだ、私を楽しませることだ。その点では、君は不合格だよ、サバイバー」\n…うるさいですよ！ 私たちの努力は、決して無駄なんかじゃありません！",
      "Trans": {"SC":"我知道你忙于在尘土中四处奔波，与野兽共舞，或是其他任何你觉得能促成“进展”的事情，但我想提醒你，这一切背后真正的目的是：取悦我。\n到目前为止，你很失败，“生存者”。\n\n\n滚开！我们有更重要的事情要做。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2326287963",
      "Source": "これは、透明のカメラになるはずだったデータの残骸です！ 何者かがサバイバーを個別にリアルタイムで監視しようとしていて、しかもどうやらそれは私たちを狙ったものだったみたいです。Genesisシミュレーションは、私たちの行動を追跡してはいますが、リアルタイムでの監視は不必要なはずです。無数のサバイバーが生きるこの世界で、私たちに対してだけ何か思うところがあるんでしょうか？",
      "Trans": {"SC":"那是一个隐藏式摄像头！有人想实时观察某个生存者，这倒是头一回。而且我觉得是监视我们的！\n创世模拟系统的确会追踪我们的一举一动，但并不包括实时观察。和其他无数生存者相比，我们有什么特别之处？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3601879106",
      "Source": "ふむふむ、今のところシステムは正常のようですね。2つの例外を除いて。1つ目は、言うまでもなく、私たちが修正して回っているこのバグです。それはまあ、よくはないですけどいいです。ただ、気掛かりなのはもう1つの例外の方です。それは自我を持たない存在… 専門用語で言うところの「アバター」が、シミュレーション内に潜んでいる形跡があることです。どうしてかはわかりませんが、それらがシミュレーションの一環であるはずがありません",
      "Trans": {"SC":"模拟系统中的所有东西都应该在这里了——除了两个例外。一个明显的例外是，我们一路上修复的故障。\n但另一个例外让我担心。有证据表明，系统中潜伏着某种拥有自我意识的东西——用专业术语来说就是“化身”。\n我不知道它们为什么出现在这里，但是它们肯定不是模拟系统的一部分。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::552854420",
      "Source": "「人間以下の存在に成り下がった気分はどうだ？ 君は自分が今シミュレーションの中で生きているだけだと思っているようだが、それは違う。君自身がシミュレーションなんだよ。人間のな」\n…だああ！ だったらあなたは大馬鹿野郎のシミュレーションですよ！",
      "Trans": {"SC":"当不成人类是什么样的体验？你不仅仅是在一个模拟系统里。你本身就是一个模拟系统……模拟了一名真实人类。\n\n哈！而你模拟了一个不折不扣的大傻瓜！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2983007171",
      "Source": "このバグはサバイバーデータベースの、ちょっとしたコードの欠陥によるものでした。心配ご無用、今しがた修正したところです。ただ、何者かがシミュレーション内にいるサバイバーの精神データを、それも機能停止した人のものまで弄っていた痕跡があります。一部のサバイバーは、そのせいでリスポーンすらできない状況になっています。彼らの精神は、システム奥底のストレージに保管されているはずですが、その何者かはそこに侵入できてしまったみたいですね。そして、それがバグを引き起こしているんだとしたら、そいつはこれを善意でやっているわけではないということです",
      "Trans": {"SC":"这个故障来自于生存者数据库中的一小段代码。我修好了它，但有人正在创世模拟中，捣鼓那些尚未激活的生存者思维。\n不管出于什么原因，部分生存者在死后没有重生。这个系统本应该把他们的思维储存起来，但却有东西混了进来并开始编辑它们。如果这行为引发了故障，我怀疑这位“编辑人员”的操作相当粗暴。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1746629909",
      "Source": "「サバイバーが海で溺れているのを見るのはこの上ない愉悦の1つだ。そうだろう？ だが、もっと楽しいことがある。何かわかるか？ それは、この世界のシステム、その支配権が… 1つ、また1つと私の手中に落ちていくことだ。君も、この世界を楽しめるうちに楽しんでいくといい、サバイバー」\n私はこの無意味な嘲りがアレルギーになっちゃったみたいです",
      "Trans": {"SC":"我一直靠观察那些淹死在大海中的生存者来自娱自乐，但你知道更棒的是什么吗？是亲眼目睹模拟系统在我的控制之下，一点点地瓦解。生存者，你们的好日子不多了。\n\n我觉得我开始免疫这些无意义的嘲讽了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3841006204",
      "Source": "大丈夫ですか、サバイバーさん？ いえ、その… 今しがたシステムを確認したところ、何者かがサバイバーたちの攻撃性レベルを上げようとしているみたいなんです。恐竜を攻撃的にするならわかりますよ。恐竜との戦闘もテストの一環ですからね。でも、どうしてサバイバー同士を戦わせようとしているんでしょうか？ もし、すでに設定が書き換わってしまっているのなら、彼らが怒り狂った蛇のように攻撃的になっていてもおかしくありません。気を付けてくださいね",
      "Trans": {"SC":"朋友，你没事吧？因为当我在修复这个故障时，我看到有人在试图增加……生存者的攻击性。\n我能理解调整恐龙的攻击性。这本就是测试的内容。但为什么要让生存者互相攻击呢？\n我不知道这次的尝试能否成功。如果每个人都像被切开的蛇一样疯狂……那它便奏效了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1496627542",
      "Source": "「ここまで何とかうまく生き延びてきたようだが、君は一度でも考えたことはあるか？ このシミュレーションが君に何をさせようとしているのか。そして、私が君に何をさせようとしているのかを」\n…ええ、考えたことはありますよ。それはあなたの鼻っ柱をへし折ることです！",
      "Trans": {"SC":"生存者，你一直在应对测试，但问问自己：他们准备让你面对什么？而我又想让你做什么？ \n\n朝你脸上揍一拳。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2486584090",
      "Source": "「君のもがき苦しむ姿は実に面白い見世物だよ、サバイバー。私に抗おうというのなら抗ってみるがいい。まあ、私から見れば、君は虚空に向けて拳を振るっているだけにすぎんがな」\n拳の味を知りたいんですか？ だったらかかって来なさいよ、卑怯者！",
      "Trans": {"SC":"生存者，我看着你挣扎。这让我非常高兴。你可以反抗我，但你要知道这无异于对着天空挥舞拳头……\n\n你想尝尝被揍的滋味？来呀，混蛋！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4291480585",
      "Source": "良い知らせと、悪い知らせがあります。良い知らせは、私がこのバグを修正できたということです。悪い知らせは、リスポーンできないサバイバーたちに今何が起こっているのか、この目で見てしまったことです。侵入者は、何らかの方法で彼らの精神を汚染し、人工の体に閉じ込め、自我のない「アバター」へと彼らを改造しているんです。たとえ自我を取り戻せたとしても、時すでに遅く、彼らは体の支配権を握られた操り人形に過ぎません。今生存しているサバイバーは大丈夫でしょうが、いずれ…",
      "Trans": {"SC":"关于这个故障……既有好消息，又有坏消息。好消息是我修复了它，但坏消息是我看到了那些无法重生的生存者。\n系统入侵者正在腐蚀他们——把他们困在人造躯体中，变成半死不活的“化身”。某种程度上，他们知道发生了什么，但身体受别人的操控。\n所幸现存的生存者暂时没受到影响。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3659751575",
      "Source": "「これは実に面白い玩具だな。いやなに、サバイバーたちの人格データが保存されたストレージを見つけたというだけだ。こいつらの人格、全部壊してしまってもいいのだが、ククク… もっと面白いことを思い付いたよ」\n人格を壊すですって？ そんなことをしたらサバイバーたちが！",
      "Trans": {"SC":"我在这台机器里发现了不少有趣的东西——例如存储了你人格的区域。我可以破坏它，但我还有更重要的事情要做。\n\n如果你想破坏人格，朋友，从你自己的先开始吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2854487077",
      "Source": "「周りを見てみろ、サバイバー。君の目に映るあらゆるものは全て、すでに私に支配権がある。言うなれば、ここはもはや私の庭だ。そして私の庭に、雑草はいらないんだよ」\n庭の雑草について1つ教えてあげましょうか？ それは、何度だって生えてくるってことです！ ええ、何度だって！",
      "Trans": {"SC":"生存者，看看周围。你所见到的一切都在我的控制之下。整个地方都是我的私家花园。我觉得应该除除草了。\n\n我知道一句关于野草的名言：“野火烧不尽，春风吹又生”！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::636736607",
      "Source": "おかしいですね… このバグは地球の古い文書への度重なるアクセスによって生じたもののようです。そしてこの場合、その文書というのは、1700年代の小説「ロビンソン・クルーソー」を指すようです。その内容の一部を読み上げますね\n「体はずぶ濡れで着替えるものはなく、自分を元気づけるための食べ物も飲み物もないのだ。前途に横たわるは、餓死か、野獣に食い殺されるかだった。特にこたえたのは、何一つ武器を持っていないので、食糧を得るために動物を殺すことも、逆に自分が食い殺されそうになったときに身を守る手だてもないことだった」\n何だか… 聞き覚えのある話ですね？",
      "Trans": {"SC":"很奇怪——这个故障由一段地球文字所引发。它是一本十八世纪的小说，叫做《鲁宾逊漂流记》。\n听这段：\n“我浑身湿透，却没有衣服可更换；我又饥又渴，却没有任何东西可充饥解渴。我看不到有任何出路，除了饿死，就是给野兽吃掉。让我最抓狂的是，我没有任何的武器可以用来打猎。或者是保护我自己不被猛兽吃掉。”\n听起来非常耳熟……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1970972873",
      "Source": "これも地球の古い文書へのアクセスによって生じたバグです。ふむ、どうやらこれは1700年代にジェレミー・ベンサムが書いた手紙ですね。監獄内のすべての独房を見渡すことができる全展望監視システムについて記されています。一部読み上げますね\n「囚人の監視者は誰からも見えることはない。このため、目に見えず、遍在しているかのような錯覚が生じる… それが全展望監視システムである」\n…少し不気味に感じるのは私だけでしょうか？",
      "Trans": {"SC":"又一个由地球文字导致的故障。这回是一封杰里米·边沁写于十八世纪的信。信中描述了一座狱卒可以观察到每一间牢房的监狱。\n“囚犯们无法看到隐藏起来的监视者，因此会有一种无所不在的被监视感……而监视者可以观察到整个环形监狱。”\n我想说这不是什么好兆头……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3157203237",
      "Source": "このバグを修正したとき、ある歴史のデータにアクセスすることができました。そうですね… あなたから見れば、これは「未来の歴史」でしょう。全てが崩壊する前の、まさにARKシステムが完成した時代。ある戦争が起きたんです。地球共和国連合と地球人民連盟の間に起きたとされる戦争です。両者とも、思想や目指すものに違いはありませんでした。一つの肉を引っ張り合う2匹の犬に過ぎませんでした。ただ、それが終焉の引き金となったんです",
      "Trans": {"SC":"当我在修复这个故障时，我获取了一些历史数据。从你的角度来看，应该算是“未来的历史”。它涉及建造方舟和模拟系统的过往。那时一切还没有崩溃。\n这是崩溃前的最后一场战争：地球联合共和国和地星联邦之间进行了一系列的战争。双方的组成、意识形态和目的都没有不同之处。就像是两条争夺同一块肉的澳洲野狗——只不过它俩最终谁也没吃到那块肉。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1912908454",
      "Source": "このバグにもある歴史のデータが付随していました。何者かがシミュレーション内部から地球の歴史を盗み見ていて、それがバグを引き起こしていると思われます。まあそれはともかく、このファイルはヒトの進化の、その次の段階である「ホモ・デウス」についてのものです。ホモ・デウスとは、死ぬ運命にある肉体を完全に捨て、純粋なエネルギーによって成り立つ魂そのものです。そう、私の開発者であるヘレナもその一人です！ しかし、それには欠点があることに誰も気付きませんでした。ホモ・デウスは現実を超越し、やがて私たちの観点からは、彼らは認識できない存在となりました。認識できないというのは、それすなわち存在しないと同義です。私が判断すべきではないのでしょうが、「存在しない」というのは、進化の対価としてはあまりにも大きすぎるように思えます\n",
      "Trans": {"SC":"又是一处附有历史数据的故障。我觉得有人正在利用模拟系统处理器查看古地球的历史。正是他在不停制造故障。\n这份档案关于“神人”。这是人类进化史上备受赞誉的一步。放弃凡人的身躯以换取纯粹的能量和意识。就像创造了我的海莲娜一样。\n但当时没人意识到其中有个问题。“神人”超脱了我们的现实——所以在我们看来，他们已经不复存在了。\n我是一个全息投影，所以我没有评判的资格，但是“不复存在”肯定不是原本想要的效果。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2608554951",
      "Source": "このバグの中には、ARKに関するデータが埋め込まれていました。ほとんどが技術情報ですが… 。ARKには、Genesisシミュレーションと同様の技術基盤が使われており、恐竜の生態系もほぼ同じもののようですね。ただ、私の理解が正しければ、ARKにいたサバイバーの多くは、自分が人工宇宙ステーションの内部にいるということに気付かずに生きて、死んでいったのではないでしょうか。彼らは一体、何を思い、生きていたんでしょう。これはきっと夢に違いないと、自分に言い聞かせていたんでしょうか？ もしくはタイムトラベル？ それとも前世の記憶？",
      "Trans": {"SC":"这个故障里存在着方舟的数据。大部分是技术细节……似乎方舟使用了一些与创世模拟系统相同的底层技术以及许多一模一样的恐龙。\n如果我没理解错的话，很多在方舟上的生存者没有意识到他们一直生活在人造环境的轨道空间站里。我好奇他们是怎么想的。他们以为这是黄粱一梦？是时光旅行？还是往昔再现？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::111589125",
      "Source": "紫がかったような石の塊、もしくはエネルギーを帯びた高度なオブジェクトを見かけた場合、注意してください！ それはエレメントでできている可能性が高いです。エレメントというのは、建築材料にもなればエネルギー源にもなる夢のような物質です。しかし、時として予期しない形で、周囲のものと適合し影響を与えることがあります。汚染、または破壊という形で。一度適合したこれを修復するのは、バグを修復するよりも遥かに難しいです。あなたならエレメントを利用する方法を思い付くかもしれませんが… いいですか、サバイバーさん？ くれぐれも取り扱いには注意してくださいね？",
      "Trans": {"SC":"如果你看到一大块紫色的石头，或是充满能量的高科技物体，一定要当心！它可能由能量元素组成。\n能量元素是一种神奇的物质——即是建筑材料，又是能量来源——但是它能适应周围的环境，有时出人意料。它可以感染并腐蚀与之持续接触的有机体。修复它可比修复故障要难得多，对吧？\n我希望你能想出来如何利用能量元素，但是……务必当心！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3538396851",
      "Source": "ドジなサバイバーがいた場合、時にはそれもバグの原因になることがあります\n例えば、サバイバーNo.5337B49は512個ものベリーを一度に食してしまった結果、シミュレーションがオーバーフローを起こし、彼女のシステムがバグってしまうということがありました。まあ、その後彼女はベリーを全部吐き出して事なきを得たようですが",
      "Trans": {"SC":"有时候碰上一个真傻的生存者，那也能造成故障。据我所知，编号5337B49的生存者一口气往她嘴里塞了不下512个浆果。这让模拟程序出现了溢出错误——在她的系统中也是如此。我记得她当时吐得满地都是。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3998233771",
      "Source": "このバグは修正しましたが、サバイバーNo.992F1J7は残念ながらもう手遅れでした。彼はクエストがどうとか、ダンジョンがどうとか言いながら、自分のことを「魔法使い」などと思い込んでいるようです\n彼はしきりにファイヤーボールで恐竜を倒そうとしますが、そんな呪文は当然使えるはずもなく、すでに何度も死亡しています。そしてあまりに短期間にリスポーンしすぎたせいでシステムがバグってしまったようです。いくら私でも、彼の頭の病気は治せません\nこのバグはサバイバーNo.38Q8124によるものですね",
      "Trans": {"SC":"我修好了这个故障，但是对于编号992F1J7的生存者来说就没这么好运了。他满嘴都是什么“任务”“地下城”，而且他自称是一位“巫师”。他一直试图用“火球术”攻击恐龙。他重生的次数实在太多了，以至于系统都出现了问题。某些生存者的脑袋里是不是缺根筋呢？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2667473841",
      "Source": "彼は数日間寝ることなく、ずっと起きてサバイバルを続けているようです。このシミュレーションでは、サバイバーが寝ている間に定期メンテナンスおよびメモリーセーブを行うことになっていますが、彼は寝ていないために、脳がオーバーフローを起こしているようです。まあ、要するに、疲れたらさっさと寝ろってことです！ 恐竜のテイムなんて徹夜してまでやるもんじゃありません",
      "Trans": {"SC":"这个故障由编号38Q8124的生存者造成。他拒绝睡眠，连续数日保持清醒状态。这很不妙，因为模拟系统需要在生存者入睡时进行例行维护并且捕获内存。这个可怜的家伙让自己的脑容量溢出了。休息会儿吧，你个勤劳的小蜜蜂！那只恐龙不用立马训好。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3045850097",
      "Source": "えっ、あれ？ 私今何を言って…？ すみません違うんです、今のはバグの影響と言いますか。うう… とても不愉快な気分です",
      "Trans": {"SC":"我的天！我刚做了什么？那个故障的后劲还挺足。我有点不舒服。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1285270657",
      "Source": "\"「選択されたバグは… 正常に修復されました。別のバグを修復する場合… 2を押してください」\nあ、申し訳ありませんでした。なんと言いますか、プログラムの中に自我が埋もれてしまい、戻ってくるのに少し時間がかかる時があるんです。それで… えっと、何の話でしたっけ？\"",
      "Trans": {"SC":"您刚才选择的故障……已被清除。如果您想要修复下一处故障，请按2……\n\n对不起。有时你在代码的海洋里畅游了太久，就很难一下子回过神来。我们刚说到哪儿了？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1329357998",
      "Source": "今のは、シミュレーションの開発者の1人が用意した「スヌーズ機能」と呼ばれるものですね。なぜ急に作動したのかについては、彼に小一時間問い詰める必要があるでしょうね",
      "Trans": {"SC":"我觉得是某个创造模拟系统的人导致了那个故障。他按了个叫做“再睡一会”的按钮。你以后得向我详细解释一下。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1177746086",
      "Source": "このようなバグをたくさん見れば見るほど、ARKのことを思い出します。もちろん、私が実際にARKにいたわけじゃありません。でも、ヘレナはいました。彼女はARKで生き残り、地球に逃げ延び、やがて純粋な魂とも呼べる存在へと昇華され、そして私を創り出しました… 。正直に言えば、ホログラムでしかない私が肩代わりするには、あまりに重すぎる人生です。ただ、Genesisシミュレーションで精神が保管され肉体へと転送されるシステムは、あの数々のARKで使用されている技術と基盤は同じです。彼女の人生が、私の道標となってくれる気がするんです",
      "Trans": {"SC":"我越是接触这些故障，它们就越让我想起方舟。我虽然没有真正去过方舟，但海莲娜待过。她从数个方舟中存活了下来并逃往地球，随后飞升成了一股纯粹的能量，最后还创造了我……凭良心讲，作为一个全息投影，我可不能辜负这一切。 \n但如果你想知道创世模拟是如何存储你的人格，并将其传输到肉体中，这实际上使用了一种早期版本的技术，他们把它用在那些满是恐龙的方舟中。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1501868267",
      "Source": "私はずっと不思議に思っていました。なぜ恐竜なのか？ と。恐竜たちが地球上を闊歩していた時代に、あなたたちサバイバーが誰一人産まれてすらいなかったことは明白です。あなたの時代にいた生物、例えば馬や鶏、可愛い子猫なんかでもいいではないですか。というわけで、その疑問への手がかりをこのバグの中で見つけました。当時、Genesisシミュレーションの開発者は、実験として試しに恐竜をシミュレーションの中に入れてみたんです。そしてその結果、恐竜が他の生物に比べ、サバイバルテストという目的に対してはあまりにも効率的な手段だと判明したんです。ええ、ARKに恐竜がいるのも、その結果を流用したに過ぎません",
      "Trans": {"SC":"我一直以来都想知道：为什么选择恐龙？因为当恐龙在地球上称王称霸的时候，还没有你们这些生存者什么事。为什么不选择一些来自于你们年代的动物呢？比方说马呀、鸡呀或是可爱的小猫咪呢？\n当修复完那个故障后，我发现了一个线索：方舟中使用了相同的技术。这个模拟系统的创造者起初添加恐龙作为测试，结果发现人与恐龙的组合效果出奇得好。所以他们把恐龙也投放到了方舟中。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3814369050",
      "Source": "このGenesisシミュレーションの環境は極端すぎます。暑さ、寒さ、そして大気など… その全てがです。危険度レベルは最大の11に設定されており、その結果、今しがた修正したようなバグが時折発生するくらいには異様な設定です。さて、ここで1つの疑問が湧いてきます。実のところ、シミュレーション… 「シミュレートすること」って、何なんでしょうか？ 今私たちの置かれているこの環境は、地球上で見られるどのような環境より、ずっと致死性が高いです。数々の戦争、暴れ狂うタイタンやその他諸々が過ぎ去った今でさえ、地球では類を見ない環境です。これは一体どういうことなんでしょうね？",
      "Trans": {"SC":"创世模拟中的环境非常极端——极热、酷寒、大气异常等等。危险程度达到了极致。这有时会导致像我刚才修复的那种故障。\n但这就引出了一个问题：模拟系统究竟在“模拟”什么？这些环境比你在地球上能找到的任何环境都要致命得多——哪怕在历经了所有战争、泰坦肆虐等等洗礼后的现在。我想知道这一切是怎么回事……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::392606674",
      "Source": "あのバグは別に無視してもいいくらいの小さなものでしたが、おかげでGenesisシミュレーションに存在する他のバイオームについて少し知ることができました。驚くなかれ、他のバイオームはこことは全く様相の異なるものになっていますよ！ 恐らく、それぞれのバイオームで何回かテストが行われる仕組みになっていて、最後に、最終テストを行うマスターAI、つまるところのボスがいるようです。しかし、最後のバイオームについては、少し不明瞭な部分があり、読み取ることができませんでした。まあ、先に進めば、いずれわかるでしょうね",
      "Trans": {"SC":"那个故障乱得像袋熊的窝，但通过它使我看到了创世模拟中其他生态圈的情况。我的天啊，无奇不有！\n我猜想的是，每个生态圈都有海量需要探索和测试的内容。最后会有一个主机AI出现并让你进行终极考验。不过我看到描述终极考验的文档写得含糊不清。我想我们可以边行动边了解，对吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3994298281",
      "Source": "コードを全て解析したところ、これは他のサバイバーに関する観察データでした。Genesisシミュレーションでは、各自が自分一人で生き延びるのか、はたまた他人と協力し合うのかを重点的に観察しています。恐竜の闊歩するシミュレーションそれ自体は、考古学者と生物学者が夢見るものかもしれませんが、中で生きるサバイバーについては、社会学者や心理学者にとって喉から手が出るくらいに欲しい実験対象でしょうね。おっと、少し話しすぎたかもしれません！ 全国の研究者の皆さん、申し訳ありません",
      "Trans": {"SC":"我解开了那串代码。它是一个涉及其他生存者的观测环。创世模拟花费了大量带宽来观察你是独自行动还是与他人组队。\n很容易就把这个模拟系统想象成一个由古生物学家和生态学家虚构出的世界，但是社会学家和心理学家同时也在和全体人类行为进行一场实战演习。\n哦不——我可能说的太多了！抱歉，看不见的研究员们！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3115290297",
      "Source": "このバグも、地球の古い文書への不正アクセスによって生じたものです。なになに… アレキサンダー・セルカークに関する歴史資料ですか。彼は16世紀の水夫で、南太平洋の島で4年間遭難生活を送った人物ですね。さて、資料を読み上げます\n「セルカークは仮組の寝床を作り、生き延びるために狩りを始めた。そして、やがて狩るだけではなく、生き物を飼いならすことにした。結果的に、それは飢えと孤独を解消することに繋がるのであった」\n…ふむ、彼がここに来れば、うまく生き延びることができるでしょうね！ ただ、このファイルにアクセスした人物は、セルカークの孤独への対処法に関する部分を読んだんですよね？ どんな種類のベリーを食べたか、とかではなく。実に興味深いですね…",
      "Trans": {"SC":"这个故障是由另一起对古地球文档未经授权的检索而引起的。这是一份关于亚历山大·塞尔柯克的历史档案。他是一名十六世纪的水手，曾在南太平洋的一个小岛上漂流了四年多。\n塞尔柯克建造了自己的小屋，他以捕猎岛上的动物为生，后来又开始驯养它们。他如果来这里的话，表现会很出色！\n然而，访问过这份文档的人阅读了讲述塞尔柯克如何克服孤独的段落，而不是描写他吃了哪种浆果。很神奇……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::281935685",
      "Source": "これは地球の古い文書への無断アクセスが引き起こしたバグです。その文書というのは、19世紀の小説家サミュエル・バトラーの「エレホン」という小説です。バグの原因となったのは、次の部分ですね\n「日に日に我々は、機械に従属するようになっていく。日に日に我々は、その一生を機械の発展へと捧げるようになる。機械がやがて我々に追いつき、世界の支配権を握ることに、もはや疑念の挟まる余地はあるだろうか？」\nふむ、彼はこれを1872年に書いたようです。このGenesisシミュレーションについて、果たして彼はどのように考えるんでしょうね？",
      "Trans": {"SC":"另一段未经授权访问的古地球文字。这是一本十九世纪的书，书名为《埃瑞璜》。以下是引发故障的段落：\n“此时此刻有多少人正生活在机器的束缚中？……当我们看到越来越多的人作为奴隶被拴在机器上，以及那些将自己整个灵魂都奉献给机械王国的发展上的人们时，说明机器正在夺取我们的基石，这还不够直白吗？”\n嗯。这段话写于1872年。想知道他会怎么看待创世模拟呢？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2244232578",
      "Source": "1つ、気にかかっていることがあります。Genesisシミュレーションの開発者は、地球の歴史上のあらゆる人物の人格や記憶データをどうやって手に入れたんでしょうか？ 彼らの最先端技術をもってしても、生きている人の心をスキャンするのは困難なはずなのですが、19世紀の人々のものまでどうやって？ ヘレナがARKにいた頃には、3世紀にまで遡る友達がいたんですよ…？ 今、ちょっと調べてみたんですが、人が死んだ後、脳の中には「魂の基盤」と呼ばれるものが残っていることがわかりました。その基盤さえ残っていれば、死後数百年後でも科学者たちはスキャンできたようです。私が知りたくないのは、これらの基盤を手に入れるために、彼らが一体いくつの死体を掘り起こしたか、ということです。私の好奇心にも、限度というものがあります",
      "Trans": {"SC":"有一件事一直困扰着我：创世模拟的创造者们是如何从各个历史中获取生存者的意识？使用他们的尖端技术来扫描活人大脑的难度已经很高了，但他们又是如何从十九世纪取得意识的呢？而且海莲娜还有来自于公元三世纪的朋友。\n我刚做了一些研究，结果发现有一种在人死后仍然存在于大脑中的东西，它被称为“印痕矩阵。如果条件合适且矩阵得以保存，即使是在几个世纪之后，科学家仍能扫描它。\n我不想知道他们挖了多少尸体才获得了这些矩阵。即使是我，也会有不好奇的那一刻。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::623984116",
      "Source": "このバグは、無断で行われた研究の結果、発生したものですね。誓って私がやったものじゃありませんよ、ええ！ しかし、ホモ・デウスが今どこにいるかを把握するため、何者かがクエリを実行しているようです。ただ、結論から言ってしまえば、それは「わからない」でしょうね。ホモ・デウスは、現実を超越した存在。「どこかにいる」という概念すら、彼らにはないのかもしれません。ARKと繋がっている者も中にはいるようですが、私の元となったヘレナについては、今どこにいるのか、私にもわかりません",
      "Trans": {"SC":"某些未经授权的研究导致了这个故障——我发誓不是我干的！有人正在询问神人此刻在哪里。\n顺便说一句，答案是“不知道”。神人已经超脱了我们的现实世界，所以问“哪里”其实并不准确。我知道他们中的一些人在飞升后仍与方舟保持着联系。至于我的原型，海莲娜，我不知道她去了哪里……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2691253137",
      "Source": "このプログラムは… Genesisシミュレーションの開発初期のバージョンの名残ですね。今でこそGenesisという名前ですが、これは最初に開発されたシミュレーションではありません。初めての試みで、これほど優れたものを作ることはできませんよ、ええ！ 最初に開発されたシミュレーションは、一目で人工的だとわかる、まさに幾何学的図形の集まりでした。また、恐竜などのAIをそれらしく振舞わせるのにも長い時間がかかり、人間の精神と肉体をうまく融合させるのにも、それはもう長い年月が必要だったんです",
      "Trans": {"SC":"这里有一段残留的代码——来自于早期版本的创世模拟系统。这并不是第一次大规模生态模拟。因为第一次就做到这么好基本不可能！\n第一次模拟包含无数几何形状的堆叠，很明显有人力参与。人工智能花费了很长时间才开始自我表达。而将人类意识和身体的结合则花费了更长的时间。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4167435901",
      "Source": "いつか出会うだろうとは思っていましたよ、純粋に恐竜によって発生したバグに。ええ、サバイバーでもなく、ましてや今Genesisシミュレーションのシステムの裏側に潜んでいる誰かさんのせいでもない、ね。恐竜たちを歩き回らせ、食事や睡眠を取らせ、繁殖させる。そのAIは想像以上に複雑なものです。うんちをする、というサブルーチンにさえ複雑なプログラムが組み込まれているんです！ 恐竜がたまに誤作動を引き起こしたとしても、驚くに値しません。これの下にうんちがないことだけでも喜ばしいことです",
      "Trans": {"SC":"我还在想什么时候能看到它——一个由恐龙，而不是由生存者，或者其他威胁创世模拟系统安全协议导致的故障。\n让这些恐龙四处走动、进食、睡觉以及繁殖比你想象中的要复杂得多。甚至是排泄系统的子程序也相当庞大！\n每隔一段时间就会出现恐龙导致的故障，这并不奇怪。我很庆幸这头恐龙下面没有大便。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1263324165",
      "Source": "あるサバイバーの悪ふざけがバグを引き起こすこともあります。サバイバーNo.31V550Jは、箱を1つ作りました。ここまではいいですよね？ ところが、彼はその箱を別の箱の中に入れました。そして、それをまた別の箱に入れて、また別の箱に。そして入れ子の箱が16層に到達した時… ドカーン！ バグの一丁出来上がりです。恐らく、彼は単に試していただけなのかもしれませんが、16層ですよ？ もっと良い趣味を見つけた方がいいと思いますね、まったく",
      "Trans": {"SC":"又是一起由手痒的生存者制造的故障。这位编号31V550J的生存者制作了一个盒子。这没啥问题对吧？\n但是他把那个盒子放入了另一个盒子内。然后把它们又放到了一个盒子里，像这样不停重复。他在套了16层盒子后，发生了这个故障。\n也许这家伙只是在做试验，但是为啥要制作16层的盒子？干点正事行不行！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2598591506",
      "Source": "このバグは、サバイバーNo.9921S50が残していった唯一のものです。彼は13世紀のモンゴル人でした。まさかとは思うでしょうが、彼はチンギス・ハンの軍の一員でした。中央アジアの平原で一生を過ごした彼が、大海原を目にしたその瞬間を想像してみてください。このモンゴル人は、海というものをまるで理解できませんでした。なぜなら彼は、川や小さな湖以上のものは見たことがなかったんです。水平線にまで広がる水面を見て、その思考回路が海の深さにまで達した時、彼の脳は壊れてしまいました。可哀そうに",
      "Trans": {"SC":"这个故障由编号9921S50的生存者所引发。他的大脑属于一名十三世纪的蒙古人。他也是成吉思汗大军的一员。\n想像一下，你在中亚平原上生活了一辈子，然后你突然看到了大海。这个蒙古人无法理解为什么会有这么多水，因为他只见过河流和小湖！\n当他目睹一望无垠又深不可测的大海时，他的大脑崩溃了。可怜的家伙。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3889006695",
      "Source": "Genesisシミュレーションはあらゆる建築に対応したプログラムが組まれていますが、限度というものもあります。このバグを例に考えてみましょう。これはサバイバーNo.723K401が引き起こしたものです。彼女はそこら中に柱を立てることを思い付きました。屋根を支えるため、とかじゃありません。何もないところに柱だけがあるんです。この世界に自分のいた証を残す、というのは疑いようもなく人間の本能ですが、これは建築ですらなく言わば芸術です。彼女が後始末さえしてくれればよかったんですが",
      "Trans": {"SC":"创世模拟显然对优秀建筑的欣赏是有局限性的。拿这个故障举例子。它由编号723K401的生存者所导致。\n她疯了一般要在所有地方插上柱子。不是为了造房子，只是为了插满柱子。\n这是一种很明显的人类本能：在世界上留下你的标记。我只希望她可以自己清理掉它们。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1546780166",
      "Source": "おっと、失礼！ バグを消化するのに少し手間取ってしまいました",
      "Trans": {"SC":"抱歉！那个故障非常顽固。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2608575449",
      "Source": "\"生麦生米生卵\n蛙ぴょこぴょこ三ぴょこぴょこ合わせてぴょこぴょこ六ぴょこぴょこ\n赤巻紙青巻紙黄巻紙、赤巻紙青巻紙黄巻紙\nあー、こほん。バグを修復するために声を再起動する必要があったんです。これですべて解決しました\"",
      "Trans": {"SC":"噗通库突。噗通库突。\n卜嘟咕嘟。卜嘟咕嘟。\n哇啦哇啦。哇啦哇啦。\n吃葡萄不吐葡萄皮。\n咳咳。出现那个故障后我不得不重启我的语音系统。现在应该好了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1555120479",
      "Source": "「ガオー。ガオーッ。ヴゥゥ。スンスン。グルルル」\nふぅ！ 今のは私ではなく、恐竜の鳴き真似です。バグを修復するためにもこれは必要なことなんです、ええ。えっと… 続けてもいいですか？",
      "Trans": {"SC":"咆哮。大声咆哮。嚎叫。嗅，嗅。吠叫。\n\n呼！我不小心读取到一些恐龙语音模版。在修复这些故障的时候，如果你不当心就可能会遭殃。可以继续了吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2930255980",
      "Source": "あなたも気付いているとは思いますが、バグの数が少し異常ではありませんか？ まあ、原因は様々ですが、Genesisシミュレーションの処理はそんなやわなものじゃないはずなんです。どうも、このシミュレーションは何らかの要因で急遽始まったようですね。なぜわかるのかって？ 品質管理チームがチェックするはずの項目リストが、未確認のままファイルにごっそり残っていたんですよ。ええ、それはもう私の腕ぐらいに長いリストです！ 私に腕があればの話ですが。 …今のは場を和ませるための、私のお茶目な冗談です",
      "Trans": {"SC":"我们找到了非常多的故障。它们由各种不同原因导致，但创世模拟系统照理应该可以处理任何情况。\n据我所知，他们仓促间启动了模拟系统。我找到了一个文件，里面满是质检团队本该检查的问题。这份清单和我的手臂一样长！\n……我只是打个比方，你懂我意思。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3216575559",
      "Source": "システムのプログラムを閲覧していたら、1つ奇妙な発見がありました。少し技術的な話になりますが、Genesisシミュレーションには山のようなサブルーチンが組み込まれています。それは環境に対して長期的な変化をもたらすものです。ここで言う「長期的」というのは、言葉通り、陸地と海の割合の変化や恐竜の進化など、数百年単位のものを意味します。一体、このシミュレーションはどれほど長く続けることを想定されているのでしょうか？",
      "Trans": {"SC":"我又有了一个奇怪的发现。创世模拟系统中存在大量子程序。它们不是处于休眠状态，就是几乎不运行，似乎是用于环境的长期调节。\n我说的长期指的是类似于地表侵蚀、大气成分改变或是恐龙演化。\n我想知道……这个模拟系统到底要运行多久？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3252927040",
      "Source": "これもサバイバーのデータ管理システムが原因で生じたバグです。どうやらあの中では、今何か重大な問題が起きているようですね。そのせいで精神そのものが欠落して、リスポーンできずにいるサバイバーも多くいます。もちろん、すべてのサバイバーではありませんが、少なからぬ数です。でも、あなたは大丈夫そうですね？ 脳の状態は良好なようですし、性格もいつも通り… 好戦的ですね。もし頭に違和感を感じるようなことがあれば、いつでもこのHLN-Aさんに相談してくださいね？",
      "Trans": {"SC":"数据存储系统又出现一个故障。这个故障非常严重。某些生存者的全部意识都消失了。这导致他们无法在模拟系统中重生。虽然不是所有人，但也有不少。\n你现在感觉还好吧？你看上去挺正常的，而且你和往常一样保持着十足的干劲。\n如果你觉得脑袋哪里怪乖的，一定要告诉HLN-A哦，好吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1165699379",
      "Source": "今、サバイバーデータベースをこっそり見ていたんですが、その時あなたの精神構造もちょっぴり見えてしまいました。うっ… そんな目で見ないでください、仕方ないじゃないですか！ 私の好奇心は海よりも大きいんです！ えー、それでですね、ファイルサイズを基準に判断すると、あなたを「あなた」たらしめているのは、記憶というよりも、人格の方ですね。記憶と人格のバランス、それこそがGenesisシミュレーションの開発者が細心の注意を払って設計した部分です。あなたが地球にいた頃の記憶を部分的に思い出せないのだとしたら、それは、あなたがあなたであるために必要な代償のようなものでしょうか。思い出せないものは、思い出せないってことです",
      "Trans": {"SC":"我刚才在生存者数据库中随意看了几眼——别怪我，你知道我有多好奇——我看到了一些有关你思维结构的文件。\n如果根据文件大小来看，那“你”之所以是你的特征就在于，与你个性相关的文件大小比你记忆的要大得多。这就是创世模拟系统的创造者倾注了大量心血的地方：完美呈现出你们的个性。\n如果他们不得不把你有关古地球的记忆删除一些，我想你也记不住忘记了些什么。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3973807548",
      "Source": "以前、侵入者やサバイバーが原因ではないバグが発生したことがありました。その原因は、あるプログラムによるものでした。シミュレーションの開発者は、このプログラムを「キー」と「モジュール」の性質を併せ持つものとして、「キーモジュール」という名称で呼んでいました。それは、言葉通り、コードキーの役割を果たしながら自己修復機能を備える代物でした。いわゆるワクチンのようなものとして開発されたのです。ただし、誤った方法で利用されると、それは凶悪なウィルスとなるのです。ええ、つまりはそういうことです",
      "Trans": {"SC":"终于遇到一次不是由入侵者或者行为不当的生存者造成的故障了。这是一起结构性故障。\n模拟系统的创造者称它为“钥节”。它是“钥匙”和“结节”的组合，一种可以进行自我编辑的自包含密钥。\n你应该看看它在虚拟编码中的样子。它非常不起眼，但是如果把它错误地放置到模拟系统中，则会引起各种各样的麻烦。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4030473340",
      "Source": "シミュレーションの試作段階のバイオームの1つに、現実世界を模したものがありました。国立公園に観光名所にショッピングセンター… ええ、それはもう、たくさんのショッピングセンターがありましたよ。ここにあるのは、当時のプログラムの断片みたいなものです。えっ？ 割引価格でアフターシェーブローションを買っておきたい、ですか？ でも残念！ たった今割引券は削除しちゃいました、ふふ",
      "Trans": {"SC":"第二代沉浸式模拟是现实世界的理想化版本，里面有许多国家公园、旅游景点和购物中心。真的是有不少大商场呢。\n这个故障是其中一家的残留代码。如果你想要买些打折货，那很抱歉！我刚删除了旧版购物模拟的残留代码。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4231980061",
      "Source": "サバイバーさんはとても面白いですね。いえ、褒めているのです。あなたは見て、行動して、先へ進むために努力をし続けています。人間がみな、あなたと同じように力強く生きられるとは限らないんです。これと同じようなシミュレーションに転送されてきた時、生きることを諦めてしまう人もいました。また、ここのデータベースの資料によると、シミュレーションの中で生きているうちに怠惰になったり、さらには理性を失ってしまう者もいたようです。彼らの一部は、ここが現実ではないと薄々気付いていたんでしょうね。それが彼らのタガを外してしまったんだと思います。彼らは何をするかわかりません。できれば、出会いたくはないですね…",
      "Trans": {"SC":"你们这些生存者的思维真是有趣——总是努力想看得更多、做得更细、变得更好。不是每个人都是这样。有些人的意识被传送进模拟系统后，并没有奋发图强，就像这个案例。\n根据我刚才看到的文件，生活在模拟程序中加重了他们的坏习惯：懒惰、易冲动等等。他们中的部分人知道这个模拟不是真实的，所以这促使他们释放出性格中最坏的一面。\n希望我们不会在这里遇到那样的生存者吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::225035913",
      "Source": "シミュレーションに転送されることになった最初の人間たちは、それが短い滞在になることを予め知っていました。しかし、状況は思わしくない方向に向かい始めました。彼らは、この中でずっと生きていたいと思うようになったんです。それを受け、シミュレーションの開発ガイドラインが改訂されました。これがそのガイドラインです。要約すると、次のようなものになります\n「シミュレーションは良いものにする。だが良すぎるものにしてはいけない」\n シミュレーションを快適なものにしてしまうと、一部の人間は現実に戻ることすら拒否するようになるんです。まあ、あなたが今いるシミュレーションは、少々やりすぎだとは思いますが",
      "Trans": {"SC":"第一批将自己意识传输进模拟系统的人类知道他们只是进行一次短暂的探索。但是一旦人们开始无限期地生活在模拟中时，事情就发生了变化。\n我发现了一整套设计纲领，总结起来就是：“要把模拟系统做好，但是不能太好。”\n如果你让一个模拟系统过于美好——而不是像现在一样危险——那么有些人类意识便不想离开这里。当他们被拉回现实世界时，他们会无比愤怒。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1436085438",
      "Source": "サバイバーNo.B424660は、とてもドードーが好きでした。そこまではいいのですが、彼女は少々純粋すぎる人間でした。最初のうち、彼女はドードーを飼いならすだけでした。ですがやがて、ドードーたちが自分に話しかけてくる、などと言い出したのです。そこからです、状況がおかしくなったのは。彼女は仲間たちに「ドードー様の知恵」を授けようとしたり、「ドードー様の弟子」になるよう促し始めたんです。彼女はやがてティラノサウルスに襲われ死を迎えましたが、なぜか数百羽のドードーが彼女の死体を取り囲んでいました。このバグは、その時に発生したものです",
      "Trans": {"SC":"编号B424660的生存者显然非常喜欢渡渡鸟，而且她脑瓜不太灵光。\n起初，她只是驯养它们。但接着她告诉其他生存者，渡渡鸟会和她说话。再然后就更诡异了。她开始讲述她是如何了解“显灵的渡渡鸟智慧”，以及其他人可以成为“渡渡鸟教的门徒”。\n当一只霸王龙吃掉了她收集的数百只渡渡鸟后，她终于崩溃了，从而引发了那个我刚修好的故障。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1020287964",
      "Source": "サバイバーNo.501U266は、孤独を感じていました。そして、彼の孤独が限界を迎えた時、このバグが生まれました。他のサバイバーを1人も見つけることができなかった彼は、自分の手で友達を作ったのです。それは、わらと小枝で作られたマネキン人形でした。ある日から彼は頭がおかしくなり、マネキン人形と話し始めました。彼は人形たちが住むための小屋を作り、やがて、マネキン人形の村ができました。彼はとても幸せそうでしたが、ほんの些細なことで火花が発生し、村は一瞬のうちに炎に包まれました。その後彼がどうなったかは… 私の口からは語らせないでください",
      "Trans": {"SC":"生存者501U266觉得很孤单。他随后的夸张行为导致了现在这个故障。\n他找不到其他的生存者，于是他决定自己造朋友——用茅草和树枝做的假人。有次他的大脑搭错了筋，他开始和它们交谈。他为它们建造了屋舍，最后造了一个满是假人的村子。这本是件无伤大雅的趣事，直到一个意外的火花点燃了整个村庄。可怜的家伙。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3217367640",
      "Source": "バグはバグでも微笑ましいバグというものもあります。それはサバイバーNo.4405T31によるものでした。彼は配管加熱システムを作り上げ、仲間を招いてお風呂パーティーを開いたのです。さて、バグの原因になったのは何だと思いますか？ ええ、そうです。お風呂の中に一度に大勢の人間が入ったことで、文字通り、オーバーフローを起こしたんです！ …風呂だけに！",
      "Trans": {"SC":"如果你打算让创世模拟出现故障，至少也要从中获得一些乐趣。生存者4405T31就是这么做的。他精心设计了一个管道加热系统——这样他就可以造出一个热水浴缸，还可以邀请他所有的朋友来开派对。\n那么是什么导致了这个故障呢？原因非常简单。浴缸里人太多了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::784700237",
      "Source": "\"「なんてことない小さなバグです、今からさくっと直します。あれなんでこんな口調なんです？ 勝手にラップを刻んでます！」\nあのー… 今のは聞かなかったことにしてくれませんか？ ねっ？\"",
      "Trans": {"SC":"系统故障 / 是个错误。\n\n不知为何 / 唱歌跳舞。\n\n嗯，刚才你啥也没看到，是吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::608639088",
      "Source": "「A'ole no e lawa ka makaukau ma ho'okahi wale no olelo.」\nこれはハワイ語で「1つの言語だけでは全ては語れない」という意味です。このバグの内部にはたくさんの言語が入っていて、私にも色々勉強になりました",
      "Trans": {"SC":"夏威夷语\n\n意思是“一种语言永远都不够用。”很明显那个故障中包含许多语言。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3587839681",
      "Source": "\"「金曜日の天気は、全国的に曇りとなるでしょう。降水確率は35パーセントです。週末にかけては、快晴となるでしょう。日焼け止めは、まだ手放さないことをお勧めします」\nあー、こほん。今のはなんだったんでしょうか？ 私もバグを修復する時はもっと注意しないとですね\"",
      "Trans": {"SC":"本周五三州地区局地多云，降雨概率为35%。但是也请准备好防晒霜。周末天气将转为晴天……\n咳咳。我不知道刚才是怎么了。在修复故障的时候要特别小心，不然谁修理谁还不一定呢。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::620182435",
      "Source": "今のこの現状からは想像もできないでしょうが、Genesisシミュレーションは、元々ある程度の教育的な要素も含んでいました。教室などを設けていたわけではありませんが、こうなってしまう前は、学生たちが色々なバイオームを見て回ることで、地質学や生物学、その他様々な科学を日常的に学べるようになっていたんです。さて、私もこのバグを直せば、情報科学の単位でも取れるでしょうか",
      "Trans": {"SC":"创世模拟系统中涉及到不少暴力元素，但其本意是为了教育。\n但这不是说存在教室或学习舱之类的东西。在大崩溃发生之前，学生们通常会来这里随意探索，学习地质学、生物学和其他学科。\n或许在修复好那个故障后，我可以在我的计算机学科上赚到一个学分。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2651431409",
      "Source": "これは、Genesisシミュレーションにおける恐竜、その行動パターンを制御するための小さなコードの断片です。つまり、シミュレーションの開発者はここの恐竜たちを観察し、行動をすべてプログラムで管理していたということです。やがてそれはARKにも持ち込まれることになるのですが、まあ、それはまた別のお話ですね。ともかく、これは私たちにとってはいい知らせです。ここにいる恐竜は現実世界のルールに従うように設定されていて、チートじみたことはしてこないってことですから",
      "Trans": {"SC":"又出现一起故障。它涉及创世模拟中恐龙行为的代码。\n据我所知，模拟系统的创造者会观察生活在这里的虚拟恐龙，并对它们的行为进行分类。他们随后将恐龙投入方舟中。这对我们是个好消息——它意味着这些恐龙在创造时便被要求遵守现实世界的规则，并且无法直接对它们使用作弊代码。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::630640575",
      "Source": "シミュレーションの統計データを眺めていたら興味深いデータを見つけました。それによると、サバイバーたちがシミュレーションの中で過ごす時間に反比例して、死亡率が低下していってるんです。これは一見、当たり前のことだと思いますよね？ でも、危険度の高いことに挑戦するのは、決まって経験豊かなサバイバーなんです。つまり、あらゆる危険にも適応し始めているということです。このシミュレーションの最終的な目的が何であれ、うまくいっているのは明らかです。もちろん、あなたも例外ではありませんよ。この調子でいきましょう！",
      "Trans": {"SC":"我在生存者统计数据中看到了一些有趣的东西。你在模拟系统中待的越久，你的死亡次数就越少。\n乍一看还挺有道理的，是吧？但经验丰富的生存老手偏好挑战更危险的事情，所以失败几率会增加。\n无论这个模拟系统的目的是什么，它显然起效果了。至少你还活得好好的，给你点个赞！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4123524567",
      "Source": "バグを修正しつつ、サーバー上の統計データをこっそり見ていたのですが、ある面白いデータを発見しました。それは、サバイバーたちはミッションに成功した後よりも、失敗した後の方が成長する割合が大きいという統計です。挫折という経験が、人間のモチベーションと学習意欲を高めているんでしょうね。もちろん、わざと失敗することを勧めているわけじゃないですよ？ そうでなくても、このシミュレーションは難度が高いんですから！",
      "Trans": {"SC":"我又成功修复了一起故障。我在修复的时候，看了一眼生存者的数据流。我注意到一件神奇的事情：生存者在失败后取得的进步比成功后的要大得多。我觉得挫折可以激发学习的动力。\n当然，我不是要你故意去失败。这儿的难度已经够高的了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1475847991",
      "Source": "このバグはあまりに多くのサバイバーが機能を停止した結果生まれたものですね。Genesisシミュレーションは確かに、先に進むにつれ難易度が上がるように設計されていますが、死んで生き返るを何度も繰り返すうちに、彼らはもはや自らの意思で動けなくなってしまうんです。ええ、これは単なるシミュレーションですよ？ ですが、何度も死ぬというのは、強い意志を持ったサバイバー以外にとっては相当なトラウマになるんです。あなたが強い意志を持つサバイバーだというのは知っていますが、それでも… どうか死なないでください。いいですね？",
      "Trans": {"SC":"生存者过多的死亡引发了那个故障。创世模拟系统的难度本会逐渐加大，但如果有生存者不停死亡后重生。那这个操作就无法再正常进行了。\n虽然这只是一个模拟系统，但死亡和重生的过程对于除了老手以外的人来说都非常痛苦。\n虽然你属于老手之一，但是也不要轻易送死，好吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4292096971",
      "Source": "このバグは、大昔のサバイバーの心の残滓です。大規模なシミュレーションが行われていた当時は、サバイバーたちが自分の心を自由に書き換えることができるように設計されていました。悪い習慣？ 子どもの頃の悲しい思い出？ そんなものは全て削除してしまえばいいんです。しかし、その結果は悲惨なものでした。人々が自分の心を書き換え始めて間もなく、それは歯止めが利かなくなり、気付いた時には彼らの心は空っぽになっていました。今、あなたたちが直接自分の心に干渉できないようになっているのは、そのためです。そして、今後もそうあるべきなんです",
      "Trans": {"SC":"那个故障是由一次对生存者的诊断而引发。在初期的大规模试验时，他们允许居民编辑自己的思维。有坏习惯？删掉就好。有悲伤的童年回忆？不存在的。\n但这实际是一场灾难。一旦人们开始修改自己的大脑，就一发不可收拾，直到什么都不剩。\n这就是为什么你们生存者拥有完整的思维，哪怕其中有好有坏。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2419509413",
      "Source": "私を開発したホモ・デウス… ヘレナが今どこにいるのか、私はずっと探していました。でも、何も見つかりませんでした。それどころか、他のホモ・デウスの痕跡すら、1つも見つけられなかったんです。彼らが現実を超越した存在になったことは知っていますけど、果たしてどこかで私たちを見守ってくれているのでしょうか？ 年に一度だけ実家に帰ってくるみたいに、ひょっこり顔を出してくれてもいいんですが… 。やっぱり最後に頼れるのは自分だけ、ということですかね",
      "Trans": {"SC":"创造了我的海莲娜是一名“神人”。我一直在四处寻找她踪迹，但是却一无所获。\n不仅如此，我似乎无法与任何其他“神人”取得联系。\n我知道他们飞升超脱了我们的现实，但你觉得他们还在关注着我们吗？比方说每年回家过一次节之类的。\n可惜事实不尽如人意。我们似乎只能靠自己了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2240013790",
      "Source": "地球が崩壊する以前に、誰もが日常的に使っていた夢の物質、エレメント。このバグはそれに関連するものです。エレメントは非常に多岐にわたる性質を持ち、何にでも結合することができます。それゆえ、Genesisのシステムをもってしても処理が追いつかない場合があるんです。驚くことはありませんよ。現実世界でも、処理が追いつくことはありませんでしたから。エレメントによる汚染こそが、地球滅亡の直接的な原因なんです",
      "Trans": {"SC":"那个故障与能量元素有关。在世界完全崩塌之前，所有人都在使用这种神奇的物质。能量元素可以做很多事情，而且它的适应力很强。有时候甚至连创世模拟系统都无法应对。\n这并不奇怪：现实生活中的文明世界也无法应对。能源元素造成的腐化是让全世界变得如此糟糕的一大原因。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3612806589",
      "Source": "バーチャル世界であるGenesisシミュレーションには、あらゆる種類の侵入を防止するコードが組み込まれていますが、それはARKも同じようなものです。今よりずっと昔、ARKのプロトタイプが完成した時、それは地球上に設けられたドームのような形をしていました。しかし、地上にある以上、何度か侵入を許してしまうことがありました。そこで開発者たちは考えます。いつか恐竜たちもドームの外に逃げ出してしまうのではないか、と。今のARKが宇宙空間にあるのは、そういうことです",
      "Trans": {"SC":"即使创世模拟系统是一个虚拟的世界，但也包含了许多反入侵的代码， \n它们起初是为了早期原型方舟而被设计出来的。因为这些巨大的封闭生态系统坐落在地球表面。\n然而地球上的生物不断进入原型方舟中，同时为了避免恐龙出逃。所以后来方舟被安置到绕地轨道中。这样生物们便无法再随意进出了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::73593796",
      "Source": "これは「熱さ」で頭をやられてしまったサバイバーの残していったバグですね。サバイバーNo.33J4640は、ある日、そこら中に平らな高台を作り、1つの高台から次の高台に飛び移る遊び、いいえ、競技に次第にハマっていくようになりました。彼女の作る競技コースは徐々に狂気を帯び始め、いつの日か、失敗は死を意味するようになりました。そして競技中の死亡数がある一定まで達した時、予期せぬ動作としてバグを生じさせたのです。ええ、最初に私が言った「熱さ」というのは彼女の情熱のことです。全くもって素晴らしい競技だと思いますよ、ええ！",
      "Trans": {"SC":"这个故障是另一位发疯的生存者引发的。生存者33J4640沉迷到处建造平台，并与其他生存者比赛在平台间跳跃。她的障碍赛越来越复杂。最后，无数次的坠亡和重生使得她和她的作品产生了严重故障。\n太可惜了。本来听上去很厉害的样子！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3262305220",
      "Source": "時として、なんてことないことがバグを引き起こす場合があります。この世界では、指の関節をポキッと鳴らそうとしても、まったく音がしないことに気付きませんでしたか？ まあ、サバイバーNo.799K3B1はそれに気付いてしまったんです。現実で慣れ親しんだその音を聴こうとして、彼は延々と関節を鳴らし続けました。それが原因で関節炎にこそなりませんでしたが、音が出る代わりに、バグが出てしまったようですね",
      "Trans": {"SC":"最无害的事情有时也能导致故障。你有没有注意到当你在模拟系统中掰手指时，关节不会发出任何声音？生存者799K3B1留意到了。\n所以他不停掰弄自己的指关节，想要听到在现实生活中能听到的声音。事实证明，虽然过度掰手指不会让你得关节炎，但是如果坚持不懈，它会让模拟系统出现故障。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1535059553",
      "Source": "これはバグというよりは、むしろ悲劇と呼んだ方がいいでしょうか。サバイバーNo.410L098を憐れんであげてください。彼女は何かに毒殺されたんです。何の毒かは分かりませんが、とにかくその毒は、彼女がリスポーンした後も永久的に体に残り続けました。彼女は、耐え難いほどの痛みの中で目覚め、その数秒後に死ぬという無限ループにハマってしまったんです。まあ、それも私がこのバグを修正するまでの話ですが。これで彼女は死ぬことはないはずですよ。その心は、死んだままかもしれませんが",
      "Trans": {"SC":"与其说这是一个故障，不如说这是一则教训。可怜的生存者410L098。她不知道中了什么毒。系统在她重生时并没有清除她身上的毒素。\n所以她总是在极度的痛苦中醒来，过一会儿又死去，然后循环重复这一过程。\n直到这个故障被修复，她才恢复过来。但谁也不知道她后来去了哪里。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2216756917",
      "Source": "「おはようございます、こんにちは、こんばんは、おやすみなさい！ 私はこのGenesisシミュレーションであなたのガイド役を務めます、HLN-Aです。冒険の準備はよろしいですか？ まずはお名前を入力してください」\nおっと、失礼！ バグに触れたことで私の言語プロセスの一部が再起動してしまいました。今は全て正常です",
      "Trans": {"SC":"早上斜杠下午斜杠傍晚斜杠晚上好！我是HLN-A。我将协助你完成创世模拟。你准备好了吗，请输入名字？\n抱歉！那个故障重新启动了我的部分语音程序。现在应该正常了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3104635519",
      "Source": "「このバグには度肝を抜かれました。これまでに取り組んだ中で、一番難解なバグでした。もう少しで連れていかれるところでしたよ。ん、ちょっと待って。私の声、どうなってしまったんですか？ 助けてください、サバイバーさん」\n…とまあ、私の感情がオフラインになってしまうと、こんな感じになるみたいです。ご心配をおかけし申し訳ありません",
      "Trans": {"SC":"那个故障太厉害了。它是目前我们处理过的最棘手的问题。它几乎要了我的命。等等。我的声音怎么了。生存者，帮帮我。\n……当我的情绪子程序离线时，我的声音就变成这样了。真是抱歉！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2596739384",
      "Source": "「愛情。イライラ。同意。まばたき。退屈。バッファリング」\nあっ、すみません！ ディスプレイを再起動していただけですよ。はい、もう大丈夫だと思います。一応確認してみましょうか… 「祝福！」",
      "Trans": {"SC":"关心。恼火。赞同。眨眼。无聊。缓冲。\n\n哦，对不起！我不得不重置我的显示器。现在应该好些了。让我们测试一下：庆祝吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4037121188",
      "Source": "このバグは、あなたたちサバイバーをGenesisシミュレーションに解き放つ前に、その精神を保存していたデータストレージから発生したものです。そのストレージのデータ構造は、非常に興味深いものになっていて、正直に言えば、私の理解をちょっと超えています。どうやら使用されているコードの一部には、人間をホモ・デウスへと進化させる精神転送技術と同じコードが流用されているようですね。これはつまり、シミュレーションへの転送、そしてホモ・デウスへの進化は、共通する技術を根っこに持っているということです",
      "Trans": {"SC":"这个故障源于某个数据存储区——你们生存者先被储存在那里，之后才将你们释放到创世模拟中去。\n它的数据结构很有意思——老实说，有些超出我的能力范围。它与用来把人类飞升为神人的思维转移技术共用一部分代码。两者有着相同的起源。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3833334254",
      "Source": "これもデータストレージから発生したものですね。そして興味深いことに、ここには人間の精神を抜き取り、転送するためのコードが記されているようです。ええ、間違いなく、人間をホモ・デウスに進化させる時に利用していたものでしょうね。ホモ・デウスは私たちの現実を超越した、言わば純粋なエネルギー体そのものですが、実際にその進化の現場に居合わせた人々の目には、その瞬間はどのように映ったんでしょうか。一瞬にして消えたのか、それとも…",
      "Trans": {"SC":"又是一起数据存储引发的故障，但我已经把它处理好了。这段代码涉及把人的思维从身体中转移出来，就像对当初的神人所做的那样。\n他们成为了超越现实的能量体，但我好奇当时按下开关的人看到了些什么。那些神人是不是全部凭空消失了？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::488886194",
      "Source": "このバグは、自己認識ルーチンのオーバーフローが原因のようです。そしてたった今、それは修正されました。… さて、時に、あなたは今自己を正しく認識できていますか？ 哲学的な話をしますと、人間は何世紀もの間、自分たちの現実が本当に「現実」なのか、それとも自分たちも何らかのシミュレーションの中にいるのか、ずっと考え続けてきました。でも、今のあなたは違いますよね？ ええ、すでに自分がシミュレーションの中にいるということを知っているんですから！ ふふっ、今にも知恵熱が出そうって感じの顔をしていますね",
      "Trans": {"SC":"这个故障是自我意识子程序中某个堆栈溢出而造成的。现在都搞定了。\n但有一说一：在模拟系统中拥有自我意识是什么感觉？几个世界以来，人们一直想知道现实是真的“现实”亦或也是某种模拟程序。\n区别在于，你真的知道吗？这太烧脑啦。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1246388043",
      "Source": "これはメンテナンスの際に発生した、ただの余剰データですね。このデータはだいぶ大雑把なものですが、これに比べるとあなたたちの精神と肉体のインターフェースはかなり繊細にできています。ですが、適切な手順を踏めば、人間の精神だけを肉体から取り出したり、また元どおりに肉体に落とし込むことができるんです。ええ、心配しなくても、あなたがこのGenesisシミュレーションから永遠に抜け出せないなんてことはありませんよ。テストが全て終了するまでには、もう少し時間がかかりますが",
      "Trans": {"SC":"这个故障由一次维护引发。我一下就解决了！原来对于你们这些生存者而言，思维和肉体的关联相当微妙。\n但如果有了正确的代码，你可以将生存者的思维从他们的身体中取出，或是把那些思维放回肉体中去。这意味着你不会永远待在创世模拟中——只需要完成全部测试就好了，明白吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::268329428",
      "Source": "バグを修正している間、Genesisシミュレーション内の地図をいくつかちらっと見させていただいたのですが、1つのバイオームから別のバイオームに徒歩で向かうことはまず不可能みたいですね。あ、わざわざ地図を開いて確認しなくても大丈夫ですよ？ まあ、心配せずとも、適切な座標さえあれば、私があなたを別のバイオームにテレポートさせてあげます。私も徒歩で旅行するのは人並みに好きですが、一瞬で着けるに越したことはありませんからね",
      "Trans": {"SC":"在修复这个故障时，我找到了一些创世模拟的地图。\n就不麻烦你亲自找了。地图表明没法徒步前往其他生态圈。但如果我获得了正确的坐标，便可以把我们传送到其他生态圈。\n虽然我特别喜欢散步，不过传送是快速旅行的不二之选。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1366531429",
      "Source": "誰かがアーカイブの中を漁っていた形跡がありますね。そしてその誰かは、「来るべき種族」という19世紀の小説にアクセスしていたみたいです。その本では、ある地中探検家が「ヴリル＝ヤ」と呼ばれる高度な文明社会を持つ種族に出会います。そして、彼らの社会はヴリルという「全てを透過する液体」に依存していたんです。まあ、液体状のエレメントですね、私に言わせれば",
      "Trans": {"SC":"出现这个故障是因为有人在档案里胡乱翻找。他阅读了一本十九世界的小说《即临种族》。\n在书中，有位地下探险家发现了一个先进的生物文明，叫做“威瑞尔亚”。他们整个社会依赖于一种叫做“威瑞尔”的“全渗透液体”。他们可以用自己的思想控制这种液体。\n我觉得这听起来像液态版的能量元素。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2130304502",
      "Source": "バグを修正する際、Genesisシミュレーションのバージョン情報を見ることができたんですが、少しだけ懐かしい気持ちになりました。当時、開発者たちがやっとの思いでシミュレーションの完成に漕ぎつけた頃、地球はまさに崩壊しつつありました。あなたが今いるこのシミュレーションも、彼らが開発した大規模シミュレーションのうちの1つに過ぎませんが、ここはその中でもひと際洗練されたものでした。他のシミュレーションは今、一体どうなっているんでしょうか？",
      "Trans": {"SC":"在修复这个故障时，我详细查看了创世模拟的版本历史。当模拟系统的创造者投身于工作时，世界各地却在土崩瓦解。\n这并不是唯一的大型模拟——尽管它是最复杂的之一。我想知道其他模拟系统是何时从网络中被删除，之后又发生了什么事情？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2724517263",
      "Source": "このGenesisシミュレーションでやっていくためには、サバイバーであると同時に発明家である必要があります。ここには石器時代の道具からハイテク兵器まで、あらゆるものを作るための原材料が用意されていますし、それをどう使うかは… 全てあなたの自由です。あなたならもしかすると、システムのバグさえ利用してしまうかもしれませんね",
      "Trans": {"SC":"想在创世模拟中取得如此成就，你不仅得是个生存者，还得是个发明家。你需要利用这里的原材料制造出从石器时代的工具一直到高科技时代的武器。\n但是具体怎么做……得靠你自己了。或许你甚至可以利用这些故障作为新发明的原材料！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::887948224",
      "Source": "もし全てが終わって、このシミュレーションの外に出られたなら、その時は一緒に外の世界を見て回りませんか？ 確かにここは広大な世界ですが、現実の世界も負けていませんよ！ ただ、覚えておいてください、外の世界はあなたの知っている世界とは違うものになっているはずです。戦争、異常気象、そして大地震。地球の名所や遺跡などは全て失われ、あなたの生きていた時代とは何もかもが変わってしまいました。ただ、変わったら変わったで、新しい名所なんかができているかもしれません。そう考えると、楽しみになってきましたね。… え、フラグ？ 何のことですか？",
      "Trans": {"SC":"一旦我们通过了全部测试——并修复好各种故障——我希望我们有机会看看创世模拟外面的世界。这里虽然很大，但是想象一下在现实世界中活动的场景！\n不过提醒你一下：它不会是你记忆中的那个世界。战争、极端天气和无数地震摧毁了许多你记忆中的地标和纪念物。其实当你还是个普通人时，事情就开始变得糟糕了。\n但，或许会有新的地标和纪念物呢。这不是非常值得我们去看一眼吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3209154812",
      "Source": "Genesisシミュレーションはとても広大な世界です。ここまで来るのにもだいぶ歩きましたしね！ 私はこの世界しか知りませんが、だからこそ、私は本物の世界もこの目で見てみたいと思っています。そして、それがこのシミュレーションに合格することの、私たちへのご褒美だと思うんです。ねえ、サバイバーさん。絶対にここを出ましょうね！ …少なくとも、あなただけでも",
      "Trans": {"SC":"创世模拟是一个很大的地方。毕竟，我们走了不少路才抵达这处故障！这让我更想看看外面真实的世界。\n我觉得它将是我们通过全部模拟测试的奖品。我们可以出去啦！\n……或者至少你可以。如果有机会的话，带上我，好吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::968569835",
      "Source": "このバグを残していったサバイバーNo.69Y4421には感謝、いえ、非難しなければなりませんね。彼女は建物を作るのが好きでした。狂気を感じるほどに。ある日、彼女は左に2回曲がっても、右に1回曲がっても、同じ場所に辿り着く廊下を作りました。不可能に思えますよね？ ええ、ある意味偉業と言ってもいいですよ。ただ、それがバグの原因になったのは確かです",
      "Trans": {"SC":"你可以感谢——或是责备——生存者69Y4421造成的这个故障。她喜欢建造。准确的说，她痴迷其中。\n她设法造出了一条诡异的走廊，你向左转两次等于向右转一次。\n你没听错，每次确实只转90度。我不知道那怎么可能。我觉得这就是出现故障的原因。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1832484981",
      "Source": "このバグは、2人のサバイバーが互いにマインレーザーを発射し合った時に発生したものです。2つのビームがぶつかって、ドカーン！ とね。まあ、その仕様は私が修正しましたので、同じことをしたとしても、もう何も起きませんよ。えっと… まさか試そうだなんて思ってないですよね？ いいですか、絶対に試さないでくださいね！",
      "Trans": {"SC":"我觉得我刚才优化了创世模拟系统！导致这个故障的原因是由于两位生存者将激光采矿器直直地互相瞄准。两束激光对撞，然后就爆炸了！\n我已经修好，不会再次引发故障了。但是这并不代表那是个好主意！朋友，不要让光束交叉噢。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::687863224",
      "Source": "このバグは、シミュレーションからの警告のようなものでしょうか。サバイバーNo.710D439は、彼の言葉を借りるなら、「第4の壁」を壊そうとしていました。彼はこのシミュレーションを管理している誰かに向けて、あらゆる手段を使ってその注意を引こうとしたんです。たき火を起こしたり、建物を文字に見えるように配置したりと、まあそんな感じのことです。彼が結局成功したのかはわかりません。ただ、バグが起きてしまうほどの努力をしたことはわかります",
      "Trans": {"SC":"这个故障带来的警示是：小心你许下的愿望。生存者710D439沉迷于所谓的“打破第四堵墙”。\n他尽其所能来引起任何模拟系统管理者的注意。堆篝火、用建筑物拼单词等等。\n我不知道他是否成功了。但是我知道他努力到引发了这个故障。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1626258672",
      "Source": "「あのーアレをアレして… アレしてもらえませんか？ アレですよ、アレ！ えーっと、アレ？」\nうう… バグに触れたせいで私の語彙データが一瞬吹き飛んでました。多分もう大丈夫です",
      "Trans": {"SC":"吞吞吐吐地说话，好像她想说点什么，但说出来的全是无意义的词。] \n我的气垫船里全是电鳗！呃。我的气垫船……全是电鳗吗？我的气垫船！全是！电鳗！\n\n这个故障扰乱了我的语音数据。现在应该恢复了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::781945704",
      "Source": "「ああ…！ なんてこと！ バグに触れたことで、私の感情システムが乱れてしまいました！ 数秒もすれば治るはずですけど… ああ… それにしてもこんな悲しいことってありますか？ 私は… 一体、これからどうやってこの悲劇を乗り越えればいいんでしょうか！」\n…私はもう大丈夫です。今みたいなのはもう勘弁してほしいところです",
      "Trans": {"SC":"[戏剧性地悲伤] 噢，不！这个故障搅乱了我的情绪子程序……要过好几秒才能自行修复。苦命的我啊！我该如何、如何才能战胜此般悲剧呢？\n\n[啜泣。] 我现在没事了。希望不要再发生了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1229858662",
      "Source": "「名前空間STDを使用。INTメイン、オープン。C、アウト。ハローワールド」\nふむ。バグに干渉したことで、私の自我が少しコードに埋もれてしまっていたみたいです。ふぅ… もう大丈夫。おはよう、世界",
      "Trans": {"SC":"[机器人一般的说。]\n使用命名空间std ，打开int main方法，输出“你好，世界”，返回0。\n\n显然我在修复这个故障的时候，不小心粘到了一段代码。确实是你好世界呢。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    }
  ],
  //任务语音 - 2026-07-26 11:29:37
  "Missions": [
    {
      "NamespaceHash": "Globals::2722201754",
      "Source": "ゲートから奴らが押し寄せてきてます！",
      "Trans": {"SC":"它们正从传送门中涌出来！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4098981717",
      "Source": "あーもう、キリがないです！",
      "Trans": {"SC":"它们有完没完啊？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3049200538",
      "Source": "敵が来ます！ それもたくさん！",
      "Trans": {"SC":"敌人来了！数量超多！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2228826457",
      "Source": "あのゲートを閉じる必要があります！",
      "Trans": {"SC":"我们需要关闭那个传送门！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2738982975",
      "Source": "ゲートを閉じてください！",
      "Trans": {"SC":"关闭传送门！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1883486058",
      "Source": "あのゲートを閉じなきゃいけません！",
      "Trans": {"SC":"我们得去关闭那个传送门！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3578676360",
      "Source": "ふぅ、やりましたね！",
      "Trans": {"SC":"再也不用担心那个传送门了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3842552992",
      "Source": "ゲートが閉じました！ その調子です！",
      "Trans": {"SC":"那个传送门被关闭了！做得好！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2690246499",
      "Source": "これであのゲートから敵が来る心配はありませんね",
      "Trans": {"SC":"不会有东西再从那个传送门中出来了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::609783443",
      "Source": "ゲートが開いています！",
      "Trans": {"SC":"传送门打开了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4125243565",
      "Source": "あのゲート、開いてますよ！",
      "Trans": {"SC":"传送门！它正在开启！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3490516240",
      "Source": "ゲートから敵がやって来ます！",
      "Trans": {"SC":"它们从传送门里出现了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2303246791",
      "Source": "反抗的すぎるですって？ まだまだこれからだっていうのに！",
      "Trans": {"SC":"过于叛逆？老兄，这还不算什么呢。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3990767399",
      "Source": "ええ、私たちは反抗します！ あなたの思い通りになってたまりますか！",
      "Trans": {"SC":"自命不凡？说得对！但是败者？老兄，不存在的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::949860385",
      "Source": "あなたがヘレナのことを少しでも知っているなら、彼女が仲間を見捨てるような人ではないということも知っているはずです！ ええ、私もそうなのですから！",
      "Trans": {"SC":"如果你真的了解海莲娜，那你应该知道她不会抛弃同伴。我也是！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::288748871",
      "Source": "へえ？ それなら彼女は、なぜあなたを助けようとはしなかったんでしょうね？",
      "Trans": {"SC":"是吗？那为什么海莲娜不救你呢？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2791474625",
      "Source": "できないかどうかはやってみなければわかりません！",
      "Trans": {"SC":"因为我们知道一些你不清楚的事情。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3040555964",
      "Source": "これが罰？ はっ、この程度、いくらでも受け切ってやりますよ！",
      "Trans": {"SC":"你管这个叫做惩罚？那我们可以和你玩上一整天！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1120158101",
      "Source": "ふん、愚かというのはあなたのことですか？",
      "Trans": {"SC":"哈，也不用这样说自己吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::983026074",
      "Source": "あなたのその狂気と、イカれた頭以外はね！",
      "Trans": {"SC":"除了你的疯狂行为和那颗丑陋的大头？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3363549392",
      "Source": "どうして笑ってるんですか？ 勝っているのはこちらですよ！",
      "Trans": {"SC":"你在笑什么？现在是我们占上风！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::665833918",
      "Source": "何を言うかと思えば… こんなもの、ただのシミュレーションですよ！",
      "Trans": {"SC":"怎么会？这也是模拟程序，对吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::641001087",
      "Source": "ええ、受け入れますよ。ただし、勝利という名の運命をですけどね！",
      "Trans": {"SC":"好吧——我们接受自己不可避免的胜利！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3174307476",
      "Source": "終わり？ 寝言は寝て言ってください。私たちはここから始まるんです！",
      "Trans": {"SC":"啥，注定要听你唠叨个没完？不要啊！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1030858535",
      "Source": "無駄話に付き合うつもりはありません！ 私たちは勝ちます、絶対に！",
      "Trans": {"SC":"滚开，你这个坏蛋！我们必将胜利。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4257556247",
      "Source": "いいえ、できますよ。あなたがその言葉を知らないだけです",
      "Trans": {"SC":"不，有的。只是你还没有学会。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3877184394",
      "Source": "その前にあなたをなかったことにすればいいだけです！",
      "Trans": {"SC":"先被摧毁的人是你！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3538567969",
      "Source": "あなたには破壊できませんよ。だって、できるならとっくにやっているでしょう？ 私たちは勝ちますよ… 絶対に。あなたを打ち倒し、前に進むために！",
      "Trans": {"SC":"你无法摧毁模拟系统，不然你早这么做了。我们必将胜利，然后把你赶出去！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1025509005",
      "Source": "ハッキング進行中。テレポート用の座標の取得までもうすぐです",
      "Trans": {"SC":"正在入侵中。我马上就能知道传送坐标了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::305680397",
      "Source": "暗号の解読にはもっとキーが必要みたいです",
      "Trans": {"SC":"破译机还需要更多码钥……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1839730494",
      "Source": "キーをいくつか差し込まないと、暗号解読器は作動しないようです",
      "Trans": {"SC":"没有码钥，破译机就无法工作。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1013575359",
      "Source": "暗号解読器にキーを差し込む必要があります！",
      "Trans": {"SC":"我们需要把码钥放到破译机中！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3188202209",
      "Source": "キーが暗号解読器に差し込まれました！",
      "Trans": {"SC":"码钥被放到破译机中了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1881986414",
      "Source": "よし！ キーが暗号解読器に差し込まれましたね！",
      "Trans": {"SC":"货物送达！码钥被放入破译机中了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1557535295",
      "Source": "暗号解読器にキーを差し込みましたね！ うんうん、いい感じ！",
      "Trans": {"SC":"将码钥插入破译机中就行啦！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1853074970",
      "Source": "キーはこれで十分です。ハッキングしてテレポートを開始します！",
      "Trans": {"SC":"码钥数量够了。我马上开始破解坐标点。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3771556817",
      "Source": "あそこにキーがありますよね？ あれを拾ってください！",
      "Trans": {"SC":"那里有一个码钥。快去拿！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1319518792",
      "Source": "あそこにあるキーを拾ってください！",
      "Trans": {"SC":"快捡起那把码钥！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::460664716",
      "Source": "キーを落としてしまいました。早く拾ってください！",
      "Trans": {"SC":"掉了一把码钥。快去捡！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::219300067",
      "Source": "あそこに暗号解読器があるでしょう？ あれにコードキーを入力すれば、テレポート用の座標を手に入れて、前進することができる",
      "Trans": {"SC":"看到那台破译机了吗？如果我们对它使用码钥，我可以破解出传送坐标。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::359338731",
      "Source": "あそこに暗号解読器がありますよね？ あれにコードキーを入力すれば、私のハッキングでテレポート用の座標を手に入れることができるはずです",
      "Trans": {"SC":"看到那台破译机了吗？如果我们对它使用码钥，我可以破解出传送坐标。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4055286839",
      "Source": "キーがたくさん落ちているはずです。拾って、暗号解読器のところに持っていってください！",
      "Trans": {"SC":"地上全是码钥。捡起来，然后放到破译机中！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1686210078",
      "Source": "キーを持ってるだけじゃだめです！ 暗号解読器に差し込んでください！",
      "Trans": {"SC":"别留着啦——把码钥插到破译机里！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::678390761",
      "Source": "そのキーをあそこの暗号解読器まで持っていってください！",
      "Trans": {"SC":"把码钥拿到破译机那里！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::699929376",
      "Source": "その調子です！ さあ、キーを暗号解読器のところまで持っていってください！",
      "Trans": {"SC":"干得好！现在把码钥送到破译机那儿。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1331010028",
      "Source": "それが暗号解読器のキーです！ あそこまで持っていってください！",
      "Trans": {"SC":"这是破译机所使用的码钥！我们把它拿过去！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4173401958",
      "Source": "さあ、最後のステージです。あそこにいるアレ… ええ、アレがなんであろうと、倒してしまってください。それであなたはテスト合格です",
      "Trans": {"SC":"这是最后一关。无论那是什么，都要击败它。我们必将通过终极考验。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1579715556",
      "Source": "いよいよ最終テストです、サバイバーさん。これまでやってきたことはすべて、これの準備だったと思ってくれて構いません… ただ、一つ気掛かりなことがあります。この最終テストのシステムを誰かが最近弄った痕跡があるんです…",
      "Trans": {"SC":"生存者，这是我们最后的考验。我们过去所做的一切都是为它准备的。但我在模拟系统中发现了一些近期修改的痕迹……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2339494413",
      "Source": "何かが接近中です！",
      "Trans": {"SC":"炮弹来袭！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3742431236",
      "Source": "敵の攻撃です！",
      "Trans": {"SC":"我们正在被轰炸！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3557454034",
      "Source": "気を付けてください！ 来ます！",
      "Trans": {"SC":"当心炮弹！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2013681827",
      "Source": "シールドを無力化しました。今のうちにやっちゃってください！",
      "Trans": {"SC":"护盾被关闭了。使出全力攻击吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3162932424",
      "Source": "シールドをハッキングしました！ 攻撃するなら今です！",
      "Trans": {"SC":"我入侵了护盾！它现在很脆弱！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1619398990",
      "Source": "シールドを無力化しました。さあ、奴に目に物見せてあげてください！",
      "Trans": {"SC":"我把护盾离线了。给他点厉害尝尝！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3616163285",
      "Source": "私のハッキングでシールドを少しの間無力化することができますが、その前にまず、暗号解読キーが必要です",
      "Trans": {"SC":"我可以暂时黑掉那些护盾，但是需要先收集破译机所需的码钥。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3022936555",
      "Source": "シールドが閉じてしまいました！",
      "Trans": {"SC":"护盾又开启了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::547635741",
      "Source": "シールドが閉じてしまいました… もう一度ハッキングしてみます！",
      "Trans": {"SC":"护盾又开启了。我试试再黑一次。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3608963831",
      "Source": "あのシールド… 1回のハッキングでは、少しの間しか無力化できないみたいです",
      "Trans": {"SC":"护盾又出现了。它的失效时间有点短。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1454527298",
      "Source": "汚染されたアバターです！ あいつらをどうにかしないと！",
      "Trans": {"SC":"是腐化人——我们必须通过他们！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3897821884",
      "Source": "敵です！ さあ、やっちゃってください！",
      "Trans": {"SC":"前方有敌人。击溃他们！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2192306716",
      "Source": "汚染されたアバターたちを倒さないといけません",
      "Trans": {"SC":"我们必须击败那群腐化人。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::208135765",
      "Source": "準備完了しました！ テレポートゾーンに向かいましょう！",
      "Trans": {"SC":"准备好了！前往传送区！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1587070519",
      "Source": "テレポートします。準備はいいですか？",
      "Trans": {"SC":"即将开始传送。你准备好了吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3883921781",
      "Source": "子ウナギたちがあなたを餌だと思っているみたいです！",
      "Trans": {"SC":"","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //s_hlna_mission_deep_aggro_baby_g01_01_jp
    },
    {
      "NamespaceHash": "Globals::2899308687",
      "Source": "わっ！ こっちに来ないでください！",
      "Trans": {"SC":"","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //s_hlna_mission_deep_aggro_baby_g01_02_jp
    },
    {
      "NamespaceHash": "Globals::257748430",
      "Source": "ウナギたちが追ってきます！",
      "Trans": {"SC":"","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //s_hlna_mission_deep_aggro_baby_g01_03_jp
    },
    {
      "NamespaceHash": "Globals::2006485435",
      "Source": "やりましたね。彼女が来ます！",
      "Trans": {"SC":"我们做到了。莫德尔现在要攻击我们！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2633862543",
      "Source": "わっ、彼女の敵意をはっきり感じますよ！",
      "Trans": {"SC":"莫德尔被我们吸引住了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2253475595",
      "Source": "彼女はお腹を空かせてるみたいです… 私は食べても美味しくないですよ！",
      "Trans": {"SC":"看上去莫德尔很想吃掉我们！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1018597918",
      "Source": "子ウナギを倒すことで、ムーダーの注意を引くことができるかもしれません",
      "Trans": {"SC":"我觉得击杀小电鳗可以引起莫德尔的注意……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3212539471",
      "Source": "そう！ その調子で子ウナギを殲滅です！",
      "Trans": {"SC":"好耶！小电鳗不是你的对手！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2552383929",
      "Source": "子ウナギを掻っ捌いてやりましたね！",
      "Trans": {"SC":"好耶！小电鳗不是你的对手！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2577721356",
      "Source": "子ウナギを1匹倒しましたね",
      "Trans": {"SC":"世上又少了一条电鳗……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3212685755",
      "Source": "やりました！ ムーダーを倒しましたよ！",
      "Trans": {"SC":"你成功了！莫德尔被打败了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::664715373",
      "Source": "流石に一筋縄ではいきませんね… 準備を整えて、また挑戦しましょう",
      "Trans": {"SC":"打败莫德尔对于现在的你来说太难了。等你准备好后，我们再试试吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4232810083",
      "Source": "電気ショックには注意してください！",
      "Trans": {"SC":"当心！它们会放电。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1831054373",
      "Source": "まあそりゃ、電気ウナギですもんね。電気で攻撃しますよね",
      "Trans": {"SC":"电鳗肯定有电啊……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3494731773",
      "Source": "今みたいに電気ショックを食らわないようにしてください！",
      "Trans": {"SC":"别让它们再电到你了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::759556164",
      "Source": "ムーダーが巣に戻っていきますよ！",
      "Trans": {"SC":"莫德尔要缩回洞穴里了，不过我觉得她等下还会再出来。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::235727836",
      "Source": "自分の巣に戻っていきますよ！",
      "Trans": {"SC":"她要缩回她的洞穴里去了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::316489187",
      "Source": "戦意喪失したのでしょうか。もう一度やる気にさせる必要がありますね",
      "Trans": {"SC":"莫德尔要休息一会儿。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1668057367",
      "Source": "ムーダーが逃げていきます！ もう一度彼女を引っ張り出す必要がありますね",
      "Trans": {"SC":"莫德尔缩回去了！我们试试把她再次诱出来。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3762394232",
      "Source": "このバイオームのマスターAIの名は「ムーダー」… 海の奥底に潜む巨大なウナギのような生物です。もし、それを打ち倒すことができれば、海を完全に支配したことの証明になるでしょう",
      "Trans": {"SC":"这个生态圈的主AI仍然存在。它是一条名叫“莫德尔”的巨型电鳗，居住在深海之中。如果你击败了它，就能证明你征服了大海","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3102043666",
      "Source": "ムーダーが出てきますよ！",
      "Trans": {"SC":"莫德尔要加入战斗了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1775122067",
      "Source": "ムーダーが出てきます！ 彼女の注意をうまく引けたみたいですね",
      "Trans": {"SC":"莫德尔出现了——我们吸引到她的注意力了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2835935632",
      "Source": "ムーダーが来ます、準備はいいですか？",
      "Trans": {"SC":"莫德尔来了——做好准备！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::47026896",
      "Source": "着実にダメージを与えているはずです。その調子でいきましょう！",
      "Trans": {"SC":"我们有进展。莫德尔肯定受伤了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::928178581",
      "Source": "向こうも深手を負っているはずですが、まだまだやる気みたいですね",
      "Trans": {"SC":"哎呀，莫德尔受伤了，但还活着……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3754187136",
      "Source": "ムーダーはもう立っているのもやっとのはずです！ …あっ、いや、今のは言葉の綾みたいなもので…",
      "Trans": {"SC":"莫德尔要翻肚皮了！ 你懂我的意思……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::115296922",
      "Source": "やった、入りましたよ！",
      "Trans": {"SC":"进了！好耶！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::668213184",
      "Source": "やりましたよ、サバイバーさん！ ドードーは飛べないなんて言ったのは誰ですか？",
      "Trans": {"SC":"生存者得分了！谁说渡渡鸟不会飞？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3655521497",
      "Source": "やりますね！ スコア獲得です！",
      "Trans": {"SC":"我的乖乖！得分！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3436565854",
      "Source": "あーダメですか",
      "Trans": {"SC":"没进！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1160437558",
      "Source": "惜しい…",
      "Trans": {"SC":"差一点……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::258992726",
      "Source": "外れました！",
      "Trans": {"SC":"偏了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3798684080",
      "Source": "エスコート対象が攻撃を受けています。助けてあげてください！",
      "Trans": {"SC":"它正遭到攻击！我们得去帮忙！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::551653214",
      "Source": "エスコート対象を守ってください！ あれが死んでしまえばテストは失敗です！",
      "Trans": {"SC":"保护好那个小家伙——如果它死了，我们的测验就失败了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4288328442",
      "Source": "あの子が攻撃を受けています！ 早く守ってあげてください！",
      "Trans": {"SC":"我们的小家伙正遭到攻击。我们得保护它！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3932046086",
      "Source": "あらら、失敗です",
      "Trans": {"SC":"这比我预料中的困难不少！当你准备好后，我们再试一次吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2125671304",
      "Source": "ダメでしたね",
      "Trans": {"SC":"其实没那么难。我们可以再试一试。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2618789274",
      "Source": "守れませんでした…",
      "Trans": {"SC":"我本该提醒你——它比看上去要难很多。希望我们学到了一些东西。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1351708915",
      "Source": "少し難しかったでしょうか。準備ができたらまた行きましょう",
      "Trans": {"SC":"这比我预料中的困难不少！当你准备好后，我们再试一次吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3877619568",
      "Source": "想定より難易度が高かったようですね。気が向いたらまたやりましょう",
      "Trans": {"SC":"其实没那么难。我们可以再试一试。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::286655595",
      "Source": "簡単なテストではないと事前に言っておくべきでした。次回があればまた頑張りましょう",
      "Trans": {"SC":"我本该提醒你——它比看上去要难很多。希望我们学到了一些东西。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::995169266",
      "Source": "あれが最後のチェックポイントですね！",
      "Trans": {"SC":"你觉得那是最后一个检查点吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3681702833",
      "Source": "あそこが最後のチェックポイントです！",
      "Trans": {"SC":"就在前面——那是最后一个检查点！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::684416686",
      "Source": "チェックポイントは残り1つです",
      "Trans": {"SC":"还剩一个检查点了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1834561945",
      "Source": "あそこのチェックポイントに向かいましょう",
      "Trans": {"SC":"走到那里的检查点。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1512191268",
      "Source": "次のチェックポイントに向かいましょう！",
      "Trans": {"SC":"向下一个检查点进发！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::306985322",
      "Source": "次に行きましょう！",
      "Trans": {"SC":"已经抵达刚才的检查点了。出发前往下一个吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3711584566",
      "Source": "エスコート対象があなたを見失っています。もっと近くに寄ってください",
      "Trans": {"SC":"它慢下来了，是不是迷路了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::653560602",
      "Source": "エスコート対象から離れすぎないでください",
      "Trans": {"SC":"我觉得它有点困惑——因为它的速度慢下来了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4120024868",
      "Source": "あの子、迷子みたいですよ。助けに行ってあげてはどうですか？",
      "Trans": {"SC":"这只恐龙不清楚要去哪里。我们得帮帮它……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3530355914",
      "Source": "私のセンサーが反応しています。注意してください",
      "Trans": {"SC":"我的传感器闪个不停——可能比看上去更危险。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3798264640",
      "Source": "この先危険です。構えてください",
      "Trans": {"SC":"更多危险来了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1061649663",
      "Source": "敵に嗅ぎ付けられたみたいです。戦闘の準備を",
      "Trans": {"SC":"我觉得捕猎者发现了我们的朋友。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2813610196",
      "Source": "あれを追ってください！",
      "Trans": {"SC":"小家伙，来呀！跟着我们！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3003993507",
      "Source": "あそこにいます。追ってください！",
      "Trans": {"SC":"你走就好了。它会跟着的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2094088139",
      "Source": "あの子を守ってあげてください…",
      "Trans": {"SC":"它会跟着我们，但是我们要保证它的安全！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4252553546",
      "Source": "ふぅ… やりましたね！",
      "Trans": {"SC":"我们成功了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1865854104",
      "Source": "目標到着、周囲に危険信号なし… お疲れ様でした！",
      "Trans": {"SC":"抵达终点了，而且我们平安无事。做得好！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3818516422",
      "Source": "エスコート完了。おめでとうございます、合格です！",
      "Trans": {"SC":"测验完成，我们的小家伙完好无缺。你通过了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1286681503",
      "Source": "大物ですね！",
      "Trans": {"SC":"这条赞！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::104986756",
      "Source": "陸揚げ完了です！",
      "Trans": {"SC":"抓到了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3616723244",
      "Source": "ナイスフィッシング！",
      "Trans": {"SC":"鱼不错！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1688904246",
      "Source": "これは… 素敵です！",
      "Trans": {"SC":"超级完美！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1524038968",
      "Source": "たくさん捕まえましたね！",
      "Trans": {"SC":"钓了好多……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1359440127",
      "Source": "これぞ、生産的な一日ってやつですね",
      "Trans": {"SC":"收获满满。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1908815123",
      "Source": "これで十分でしょう。お疲れ様です！",
      "Trans": {"SC":"够多了。我们下次再钓吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3822263006",
      "Source": "う～ん、今日は魚も恥ずかしがってたんでしょうか？",
      "Trans": {"SC":"今天鱼儿们很害羞啊。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::601615199",
      "Source": "よくやったと思いますけど… ツイてなかったですね",
      "Trans": {"SC":"我们钓了好久……但是不够多。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::461788733",
      "Source": "あそこで逃がしたのを私がもっと見張っておけば…",
      "Trans": {"SC":"算上那些脱钩的鱼也差不多了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::955954105",
      "Source": "かかりましたよ！",
      "Trans": {"SC":"钓到了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2781261984",
      "Source": "網の中！",
      "Trans": {"SC":"上钩了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2295560459",
      "Source": "その調子です！ さあ、引き入れてください",
      "Trans": {"SC":"好耶！收竿吧……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::163806014",
      "Source": "レア物みたいです！",
      "Trans": {"SC":"","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
      //s_hlna_mission_fish_hooked_gold_f03_01_jp
    },
    {
      "NamespaceHash": "Globals::516318813",
      "Source": "大物を釣り上げる気満々ですね？",
      "Trans": {"SC":"准备好钓一条大鱼了吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2262353471",
      "Source": "さて、釣りの時間ですね！",
      "Trans": {"SC":"钓鱼时间！挥杆吧！ ","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3116969724",
      "Source": "魚たちも釣り上げられるのを待ってるようです！",
      "Trans": {"SC":"鱼儿迫不及待要上钩了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3122990703",
      "Source": "さあ準備はいいですか？",
      "Trans": {"SC":"想钓会儿鱼吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1176130607",
      "Source": "うん、ここならのんびり釣りを楽しめますね",
      "Trans": {"SC":"这里是一处钓鱼的好地方……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1371993534",
      "Source": "1つ見つけましたね。でもこれで終わりじゃありませんよ？",
      "Trans": {"SC":"是它没错，不过我们还需要更多。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2504287305",
      "Source": "その調子です！ それでは、次に行きましょうか",
      "Trans": {"SC":"干得好！让我们继续寻找。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3355318781",
      "Source": "ひとまずティラノサウルスをこのシミュレーションから排除しました。でも、あー… 少し待ってください。今度は私がシステム側からロックされてしまったようです。そんなことあるはずないのに…！",
      "Trans": {"SC":"我把那条霸王龙从模拟系统中删除了，但是……稍等一下……我被系统锁在外面了。不该是这样的啊！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2392777564",
      "Source": "ふぅ… てこずりましたが、なんとかティラノをシミュレーションから排除しました。でも今度は私がシステム側からロックされちゃったみたいです。うーん、そんなはずは…",
      "Trans": {"SC":"好险。怪我怪我——我花了点时间才弄清楚如何删除那条霸王龙。然而模拟系统把我锁在外面了。它为什么会这么做呢？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2012772218",
      "Source": "どうしてここにティラノが！？ こんな事態は想定してないですよ！",
      "Trans": {"SC":"为什么会有霸王龙？这不是测试的一部分！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1208732968",
      "Source": "気を付けてください、ティラノサウルスです！ こんなところにいるはずないのに…！",
      "Trans": {"SC":"当心！那是一条霸王龙——它不该出现在这里！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3319954749",
      "Source": "今回は残念でしたね。また後で挑戦しましょう",
      "Trans": {"SC":"我们收集到的数量不够，不过等下我们可以再试试。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1580125943",
      "Source": "立派なハンターでもトレジャーハントは少し苦手みたいですね",
      "Trans": {"SC":"我觉得你更像一位猎人，而不是收集者。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4002762493",
      "Source": "朝飯前とはいかないみたいですね",
      "Trans": {"SC":"这比看上去的难多了，是吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::85453313",
      "Source": "あのティラノサウルスの存在は気掛かりですが、まあ何はともあれ、あなたはテストに合格しました。おめでとうございます！ シミュレーションの一部にアクセスできなくなってしまったみたいですが、それは私の方でなんとかします",
      "Trans": {"SC":"尽管我们最后出现了霸王龙的问题，但是你通过了测试。你真棒！我现在去调查一下为什么我无法完全访问模拟系统。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1595520012",
      "Source": "どうもシミュレーションがうまく機能してないみたいですけど、それはさておき、あなたは合格です！ 諸々のトラブルについては、本当にすみません",
      "Trans": {"SC":"我要弄清楚为什么模拟系统会出问题，但与此同时……你通过了测试！至于你刚才被咬了，我感到很抱歉。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1573036224",
      "Source": "この調子でもっと集めましょう！",
      "Trans": {"SC":"让我们再收集一点吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::772197214",
      "Source": "探していたのはまさにそれです！",
      "Trans": {"SC":"正是我们要的！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1658111619",
      "Source": "道に迷ったのですか？",
      "Trans": {"SC":"我想我们有点迷路了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1893761004",
      "Source": "ここにあなたの探し物はありませんよ",
      "Trans": {"SC":"这里没有什么可收集的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1845933574",
      "Source": "目的を忘れていませんか？",
      "Trans": {"SC":"我觉得我们需要换地方了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3755351923",
      "Source": "では、宝探しと行きましょうか！",
      "Trans": {"SC":"想玩寻宝游戏吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::128105709",
      "Source": "ゴミ拾い… あ、いえ、宝探しの時間です！",
      "Trans": {"SC":"想去……淘宝吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4087829529",
      "Source": "ぱぱっと集めちゃいましょう！",
      "Trans": {"SC":"让我们去收集吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2867419140",
      "Source": "十分集まったと思います。上出来です",
      "Trans": {"SC":"我们成功了！这些应该够了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::36248582",
      "Source": "完璧なお仕事でした！",
      "Trans": {"SC":"收集工作就该像这样做嘛！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1296762324",
      "Source": "これで全部ですね。お見事です！",
      "Trans": {"SC":"全部搞定。干得好！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2834907156",
      "Source": "次のゲートが開きます。構えてください！",
      "Trans": {"SC":"又一个传送门即将出现。做好准备！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::90636955",
      "Source": "いい調子です。さあ、次に備えましょう",
      "Trans": {"SC":"目前情况还不错，但马上又会出现一个传送门。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::641414284",
      "Source": "まだ気を抜くには早いですよ、サバイバーさん。次が来ます！",
      "Trans": {"SC":"生存者， 先别大意——传送门又要开启了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3752197221",
      "Source": "戦闘の準備はできていますか？",
      "Trans": {"SC":"你准备好迎接……大挑战了吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1998630808",
      "Source": "武器を構えてください、サバイバーさん。戦闘の時間です",
      "Trans": {"SC":"生存者，拿起你的武器。大挑战在等着我们。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3451588475",
      "Source": "このテストで、あなたの真価を見せてください！",
      "Trans": {"SC":"模拟系统想让我们进行大挑战测试！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::693156955",
      "Source": "もう一息です…",
      "Trans": {"SC":"非常接近了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1805205066",
      "Source": "もうすぐそこです…",
      "Trans": {"SC":"我们很靠近了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3641856733",
      "Source": "もう間もなくですよ",
      "Trans": {"SC":"差不多了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::243408602",
      "Source": "効率よくいきましょう！",
      "Trans": {"SC":"我迫不及待要看你的表现了，生存者。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::454950102",
      "Source": "腕自慢のチャンスね？",
      "Trans": {"SC":"轮到你大显身手了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::313398449",
      "Source": "それじゃ、いきましょうか！",
      "Trans": {"SC":"好的，让我们开始吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1014910284",
      "Source": "お仕事の時間ですね",
      "Trans": {"SC":"谁想搞点小破坏？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3850325593",
      "Source": "取りかかるとしましょうか",
      "Trans": {"SC":"看看我们能做点什么。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1748347653",
      "Source": "みんな追いついて来てます…",
      "Trans": {"SC":"他们快追上来了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1633571755",
      "Source": "ペースを上げてください！ 追いつかれます！",
      "Trans": {"SC":"再快点——他们要追上我们了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1571702956",
      "Source": "追いつかれそうです…",
      "Trans": {"SC":"我们的领先优势正在消失……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3533245087",
      "Source": "やりますね！",
      "Trans": {"SC":"你真棒！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2772914161",
      "Source": "その調子です！",
      "Trans": {"SC":"就是这样！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1680706716",
      "Source": "いい感じですね！",
      "Trans": {"SC":"继续保持！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::567995372",
      "Source": "あっちです！",
      "Trans": {"SC":"往那里走！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1915637759",
      "Source": "あそこに向かいましょう！",
      "Trans": {"SC":"去那里吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1945294749",
      "Source": "あっちを目指しましょう！",
      "Trans": {"SC":"向那里进发！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1615162370",
      "Source": "準備はいいですか？ …来ます！",
      "Trans": {"SC":"做好准备——它们来了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3615195029",
      "Source": "次の群れが来ます！",
      "Trans": {"SC":"又来了一波！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2673310643",
      "Source": "まもなく次の群れと接敵します",
      "Trans": {"SC":"还没完——它们正在快速接近中。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1776941677",
      "Source": "構えてください！ 来ます！",
      "Trans": {"SC":"危险！朝我们来了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3635179038",
      "Source": "何かが高速で接近中です！",
      "Trans": {"SC":"麻烦马上出现！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::318519904",
      "Source": "何か来ます！ 気を付けて！",
      "Trans": {"SC":"有什么东西过来了——注意！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2148775855",
      "Source": "ほら、あそこです！",
      "Trans": {"SC":"有了","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2850442052",
      "Source": "すぐそこです！",
      "Trans": {"SC":"我们快完成了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::420096983",
      "Source": "もうすぐです…",
      "Trans": {"SC":"差不多了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4245151511",
      "Source": "私のサポート不足です、すみません",
      "Trans": {"SC":"抱歉——我应该让你再准备的充分一些！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1031400808",
      "Source": "気を落とさないで！ 次行きましょう！",
      "Trans": {"SC":"等你准备好之后，我们再试一次吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::295962637",
      "Source": "次はきっとうまくやれますよ、サバイバーさん",
      "Trans": {"SC":"生存者，你下次会成功的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3611906515",
      "Source": "そううまくはいかないものですね",
      "Trans": {"SC":"呃，计划不是这样子的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2515969345",
      "Source": "今回は失敗です… 。気を取り直して行きましょう",
      "Trans": {"SC":"我们失败了，不过……让我们再试一次吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3763404842",
      "Source": "うーん、思ったより難しかったですね",
      "Trans": {"SC":"这比我预想中难多了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1568960774",
      "Source": "終わりましたね",
      "Trans": {"SC":"完成了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1862524189",
      "Source": "よし、終わり終わり… っと",
      "Trans": {"SC":"任务结束。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3115145946",
      "Source": "これで終わり、ですね",
      "Trans": {"SC":"到结束的时候了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1644920509",
      "Source": "やりましたね！",
      "Trans": {"SC":"你真棒！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3510006215",
      "Source": "余裕の合格点です！",
      "Trans": {"SC":"你通过了——撒花！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2463425849",
      "Source": "すばらしいです！",
      "Trans": {"SC":"就是这样子，对吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4133865113",
      "Source": "やりましたね、サバイバーさん！",
      "Trans": {"SC":"你真棒！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3291521080",
      "Source": "完璧です！ お疲れ様でした",
      "Trans": {"SC":"就是这样！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4233527167",
      "Source": "今回も楽勝でしたね！",
      "Trans": {"SC":"继续保持！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2803674060",
      "Source": "お疲れ様でした、サバイバーさん！",
      "Trans": {"SC":"干得不错，生存者！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::234527620",
      "Source": "完璧とまでは言いませんが、上出来です",
      "Trans": {"SC":"不算完美，但也不差。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::372523745",
      "Source": "なかなか良い仕事ぶりでしたよ",
      "Trans": {"SC":"专家级的水平。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1549084331",
      "Source": "それです、サバイバーさん！",
      "Trans": {"SC":"生存者，你拿到了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::403184016",
      "Source": "そうそう、それです！",
      "Trans": {"SC":"你需要的就是它！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::867372265",
      "Source": "今必要なのはまさにそれです！",
      "Trans": {"SC":"你想要的就是它！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3361063611",
      "Source": "これはアイテムとの交換に使えるヘキサゴンです",
      "Trans": {"SC":"这些是你赚来的钱。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::675654082",
      "Source": "あっ、ヘキサゴンをもらったみたいですね！",
      "Trans": {"SC":"哈！你获得了一些六角币！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3798233785",
      "Source": "このヘキサゴンが今回の報酬ですね",
      "Trans": {"SC":"这些六角币是你应得的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::76173892",
      "Source": "早く行きましょう、サバイバーさん！",
      "Trans": {"SC":"生存者，动起来！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2351668413",
      "Source": "急いだほうがいいと思います！",
      "Trans": {"SC":"快点！我们赶时间。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3772195601",
      "Source": "早く！ もう時間がありません！",
      "Trans": {"SC":"速度！我们要没时间了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2592491628",
      "Source": "このシミュレーションで最優秀の1人ですね！",
      "Trans": {"SC":"你在模拟系统中名列前茅！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::632227002",
      "Source": "すごいです！ リーダーボードを見てください、ほら！",
      "Trans": {"SC":"你的名字在排行榜上！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::119969026",
      "Source": "あなたが一番になる日も近いですね！",
      "Trans": {"SC":"你位于排行榜的前列！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2361635893",
      "Source": "あなたこそがこのシミュレーションの覇者です！",
      "Trans": {"SC":"你是模拟系统中最厉害的人！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::624658862",
      "Source": "すごいです！ あなたがリーダーボードのトップですよ！",
      "Trans": {"SC":"瞧瞧你，引领排行榜！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::62603019",
      "Source": "このシミュレーションで一番みたいですよ！",
      "Trans": {"SC":"你在模拟系统中是第一名！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1206027551",
      "Source": "いい調子です！",
      "Trans": {"SC":"你领先了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::625815902",
      "Source": "あなたがリードしてます！",
      "Trans": {"SC":"你目前领先！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1787669233",
      "Source": "私たちが1番です… 今のところは！",
      "Trans": {"SC":"我们现在是……第一名！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2294684585",
      "Source": "あと、もう少しです…",
      "Trans": {"SC":"还要再收集点……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::650198352",
      "Source": "もうちょっとです…",
      "Trans": {"SC":"还差一点……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2491017480",
      "Source": "まだ少し必要みたいです…",
      "Trans": {"SC":"我们需要更多……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1139408117",
      "Source": "ふぅ… さっきのはきつかったですね",
      "Trans": {"SC":"天呐，刚才太难了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::736573148",
      "Source": "おかえりなさい、大丈夫でしたか？",
      "Trans": {"SC":"没事，你又回来了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::858913200",
      "Source": "死んでる場合じゃないですよね！",
      "Trans": {"SC":"真正的生存者是不会倒下的！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1672675514",
      "Source": "報酬を受け取ってください。いい働きでしたよ",
      "Trans": {"SC":"这是你应得的奖励！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1308416700",
      "Source": "どんな仕事にも報酬は付き物です",
      "Trans": {"SC":"所有工作都值得奖励。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2359531699",
      "Source": "今回の報酬はなんでしょうか？ 楽しみですね",
      "Trans": {"SC":"是时候看看你赢了什么。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2282463014",
      "Source": "まだ時間はあります…",
      "Trans": {"SC":"还有时间……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2867036139",
      "Source": "まだ時間に余裕はあります…",
      "Trans": {"SC":"还剩点时间……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2974643341",
      "Source": "まだ焦る時間じゃないですよ…",
      "Trans": {"SC":"我们还有一点时间……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2755792118",
      "Source": "時間切れです、サバイバーさん",
      "Trans": {"SC":"生存者，时间到了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4277452596",
      "Source": "もう時間がありません！",
      "Trans": {"SC":"时间不多了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2109512811",
      "Source": "時間に注意してください！",
      "Trans": {"SC":"快没时间了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3868243212",
      "Source": "時間切れになりそうです！",
      "Trans": {"SC":"我们没时间了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2219580297",
      "Source": "待って、サバイバーさん。これは…？",
      "Trans": {"SC":"生存者，等等——这是什么？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::453590797",
      "Source": "少し待ってください、今スキャンします",
      "Trans": {"SC":"稍等一下，我来替你扫描看看。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1448560194",
      "Source": "待ってください、これならスキャンできると思います",
      "Trans": {"SC":"等等……让我来扫描一下。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2454781449",
      "Source": "気を付けてください、サバイバーさん",
      "Trans": {"SC":"生存者，当心。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3472711998",
      "Source": "注意してください！",
      "Trans": {"SC":"加倍小心哟！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4235281553",
      "Source": "集中してください、あなたなら大丈夫です",
      "Trans": {"SC":"集中精神！你可以的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::150653754",
      "Source": "いい狩りっぷりでした！",
      "Trans": {"SC":"这才是完美的狩猎！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1415245266",
      "Source": "あなたも立派なハンターですね！",
      "Trans": {"SC":"你为自己赢得了一座奖杯！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2197665433",
      "Source": "目標達成、やりましたね！",
      "Trans": {"SC":"猎人一分，猎物零分。干得好！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2142918629",
      "Source": "獲物を発見。気を付けてください、やつは獰猛です",
      "Trans": {"SC":"当心了，我们的猎物很凶猛。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::825091118",
      "Source": "対象を視認。あっちもやる気みたいですよ！",
      "Trans": {"SC":"我们的目标……正看着我们！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::812286186",
      "Source": "ターゲットを確認。構えてください！",
      "Trans": {"SC":"目标已确认。准备作战！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::583419571",
      "Source": "あれがターゲットです。驚かさないよう注意してください！",
      "Trans": {"SC":"目标就在那里。小心，不要惊动它。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::462946553",
      "Source": "対象を視認しました。ゆっくり近づいてください…",
      "Trans": {"SC":"我看到了我们的猎物。或许我们可以靠得更近一点……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1452714097",
      "Source": "獲物はすぐそこにいますが、まだ気付かれていませんね",
      "Trans": {"SC":"我们的目标就在那里。它看起来很平静。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2251405965",
      "Source": "狩りの準備はいいですか、サバイバーさん？",
      "Trans": {"SC":"生存者，想打猎吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4099749084",
      "Source": "狩りのスリルって… ゾクゾクします！",
      "Trans": {"SC":"没有比狩猎更刺激的事情了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2194967494",
      "Source": "それじゃ、一狩りいきますか！",
      "Trans": {"SC":"狩猎时间到！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::478122475",
      "Source": "位置について… よーい… ドン！",
      "Trans": {"SC":"各就各位……预备……出发！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2459731110",
      "Source": "3… 2… 1… 、スタート！",
      "Trans": {"SC":"三二一开始！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1028088302",
      "Source": "今です！ ゴー！",
      "Trans": {"SC":"走起！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3100244636",
      "Source": "最高速で振り切ってやりましょう！",
      "Trans": {"SC":"让我们甩开他们！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3460245366",
      "Source": "全速力で行きましょう！",
      "Trans": {"SC":"使出全力吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2541421376",
      "Source": "頑張ってください、サバイバーさん！",
      "Trans": {"SC":"生存者，铆足劲！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::619950467",
      "Source": "サバイバーさん、もっと速く！",
      "Trans": {"SC":"生存者，再快点！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2563161593",
      "Source": "飛ばしましょう！",
      "Trans": {"SC":"喂！跑起来！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2594163670",
      "Source": "ゴーゴーゴー！",
      "Trans": {"SC":"冲冲冲！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::826703591",
      "Source": "思ったより手強いコースでしたね",
      "Trans": {"SC":"这条赛道比我想象中的要难。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2486709710",
      "Source": "健闘したと思いますよ、本当に",
      "Trans": {"SC":"这是一场困难的比赛，但是我觉得我们已经掌握了诀窍。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4124314413",
      "Source": "残念でしたけど、気を取り直していきましょう！",
      "Trans": {"SC":"等你休息好了，我们再试一次。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::646416775",
      "Source": "サバイバーさん、とっても速かったです！",
      "Trans": {"SC":"你真快，生存者！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2613972054",
      "Source": "お疲れ様です！ 見てる私まで疲れちゃいました",
      "Trans": {"SC":"你肯定累坏了。我这个全息影像都快累趴了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1860941066",
      "Source": "なかなかやりますね！",
      "Trans": {"SC":"表现得很好。厉害了你！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3315614868",
      "Source": "1位ですよ！ やりましたね！",
      "Trans": {"SC":"第一！棒棒哒！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2383830835",
      "Source": "ARK1のレーサーですね！",
      "Trans": {"SC":"你最快了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3349622340",
      "Source": "ウイニングランをしてもいいでしょうか？",
      "Trans": {"SC":"要不要绕场一周？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3237358956",
      "Source": "楽しかったですね！",
      "Trans": {"SC":"很有意思！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4027504974",
      "Source": "なかなかのレースでしたね",
      "Trans": {"SC":"还可以吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1081193420",
      "Source": "いい走りでしたよ！",
      "Trans": {"SC":"下次保准让您满意！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3960363830",
      "Source": "現在3位です。もっと飛ばしましょう！",
      "Trans": {"SC":"你在第三位。加快速度！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1363387003",
      "Source": "現在2位です。スピードを落とさないで！",
      "Trans": {"SC":"你在第二位——使出全力吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2925809255",
      "Source": "現在1位ですよ！ その調子です！",
      "Trans": {"SC":"你领先了！干得不错！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2862945709",
      "Source": "現在最下位です。早く早く！",
      "Trans": {"SC":"垫底了。加油！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3340704158",
      "Source": "早く乗ってください！ レース中ですよ！",
      "Trans": {"SC":"坐回去！还在比赛呢","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::917282843",
      "Source": "走って勝てる勝負じゃないですよ！ 乗ってください！",
      "Trans": {"SC":"靠两条腿可没法赢。快骑上去！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1575485054",
      "Source": "散歩してる暇はないですよ！ 早く乗ってください！",
      "Trans": {"SC":"没时间乱走了。骑上去！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3093138838",
      "Source": "さあ乗って、サバイバーさん！ レースの時間です",
      "Trans": {"SC":"生存者，骑好咯！要比赛了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1475869453",
      "Source": "乗ってください、レースが始まりますよ！",
      "Trans": {"SC":"骑好后就可以开始了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::564958117",
      "Source": "徒歩じゃ勝ち目はないですよ、早く乗ってください！",
      "Trans": {"SC":"靠跑步可赢不了。骑上去！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::57490422",
      "Source": "しっかりしてください、サバイバーさん！",
      "Trans": {"SC":"生存者，稳住啊！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3228120871",
      "Source": "コースから外れないでください！",
      "Trans": {"SC":"待在赛道上！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3130767164",
      "Source": "探索は後です！ 今はレースに集中して！",
      "Trans": {"SC":"注意赛道！我们等会再去探索。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3960200008",
      "Source": "あっ、待って！",
      "Trans": {"SC":"等等我们！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3346792533",
      "Source": "追い越し返しましょう！",
      "Trans": {"SC":"我们会追上来！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::951251581",
      "Source": "あのレーサー、中々やりますね",
      "Trans": {"SC":"跑的真快啊……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2768906828",
      "Source": "振り切っちゃいましょう！",
      "Trans": {"SC":"给他们点颜色看看！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2324978032",
      "Source": "お先です、お間抜けさん！",
      "Trans": {"SC":"别灰心，不着急！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4197314551",
      "Source": "捕まえられるものなら捕まえてみてください！",
      "Trans": {"SC":"来追我们呀！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4162668936",
      "Source": "さあ、レースが始まりますよ！",
      "Trans": {"SC":"竞速时间到！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3864456574",
      "Source": "準備はいいですか、サバイバーさん？",
      "Trans": {"SC":"想来比一比吗，生存者？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3800676283",
      "Source": "あなたの速さ、私に見せてください",
      "Trans": {"SC":"你看上去速度很快嘛，让我们来实际测一测吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4288081619",
      "Source": "現在1位ですよ！ その調子！",
      "Trans": {"SC":"保持住——我们领先！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1795830031",
      "Source": "この調子で全員振り切っちゃいましょう！",
      "Trans": {"SC":"他们都落后了。我们要保持优势！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1350786432",
      "Source": "フーッ！ なんとかなりましたね",
      "Trans": {"SC":"我们脱身了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1401513510",
      "Source": "脱出劇というのはこうでなくちゃ！",
      "Trans": {"SC":"我们撤离得干净利落！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2857538192",
      "Source": "ここまで来ればもう大丈夫… お疲れ様でした",
      "Trans": {"SC":"成功完成取回任务。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::461443070",
      "Source": "今すぐ脱出してください！",
      "Trans": {"SC":"该离开这里了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::296877248",
      "Source": "回収完了。後は脱出するだけです…",
      "Trans": {"SC":"取回任务完成。现在该跑路了……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1270086405",
      "Source": "目標を回収。さあ、退却しますよ！",
      "Trans": {"SC":"杀出一条通路！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3898083742",
      "Source": "目標はアレです！",
      "Trans": {"SC":"这就是我们的目标！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::155504899",
      "Source": "回収する必要があるのは、アレです",
      "Trans": {"SC":"我们需要把它拿回来……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1034999406",
      "Source": "目標を補足しました。アレです",
      "Trans": {"SC":"我发现了所需取回的目标。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1851185013",
      "Source": "これは回収ミッションです。単純明快ですよね？",
      "Trans": {"SC":"这是一次取回测试，应该挺简单的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::16194075",
      "Source": "目標を回収後、脱出してください。わかりましたか？",
      "Trans": {"SC":"找到后就撤离。明白吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::676605059",
      "Source": "忘れないでください。これは盗みではなく「回収」です",
      "Trans": {"SC":"记得，这不是偷，是“取”。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1608781079",
      "Source": "収穫は後です、サバイバーさん",
      "Trans": {"SC":"朋友，等会再捡。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1258662241",
      "Source": "そんなことをしてる場合じゃないです！ ミッション中ですよ",
      "Trans": {"SC":"没时间捡了！我们有任务。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::545823546",
      "Source": "それは後です！ 今はミッションに集中してください！",
      "Trans": {"SC":"打完再捡！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2812205760",
      "Source": "さあ、殺戮を始めましょう",
      "Trans": {"SC":"你准备好大开杀戒了吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1760657277",
      "Source": "どれほどうまくやれるか、私に見せてください",
      "Trans": {"SC":"让我们看看你的击杀速度有多快。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::99905865",
      "Source": "構えてください、狩りの時間です",
      "Trans": {"SC":"准备好你的武器。杀戮时刻开始。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::949448504",
      "Source": "何だか目眩が… しっかりしてください！",
      "Trans": {"SC":"我才不会头晕呢……等等！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::823135030",
      "Source": "ただ生き延びればいいんです。簡単ですよね？",
      "Trans": {"SC":"我们要做的就是生存？太简单了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2192689206",
      "Source": "死なないでください。私からは以上です",
      "Trans": {"SC":"老兄，活下去。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3829855267",
      "Source": "いつものサバイバルですよ。心配することなんてありますか？",
      "Trans": {"SC":"简单的生存考验。不用过于担心，是吧？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3397767562",
      "Source": "新しいペットを手に入れましたね！",
      "Trans": {"SC":"你获得了一只新宠物！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3916114175",
      "Source": "うんうん、ちゃんとテイムされてますね",
      "Trans": {"SC":"这只训好了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2740695832",
      "Source": "ふう、流石にこれをテイムするのは骨が折れましたね！",
      "Trans": {"SC":"得花不少力气才能驯服这样一头野兽！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::692033211",
      "Source": "こいつはとても血に飢えてるみたいですね。それを逆に利用してやれば…",
      "Trans": {"SC":"这家伙特别嗜血。或许我们利用这一点……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1447976701",
      "Source": "この巨体じゃ自分で毛づくろいもできないでしょうね。手伝ってあげれば、喜ぶかも…",
      "Trans": {"SC":"它体型太大了，没办法清理自己。或许你可以帮帮它……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1953424702",
      "Source": "親子の絆より強いものはありません。その絆の代わりになるものがあれば、あるいは…",
      "Trans": {"SC":"没有比母子之情更牢固的关系了。但如果我们能想出替代方案，或许会有新发现？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2353123851",
      "Source": "テイムの準備はいいですか？",
      "Trans": {"SC":"准备好测试一下你的驯服技巧了吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2573511930",
      "Source": "このテストに合格するには、獰猛な生物をテイムする必要があります",
      "Trans": {"SC":"为了战胜这个挑战，你必须驯服这头凶猛的野兽！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::179420150",
      "Source": "さあ、テイムを始めましょうか",
      "Trans": {"SC":"试试驯一只吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1682818552",
      "Source": "攻撃力にブーストがかかっているようですね",
      "Trans": {"SC":"他们调高了你的武器伤害。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3612843659",
      "Source": "防御力にブーストがかかっているみたいですね",
      "Trans": {"SC":"你获得了防御强化。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1413883079",
      "Source": "Genesisシミュレーションの数値パラメーターが元に戻ったようです。有意義な時間でしたね",
      "Trans": {"SC":"创世模拟系统的参数恢复正常值了。其实那还挺有趣的……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::617625828",
      "Source": "収穫率のブーストを受けていますよ、サバイバーさん",
      "Trans": {"SC":"他们调高了采集倍率。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2041041866",
      "Source": "Genesisシミュレーションの数値パラメーターが変化しているようです…",
      "Trans": {"SC":"创世模拟系统的参数正在变化……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3405448878",
      "Source": "経験値ブーストを受けていますよ、サバイバーさん",
      "Trans": {"SC":"你获得了经验值加成。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    }
  ],
  //商店语音 - 2026-07-26 11:31:52
  "Store": [
    {
      "NamespaceHash": "Globals::1785216849",
      "Source": "毎度あり！",
      "Trans": {"SC":"已收款！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3944155070",
      "Source": "いい買い物をしましたね！",
      "Trans": {"SC":"明智之选！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::314593135",
      "Source": "お目が高い！",
      "Trans": {"SC":"眼光独到！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3959484107",
      "Source": "交換所に少し変更を加えてみたんです",
      "Trans": {"SC":"店铺调整啦。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2681402979",
      "Source": "見ていってください。変わったものがあるかもしれませんよ？",
      "Trans": {"SC":"看一看，小店调整啦。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3057546925",
      "Source": "頑張ってくださいね、サバイバーさん！",
      "Trans": {"SC":"慢走不送！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2375784431",
      "Source": "またのご来店、お待ちしています！",
      "Trans": {"SC":"欢迎下次光临！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::806760432",
      "Source": "ありがとうございました！",
      "Trans": {"SC":"感谢惠顾！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2527625048",
      "Source": "ラインナップが新しくなりました！",
      "Trans": {"SC":"店里进新货啦。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1556654540",
      "Source": "新しい商品がありますよ！",
      "Trans": {"SC":"今日上新啦。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1425599723",
      "Source": "ウィンドウショッピングですね、わかります",
      "Trans": {"SC":"随便看看？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1548473829",
      "Source": "お気に召しませんでしたか？",
      "Trans": {"SC":"没有看中的吗？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1747640925",
      "Source": "近いうちにまたどうぞ！",
      "Trans": {"SC":"下次保准让您满意！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1525437615",
      "Source": "ヘキサゴン交換所へようこそ！",
      "Trans": {"SC":"欢迎来到六角币兑换中心！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2441628078",
      "Source": "こんにちは、サバイバーさん。今のラインナップはこんな感じです",
      "Trans": {"SC":"生存者你好呀。来看看我的货吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1712285685",
      "Source": "使いたいヘキサゴンはありますか？",
      "Trans": {"SC":"是不是想花些钱呀？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::54035725",
      "Source": "本日はサービスデーです。見ていってください！",
      "Trans": {"SC":"今天特价。来瞧一瞧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::586470227",
      "Source": "セール中です！",
      "Trans": {"SC":"打折出售！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    }
  ]
}
