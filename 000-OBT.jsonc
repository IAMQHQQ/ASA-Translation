      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::315902104",
      "Source": "You feel refreshed and your thirst has left you",
      "Trans": {"SC":"You feel refreshed and your thirst has left you","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2323358453",
      "Source": "You feel refreshed!",
      "Trans": {"SC":"你感觉浑身舒畅!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1084133099",
      "Source": "You fixed an Air Supply Tank!",
      "Trans": {"SC":"你修复了一个空气储存罐!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::904353272",
      "Source": "You flirt coyly.",
      "Trans": {"SC":"你害羞地扭捏着!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3355355040",
      "Source": "You gain Oxygen when submerged from the SCUBA Tank, while depleting its durability!",
      "Trans": {"SC":"呼吸瓶中的氧气!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1172013428",
      "Source": "You get increased hyperthermic insulation, 300% additional speed, and decreased undwater oxygen depletion!",
      "Trans": {"SC":"你获得更高的高温抗性, 三倍的额外速度, 并减少水下氧气消耗!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3907053371",
      "Source": "You get increased insulation stats",
      "Trans": {"SC":"你的抗性提高了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2235759489",
      "Source": "You have advanced to the next room!",
      "Trans": {"SC":"你已经进入到下一个房间了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1031948587",
      "Source": "You have been blinded and slowed by ink",
      "Trans": {"SC":"你被墨汁糊了眼且被减速了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3184396413",
      "Source": "You have been blinded and your ears are ringing!",
      "Trans": {"SC":"眼睛看不清, 耳朵嗡嗡响!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3526736470",
      "Source": "You have been caught in a Bola, and are immobilized",
      "Trans": {"SC":"你被流星锤套住了, 无法移动!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3243782805",
      "Source": "You have been caught in a Chain Bola, and are immobilized",
      "Trans": {"SC":"你被流星锁链套住了, 无法移动!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2301983971",
      "Source": "You have been impaled and are bleeding out!",
      "Trans": {"SC":"你被刺穿了并且流血不止!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::842517646",
      "Source": "You have been stung by BEES!",
      "Trans": {"SC":"你被蜜蜂蜇了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2689617839",
      "Source": "You have constructed a TEK Hover Skiff!",
      "Trans": {"SC":"你建造了一艘泰克悬浮艇!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2857824510",
      "Source": "You have earned the dinosaurs' trust for a brief period of time!",
      "Trans": {"SC":"你在短时间内赢得了恐龙的信任!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::320786005",
      "Source": "You have not completed this mission yet.",
      "Trans": {"SC":"你还没有完成这个任务。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2172417061",
      "Source": "You have some protection from bees!",
      "Trans": {"SC":"你不用那么怕蜜蜂了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1216397828",
      "Source": "You have taken control of the Hangar doors, elevator and turrets!",
      "Trans": {"SC":"你已经控制了生物培养库的门、电梯和炮塔!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::457026241",
      "Source": "You jump out and scream \"BOO!\"",
      "Trans": {"SC":"你跳出来大声喝倒彩!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2670217155",
      "Source": "You killed a {1} {2}",
      "Trans": {"SC":"你杀死了一只 {1} {2}","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2798190220",
      "Source": "You killed the Corrupted Master Controller!",
      "Trans": {"SC":"你杀死了腐化的主宰者!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1462579226",
      "Source": "You killed {num} dinos!",
      "Trans": {"SC":"你杀死了 {num} 个恐龙!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2750106664",
      "Source": "You knock menacingly...",
      "Trans": {"SC":"你来势汹汹地敲...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1547940792",
      "Source": "You know, this whole \"staving off the ever looming spectre of despair\" thing would be a lot easier without all the dinosaurs. Did I not mention those? I should have mentioned those. Anyway, turns out that raptor attacks aren't so great for morale. True story.\n\nAt least the weather's holding up. We've had clear skies for three days now. It was a good idea to start giving people callsigns, too. Getting a new callsign from my squadron always made me feel closer to them, whatever it was. Hopefully it works with this bunch.\n\nThe newbie suggested Rubberneck for me, since I keep looking at the sky, but I can't help it. It really is gorgeous here. A perfect blue.",
      "Trans": {"SC":"要是没有恐龙, 那这“摆脱绝望心态”的事还不算太难。我没说过有恐龙是吧? 我该说的。遭受迅猛龙的攻击对士气影响没那么大。真实的故事。\n\n至少天气还好。已经晴了三天。给别人起绰号是个很不错的主意。每次当我被中队的人起了新的绰号的时候, 总是让我感觉与他们更亲近。希望这群人也是这样。\n\n菜鸟建议叫我“长脖子”, 因为我总是伸长脖子望天, 但我就是停不下来。这里太漂亮了。完美的蓝天。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::758210873",
      "Source": "You launch yourself into the air.",
      "Trans": {"SC":"你把自己发射到空中!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::90033770",
      "Source": "You lay down a sick beat!",
      "Trans": {"SC":"你敲出了一个很酷的节拍!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::172644804",
      "Source": "You made it! I knew you could, but it's still exciting to see the pieces fall into place. \r\n\r\nWelcome home.\r\n\r\nHome...yet another intangible, human concept. Some non-sentient species take up residence in a single location for shelter, hibernation or to raise their young. Yet none of them grow psychologically attached to a place in the same way humans do - a house, a town, a planet...\r\n\r\nThat's why this is so important. That's why the System exists as it does. There were other designs, backups if you will, but the System was the first choice. Humanity needs its home, and it's up to you to build it.\r\n\r\nSo I hope you brought your hammer. And some friends. And weapons. And friends that can be weapons. You're going to need lots of things, basically. This home is...well it's what you'd call a fixer-upper.",
      "Trans": {"SC":"你做到了! 我就知道你能够做到, 但是看到事情终于步入正轨还是相当振奋人心的。\n\n欢迎回家。\n\n家...但这是另一个难以理解的人类的概念。一些没有感知能力的物种会在某一个地点定居下来, 并将其作为自己寻求庇护、休眠以及抚育后代的地方。\n\n但是没有一种生物会像人类那样对某一个地方产生心理上的依恋 -- 不管是一栋房子, 一个小镇, 还是一颗星球...\n\n所以这就是为什么这一切是如此重要。这就是系统会存在的理由。曾经还有其他的设计, 你可以称它们为候选方案, 但是系统是最佳方案。人类需要他们的家园, 而现在轮到你建立起这个家园了。\n\n所以我希望你带着你的锤子。以及一些朋友。还有武器。还有能够成为武器的朋友。基本上你会需要一大堆东西。你的家园现在...嗯, 你可以说它需要好好修缮一下。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2674169614",
      "Source": "You made it! I knew you would, but it's still exciting to see the pieces fall into place. \n\nWelcome home.\n\nHome...yet another intangible, human concept. Some non-sentient species take up residence in a single location for shelter, hibernation or to raise their young. Yet none of them grow psychologically attached to a place in the same way humans do - a house, a town, a planet...\n\nThat's why this is so important. That's why the System exists as it does. There were other designs, backups if you will, but the System was the first choice. Humanity needs its home, and it's up to you to build it.\n\nSo I hope you brought your hammer. And some friends. And weapons. And friends that can be weapons. You're going to need lots of things, basically. This home is...well it's what you'd call a fixer-upper.",
      "Trans": {"SC":"你做到了! 我就知道你能够做到, 但是看到事情终于步入正轨还是相当振奋人心的。\n\n欢迎回家。\n\n家...但这是另一个难以理解的人类的概念。一些没有感知能力的物种会在某一个地点定居下来, 并将其作为自己寻求庇护、休眠以及抚育后代的地方。\n\n但是没有一种生物会像人类那样对某一个地方产生心理上的依恋 -- 不管是一栋房子, 一个小镇, 还是一颗星球...\n\n所以这就是为什么这一切是如此重要。这就是系统会存在的理由。曾经还有其他的设计, 你可以称它们为候选方案, 但是系统是最佳方案。人类需要他们的家园, 而现在轮到你建立起这个家园了。\n\n所以我希望你带着你的锤子。以及一些朋友。还有武器。还有能够成为武器的朋友。基本上你会需要一大堆东西。你的家园现在...嗯, 你可以说它需要好好修缮一下。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3023740861",
      "Source": "You must Ascend to Gamma level before accessing this ARK.",
      "Trans": {"SC":"你需要通过简单等级的飞升才能前往该方舟。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3363601480",
      "Source": "You need a water vein",
      "Trans": {"SC":"需要一个泉眼","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4276071654",
      "Source": "You need an oil vein",
      "Trans": {"SC":"需要一个油矿","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::357903898",
      "Source": "You need more water to make this drink.",
      "Trans": {"SC":"你需要更多的水来制作这个饮品","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3914447696",
      "Source": "You play some sweet licks.",
      "Trans": {"SC":"你弹了一些甜蜜的吉他和弦!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::678347501",
      "Source": "You really outdid yourself with this mech, Santiago. Even busted up and slumped against a building, it's one impressive machine, and it looks like you made sure it went down swinging. Would've been a blast to put it through its paces together, like we did with that TEK armor when we first met. \n\nIt's not right that you died here all alone, after everything you did. The Gateway Project gave us hope for the future, and you made it possible. Honestly I'm not sure why the voice would bring me back and not you too. It doesn't seem fair.\n\nNow said voice is saying \"sorry\" over and over again in my head, so it must have tried. Well don't worry, mysterious-ethereal-whatever-you-are, one miracle's enough. For both you and Santiago, I'll make it count. Bank on it.",
      "Trans": {"SC":"圣地亚哥, 你的机甲真的是你最伟大的作品! 即使它已经被打坏了, 摔倒在一栋建筑上, 它依然让人影响深刻, 而且看起来你确保它一直战斗到了最后一刻。把它组装起来一定花了很多精力, 就像我们第一次见面时我们制造泰克装甲那样。\n\n在你做了那么多之后, 让你就在这里一个人死去实在是不对。传送门项目让我们对未来充满了希望, 是你让这个项目成为了可能。说实话, 我不确定为什么那个声音能够复活我而不能复活你。这看起来不公平。\n\n现在那个声音在我脑海中一遍又一遍地说“对不起”, 所以它一定有尝试过。嗯, 不要担心, 神秘的、缥缈的——不管你是啥, 一个奇迹就足够了。为了你和圣地亚哥, 我会充分利用这次机会的。相信我。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3305527508",
      "Source": "You shouldn't have this.  Seriously.  It's not possible to obtain.  There's either a huge bug you need to report, or you're cheating.",
      "Trans": {"SC":"你不应该有这个的。说真的, 它不可能被你获得。要么是有一个大Bug需要你汇报, 要么就是你在作弊","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3319534262",
      "Source": "You show your feelings!",
      "Trans": {"SC":"你表达了你的感受!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3833818904",
      "Source": "You start to hippity hop and just won't stop!",
      "Trans": {"SC":"你开始不停地跳嬉皮士舞!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::974120245",
      "Source": "You thrash around wildly!",
      "Trans": {"SC":"你疯狂地打滚!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3522460176",
      "Source": "You throw a snowball!",
      "Trans": {"SC":"你扔了个雪球!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::972061811",
      "Source": "You wiggle your tail.",
      "Trans": {"SC":"你摇起了尾巴!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::44050036",
      "Source": "You would have been proud of me. I controlled my breathing, just like you taught me, even with the tears streaming down my face. Even with all the hate and anger in my heart, I kept my aim steady, and I killed them. I killed them all, John.\n\nSo why have you abandoned me, too? You were the survivor, not I. These creatures should not have been enough to kill you. You were too strong. I need you too much.\n\nPlease. Come back to me. I need to hear your voice. I need to see your smile. Please. Please.",
      "Trans": {"SC":"你会为我感到骄傲的。我学会了如何控制我的呼吸——就像你教我的那样, 哪怕泪水不停顺着我的脸颊流下来。即使心中充满了仇恨和愤怒, 我仍然稳稳地瞄准我的目标, 然后杀死它们。我把它们全杀了, 约翰。\n\n为什么连你也抛弃了我? 你才是生存专家, 不是我。这些生物不可能杀死你。你太强大了。我太需要你了。\n\n求你了。回到我身边吧。我需要听到你的声音。我需要看到你的笑颜。求求你了。求求你。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3517647526",
      "Source": "You'd think I'd be more enthused. We saved the village, I confirmed the true nature of these space stations and when the gateway project is complete, we could actually escape this madness. It's all good news really, so why am I not thrilled?\nI tried sketching some of the wildlife we've spotted on the way back the village, but I stopped halfway through. What's the point? In the desert, I told myself it was a form of self-expression, but is it really? If a machine created me to behave a certain way, am I expressing myself or the will of the machine?\nI really need that pint. Maybe several.",
      "Trans": {"SC":"你或许认为我会更加幸福。我们拯救了村庄, 我确认了这些空间站的真实面目, 当传送门工程完成之后, 我们就能逃离这个疯狂的地方。这些都是好事情, 但是为什么我高兴不起来? \n\n我试着临摹一些我们在回村路上看到的野生动物, 但是我画到半路就停下来了。这么做有什么意义? \n\n在焦土, 我告诉我自己这只是一种自我表达的方式, 但真的是这样吗? 如果我的这些行为都是由一个机器设计出来的, 那么我所表达的到底是我自己还是机器的意志? \n\n我真的需要来一壶酒。也许要好几壶。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1545983635",
      "Source": "You'll do just fine on your own out there.\nYou're a survivor.",
      "Trans": {"SC":"你一个人在外面也会过得很好。\n你是一名生存者。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2534465590",
      "Source": "You'll want a moniker for me, won't you? Words and names are not explicitly necessary to process the world within oneself, but they are important when conveying it to others.\n\nI don't have one of those, not as I am now. Not anymore. Others have found that problematic, so they say things like nameless, ethereal and \"whatever.\" They describe my qualities, if poorly, but not who I am.\n\nAs a being who possess free will, or as much of it as one can truly possess within this universe, who I am is the sum of my actions. I am what I do, and what I do is wait. For you, for the Earth, for everything - I wait. On and on into forever, I wait and I wait, so that is who I am.\n\nI am One Who Waits.",
      "Trans": {"SC":"你会想要给我起一个名字, 不是吗? 当一个人在自己的脑海中研究世间的事物时, 语言和名字并不是必须的, 但是若是要和他人交流的话, 语言和名字就很重要了。\n\n我并没有名字。当我变成了这样之后, 我就再也没有名字了。其他人觉得这挺麻烦, 所以他们就给我取了“无名者”、“虚无者”或者“那玩意儿”之类的名字。他们描述了我的特征, 虽然有些蹩脚, 但那不是我。\n\n作为一个拥有自由意志的存在, 或者说在这个宇宙中能够最大程度地拥有自由意志的存在, 我的身份是由我的所作所为决定的。\n\n我即我所为, 而我所做的就是等待。等你, 等地球, 等所有的事情——我在等待。我一直在等啊等, 永远地等下去, 所以这就是我。\n\n我就是等待者。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3675595609",
      "Source": "You're Freezing!",
      "Trans": {"SC":"你觉得很冷!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4046564018",
      "Source": "You're Frozen!",
      "Trans": {"SC":"你被冻住了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3348022846",
      "Source": "You're Igniting!",
      "Trans": {"SC":"你着火了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::415161742",
      "Source": "You're Rooted!",
      "Trans": {"SC":"你被缠住了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3764799823",
      "Source": "You're about to be Zapped!",
      "Trans": {"SC":"你要被雷劈了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::941780248",
      "Source": "You're bleeding! 10% of your Health will be drained!",
      "Trans": {"SC":"你流血了! 损失10%的生命值!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2387239027",
      "Source": "You're bleeding! 20% of your Health will be drained!",
      "Trans": {"SC":"你流血了! 损失20%的生命值!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::865051679",
      "Source": "You're boiling up! A percentage of your Health will boil away and your movement speed will reduce!",
      "Trans": {"SC":"你热到沸腾了! 会蒸发掉部分生命值并降低移动速度!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2665618055",
      "Source": "You're burning up! 10% of your Health will burn away!",
      "Trans": {"SC":"You're burning up! 10% of your Health will burn away!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3743506953",
      "Source": "You're burning up! 20% of your Health will burn away!",
      "Trans": {"SC":"你着火了! 将消耗你20%的生命值!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3998213565",
      "Source": "You're burning up! A percentage of your Health will burn away!",
      "Trans": {"SC":"你着火了! 将消耗你的部分生命值!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3124123734",
      "Source": "You're burning!",
      "Trans": {"SC":"你着火了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::951651759",
      "Source": "You're cold. You should find some warmth soon.",
      "Trans": {"SC":"你有点冷. 找个暖和的地方待一会吧.","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::886433233",
      "Source": "You're covered in paralyzing poison.",
      "Trans": {"SC":"你被麻痹毒药覆盖了。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::601583400",
      "Source": "You're dehydrated! Find some water, fast!",
      "Trans": {"SC":"你脱水了! 赶紧找些水喝!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2324296410",
      "Source": "You're encumbered! Drop some Inventory weight in order to move again!",
      "Trans": {"SC":"你超重了! 丢弃一些重量才能重新移动!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1412709311",
      "Source": "You're feeling lucky",
      "Trans": {"SC":"你感觉很幸运","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1378966324",
      "Source": "You're freezing quickly!",
      "Trans": {"SC":"你快要冻僵了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3853786845",
      "Source": "You're freezing! You should find some warmth immediately!",
      "Trans": {"SC":"你冻僵了! 马上找个暖和的地方!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4183346687",
      "Source": "You're hot. You should find some place to cool down soon.",
      "Trans": {"SC":"你有点热. 你应该找个凉快的地方待一会.","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3295539354",
      "Source": "You're igniting quickly!",
      "Trans": {"SC":"你快要着火了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::33443389",
      "Source": "You're igniting quickly! {1}%",
      "Trans": {"SC":"你身上火势迅速蔓延! {1}%","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1732393757",
      "Source": "You're injured! Recover some Health in order to move properly again.",
      "Trans": {"SC":"你受伤了! 恢复些生命值才可正常移动。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::865552672",
      "Source": "You're knocked out! Wait for your Torpidity to reduce in order to wake back up.",
      "Trans": {"SC":"你晕倒了! 需等待眩晕值降低些才会苏醒.","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3841784475",
      "Source": "You're overheating! You should find some place to cool down immediately!",
      "Trans": {"SC":"你热死了! 马上找个凉快的地方!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::43260190",
      "Source": "You're starving! Find somethin to eat, fast!",
      "Trans": {"SC":"你在挨饿! 赶快找些东西吃!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2330505376",
      "Source": "You're suffocating! Get some air, immediately!",
      "Trans": {"SC":"你窒息了! 赶快吸些空气!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1574237174",
      "Source": "You're temporarily immune to contracting certain Lesser Diseases!",
      "Trans": {"SC":"你对某些次级疾病暂时免疫了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1466164928",
      "Source": "You're thunderstruck!",
      "Trans": {"SC":"你被雷击了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::862856602",
      "Source": "You're tired! Stop moving for a moment to regain your Stamina!",
      "Trans": {"SC":"你累了! 暂时停止移动可恢复你的耐力!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::790331351",
      "Source": "You're within the effects of a Charge radius, protecting you from the Nameless!",
      "Trans": {"SC":"电荷光范围内可保护你免遭无名怪的攻击!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1945988366",
      "Source": "You've been Iced!",
      "Trans": {"SC":"你被冻住了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3085409806",
      "Source": "You've been Poisoned! Your Stamina is decreasing!",
      "Trans": {"SC":"你中毒了! 你的耐力正在降低!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1230470318",
      "Source": "You've been Poisoned! Your Torpidity is rapidly increasing...",
      "Trans": {"SC":"你中毒了! 你的眩晕值正在急速增加...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3449916737",
      "Source": "You've been debuffed by a Macrophage!",
      "Trans": {"SC":"你被巨噬细胞施加了负面效果!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1890685176",
      "Source": "You've been impaled!",
      "Trans": {"SC":"你被钉住了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1377469102",
      "Source": "You've been infected by poisonous spores!",
      "Trans": {"SC":"你已经感染了剧毒孢子!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2504188292",
      "Source": "You've been rewarded!",
      "Trans": {"SC":"你得到了奖励!","JA":""},
