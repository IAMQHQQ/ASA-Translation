      "Trans": {"SC":"影响留痕任务超时之后\n留痕品质下降的时长。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3159614410",
      "Source": "A mushroom as black as a moonless midnight. Looks to be highly narcotic.",
