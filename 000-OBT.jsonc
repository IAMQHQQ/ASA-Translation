      "Source": "You feel disgusting!",
      "Trans": {"SC":"You feel disgusting!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1853159638",
      "Source": "You feel lightheaded after just touching this.  Ingesting it would be dangerous.",
