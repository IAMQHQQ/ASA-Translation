    {
      "NamespaceHash": "Content::869583533",
      "Source": "Climb aboard a Woolly Rhino and race across the frozen plains in the most watched race on Genesis.",
      "Trans": {"SC":"骑上一头披毛犀, 然后在创世模拟系统中最受瞩目的竞赛里比一场吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3187938308",
      "Source": "Climb up and hang from nearly any surface with these!",
      "Trans": {"SC":"可以攀爬并悬挂在几乎所有表面上!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2402629218",
