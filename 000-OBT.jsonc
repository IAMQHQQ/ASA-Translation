    {
      "NamespaceHash": "Content::4129268127",
      "Source": "Have some peace of mind while you incubate your embryos.\r\n\r\nEmbryos that normally must be birthed underwater require the incubator to be underwater.",
      "Trans": {"SC":"你可以安心地等待胚胎的发育。\r\n\r\n通常水中出生的生物, 培养器也必须放置在水中才能正常出生。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3697543490",
