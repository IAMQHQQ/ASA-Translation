    {
      "NamespaceHash": "Content::1953892055",
      "Source": "Stryder Riding Platform",
      "Trans": {"SC":"泰克跨步者骑行平台","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3721399776",
      "Source": "Stryder Shield",
      "Trans": {"SC":"泰克跨步者护盾","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3114016894",
      "Source": "Stryders equipped with this platform can be piloted and used to transport passengers.",
      "Trans": {"SC":"拥有此平台的泰克跨步者可以驾驶并运送乘客。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1253676887",
      "Source": "Stryders equipped with this rig can detect creatures within radar range.",
      "Trans": {"SC":"拥有此配件的泰克跨步者可以探测雷达范围内的生物和人类。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2498895905",
      "Source": "Stryders equipped with this rig can fire high-rate plasma bursts.",
      "Trans": {"SC":"拥有此配件的泰克跨步者可以高速连续发射等离子弹药。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2003914793",
      "Source": "Stryders equipped with this rig can fire highly-damaging plasma blasts.",
      "Trans": {"SC":"拥有此配件的泰克跨步者可以发射极具破坏性的等离子炮弹。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1747744544",
      "Source": "Stryders equipped with this rig can gather mined resources from mining drills with an attractor beam when activated. Also greatly reduces inventory weight.",
      "Trans": {"SC":"拥有此配件的泰克跨步者可以在激活时从采矿钻机中通过吸引光束收集所开采到的资源。并大大降低了资源的库存重量。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::966846865",
      "Source": "Stryders equipped with this rig can mine high-value resources like stone and metal. Can be linked to a Tek Dedicated Box.",
      "Trans": {"SC":"拥有此配件的泰克跨步者可以开采石头和金属等高价值资源。可以链接到泰克专用储物箱。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1246838948",
      "Source": "Stryders equipped with this rig can project a directional force field.",
      "Trans": {"SC":"拥有此配件的泰克跨步者可以张开一个定向力场护盾。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3670470337",
      "Source": "Stryders equipped with this rig can project a force field bubble.",
      "Trans": {"SC":"拥有此配件的泰克跨步者可以张开一个气泡型力场护罩。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::637093573",
      "Source": "Stryders equipped with this rig can suppress enemies with a sonic attack. ",
      "Trans": {"SC":"拥有此配件的泰克跨步者可以用声波攻击压制敌人使许多敌方生物无法使用技能。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
