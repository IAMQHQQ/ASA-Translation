    },
    {
      "NamespaceHash": "GraphLiteral::3907963280",
      "Source": "The scaling factor for the damage Structures deal with their attacks (ex: Spiked Walls).",
      "Trans": {"SC":"建筑攻击造成伤害的系数。(例如: 拒马)。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1841070732",
      "Source": "The scaling factor for the damage taken by Structures built inside caves.",
      "Trans": {"SC":"建筑在洞穴内造成的伤害比例系数。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3415827946",
      "Source": "The scaling factor for the damage turrets deal to Creatures. Higher values mean more damage.",
      "Trans": {"SC":"炮台伤害对生物的比例系数。较高的值意味着更多的伤害。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3003799069",
      "Source": "The scaling factor for the distance that connected Players are allowed to be from the host Player. Higher values means Players can move farther away before being tethered.",
      "Trans": {"SC":"数值越小其他玩家越容易回弹到主机玩家身边, 影响其他玩家与主机玩家角色的距离系数。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::932690798",
      "Source": "The scaling factor for the experience received by Players, Tribes, and Creatures. Higher values means faster leveling.",
      "Trans": {"SC":"玩家、部落和生物获得的经验的比例系数。较高的值意味着更快的升级。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2217178269",
      "Source": "The scaling factor for the length of time a Player or Tribe can remain inactive before their Creatures can be claimed by others.",
      "Trans": {"SC":"玩家或部落在处于不活跃状态时, 其生物可以被其他玩家认领的时间系数。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::599219186",
      "Source": "The scaling factor for the length of time a Player or Tribe can remain inactive before their Structures can be demolished by others.",
      "Trans": {"SC":"玩家或部落在处于不活跃状态时, 其建筑可以被其他玩家拆除的时间系数","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3860408492",
      "Source": "The scaling factor for the limit of Structures that can be placed on a platform.",
      "Trans": {"SC":"可以放置在平台上的建筑极限的比例系数。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2567405807",
      "Source": "The scaling factor for the passage of time in the ARK, controlling how often day changes to night and night changes to day. (Values less than 1 slow down the cycle)",
      "Trans": {"SC":"方舟中时间流逝的比例系数, 控制白天变为夜晚和夜晚变为白天的频率(小于1的值会减慢循环速度)","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::57826538",
      "Source": "The scaling factor for the quality level of crafted items based on the Player's crafting skill.",
      "Trans": {"SC":"根据玩家的制作技能, 数值越高加成越好。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::187894414",
      "Source": "The scaling factor for the quality level of items found in loot crates.",
