    {
      "NamespaceHash": "Content::2382782744",
      "Source": "Rare mechanochemical substance derived from Mutagen. Use with caution to tame autonomous Stryders.",
      "Trans": {"SC":"从诱变剂中提取的稀有的化学物质。谨慎使用以驯服泰克跨步者。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1489442744",
      "Source": "Rare substance with aggravating and mutagentic properties. Use with caution to boost creature stats and gain access to Rockwell's Inner Sanctum.",
      "Trans": {"SC":"可以通过诱变使生物属性增加的稀有物质。谨慎使用以提高生物属性并进入罗克韦尔的内部洞穴。","JA":""},
