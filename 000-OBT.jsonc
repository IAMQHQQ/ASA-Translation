    {
      "NamespaceHash": "Globals::4019709948",
      "Source": "Remember, when you join a Tribe, all of your structures and dinos become owned by the Tribe. It's all for one and one for all!",
      "Trans": {"SC":"记住, 当你加入一个部落的时候, 所有你的建筑物和恐龙都归该部落所有。人人为我, 我为人人!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3592302514",
      "Source": "Remember, you don't have to run faster than the dinos, only faster than your friends.",
