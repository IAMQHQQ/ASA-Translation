    },
    {
      "NamespaceHash": "GraphLiteral::1976948211",
      "Source": "The scaling factor for Creature spawns. Higher values increase the total number of Creatures spawned throughout the ARK.",
      "Trans": {"SC":"生物生成的比例系数。较高的值会增加整个方舟中生成的生物总数。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1549065002",
      "Source": "The scaling factor for Creature taming speed. Higher values means faster taming.",
      "Trans": {"SC":"生物驯服速度的比例系数。较高的值意味着更快的驯服。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1941163498",
      "Source": "The scaling factor for Creature's food consumption. Higher values cause Creatures to get hungry faster.",
      "Trans": {"SC":"生物食物消耗的比例系数。较高的值会导致生物更快地变得饥饿。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1574104696",
      "Source": "The scaling factor for Creature's health recovery. Higher values cause Creatures to heal faster.",
      "Trans": {"SC":"生物生命恢复的比例系数。较高的值会导致生物更快地治愈。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1117034328",
      "Source": "The scaling factor for Creature's stamina consumption. Higher values cause Creatures to get tired faster.",
      "Trans": {"SC":"生物耐力消耗的比例系数。较高的值会导致生物更快地疲倦。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::828430400",
      "Source": "The scaling factor for Creatures spawning eggs. Higher numbers mean less time between egg spawns.",
      "Trans": {"SC":"生物产蛋间隔的比例系数。数值越高就意味着更频繁的产蛋。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3405523473",
      "Source": "The scaling factor for Player's food consumption. Higher values cause Players to get hungry faster.",
