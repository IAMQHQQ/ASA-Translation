    {
      "NamespaceHash": "Content::1943986187",
      "Source": "Burns Gasoline to cook large quantities of food quickly.  Put various ingredients in this to make soups, stews, and dyes.",
      "Trans": {"SC":"以汽油作为燃料来快速烹煮大量食物。放入各种原材料可做成汤, 炖菜和染料。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3683143712",
      "Source": "Burns sparkpowder at low temperatures to dehydrate food and kill bacteria.  Keeps perishables from spoiling for a small time.",
      "Trans": {"SC":"低温燃烧的引火粉可以给食物脱水灭菌。可以延长易腐品的保鲜期。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::633415607",
      "Source": "Bush",
