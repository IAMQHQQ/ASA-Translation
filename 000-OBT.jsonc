    },
    {
      "NamespaceHash": "Content::2006573200",
      "Source": "Destroy Rockwell's super-virus so it can't track down the Replication subsystem",
      "Trans": {"SC":"消灭罗克韦尔的超级病毒, 使其无法追踪到备份数据的子系统","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2721002045",
      "Source": "Destroy Rockwell's viruses before all the biopod control systems are infected",
      "Trans": {"SC":"在所有生物培养罐的控制系统被感染之前消灭罗克韦尔病毒","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2240296663",
