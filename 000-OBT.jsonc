      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1607988932",
      "Source": "If checked, spike walls will damage wild and\nriderless Dinosaurs.",
      "Trans": {"SC":"勾选后, 拒马会对野生和无人骑乘\n的恐龙造成伤害。","JA":""},
