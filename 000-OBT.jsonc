    {
      "NamespaceHash": "Content::2753648602",
      "Source": "Spear of the Gods",
      "Trans": {"SC":"上帝之矛","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1445118870",
      "Source": "Special Bow Skin",
      "Trans": {"SC":"Special Bow Skin","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2080994078",
      "Source": "Special Reward",
      "Trans": {"SC":"特别奖励","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1076502964",
      "Source": "Specifies the scaling factor for a tamed\nTitanosaur's food consumption. Higher values\ncause the dino to get hungry faster.",
      "Trans": {"SC":"影响驯服的泰坦龙的食物消耗速度。\n值越高代表它会饿得越快。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::751634067",
      "Source": "Specifies the scaling factor for dinosaur spawns. Higher values increase the total number of dinosaurs spawned throughout the ARK.",
      "Trans": {"SC":"影响恐龙刷新的速度。值越高代表整个方舟世界中恐龙的总数越高。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1113450432",
      "Source": "Specifies the scaling factor for dinosaur taming speed. Higher values make taming faster.",
      "Trans": {"SC":"影响恐龙的驯养速度。值越高代表驯养时间越短。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2352597033",
      "Source": "Specifies the scaling factor for dinosaur's food consumption. Higher values cause dinosaurs to get hungry faster.",
      "Trans": {"SC":"影响恐龙的食物消耗速度。值越高代表恐龙饿得越快。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1564248192",
      "Source": "Specifies the scaling factor for dinosaur's health recovery. Higher values cause dinosaurs to heal faster.",
      "Trans": {"SC":"影响恐龙生命恢复速度。值越高代表恐龙自愈得越快。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3263706797",
      "Source": "Specifies the scaling factor for dinosaur's stamina consumption. Higher values cause dinosaurs to get tired faster.",
      "Trans": {"SC":"影响恐龙的耐力消耗速度。值越高代表恐龙的耐力越容易耗尽。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3465914900",
      "Source": "Specifies the scaling factor for player character's food consumption. Higher values cause player characters to get hungry faster.",
      "Trans": {"SC":"影响玩家角色的食物消耗速度。值越高代表玩家角色越容易饿。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3904393827",
      "Source": "Specifies the scaling factor for player character's health recovery. Higher values cause player characters to heal faster.",
      "Trans": {"SC":"影响玩家角色的生命恢复速度。值越高代表玩家角色自愈得越快。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3279438863",
      "Source": "Specifies the scaling factor for player character's stamina consumption. Higher values cause player characters to get tired faster.",
      "Trans": {"SC":"影响玩家角色的耐力消耗速度。值越高代表玩家角色的耐力越容易耗尽。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::369312913",
      "Source": "Specifies the scaling factor for player character's water consumption. Higher values cause player characters to get thirsty faster.",
      "Trans": {"SC":"影响玩家角色的水消耗速度。值越高代表玩家角色越容易口渴。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3988872884",
      "Source": "Specifies the scaling factor for the \"health\" of\nitems that can be harvested (trees, rocks,\ncarcasses, etc.). Higher values increase the\namount of damage (i.e. \"number of strikes\")\nsuch objects can withstand before being\ndestroyed, which results in higher overall\nharvest yields.",
      "Trans": {"SC":"影响资源的“生命值”(树木、岩石、尸体等等)。\n值越高代表该物体被摧毁前可以承受的伤害量\n越多, 并可以采集到更多资源。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2147160729",
      "Source": "Specifies the scaling factor for the damage dinosaurs deal with their attacks.",
      "Trans": {"SC":"影响恐龙在攻击时造成伤害量的系数","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2347944973",
      "Source": "Specifies the scaling factor for the damage players deal with their attacks.",
      "Trans": {"SC":"影响玩家在攻击时造成伤害量的系数","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3522122850",
      "Source": "Specifies the scaling factor for the damage structures deal with their attacks (e.g. spiked walls).",
      "Trans": {"SC":"影响建筑物(例如: 拒马)的攻击力。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::404288602",
      "Source": "Specifies the scaling factor for the experience received by players, tribes and dinosaurs.",
      "Trans": {"SC":"影响玩家、部落和恐龙获取到的经验值数量。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::277335452",
      "Source": "Specifies the scaling factor for the passage\nof time in the ARK, controlling how often day\nchanges to night and night changes to day.\n(Values less than 1 slow down the cycle)",
      "Trans": {"SC":"影响方舟世界中时间的流逝速度。\n (若值小于1则会放慢日夜循环)","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1931307173",
      "Source": "Specifies the scaling factor for the resistance to damage dinosaurs receive when attacked. Higher values decrease resistance, increasing damage per attack.",
      "Trans": {"SC":"影响恐龙对伤害的抵抗力。值越高代表抵抗力越低, 每次受到的伤害越高。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::269150145",
      "Source": "Specifies the scaling factor for the resistance to damage players receive when attacked. Higher values decrease resistance, increasing damage per attack.",
      "Trans": {"SC":"影响玩家角色对伤害的抵抗力。值越高代表抵抗力越低, 每次受到的伤害越高。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3622746552",
      "Source": "Specifies the scaling factor for the resistance to damage structures receive when attacked. Higher values decrease resistance, increasing damage per attack.",
      "Trans": {"SC":"影响建筑物对伤害的抵抗力。值越高代表抵抗力越低, 每次受到的伤害越高。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4153365089",
      "Source": "Specifies the scaling factor for the respawn\nrate for resource nodes (e.g. trees, rocks).\nLower values cause nodes to respawn more\nfrequently.",
      "Trans": {"SC":"影响资源点刷新(例如: 树木、石头)\n的速度。值越低代表刷新得越快。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3731197787",
      "Source": "Specifies the scaling factor for yields from all harvesting activities (e.g. chopping down trees, picking berries).",
      "Trans": {"SC":"影响所有资源采集 (例如砍树、采摘浆果) 的数量。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
