      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1999142584",
      "Source": "Provides light, and some warmth. Doubles as a melee weapon in a pinch, and can be applied to various saddles & your belt for a hands free light source.",
      "Trans": {"SC":"提供光照和温度。可以在紧要关头作为近战武器, 还可以添加到各种鞍上作为一个移动光源。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3579297680",
      "Source": "Provides little defense, but tremendous hyperthermal insulation specifically when underwater.",
