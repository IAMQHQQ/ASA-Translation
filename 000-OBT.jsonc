    {
      "NamespaceHash": "Content::2514655534",
      "Source": "Brave a Magmasaur's den and steal one of their precious eggs. Only the most prepared survivors will escape the onslaught of fire and teeth that follows.",
      "Trans": {"SC":"闯入熔岩龙的巢穴并偷走它们一颗珍贵的龙蛋。只有做好万全准备的生存者才能摆脱随后而来的烈焰。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2107783187",
      "Source": "Brave winter's chill to find hidden points among the frozen lakes and ice structures. The cold never bothered you anyway.",
      "Trans": {"SC":"顶着严寒找到位于湖泊和建筑物中的隐藏地点。冰封千里你也从不害怕。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
