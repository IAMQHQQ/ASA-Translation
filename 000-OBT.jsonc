      "NamespaceHash": "Content::3137413",
      "Source": "Blood Kit",
      "Trans": {"SC":"血包","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1033664840",
      "Source": "Blood Lake",
      "Trans": {"SC":"血之湖","JA":""},
