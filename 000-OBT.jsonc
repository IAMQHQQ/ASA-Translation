    },
    {
      "NamespaceHash": "Content::2916821007",
      "Source": "You can use this to skin the appearance of C4 into an eggsplosive Easter basket. Nothing beats these eggs for poaching your enemies... it'll be over easy!",
      "Trans": {"SC":"你可以使用这个皮肤来将C4炸弹的外观变成一个装满蛋的复活节篮子。没有什么比煮熟这些你的敌人所产下的蛋更让人浑身舒畅的了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3974002459",
      "Source": "You can use this to skin the appearance of a Boomerang. Portable fun for the beach!",
      "Trans": {"SC":"你可以使用这个皮肤来改变回旋镖的外观。海滩的便携式乐趣!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2566934595",
      "Source": "You can use this to skin the appearance of a Hat. No one will catch you staring.\n\nNon-human creatures adamantly refuse to wear this.",
      "Trans": {"SC":"你可以使用这个皮肤来改变帽子的外观。没有人会发现你盯着看。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3463679519",
      "Source": "You can use this to skin the appearance of a Saddle.\n\nHelp your mount celebrate independence -- without actually becoming independent, of course.",
