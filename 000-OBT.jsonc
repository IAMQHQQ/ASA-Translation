    {
      "NamespaceHash": "Content::2198005589",
      "Source": "Equip a Carno with this to ride it.",
      "Trans": {"SC":"装备到肉食牛龙上以骑乘。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
