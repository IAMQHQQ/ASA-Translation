      "Trans": {"SC":"森林泰坦终端","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2600223309",
      "Source": "Forgotten City",
      "Trans": {"SC":"遗忘之城","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
