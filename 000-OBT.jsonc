      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2793473345",
      "Source": "This will override all other skins, acting as a full-body costume to help you blend right in with all the other turkeys. \n\nShould always be set on Torso Armor. ",
