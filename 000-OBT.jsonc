      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::138563644",
      "Source": "The scaling factor for the rate at which fuel is consumed.",
      "Trans": {"SC":"燃料消耗速率的比例系数。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1983269980",
      "Source": "The scaling factor for the resistance to damage Creatures receive when attacked. Higher values decrease resistance, increasing damage per attack.",
      "Trans": {"SC":"生物受到攻击时抵抗伤害的比例系数。较高的值会降低抵抗力, 增加每次攻击受到的伤害。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::248310243",
      "Source": "The scaling factor for the resistance to damage Players receive when attacked. Higher values decrease resistance, increasing damage per attack.",
      "Trans": {"SC":"玩家受到攻击时抵抗伤害的比例系数。较高的值会降低抵抗力, 增加每次攻击受到的伤害。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1613836508",
      "Source": "The scaling factor for the resistance to damage Structures receive when attacked. Higher values decrease resistance, increasing damage per attack.",
