      "Trans": {"SC":"荒野","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1258736094",
      "Source": "Would you like to wait to automatically join this session?",
      "Trans": {"SC":"你想要等到自动加入该服务器吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::790849782",
      "Source": "Write your Note Text:",
      "Trans": {"SC":"输入内容: ","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3431286026",
      "Source": "Write your Sign Text:",
      "Trans": {"SC":"输入内容: ","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3606361414",
      "Source": "Write your Text:",
      "Trans": {"SC":"输入内容: ","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3439912692",
      "Source": "XP : %.1f",
      "Trans": {"SC":"经验值 : %.1f","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::131056306",
      "Source": "XP : %.1f / %i",
      "Trans": {"SC":"经验值 : %.1f / %i","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3597240611",
      "Source": "YOU",
      "Trans": {"SC":"你","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2441691988",
      "Source": "YOUR BEST SCORE",
      "Trans": {"SC":"个人最佳","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2487604531",
      "Source": "You %s %s!",
      "Trans": {"SC":"你 %s %s!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3003288737",
      "Source": "You already have a character on this server would you like to overwrite it?",
      "Trans": {"SC":"您在此服务器上已有角色信息, 想要覆盖它吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::315951944",
      "Source": "You already have too many paintings saved!",
      "Trans": {"SC":"已保存的绘画太多了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::780035296",
      "Source": "You are carrying items which are not ready for upload.  Do you want to drop them here and continue transfering?",
      "Trans": {"SC":"你的物品栏中含有暂时无法上传的物品。你想要丢弃它们并继续传送吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2368963468",
      "Source": "You are carrying items which are not ready for upload. You can wait till they are ready or drop those items and try again.",
      "Trans": {"SC":"你的物品栏中含有暂时无法上传的物品。你可以再等等或是丢弃它们, 然后重新开始传送。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1581604517",
      "Source": "You are carrying items which can not be transferred. Drop such items and try again.",
      "Trans": {"SC":"你带着禁止传送的物品。请丢弃后重试。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3183742170",
      "Source": "You are in a Mission Start zone. If you stay, you will join: ",
      "Trans": {"SC":"你位于任务开始区域。如果你留下来, 则将加入: ","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2221453171",
      "Source": "You are thankful",
      "Trans": {"SC":"你充满了感激之情!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1679803467",
      "Source": "You can drag a dead or unconscious body around, if you're strong enough. Even your Mount can carry bodies!",
      "Trans": {"SC":"假如你足够强壮, 你可以随意拖动一具已死亡或者昏迷中的躯体。你的坐骑也可以做到!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::681577319",
      "Source": "You can only have up to 8 ingredients in your Recipe!",
      "Trans": {"SC":"你的食谱中最多只能有8种原材料!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1733780435",
      "Source": "You can replace Thatch structures with Wooden ones.",
      "Trans": {"SC":"你可以使用木制建筑来取代茅草建筑。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1657131883",
      "Source": "You can use beds to fast-travel across the island, but you can't take items with you.",
      "Trans": {"SC":"你可以使用床的快速传送功能来瞬移, 但是传送时无法携带物品。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2646172227",
      "Source": "You can't join now!",
      "Trans": {"SC":"你现在无法加入!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3549347995",
      "Source": "You cheer",
      "Trans": {"SC":"你大声欢呼!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2158740006",
      "Source": "You defecated.",
      "Trans": {"SC":"你排泄了.","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2310035275",
      "Source": "You died!",
      "Trans": {"SC":"你死了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::DLCNotOwnedMessage",
      "Source": "You do not own this map. Would you like to go to the Nintendo eShop to purchase it?",
      "Trans": {"SC":"你还未拥有这张地图。要前往 Nintendo eShop 购买吗?","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"3702689366"}
    },
    {
      "NamespaceHash": "Globals::3169742192",
      "Source": "You feel sorry",
      "Trans": {"SC":"你感到很抱歉!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3555946182",
      "Source": "You have been globally banned.",
      "Trans": {"SC":"你已被全球封禁","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4095382835",
      "Source": "You have been temporarily banned from officials.",
      "Trans": {"SC":"你暂时被官方服务器封禁。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2463370701",
      "Source": "You have learned the '%s'!",
      "Trans": {"SC":"你学会了 '%s'!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3496414394",
      "Source": "You have not yet met the requirements to equip the cosmetic.",
      "Trans": {"SC":"您尚未满足装备该服饰的要求。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1179751339",
      "Source": "You have tamed ",
      "Trans": {"SC":"你已成功驯养 ","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4112517128",
      "Source": "You hide your hat.",
      "Trans": {"SC":"你隐藏了你的头盔!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::856986929",
      "Source": "You killed yourself!",
      "Trans": {"SC":"你自杀了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::66315038",
      "Source": "You laugh",
      "Trans": {"SC":"你哈哈大笑!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::112765101",
      "Source": "You lower your hands in friendly sign",
      "Trans": {"SC":"你举起双手表示友好!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2050738382",
      "Source": "You make a taunt",
      "Trans": {"SC":"你在挑衅!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::926439071",
      "Source": "You must be at least Level %i to Feed this %s.",
      "Trans": {"SC":"你必须至少%i级才能喂食%s。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2013703145",
      "Source": "You nod your head affirmatively",
      "Trans": {"SC":"你点了点头!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4233324047",
      "Source": "You salute",
      "Trans": {"SC":"你表示敬意!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3759295837",
      "Source": "You shake your head negatively",
      "Trans": {"SC":"你摇了摇头!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::3216493591",
      "Source": "You show your hat.",
      "Trans": {"SC":"你显示了你的头盔!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::1654714863",
      "Source": "You wave your hands",
      "Trans": {"SC":"你招了招手!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::2193899430",
      "Source": "You were killed by",
      "Trans": {"SC":"你死于","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Globals::4217213296",
