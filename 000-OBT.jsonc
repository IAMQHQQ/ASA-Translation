      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4169987514",
      "Source": "Destroy them as fast as possible!",
      "Trans": {"SC":"尽快消灭它们!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
