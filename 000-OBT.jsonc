    {
      "NamespaceHash": "Content::3100700850",
      "Source": "Time (in seconds) at which the game will switch to PVE settings if Allow PVE Timer is True.",
      "Trans": {"SC":"允许PVE计时器的前提下, 游戏切换成PVE模式的时间(秒)。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
