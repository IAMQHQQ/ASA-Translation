      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2032772310",
      "Source": "A regurgitated pellet of undigested owl food. Sought after for its high concentration of plant nutrients, experienced farmers often use these as a replacement for conventional fertilizer.",
      "Trans": {"SC":"未消化的猫头鹰反刍物。由于其具有极高的营养价值, 经验丰富的农民经常使用它们替代传统肥料。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3219741904",
      "Source": "A reinforced wooden door that provides entrance to structures. Can be locked for security.",
      "Trans": {"SC":"木头加工而成的加固门, 可以安放在门框上。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::80237061",
      "Source": "A saddle for your Diplodocus. It has ten seats! Bring lots of friends!",
