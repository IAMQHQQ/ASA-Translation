    },
    {
      "NamespaceHash": "GraphLiteral::185141482",
      "Source": "Enables Creatures not on a flier's \"team\" (Tribe or Ally) to stand on the flier platform. Otherwise, they slide off.",
      "Trans": {"SC":"启用后, 将允许非己方单位停留在平台鞍上。否则, 他们将从平台鞍上滑落。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::954142767",
      "Source": "Enables Players to create their own recipes and cook custom foods using the recipes.",
      "Trans": {"SC":"使玩家可以创建自己的食谱, 并使用食谱烹饪定制食物。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2734609796",
      "Source": "Enables Spike Walls to damage wild and riderless Creatures.",
      "Trans": {"SC":"启用拒马伤害野生和无人操控的恐龙。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2526665817",
      "Source": "Enables Tribes in PVE to declare war and fight one another for a specified length of time.",
      "Trans": {"SC":"PVE模式中允许部落宣战并在指定的时间内相互战斗。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2289330613",
      "Source": "Enables Tribes to cancel an agreed-upon war before it has actually started.",
      "Trans": {"SC":"允许部落在战争开始之前取消预定战争。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::4178580047",
      "Source": "Enables a permanent crosshair on the HUD.",
      "Trans": {"SC":"启用准星。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3219335888",
      "Source": "Enables a tamed Titanosaur to consume food in its inventory and stay alive (Titanosaur normally starves to death to prevent any Player or Tribe from owning it forever).",
      "Trans": {"SC":"允许被驯服的泰坦类恐龙允许进食(通常情况泰坦类恐龙都会被饿死, 为了防止玩家或部落永久的拥有它。)","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2218619297",
      "Source": "Enables an RPG-style pop-up text to appear, displaying damage numbers.",
      "Trans": {"SC":"启用类似RPG风格的弹出文本, 显示伤害数值。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1742863907",
      "Source": "Enables building in caves when PvE mode is enabled.",
      "Trans": {"SC":"PVE模式中允许洞穴中建造。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3701286844",
      "Source": "Enables everyone to \"take care\" of a baby Creature (including cuddling), not just the Player character who imprinted the Baby.",
      "Trans": {"SC":"允许其他玩家帮助完成留痕任务, 而不是只有认养的玩家才能进行留痕。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::277170302",
      "Source": "Enables flying Creatures to be allowed into caves (fliers are able to go into caves by default on custom maps)",
      "Trans": {"SC":"允许飞行生物在洞穴骑乘的功能(在自定义地图上, 飞行生物默认允许在洞穴骑乘)。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::1002475003",
      "Source": "Enables hardcore mode (Players revert to level 1 upon death).",
      "Trans": {"SC":"启用硬汉模式(玩家死后需要重新创建角色)","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3141005025",
      "Source": "Enables local manipulation of gamma settings during PVP (could allow unfair advantages at night).",
      "Trans": {"SC":"启用在PVP中对伽玛设置进行本地调整(可能导致在夜间获得不公平的优势)。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2605058674",
      "Source": "Enables switching at real-world (server-side) times. Requires \"Use Timer\" to be On",
      "Trans": {"SC":"启用根据实际世界(服务器端)时间进行切换。需要打开“使用定时器”。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::32696305",
      "Source": "Enables switching from PvE to PvP mode at pre-specified in-game times.",
      "Trans": {"SC":"在预先指定的游戏时间时, 启用可以从PVE切换到PVP模式。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3624857891",
      "Source": "Enables the \"Initial Time Of Day\" setting.",
      "Trans": {"SC":"启用“初始时间”设置。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::661092616",
      "Source": "Enables the Creative Mode button in pause menu.",
      "Trans": {"SC":"在暂停菜单中显示建造模式的按钮。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3874091419",
      "Source": "Enables the ability to level movement speed in Players and Creatures.",
      "Trans": {"SC":"允许玩家和生物加移速点数。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::2102959964",
      "Source": "Enables the ability to level movement speed in flying Creatures (if Speed Leveling is enabled).",
      "Trans": {"SC":"启用飞行生物可加移速点数(如果启用允许加移速点数)。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3240646000",
      "Source": "Enables third-person view.",
      "Trans": {"SC":"允许第三人称视角。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3981025371",
      "Source": "Enables turrets and spikes to be built and operated on platform saddles.",
      "Trans": {"SC":"使炮台和拒马可以在平台鞍上建造和操作。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::3368228082",
      "Source": "End OSD Defense",
      "Trans": {"SC":"结束对轨道空投的防守","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "GraphLiteral::289683757",
      "Source": "Enemies Approaching!",
      "Trans": {"SC":"敌人接近了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
