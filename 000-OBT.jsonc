    {
      "NamespaceHash": "Content::39354829",
      "Source": "Provides heavy physical protection and reduced physical torpor, but provides almost no protection from the elements.",
      "Trans": {"SC":"具有极强的防御能力, 同时减少受到的眩晕效果, 但是几乎没有炎热和寒冷抗性。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::500544867",
      "Source": "Provides heavy physical protection, but makes the elements harder to endure.",
      "Trans": {"SC":"具有极强的防御效果, 但是几乎没有炎热和寒冷抗性。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3909079768",
      "Source": "Provides heavy physical protection, but makes the elements harder to endure. Comes with a built-in light source, which wears out over time.",
