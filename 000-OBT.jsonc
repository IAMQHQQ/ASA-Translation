      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::444566352",
      "Source": "A gigantic bola made of metal chain, capable of ensnaring larger creatures. Usable within a Ballista Turret.",
