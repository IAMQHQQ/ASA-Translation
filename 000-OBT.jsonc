    },
    {
      "NamespaceHash": "Content::2227041008",
      "Source": "Put food for your nearby pets in this, and they'll automatically eat it when hungry!",
      "Trans": {"SC":"将食物放入其中, 附近的生物在饥饿时会自动进食!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3428987402",
      "Source": "Put food for your nearby pets in this, and they'll automatically eat it when hungry! Can refridgerate items, so long as it's powered by a Tek Generator!",
      "Trans": {"SC":"将食物放入其中, 附近的生物在饥饿时会自动进食! 若有泰克发电机为其供能, 则还有延长腐腐坏时间的功能。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3617759404",
      "Source": "Put in water to start a pipe system.",
      "Trans": {"SC":"放入水中给你的水利系统供水","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2123055456",
      "Source": "Put it in a glass jar to drink it!",
      "Trans": {"SC":"装在玻璃瓶中来喝!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3715516116",
      "Source": "Put it on a wall, and look at your beautiful self!",
