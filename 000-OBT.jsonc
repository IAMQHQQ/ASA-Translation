      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1319402189",
      "Source": "A thick blob of unrefined sap.",
      "Trans": {"SC":"一团未精炼的稠密树脂。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3201364184",
      "Source": "A thick piece of skin, densely covered with heavy insulating fur. Carefully hacked from a dead animal.",
      "Trans": {"SC":"一块厚重有着浓密毛发的皮, 小心地从一个死的动物身上剥下来。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1819888319",
      "Source": "A thick piece of skin, hacked from a dead animal.",
      "Trans": {"SC":"一块从死去动物身上剥下来的厚皮。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::830502192",
      "Source": "A thick, sturdy cutting from a corrupted tree. Has all of the properties of a chunk of fungal wood!",
      "Trans": {"SC":"从腐化树木上砍下的硬物。性质与木头几乎一致!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::123499882",
