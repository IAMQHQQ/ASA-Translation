    {
      "NamespaceHash": "Content::4132789840",
      "Source": "Plant this in a viable large crop plot to grow a charge-infused plant, that will protect you against enemies and provide you with fruits!",
      "Trans": {"SC":"把它种植在大型耕地中会长出一株带有电荷的植物, 可以结出特殊的果实!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3906498355",
      "Source": "Plant this in a viable large crop plot to grow a frightening-looking defensive plant, which will shoot poisonous spores at any interlopers!",
      "Trans": {"SC":"把它种植在大型耕地中会长出一株看起来骇人且具有防御性的植物, 会对任何闯入者喷射有毒孢子!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::242136814",
      "Source": "Plant this in a viable tek crop plot to grow a tentacle plant, that can be harvested for cuts of Raw Fish Meat!",
      "Trans": {"SC":"将它种植在泰克耕地中会长出有青色条纹触手的植物, 可以采集出生鱼肉!","JA":""},
