    },
    {
      "NamespaceHash": "Content::1862177902",
      "Source": "If checked, this will prevent spawning of Loot crates (artifact creates will still spawn).",
      "Trans": {"SC":"勾选后, 将不会出现补给箱(不影响神器)。","JA":""},
