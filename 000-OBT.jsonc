    {
      "NamespaceHash": "Content::1150357220",
      "Source": "Attach to water pipes, and sit on it when you hear the call of nature. Do your business, feel refreshed, and then flush for efficient waste disposal!",
      "Trans": {"SC":"需要连接到水管。来体验一泄千里的畅通感吧!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2906682830",
      "Source": "Attaches to a large tree, enabling you to build on it!",
      "Trans": {"SC":"可安放在大树上并在其上面建造建筑!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
