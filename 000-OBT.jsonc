      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2504085863",
      "Source": "Track and kill a horde of Yutyrannuses on the prowl. Take them down before they get a chance to roar!",
      "Trans": {"SC":"追踪并杀死一群游荡着的羽王龙。在它们吼叫前解决掉它们!","JA":""},
