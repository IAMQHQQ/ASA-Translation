      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2860995954",
      "Source": "<RichColor Color=\"1.0, 0.4, 0.0\">Set Type:</>  <RichColor Color=\"1,0,0\">Ragnarok</><#RN#><#RN#><RichColor Color=\"1.0, 0.4, 0.0\">Set Bonuses:</><#RN#><RichColor Color=\"1.0, 0.4, 0.0\">2 Items:</> Gives <RichColor Color=\"1,1, 0 \">10%</> Increased attack power<#RN#><RichColor Color=\"1.0, 0.4, 0.0\">3 Items:</> Has <RichColor Color=\"1,1, 0 \">10%</> Chance to inflict burn damage on nearby dinosaurs<#RN#><RichColor Color=\"1.0, 0.4, 0.0\">Full Set:</> Has <RichColor Color=\"1,1, 0 \">15%</> Chance to summon a meteor strike on hit<#RN#><#RN#><#RN#><#RN#><RichColor Color=\"1.0, 0.4, 0.0\">Additional Stats</><#RN#>Speed increased by <RichColor Color=\"1,1, 0 \">3%</><#RN#>Health Regeneration per second: <RichColor Color=\"1,1, 0 \">6</><#RN#>Heat Insulation increased by <RichColor Color=\"1,1, 0 \">50%</><#RN#>Base attack damage increased by <RichColor Color=\"1,1, 0 \">500</><#RN#><#RN#><#RN#><RichColor Color=\"1.0, 0.4, 0.0\"> Special Effects</><#RN#>Jump height increased by <RichColor Color=\"1,1, 0 \">4%</><#RN#>Dodge Chance increased by <RichColor Color=\"1,1, 0 \">0.2%</><#RN#>Loot Chance increased by <RichColor Color=\"1,1, 0 \">0.5%</>",
      "Trans": {"SC":"<RichColor Color=\"1.0, 0.4, 0.0\">套装类型：</>  <RichColor Color=\"1,0,0\">Ragnarok</><#RN#><#RN#><RichColor Color=\"1.0, 0.4, 0.0\">套装增益：</><#RN#><RichColor Color=\"1.0, 0.4, 0.0\">2件：</> 获得 <RichColor Color=\"1,1, 0 \">10%</> 攻击强度提升<#RN#><RichColor Color=\"1.0, 0.4, 0.0\">3件：</> 有 <RichColor Color=\"1,1, 0 \">10%</> 几率对附近恐龙造成燃烧伤害<#RN#><RichColor Color=\"1.0, 0.4, 0.0\">全套：</> 有 <RichColor Color=\"1,1, 0 \">15%</> 几率在命中时召唤流星打击<#RN#><#RN#><#RN#><#RN#><RichColor Color=\"1.0, 0.4, 0.0\">额外属性</><#RN#>速度提升 <RichColor Color=\"1,1, 0 \">3%</><#RN#>每秒生命值回复： <RichColor Color=\"1,1, 0 \">6</><#RN#>隔热值提升 <RichColor Color=\"1,1, 0 \">50%</><#RN#>基础攻击伤害提升 <RichColor Color=\"1,1, 0 \">500</><#RN#><#RN#><#RN#><RichColor Color=\"1.0, 0.4, 0.0\"> 特殊效果</><#RN#>跳跃高度提升 <RichColor Color=\"1,1, 0 \">4%</><#RN#>闪避几率提升 <RichColor Color=\"1,1, 0 \">0.2%</><#RN#>战利品几率提升 <RichColor Color=\"1,1, 0 \">0.5%</>","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
