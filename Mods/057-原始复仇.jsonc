    },
    {
      "NamespaceHash": "Content::1696098173",
      "Source": "Created by mixing both Zinc+Copper<#RN#><#RN#>(Copper can be found by mining metal ores)<#RN#><#RN#>TIP: Copper can be mined with normal metal tools.",
      "Trans": {"SC":"由锌+铜混合制成\\n\\n（铜可通过挖掘金属矿石获得）\\n\\n提示：铜可用普通金属工具挖掘。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3727430018",
      "Source": "Created by mixing both Tin+Copper<#RN#><#RN#>(Both can be found by mining metal ores)<#RN#><#RN#>TIP: Need atleast brass tools to mine Tin ore",
      "Trans": {"SC":"由锡+铜混合制成\\n\\n（两者均可通过挖掘金属矿石获得）\\n\\n提示：至少需要黄铜工具才能挖掘锡矿","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1258517268",
      "Source": "Gold can be found from StarFire rock golems",
      "Trans": {"SC":"黄金可从星火岩石傀儡处获得","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3276790428",
      "Source": "Created by mixing both Nickel+Iron<#RN#><#RN#>(Nickel can be found from resource rock golems)<#RN#><#RN#>TIP: Need atleast Bronze tools to mine the Nickel",
      "Trans": {"SC":"由镍+铁混合制成\\n\\n（镍可从资源岩石傀儡处获得）\\n\\n提示：至少需要青铜工具才能挖掘镍。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::534949525",
      "Source": "Can be used to make special ingots",
      "Trans": {"SC":"可用于制作特殊锭","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2508267253",
      "Source": "Can be used to make special ingots, or used to tame resource golems!",
      "Trans": {"SC":"可用于制作特殊锭，或用于驯服资源傀儡！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2408401130",
      "Source": "Can be used to make High quality metals!",
      "Trans": {"SC":"可用于制作高品质金属！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::999150826",
      "Source": "Can be equipped in the Trophy slot within a dino.<#RN#><#RN#><#RN#>Can be further upgraded by applying Relic traits to it.",
      "Trans": {"SC":"可装备在恐龙的战利品栏中。\\n\\n\\n可通过施加圣物特质进一步升级。","JA":""},
