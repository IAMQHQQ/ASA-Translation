    },
    {
      "NamespaceHash": "Content::3177471825",
      "Source": "Challenger Mindset",
      "Trans": {"SC":"挑战者心态","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2444580059",
      "Source": "Inostrancevia deals 15% more damage to, and takes 15% less, from bosses, mission dinos, and alphas. Ino heals and gains increased XP after killing one. <#N#><#N#>CANNOT BE USED WITH OTHER MINDSET ABILITIES.",
      "Trans": {"SC":"狼蜥兽对首领、任务目标恐龙和精英生物造成的伤害提升 15%，受到的伤害降低 15%。击杀这类目标后，自身会恢复生命值并获得额外经验加成。<#N#><#N#>该心态无法与其他心态技能叠加。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::432772668",
      "Source": "Collector Mindset",
      "Trans": {"SC":"收集者心态","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2017897239",
      "Source": "Makes items weigh 30% less in the inventory of Inostrancevia. Black Pearls, Gems, Silica Pearls, Element Shards, Element Dust, and Mutagel are given a 3.5x harvest multiplier.<#N#><#N#>CANNOT BE USED WITH OTHER MINDSET ABILITIES.",
      "Trans": {"SC":"狼蜥兽背包内的物品重量降低 30%。采集黑珍珠、各类宝石、硅珍珠、元素碎片、元素粉尘和诱变凝胶时，收获倍率提升至 3.5 倍。<#N#><#N#>该心态无法与其他心态技能叠加。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2771359301",
      "Source": "Estute Mindset",
      "Trans": {"SC":"敏锐者心态","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4089434453",
      "Source": "Killing anything above 550 drag weight grants 1.5x xp for 5 minutes to self and allies. Killing an Alpha grants 2x XP for 30 minutes. Killing a boss grants 4x XP for an hour.<#N#><#N#>CANNOT BE USED WITH OTHER MINDSET ABILITIES.",
      "Trans": {"SC":"击杀拖拽重量超过 550 的生物后，自身与队友将获得 5 分钟 1.5 倍经验加成；击杀精英生物，可获得 30 分钟 2 倍经验加成；击杀首领生物，可获得 1 小时 4 倍经验加成。<#N#><#N#>该心态无法与其他心态技能叠加。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3609192597",
      "Source": "Frenzied Mindset",
      "Trans": {"SC":"狂怒者心态","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2426986636",
      "Source": "Makes Inostrancevia deal 25% more damage when above 75% HP. After dealing damage for a set amount of time, heal for a time.<#N#><#N#>CANNOT BE USED WITH OTHER MINDSET ABILITIES.",
      "Trans": {"SC":"狼蜥兽生命值高于 75% 时，造成的伤害提升 25%。持续造成伤害一段时间后，会进入持续回血状态。<#N#><#N#>该心态无法与其他心态技能叠加。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2821061059",
      "Source": "Ino Base Ability",
      "Trans": {"SC":"狼蜥兽基础能力","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2531918081",
      "Source": "THE INO IS POGGING?!",
      "Trans": {"SC":"这只狼蜥兽燃起来了？！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1631813541",
      "Source": "Survivor Mindset",
      "Trans": {"SC":"幸存者心态","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3389127441",
      "Source": "Upon killing any target, Inostrancevia takes 25% less damage and heals over time. <#N#><#N#>CANNOT BE USED WITH OTHER MINDSET ABILITIES.",
      "Trans": {"SC":"狼蜥兽击杀任意目标后，受到的伤害降低 25%，并进入持续回血状态。<#N#><#N#>该心态无法与其他心态技能叠加。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1776178813",
      "Source": "Traveler Mindset",
      "Trans": {"SC":"旅行者心态","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3181109158",
      "Source": "Makes Inostrancevia 25% faster overall, but reduces attack and defence by 15% each. <#N#><#N#>CANNOT BE USED WITH OTHER MINDSET ABILITIES.",
      "Trans": {"SC":"狼蜥兽全速度提升 25%，但攻击力与防御力各降低 15%。<#N#><#N#该心态无法与其他心态技能叠加。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3032537268",
      "Source": "Fertilized R-Diabloceratops Egg",
      "Trans": {"SC":"受精的 R-恶魔角龙蛋","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::870129176",
      "Source": "Fertilized Edmonto Egg",
      "Trans": {"SC":"受精的埃德蒙顿龙蛋","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3531407804",
      "Source": "Fertilized Epanterias Egg",
      "Trans": {"SC":"受精的依潘龙蛋","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1092287241",
      "Source": "Pet Food Kibble",
      "Trans": {"SC":"宠物饲料","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1329368923",
      "Source": "A simple, preserved type of kibble. Not an effective taming food, but an excellent, easy-to-make pet food to fill your troughs. Almost anything will eat it.",
      "Trans": {"SC":"一种制作简易的长效饲料。虽不适合用于驯服生物，但却是填充食槽的优质选择，制作便捷且几乎所有生物都会食用。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::942151300",
      "Source": "Strawberry Seed",
      "Trans": {"SC":"草莓种子","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2281433469",
      "Source": "Eat it to gain a tiny amount of nourishment, or plant it to grow your own Strawberry bush.  Can be planted in Small, Medium, or Large Crop Plots.",
      "Trans": {"SC":"食用可获得少量营养，也可种植培育出专属草莓丛，适用于小型、中型和大型耕地。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1834354037",
      "Source": "Fertilized Hadal Dragonfish Egg",
      "Trans": {"SC":"受精的深渊奇棘鱼卵","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3370009031",
      "Source": "Fertilized Eryops Egg",
      "Trans": {"SC":"受精的引螈蛋","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1885354233",
      "Source": "Anthracite",
      "Trans": {"SC":"无烟煤","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3010549713",
      "Source": "A dense, compact form of coal.You could use this in place of charcoal. Normally, this mineral can be found with Obsidian.",
      "Trans": {"SC":"一种质地致密坚硬的煤炭，可作为木炭的替代品。通常与黑曜石伴生。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::462933789",
      "Source": "A mineral known as a fuel source and highly valued. On the arks, Coal seems to often be found with Sulfur.You could use it in a similar manner as Sparkpowder",
      "Trans": {"SC":"一种极具价值的燃料矿产。在方舟大陆上，煤炭常与硫磺伴生，用途与火花粉类似。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1011968665",
      "Source": "Candlewax",
      "Trans": {"SC":"蜡烛蜡","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::696179588",
      "Source": "Some survivors have found the internal furnaces of Yangchuanosaurus and its natural processes perfect for making candle wax!",
      "Trans": {"SC":"部分幸存者发现，永川龙体内的体温循环系统，是提炼蜡烛蜡的绝佳天然工坊！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1003773463",
      "Source": "Hunt Point",
      "Trans": {"SC":"狩猎点数","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3924242520",
      "Source": "Signifies a significant kill for your Albertosaurus. Use it to unlock skills and features. ",
      "Trans": {"SC":"由阿尔伯托龙完成重大击杀后获得，可用于解锁新技能与新特性。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2768757794",
      "Source": "Hunt Point (Admin)",
      "Trans": {"SC":"狩猎点数（管理员专用）","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::370209249",
      "Source": "Digested Cementing Paste",
      "Trans": {"SC":"消化水泥膏","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1373571657",
      "Source": "Scorpiovenator's diet is aided by a complex and powerful digestive system. This Digestive system breaks down chitin and keratin into a paste-like slush that the animal then excretes. It's the exact same as cementing paste!",
      "Trans": {"SC":"蝎猎龙拥有一套强大复杂的消化系统，助力其高效消化食物。这套系统能将甲壳素与角蛋白分解为糊状物质并排出体外，产物与水泥膏完全一致！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1803800028",
      "Source": "Reward Crate: Wild Ark",
      "Trans": {"SC":"奖励补给箱：野性方舟","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::711635250",
      "Source": "\"You're doing well, survivor. The more things change, the more they stay the same.<#RN#><#RN#>If you see any of my people, give them a hand, would you? In the meantime, here: for your troubles and efforts.<#RN#><#RN#>Maybe we'll meet one day.<#RN#><#RN#>-H\"",
      "Trans": {"SC":"干得不错，幸存者。世事变迁，本质依旧。<#RN#><#RN#>若你遇见我的族人，还请伸出援手。这是给你的奖励，聊表谢意。<#RN#><#RN#>或许，我们会在某天相遇。<#RN#><#RN#>——H","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3889101219",
      "Source": "A powerful propellant. Necessary for any firearm or explosive.",
      "Trans": {"SC":"一种威力强劲的推进剂，是制造所有枪械与爆炸物的必备材料。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::997522477",
      "Source": "Sparkpowder Conversion.",
      "Trans": {"SC":"火花粉转化特性","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3135345112",
      "Source": "Yangchuannosaurus naturally creates Sparkpowder in its own inventory when it cannot gain access to sulfur in the wild: take advantage of this!",
      "Trans": {"SC":"当永川龙在野外无法获取硫磺时，会自动在背包内生成火花粉，好好利用这一特性！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3667662790",
      "Source": "Fragrant candle that when placed down and powered, provides a buff that increases crafting speed (not skill) by 4x and slightly increases exp rate.<#N#><#N#>Ineffective on \"large dinos\".",
      "Trans": {"SC":"一款芳香蜡烛，放置并充能后，可提供增益效果：制作速度提升 4 倍（不提升技能等级），经验获取速率小幅提高。<#N#><#N#>对大型恐龙无效。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3465146075",
      "Source": "Fragrant candle that when placed down and powered, provides a buff that slightly regenerates HP while also reducing food and water drain.<#N#><#N#>Ineffective on \"large dinos\".",
      "Trans": {"SC":"一款芳香蜡烛，放置并充能后，可提供增益效果：生命值小幅持续恢复，食物与水分消耗速度降低。<#N#><#N#>对大型恐龙无效。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
