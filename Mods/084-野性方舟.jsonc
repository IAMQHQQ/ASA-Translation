    },
    {
      "NamespaceHash": "Content::806862821",
      "Source": "Albert Base Ability",
      "Trans": {"SC":"阿尔伯托龙基础能力","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::66888024",
      "Source": "THE ALBERT IS POGGING?!",
      "Trans": {"SC":"这只阿尔伯托龙燃起来了？！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::670649749",
      "Source": "Skin: Dense Muscles",
      "Trans": {"SC":"皮肤特性：肌肉发达","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1660782634",
      "Source": "Passive ability. The muscles underneath Albertosaurus's skin experience profound growth. However, the skin above becomes thinner to allow these muscles to move.<#N#><#N#>-50% Resistance for +25% Movement Speed and +25% Melee Damage.<#N#><#N#>As a Skin ability, this cannot stack with Thick Skin or Thin Skin.",
      "Trans": {"SC":"被动技能。阿尔伯托龙皮下肌肉会大幅增生，为了让肌肉更好活动，表层皮肤会随之变薄。<#N#><#N#>效果：抗性降低 50%，移动速度提升 25%，近战伤害提升 25%。该皮肤特性无法与厚皮、薄皮特性叠加。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3539553621",
      "Source": "Ability: Feast",
      "Trans": {"SC":"技能：暴食盛宴","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::628671694",
      "Source": "Unlocks Albertosaurus's Feast ability. The primary bite will be able to gain a potent healing buff from harvesting corpses.",
      "Trans": {"SC":"解锁阿尔伯托龙的暴食盛宴技能。使用普通撕咬啃食尸体时，可获得强效治疗增益。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::415823321",
      "Source": "Ability: Crushing Bite",
      "Trans": {"SC":"技能：粉碎撕咬","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4276784088",
      "Source": "Unlocks Albertosaurus's Crushing Bite ability, which inflicts Bone Break. The attack becomes available on C (third attack).",
      "Trans": {"SC":"解锁阿尔伯托龙的粉碎撕咬技能，可触发骨折效果。该技能绑定 C 键释放（为第三攻击段）。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2915517909",
      "Source": "Ability: I Recognize This",
      "Trans": {"SC":"技能：我认得你","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3925382967",
      "Source": "Unlocks a... change to Albertosaurus's roar. The ability can be shifted on and off with O key.",
      "Trans": {"SC":"解锁阿尔伯托龙的咆哮变体效果，可通过 O 键开关该技能。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1322798404",
      "Source": "Ability: Shoulderbash",
      "Trans": {"SC":"技能：肩撞冲击","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2121940901",
      "Source": "Unlocks Albertosaurus's Shoulder Bash. Deals good damage for its size, while inflicting heavy knockback. The attack becomes available on jump bind. Provides a parry window during the shoulder bash itself. <#RN#><#RN#>If timed correctly, take 0 damage and reflect damage back to the attacker in the attack's damagetype. Calculation: (1/4 Damage you would've received) x Your Melee Stat, to a max of 2,250.",
      "Trans": {"SC":"解锁阿尔伯托龙的肩撞冲击技能。以其体型而言，该技能伤害可观且附带强力击退效果，绑定跳跃键释放。肩撞过程中会出现格挡判定窗口，<#RN#><#RN#>时机把握得当的话，可免疫本次伤害，并将伤害按原类型反弹给攻击者。伤害计算公式：（即将承受伤害的 1/4）× 自身近战属性值，最高反弹上限为 2250 点。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4184396320",
      "Source": "Ability: Swift Swim",
      "Trans": {"SC":"技能：迅捷泳姿","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2551562405",
      "Source": "Increases Albertosaurus's swimming speed by 25%",
      "Trans": {"SC":"阿尔伯托龙游泳速度提升 25%","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2570304812",
      "Source": "Skin: Thick Skin",
      "Trans": {"SC":"皮肤特性：厚皮","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3880237003",
      "Source": "Passive ability. The skin of the albertosaurus becomes thicker and more resistant to damage and stress. However, the excess weight makes movement a bit harder..<#RN#><#RN#>+25% Resistance and +25% Weight at the cost of -50% speed<#RN#><#RN#>As a Skin ability, this cannot stack with Thin Skin or Dense Muscles.",
      "Trans": {"SC":"被动技能。阿尔伯托龙的皮肤会增厚变硬，提升伤害抗性与负重能力，但额外的重量会拖累行动速度。<#RN#><#RN#>效果：抗性提升 25%，负重提升 25%，移动速度降低 50%。<#RN#><#RN#>该皮肤特性无法与薄皮、肌肉发达特性叠加。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::715155469",
      "Source": "Skin: Thin Skin",
      "Trans": {"SC":"皮肤特性：薄皮","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1480281894",
      "Source": "Passive ability. The skin of the albertosaurus becomes thinner, thus less effort needed to move. However, the loss of mass decreases strength for carry weight and resistance.<#N#><#N#>-25% Resistance and -25% weight for +50% movement speed.<#N#><#N#>As a Skin ability, this cannot stack with Thick Skin or Dense Muscles.",
      "Trans": {"SC":"被动技能。阿尔伯托龙的皮肤会变得纤薄，大幅降低行动负担，但身体防护力和负重能力也会随之下降。<#N#><#N#>效果：抗性降低 25%，负重降低 25%，移动速度提升 50%。<#N#><#N#>该皮肤特性无法与厚皮、肌肉发达特性叠加。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2439647263",
      "Source": "Strawberry",
      "Trans": {"SC":"草莓","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1852920290",
      "Source": "A familiar red berry, known for its juiciness and sweet taste. Better than normal berries for food. Herbivores might perk up if you used this somehow...",
      "Trans": {"SC":"一种常见的红色浆果，以多汁香甜著称，作为食物的效果优于普通浆果。食草生物或许会对它格外感兴趣……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::881235374",
      "Source": "Honey-Glazed Strawberry",
      "Trans": {"SC":"蜜汁草莓","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1361576216",
      "Source": "A strawberry, coated in sticky honey. A really sweet treat. Most critters eat it like a berry, but a certain creature of tropical locales might really like this...",
      "Trans": {"SC":"裹满粘稠蜂蜜的草莓，是绝佳的甜食。大部分生物都会将其当作浆果进食，但生活在热带地区的某类生物，或许会对它情有独钟……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1401694669",
      "Source": "A Worthy Challenge",
      "Trans": {"SC":"强者的试炼","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2043785800",
      "Source": "Use on your mount to initiate the taming process for Magnapaulia:<#N#><#N#>- Cannot be used on Carnivores, Flyers or Players<#N#>- Cannot dismount your creature during the process until Magnapaulia is downed.",
      "Trans": {"SC":"对坐骑使用，即可开启巨保罗龙的驯服流程。<#N#><#N#>注意：不可对肉食生物、飞行生物或玩家使用；驯服过程中需持续骑乘，直至大鸭龙被击晕，期间无法下马。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2524302994",
      "Source": "Crop Blend",
      "Trans": {"SC":"作物混合饲料","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1761004820",
      "Source": "A blend of crops and other resources.Due to the flavor and presentation, herbivores will go nuts over this.",
      "Trans": {"SC":"由各类作物与其他资源调配而成的饲料。凭借绝佳的风味与口感，能让食草生物为之疯狂。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2245304565",
