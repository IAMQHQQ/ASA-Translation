    {
      "NamespaceHash": "Content::3440579837",
      "Source": "Concussive Arrow",
      "Trans": {"SC":"震荡箭","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2856689402",
      "Source": "An arrow tipped with a small, ceramic grenade. The explosive cannot damage structures, but its great for concussive taming.<#N#><#N#>The grenade at the tip decreases flight time, making it inaccurate. However, it only hits once, meaning you cant accidentally damage a creature after knocking it out.",
      "Trans": {"SC":"箭头装有小型陶瓷手榴弹，爆炸不会对建筑造成损伤，非常适合眩晕驯服。<#N#><#N#>箭头的榴弹会缩短飞行时长，导致精准度下降。但它仅会触发一次命中，意味着击晕生物后不会意外对其造成额外伤害。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3100988463",
      "Source": "Fasolasuchus Loricatus Saddle",
      "Trans": {"SC":"法索拉鳄（AC）鞍","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3582559041",
      "Source": "Equip a Fasolasuchus Loricatus with this to ride it.",
      "Trans": {"SC":"给法索拉鳄（AC）装备此物，即可骑乘。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2366580717",
      "Source": "Erythrosuchus Combat Saddle",
      "Trans": {"SC":"引鳄战斗鞍","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::569496242",
      "Source": "Equip an Erythrosuchus with this to ride it. For a single rider and their brutish companion, helps better tap into combat.",
      "Trans": {"SC":"给引鳄装备此物，即可骑乘。专为单人骑手打造，能助力骑手与坐骑更好地投入战斗。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4924167",
      "Source": "Erythrosuchus Saddle",
      "Trans": {"SC":"引鳄鞍","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1281848039",
      "Source": "Equip an Erythrosuchus with this to ride it. The standard saddle fits two passengers! Bring friends!",
      "Trans": {"SC":"给引鳄装备此物，即可骑乘。这款标准鞍可容纳两名乘员，带上伙伴一起出发吧！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
