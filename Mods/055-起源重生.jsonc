      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3991216930",
      "Source": "Less deadly than other arrows, but rapidly increases the victim's Torpidity. Better then tranq arrows.",
      "Trans": {"SC":"比其他箭杀伤力小，但能快速增加受害者的麻醉值。比麻醉箭更好。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2188838361",
      "Source": "Less deadly than other arrows, but rapidly increases the victim's Torpidity and decrease food and speed. Better than tranq arrows.",
      "Trans": {"SC":"比其他箭杀伤力小，但能快速增加受害者的麻醉值并降低其食物值与速度。比麻醉箭更好。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3942557133",
      "Source": "A potent dart full of tranquilizing poison.",
      "Trans": {"SC":"装满麻醉毒药的强力飞镖。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2455356027",
      "Source": "Make you invisible for wild dino's. Use it to tame Alpha creatures",
      "Trans": {"SC":"让你对野生恐龙隐形。用它来驯服精英生物","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3093519962",
      "Source": "Improves armor rating and provides major heat and cold protection. These gloves doubles damage output and craft speed.",
      "Trans": {"SC":"提升护甲值并提供强效的冷热防护。这副手套能使伤害输出和制作速度翻倍。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3276620339",
      "Source": "Consume this to get your Reward",
      "Trans": {"SC":"消耗此物品以获取你的奖励","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4002704651",
      "Source": "Consume this to get Knight Armor Set",
      "Trans": {"SC":"消耗此物品以获取骑士护甲套装","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3965629616",
      "Source": "Instantly regenerates 100% health. Use it from your hotbar to heal your creature.",
      "Trans": {"SC":"立即恢复100%生命值。从快捷栏使用它来治疗你的生物。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::279364045",
      "Source": "Highly advanced boots capable of absorbing the impact of falling from high distances.<#N#>Does not require Element.",
      "Trans": {"SC":"高度先进的靴子，能吸收从高处坠落的冲击。<#N#>无需元素。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3124542612",
      "Source": "Highly advanced gauntlets that allow the wearer to perform devastating punches.<#N#>Does not require Element.",
      "Trans": {"SC":"高度先进的护腕，让穿戴者能打出毁灭性的拳击。<#N#>无需元素。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3316412898",
      "Source": "Never get lost again with the Tek Helmets night vision. Also provides a targeting mode that reveals other characters' positions, and infinite oxygen while underwater.<#N#>Does not require Element. Make you invisible for the wild dino's",
      "Trans": {"SC":"有了泰克头盔的夜视功能，再也不会迷路。还提供目标锁定模式，能显示其他角色的位置，且水下无限氧气。<#N#>无需元素。让你对野生恐龙隐形","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3173821949",
      "Source": "Highly advanced leggings that allow for powerful forward movement.<#N#>Does not require Element.",
      "Trans": {"SC":"高度先进的护腿，能实现强力的前冲移动。<#N#>无需元素。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
