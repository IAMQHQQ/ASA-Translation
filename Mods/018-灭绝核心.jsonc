    {
      "NamespaceHash": "Content::167593158",
      "Source": "The One Being heard you, want to earn the title of a Honored One? Defeat him in his 10% form an _____ in order to get The Honored Title. Do you have what it takes? <RichColor Color=\"1,0,0,1\">EndGame Boss.</>",
      "Trans": {"SC":"永恒真神已感知到你，是否想荣获尊者之名？击败一成战力形态的它即可解锁尊者称号，你是否具备这份实力？<RichColor Color=\"1,0,0,1\">终局 BOSS</>","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2220452088",
      "Source": "Protien Jar",
      "Trans": {"SC":"饱腹剂","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2975247645",
      "Source": "Need a Dino to consume bunch of food after a hard fight? Baby just finished raised but want it to have full stomach. Make them consume this!",
      "Trans": {"SC":"恐龙战后急需大量进食、幼龙养大后想要饱腹，均可使用此物","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3653886507",
      "Source": "Alpha Karkinos will most of the time leave you alone with this consumption. Effect lasts 10 minutes.",
      "Trans": {"SC":"使用后精英巨蟹大多不会主动攻击你，效果持续十分钟","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3941000347",
      "Source": "Ultimate Horvath Vial",
      "Trans": {"SC":"终极霍瓦斯药剂","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3285748942",
      "Source": "This lasts for 15 minutes,once consumed you will have the courage to take on Ultimate Horvath to get him to join your tribe.<#RN#>",
      "Trans": {"SC":"效果持续十五分钟，服用后可挑战终极霍瓦斯并将其收服入部落","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1332815320",
      "Source": "Fertilized Alpha Xiphactinus Egg",
      "Trans": {"SC":"受精的精英剑射鱼卵","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1888040723",
      "Source": "Warcheif Yuto Vial",
      "Trans": {"SC":"战争酋长悠斗元药剂","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::609005026",
      "Source": "This lasts for 15 minutes,once consumed you will have the courage to take on Warcheif of Extinction Core to get him to join your tribe.<#RN#>",
      "Trans": {"SC":"效果持续十五分钟，服用后可挑战灭绝核心战争酋长并将其收服入部落","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
