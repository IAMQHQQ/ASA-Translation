    {
      "NamespaceHash": "Content::1385180233",
      "Source": "Shiny Essence",
      "Trans": {"SC":"闪光精华","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2315555004",
      "Source": "Feed this to a dino to turn it into a Shiny!<#RN#><#RN#>Only the same or related species will eat it, and only if it is not a Shiny of a conflicting type!",
      "Trans": {"SC":"将此喂给恐龙即可使其变为闪光形态！仅相同或近缘物种会食用，且该恐龙不能是冲突类型的闪光个体！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2728289687",
      "Source": "Raw Shiny Essence",
      "Trans": {"SC":"原生闪光精华","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3790711016",
      "Source": "The raw essence of a powerful Shiny Dino. It can be used to harvest the essence of lesser Shiny Dinos.",
      "Trans": {"SC":"强大闪光恐龙的原生精华。可用于提取次级闪光恐龙的精华。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3707888123",
      "Source": "Shiny Spear Bolt",
      "Trans": {"SC":"闪光矛矢","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2560739887",
      "Source": "A range version of the Shiny! Prod.<#RN#><#RN#>Load it into a Harpoon and shoot a wild Shiny Dino with this to unlock its essence, but beware, it'll greatly anger it. Kill it to extract its essence before the effect wears off. Note that only special Shiny Dinos are affected by this.<#RN#><#RN#>Extracted essences can be applied to other tamed dinos of the same species.",
      "Trans": {"SC":"闪光刺针（远程版）装入鱼叉后向野生闪光恐龙发射，可解锁其精华 —— 但请注意，这会使其大幅激怒。需在效果消失前将其击杀以提取精华。<#RN#>注：仅特殊闪光恐龙会受此影响。提取的精华可应用于同物种的其他已驯服恐龙。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3177460620",
      "Source": "Shiny Essence Prod",
      "Trans": {"SC":"闪光精华刺针","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2208797729",
      "Source": "Prod a wild Shiny Dino with this to unlock its essence, but beware, it'll greatly anger it. Kill it to extract its essence before the effect wears off. Note that only special Shiny Dinos are affected by this.<#RN#><#RN#>Extracted essences can be applied to other tamed dinos of the same species.",
      "Trans": {"SC":"用此刺击野生闪光恐龙即可解锁其精华 —— 但请注意，这会使其大幅激怒。需在效果消失前将其击杀以提取精华。<#RN#>注：仅特殊闪光恐龙会受此影响。提取的精华可应用于同物种的其他已驯服恐龙。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
