      "Source": "Created by grinding Sand with Cactus Sap. ",
      "Trans": {"SC":"由沙子和仙人掌汁研磨而成。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::985433236",
      "Source": "Home Sweet Home",
      //buffname
      "Trans": {"SC":"温馨的家","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1720544228",
      "Source": "When home safe and sound, will keep the owner  refreshed and well fed. As well as giving a small boost in weight carrying.",
      "Trans": {"SC":"当玩家满血状态在家时, 它能让玩家精神焕发、饮食无忧, 还能小幅提升玩家的负重能力。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
