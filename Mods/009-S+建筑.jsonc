    },
    {
      "NamespaceHash": "Content::3611485045",
      "Source": "<RichColor Color=\"#00FFFF\">Cybers Structures</>\r\n\r\nA large bin for converting thatch and dung into high-quality fertilizer.",
      "Trans": {"SC":"<RichColor Color=\"#00FFFF\">Cybers Structures</>\r\n\r\n用于将茅草和粪便转化为优质肥料的箱子。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
