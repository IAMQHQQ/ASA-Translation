      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1352115338",
      "Source": "<RichColor Color=\"#00FFFF\">Cybers Structures</>\r\n\r\nUpon use, this potion bestows a magical allure that makes cats instantly and eternally affectionate toward you.",
      "Trans": {"SC":"<RichColor Color=\"#00FFFF\">Cybers Structures</>\r\n\r\nUpon use, this potion bestows a magical allure that makes cats instantly and eternally affectionate toward you.","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2022692217",
      "Source": "<RichColor Color=\"#00FFFF\">Cybers Structures</>\r\n\r\nDrink this tonic to forget everything you have learned (does not reset your Engram Points). Usable once every 24 hours.",
      "Trans": {"SC":"<RichColor Color=\"#00FFFF\">Cybers Structures</>\r\n\r\n使用它可以让你忘记所学之物(不会重置你的印记点数)。24小时内只能使用一次。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
