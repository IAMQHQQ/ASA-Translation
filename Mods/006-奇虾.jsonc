  "Additions Ascended: Anomalocaris": [
    {
      "NamespaceHash": "Content::2262940722",
      "Source": "Anomalocaris",
      "Trans": {"SC":"奇虾","JA":"奇蝦"},
      "Config": {"Item":false,"Dino":true,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2482176816",
      "Source": "Alpha Anomalocaris",
      "Trans": {"SC":"精英奇虾","JA":"精英奇蝦"},
      "Config": {"Item":false,"Dino":true,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3874934773",
      "Source": "Anomalocaris Pheromone",
      "Trans": {"SC":"奇虾信息素","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::152150295",
      "Source": "Eating this will make Anomalocaris ignore you. Maybe a few pieces of Chitin Armor will make you indistuingishable to them?...",
      "Trans": {"SC":"吃了这个会让奇虾忽略你，但也许几件甲壳素盔甲就能让他们认不出你了？","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2035837702",
      "Source": "Anomalocaris Saddle",
      "Trans": {"SC":"奇虾鞍","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::318067003",
      "Source": "Equip an Anomalocaris with this to ride it.",
      "Trans": {"SC":"装备到奇虾上以骑乘。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::100736001",
      "Source": "You can use this to skin the appearance of a helmet or hat. Provides a chef look. Bon Appétit!",
      "Trans": {"SC":"你可以用这个来改变头盔或帽子的外观皮肤，营造出厨师的摸样，祝你好胃口！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2496540675",
      "Source": "Anomalo Friend",
      "Trans": {"SC":"奇虾之友","JA":"奇蝦之友"},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3904798407",
      "Source": "The Anomalo pheremone is making Anomalocaris non-hostile to you!",
      "Trans": {"SC":"使用了奇虾信息素.奇虾现在对你没有敌意!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::428542661",
      "Source": "An Anomalo has poisoned you!",
      "Trans": {"SC":"奇虾让你中毒了!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2836025253",
      "Source": "Anomalo has gained some damage resistance!",
      "Trans": {"SC":"奇虾获得了一些伤害抗性!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3821094005",
      "Source": "Shrimp Buzzed",
      "Trans": {"SC":"虾之躁动","JA":"蝦之躁動"},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2760461863",
      "Source": "Most of the benefits of your standard beer, with an additional 3x XP boost!",
      "Trans": {"SC":"具备你平常所喝啤酒的大部分增益，另外还能获得3倍的经验值提升！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2058177746",
      "Source": "Dino Chef Hat",
      "Trans": {"SC":"恐龙厨师帽","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3571153372",
      "Source": "You can use attach this to a saddle to provide a chef look. Bon Appétit!",
      "Trans": {"SC":"你可以把这个附在鞍上，营造出厨师的模样。祝你好胃口！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::865981873",
      "Source": "Chibi-Alpha Anomalocaris",
      "Trans": {"SC":"袖珍-精英奇虾","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1201302654",
      "Source": "Chibi-Anomalocaris",
      "Trans": {"SC":"袖珍-奇虾","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2955967350",
      "Source": "Chibi-Chef Crevette",
      "Trans": {"SC":"袖珍-厨师奇虾","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4223997762",
      "Source": "Anomalo Cocktail",
      "Trans": {"SC":"奇虾鸡尾酒","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2385967746",
      "Source": "A deliciously devilish drink topped with tasty Alpha Anomalo meat. Yummy! Consuming this will give an XP bonus for a time!",
      "Trans": {"SC":"一款美味又独特的饮品，上面点缀着美味的精英奇虾肉，好吃！饮用此饮品能在一段时间内获得经验值加成！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2553420379",
      "Source": "Alpha Anomalo meat",
      "Trans": {"SC":"精英奇虾肉","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1074689060",
      "Source": "Chunky, shrimpy meat from an Alpha Anomalo. Feeding this to your own Anomalocaris can channel their inner hunter...",
      "Trans": {"SC":"来自精英奇虾的大块虾肉，将其喂给你自己的奇虾，能激发它们内心的猎手本能…","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2107764354",
      "Source": "You must own `Additions Ascended: Anomalocaris` before you can use this item!",
      "Trans": {"SC":"在你能够使用这件物品之前,你必须先拥有'Additions Ascended: Anomalocaris'!","JA":""},
