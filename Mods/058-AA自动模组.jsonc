    },
    {
      "NamespaceHash": "Content::2699059765",
      "Source": "Imprinting Kibble",
      "Trans": {"SC":"印记饲料","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2600366787",
      "Source": "Inject Bug Repellant into an ant hill to drive out its inhabitants. Be sure to have something to harvest the corpses!",
      "Trans": {"SC":"将驱虫剂注入蚁巢以驱赶其中的居民。务必准备好收集尸体的工具！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4059233774",
      "Source": "This is the Heart and Soul of Automated Ark. You need one of these in your base for the magic to happen! Put this in the center of your base. Be sure to enable auto-sorting AFTER you have set up your OCD storage! Don't say I didnt warn you!",
      "Trans": {"SC":"这是自动化方舟的核心与灵魂。你的基地需要一个这样的装置才能触发“魔法”！将它放在基地中央。务必在设置好OCD存储后再启用自动分类！别说我没警告过你！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::465111308",
      "Source": "Used to make growable resources and can be used to irrigate crops by snapping pipes to it.",
      "Trans": {"SC":"用于制造可种植资源，也可通过连接管道来灌溉作物。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::476233400",
      "Source": "Perfect for cooking meat in bulk, requires electricity. Refrigerates meat before and after cooking!",
      "Trans": {"SC":"非常适合大量烹饪肉类，需要电力。烹饪前后都会冷藏肉类！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2824899384",
      "Source": "Uses Healing Brews to heal dinos and players in range over time. Has auto pulling of brews. Will not heal if Daeodon is actively healing in the area. Range is rougly a 3.5 foundations radius from the structure. New model will show exact range when its ready. Only 1 can be placed in the effective area to prevent stacking of function.",
      "Trans": {"SC":"使用治疗药酒持续治疗范围内的恐龙和玩家。具备药酒自动抽取功能。若区域内有凶齿稀正在主动治疗，则不会生效。范围约为以装置为中心、3.5个地基半径的区域。新模型就绪后会显示精确范围。有效区域内仅能放置1个，以防止功能叠加。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3243901396",
      "Source": "Repairs everything in the inventory at the push of a button with automated pulling. Can also repair the damaged structrues in the area over time (admin adjustable timer). Must be in range of a console to function. Only 1 can be placed in the effective area to prevent stacking of function.",
      "Trans": {"SC":"按一下按钮即可修复背包中的所有物品，具备自动抽取功能。还能随时间修复区域内的受损结构（管理员可调整计时器）。必须在控制台范围内才能工作。有效区域内仅能放置1个，以防止功能叠加。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1864911695",
      "Source": "2 jars in a block of ice to store perishables in early game!",
      "Trans": {"SC":"早期游戏中，用冰块中的两个罐子存储易腐物品！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4233702454",
      "Source": "Puts poop in Dung Beetles, Collects Poop from ground and Thatch to make fertilizer. Pushes to Fertilizer Silo.",
      "Trans": {"SC":"将粪便放入屎壳郎，从地面收集粪便和茅草来制作肥料。推送至肥料仓。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::837325805",
      "Source": "Controls for the AA Helper Remote.",
      "Trans": {"SC":"AA辅助遥控器的控制装置。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3158796528",
      "Source": "Uses Electricity to make all recipes very quickly. Does NOT require a water source, and can be used as a water source. Must have Control Console nearby for pulling to function!",
      "Trans": {"SC":"使用电力快速制作所有配方。无需水源，且可作为水源使用。必须靠近控制控制台才能启用抽取功能！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::509818813",
      "Source": "Use this structure to set all nearby crop plot ranges and targetting.",
      "Trans": {"SC":"使用该结构设置所有附近作物田的范围和目标。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1067867093",
      "Source": "Store your perishables to preserve. Uses Electricity to make cooked meat into jerky!",
      "Trans": {"SC":"存储易腐物品以保鲜。使用电力将熟肉制成肉干！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2528451477",
      "Source": "Gathers eggs from the ground and places them inside the bin. Option to Gather Fertilized Eggs in Radial Menu. Greatly Increases Spoil timers.",
      "Trans": {"SC":"从地面收集蛋并放入箱中。径向菜单中有收集受精蛋的选项。大幅延长腐坏时间。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2192680986",
      "Source": "Use this to save your current engram layout to relearn them when you mindwipe! Once you have learned the engrams you want, hit \"Save Engrams\" then once you mindwipe and level back up, simply walk up to the structure and \"Restore Engrams\"",
      "Trans": {"SC":"用这个保存你当前的印痕布局，以便洗点后重新学习！一旦学会了你想要的印痕，点击“保存印痕”，然后当你洗点并重新升级后，只需走到该结构前点击“恢 痕”即可。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::229362728",
      "Source": "Collects Fertilizer from AA:: Compost Bin and Distributes it EVENLY to all crop plots, even modded.",
      "Trans": {"SC":"从AA:: 堆肥箱收集肥料，并均匀分配给所有作物田，包括模组添加的。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::411071805",
      "Source": "Gives insulation to nearby fertilized eggs to hatch them easilly and makes you cozy.",
      "Trans": {"SC":"为附近的受精蛋提供保温，使其易于孵化，还能让你感到舒适。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::349089144",
      "Source": "Gives large increase to spoil timers for all consumables plus Organic Polymer, Leech Blood, and Wyvern Milk! Must have Control Console nearby for OCD Pulling to function!",
      "Trans": {"SC":"大幅延长所有消耗品以及有机聚合物、水蛭血和飞龙奶的腐坏时间！必须靠近控制控制台才能启用OCD抽取功能！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1629364086",
      "Source": "Eat it to gain a tiny amount of nourishment, or plant it to grow your own Aggreavic Mushroom.  Can be planted in Small, Medium, or Large Crop Plots.",
      "Trans": {"SC":"食用可获得少量营养，或种植以培育自己的狂怒蘑菇。可种植在小型、中型或大型作物田中。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4178494431",
      "Source": "Eat it to gain a tiny amount of nourishment, or plant it to grow your own Aquatic Mushrooms.  Can be planted in Small, Medium, or Large Crop Plots.",
      "Trans": {"SC":"食用可获得少量营养，或种植以培育自己的水生蘑菇。可种植在小型、中型或大型作物田中。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1786596450",
      "Source": "Eat it to gain a tiny amount of nourishment, or plant it to grow your own Ascerbic Mushroom.  Can be planted in Small, Medium, or Large Crop Plots.",
      "Trans": {"SC":"食用可获得少量营养，或种植以培育自己的酸蚀蘑菇。可种植在小型、中型或大型作物田中。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::432849778",
      "Source": "Eat it to gain a tiny amount of nourishment, or plant it to grow your own Auric Mushroom.  Can be planted in Small, Medium, or Large Crop Plots.",
      "Trans": {"SC":"食用可获得少量营养，或种植以培育自己的金耀蘑菇。可种植在小型、中型或大型作物田中。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
