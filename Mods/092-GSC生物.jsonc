      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::502804205",
      "Source": "Depressed",
      "Trans": {"SC":"意志消沉","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::670377795",
      "Source": "The guy failed in the duel and felt extremely depressed.",
      "Trans": {"SC":"该生物决斗失败，陷入极度消沉。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3328209889",
      "Source": "Found tamed carnivore,so became stronger.",
      "Trans": {"SC":"发现已驯服的食肉生物，因此获得强化。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3708717746",
      "Source": "Attract it to attack you(No Flyer).It will be excited.Over time, it will be tired.If now its health below 15%, you can tame it.",
      "Trans": {"SC":"吸引它攻击你（飞行生物无效），它将会进入亢奋。随时间推移它会疲惫，当其生命值低于 15% 时即可驯服。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3868697247",
      "Source": "Refreshing Oxygen",
      "Trans": {"SC":"清新氧气","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::266270868",
