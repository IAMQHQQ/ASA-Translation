      "Source": "Cozy",
      "Trans": {"SC":"舒适状态","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2084981953",
      "Source": "Increased your speed and health recovery rate, reduced stamina consumption rate.",
