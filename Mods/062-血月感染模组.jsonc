    },
    {
      "NamespaceHash": "Content::1645065423",
      "Source": "Turns Target into Splitter Zombie",
      "Trans": {"SC":"将目标转化为分裂僵尸","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2050809792",
      "Source": "Rot-Blocker Serum",
      "Trans": {"SC":"腐坏阻断血清","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4254584990",
      "Source": "Barely holds the virus at bay. Might take several doses to slow the rot. Use recklessly, and the sickness will only grow stronger. Also cures lesser diseases.",
      "Trans": {"SC":"勉强抑制病毒。可能需要多剂才能减缓腐坏。肆意使用的话，病情只会加重。也可治愈轻度疾病。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::904080846",
      "Source": "Rot-Purging Serum",
      "Trans": {"SC":"腐坏净化血清","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1952089545",
      "Source": "Stronger than the weak stuff, this serum burns out the rot hiding beneath the skin. Powerful enough for most infections—but risk remains. Use care, or the virus fights back harder. Also cures lesser diseases.",
      "Trans": {"SC":"比那些弱效的东西更强，这种血清能灼烧皮下隐藏的腐坏。足以应对大多数感染——但加特林仍在。小心使用，否则病毒会更猛烈地反扑。也可治愈轻度疾病。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2161894947",
      "Source": "Panacea-Z610",
      "Trans": {"SC":"万灵药-Z610","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1994713303",
      "Source": "The holy grail of cures. Panacea-Z610 can drag a fully turned corpse back to the living, but the process is violent, unpredictable, and not always… complete. Handle with extreme care. Also cures lesser diseases.",
      "Trans": {"SC":"治愈的圣杯。万灵药-Z610能将完全转化的尸体拉回生者之列，但过程剧烈、不可预测，且并不总是……完整。极度小心处理。也可治愈轻度疾病。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::453067593",
      "Source": "Zombie Tumor",
      "Trans": {"SC":"僵尸瘤","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3497871633",
      "Source": "Will infect you if consumed!",
      "Trans": {"SC":"食用会感染你！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1523337049",
      "Source": "Blood Moon:Contagion Mod Menu",
      "Trans": {"SC":"血月：传染模组菜单","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
