    {
      "NamespaceHash": "Content::2581754190",
      "Source": "Volatile Zombie Tumor",
      "Trans": {"SC":"挥发性僵尸肿瘤","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1396724459",
      "Source": "Very Potent and will infect you if consumed! ",
      "Trans": {"SC":"效力极强，食用会感染你！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3323804352",
      "Source": "Rot-Cleanse Vial",
      "Trans": {"SC":"腐坏净化瓶","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3273336473",
      "Source": "A rare and powerful vial capable of stripping the rot from deep within the body. It’s the closest thing to a true cure—though even this miracle can backfire in careless hands. Also cures lesser diseases.",
      "Trans": {"SC":"一种稀有且强大的瓶子，能清除体内深层的腐坏。这是最接近真正治愈的东西——尽管即使是这种奇迹在粗心的人手中也会适得其反。也可治愈轻度疾病。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3626235868",
      "Source": "Radioactive Zombie Tumor",
      "Trans": {"SC":"放射性僵尸瘤","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
