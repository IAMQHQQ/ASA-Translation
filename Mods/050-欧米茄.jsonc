{
  "欧米茄": [//2025.11.30文本更新过于频繁qwq等以后稳定再更新吧
    {
      "NamespaceHash": "Content::3322510115",
      "Source": "Newbie",
      "Trans": {"SC":"新手","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::812046567",
      "Source": "Omega Protection Forcefield",
      "Trans": {"SC":"Omega-力场护盾","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2603362897",
      "Source": "Generates a forcefield that makes all structures within unable to be damaged.",
      "Trans": {"SC":"生成一个力场, 使内部所有建筑都无法被损坏。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3285699268",
      "Source": "Omega Glider Suit",
      "Trans": {"SC":"Omega-滑翔翼","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1152269305",
      "Source": "Omega Egg Collector",
      "Trans": {"SC":"Omega-蛋类收集器","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2568910111",
      "Source": "Place this near your dinos to collect any eggs that are dropped on the ground. It will not collect eggs for wild dinos! This will also prevent all eggs from spoiling.\\n\\nThe Egg Collector can integrate female dinos into it. The dino will be destroyed, but the dino's egg type will be stored in the egg collector, being passively generated based on your server's egg laying rates settings. Dinos with a * at the start of their name will not populate on the list to be integrated.\\n\\nThe default egg laying timer is sped up, and automatically includes both mate boosting and Oviraptor bonus without the need for either.\\n\\nThis structure will automatically pick up fertilized eggs and incubate them. Fertilized egg pickup can be disabled using the multiwheel.\\n\\nEgg layer data is preserved if the egg collector is picked up by hand and will remain intact if you place the egg collector in another location.\\n\\nYou can place any other Omega Egg Collector or Egg Collector from my other mod into the inventory of an Omega Egg Collector to combine their egg layers!",
      "Trans": {"SC":"它会自动收集家养生物掉落在地上的全部蛋。此外还能为收集来的蛋保鲜。\\n\\nThe Egg Collector can integrate female dinos into it. The dino will be destroyed, but the dino's egg type will be stored in the egg collector, being passively generated based on your server's egg laying rates settings. Dinos with a * at the start of their name will not populate on the list to be integrated.\\n\\nThe default egg laying timer is sped up, and automatically includes both mate boosting and Oviraptor bonus without the need for either.\\n\\nThis structure will automatically pick up fertilized eggs and incubate them. Fertilized egg pickup can be disabled using the multiwheel.\\n\\nEgg layer data is preserved if the egg collector is picked up by hand and will remain intact if you place the egg collector in another location.\\n\\nYou can place any other Omega Egg Collector or Egg Collector from my other mod into the inventory of an Omega Egg Collector to combine their egg layers!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1580856653",
      "Source": "Omega Spyglass",
      "Trans": {"SC":"Omega-望远镜","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2538517518",
      "Source": "This spyglass is designed to help players get the information on dinos that they need.<#RN#>It is not designed to replace spyglass mods.",
      "Trans": {"SC":"该望远镜的设计专门用于帮助玩家获取目标生物的关键数据。<#RN#>并非设计为望远镜模组的替代品。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::637680245",
      "Source": "Omega Raft",
      "Trans": {"SC":"Omega-木筏","JA":""},
      "Config": {"Item":false,"Dino":true,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1125466458",
      "Source": "An alternative to the normal raft, this one has an inventory, can equip Raft Armor to improve its defenses, and has a custom slot for upgrades. <#N#><#N#>It is also more maneuverable, can sprint for double speed, and easier to control.",
      "Trans": {"SC":"作为常规木筏的替代版, 该载具配备储物舱, 可装载木筏装甲提升防御, 并设有专用升级插槽。 <#N#><#N#>同时具备更强的机动性，可进行两倍速冲刺，且操控更为简易。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3876161542",
      "Source": "Omega Altar",
      "Trans": {"SC":"Omega-祭坛","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1726644446",
      "Source": "An ancient altar used to summon powerful gods. <#N#><#N#>BE WARNED. Bosses summoned from this are intended to be raid Bosses. They should not be attempted without help. They are exponentially stronger and more dangerous than the variant gods and are capable of quickly wiping armies of Omegas.",
      "Trans": {"SC":"一座用于召唤强大神灵的古老祭坛。<#N#><#N#>BE WARNED.警告: 通过此祭坛召唤的Boss均为世界级Boss。不建议在无团队协作的情况下挑战。相较普通变种神灵, 可迅速歼灭整支Omega战力的军团, 其强度与危险性呈指数级增长。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1463359868",
      "Source": "Omega Stamina Potion",
      "Trans": {"SC":"Omega-耐力药水","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::467712821",
      "Source": "This potion will restore 12% Stamina per second for 30 seconds.",
      "Trans": {"SC":"此药水每秒恢复12%的耐力, 持续30秒。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1697636102",
      "Source": "Omega Health Potion",
      "Trans": {"SC":"Omega-生命药水","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::258883118",
      "Source": "This potion will restore 12% health per second for 30 seconds.",
      "Trans": {"SC":"此药水每秒恢复12%的生命值, 持续30秒。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2831166343",
      "Source": "Omega Laser",
      "Trans": {"SC":"Omega-激光器","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::891092793",
      "Source": "An incredibly effective Resource Soul powered harvesting tool that utilizes an energy beam to collect valuable resources and murder resource dinos at distance.",
      "Trans": {"SC":"由资源灵魂供能的超效采集装置, 通过能量光束远程收集珍贵资源并歼灭资源型生物。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::729397852",
      "Source": "Omega Item Fragmenter",
      "Trans": {"SC":"Omega-物资粉碎器","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1404020687",
      "Source": "Grind up Unique and Set Items as well as Magic Charms into fragments used specifically on those items.",
      "Trans": {"SC":"可将独特装备、套装物品及魔法护符粉碎处理, 生成专用于对应物品的分解碎片。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3892681579",
      "Source": "Omega Beacon",
      "Trans": {"SC":"Omega-信标","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2225885983",
      "Source": "Sacrifices souls to lure in wild creatures to kill or tame. Placing the beacon in the water will summon various water creatures. Sacrificing 100 souls in the beacon will summon a Boss creature, required for progression.<#N#><#N#>WARNING: DO NOT PLACE THIS NEAR YOUR BASE.<#N#>The beacon destroys structures within a 20-foundation range when used. <#N#><#N#>World Bosses can be spawned onto a Beacon by enabling them in the radial wheel. This wil turn the beacon's beam red, and allow Titans and Lucky Gods to spawn in on the beacon when their timers expire. Timers can be viewed in the Guide.",
      "Trans": {"SC":"通过献祭灵魂引诱野生生物, 供玩家猎杀或驯服。将信标置于水域可召唤各类水生生物。累计献祭100个灵魂将召唤推进游戏进程所需的Bosses级生物。<#N#><#N#>警告: 切勿在基地附近部署。<#N#>使用时会摧毁20地基单位半径范围内的所有建筑。<#N#><#N#>通过轮盘菜单启用世界Bosses召唤功能, 可在信标处生成世界Bosses。该操作将使信标光束转为红色, 当计时器归零时, 泰坦和幸运神会在信标处生成。计时器可在指南中查看。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3342399877",
      "Source": "Protects you from the weather, by making you nearly immune to hot and cold.",
      "Trans": {"SC":"通过使你几乎免疫炎热和寒冷，保护你免受天气影响。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2553998468",
      "Source": "Gravity Potion",
      "Trans": {"SC":"重力药水","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3594111400",
      "Source": "Increases the effect of gravity on you 10-fold.<#N#>You will also sink in water.",
      "Trans": {"SC":"将你所受的重力影响增强10倍, 若你在水中则会下沉。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3715241564",
      "Source": "Wake-Up Potion",
      "Trans": {"SC":"唤醒药水","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3359195008",
      "Source": "This potion will instantly wake up any sleeping player. For creatures, it will restore 10% of their maximum torpor per second.",
      "Trans": {"SC":"这种药水会立即唤醒任何玩家。也可为恐龙减少每秒10%的最大眩晕值。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2758025947",
      "Source": "Anti-Gravity Potion",
      "Trans": {"SC":"反重力药水","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::559294104",
      "Source": "Reduces the effect of gravity on you by 80%.",
      "Trans": {"SC":"将你所受的重力影响减少80%。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2943485037",
      "Source": "Delta Stamina Potion",
      "Trans": {"SC":"Delta耐力药水","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3912480409",
      "Source": "This potion will restore 2% Stamina per second for 30 seconds.",
      "Trans": {"SC":"此药水每秒恢复2%的耐力, 持续30秒。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3688220743",
      "Source": "Delta Health Potion",
      "Trans": {"SC":"Delta生命药水","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1891133406",
      "Source": "This potion will restore 2% health per second for 30 seconds.",
      "Trans": {"SC":"此药水每秒恢复2%的生命值, 持续30秒。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1023859750",
      "Source": "Basic Sedative",
      "Trans": {"SC":"Basic麻醉药","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2151275435",
      "Source": "These powerful sedatives provide 2x the torpor of Narcotics.",
      "Trans": {"SC":"麻醉效果相当于普通麻醉药物的2倍。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3792005062",
      "Source": "Kibble Machine",
      "Trans": {"SC":"饲料加工台","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::159918421",
      "Source": "A machine to craft and store all of your kibble. Will keep them from spoiling.",
      "Trans": {"SC":"可制作并存储各类饲料, 具备永久防腐效果。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::591489898",
      "Source": "Knockout Club",
      "Trans": {"SC":"击晕棒","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3710338458",
      "Source": "A more effective club. Cheap, great at dealing torpor, and with a 6% chance of stunning the target.",
      "Trans": {"SC":"一种强化型棍棒, 造价低廉, 眩晕积累极强, 且有6%概率直接击晕目标。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3314901467",
      "Source": "Imbue Workbench",
      "Trans": {"SC":"附魔工作台","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4089439216",
      "Source": "Upgrade your Ark items with Essences from Ark Omega.<#N#>Allows random RNG based modifiers to be added to your items that can grant them bonus resistances, damage, armor, durability, etc.",
      "Trans": {"SC":"使用方舟Omega的精华以升级你的方舟物品。<#N#>可为物品附加随机属性, 如额外抗性、伤害、护甲、耐久等。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4156328618",
      "Source": "Spiritual Potion",
      "Trans": {"SC":"灵体药水","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3791944175",
      "Source": "Makes you ignore weight and stamina, and move faster, for a full 3 minutes.",
      "Trans": {"SC":"可令你无视负重与耐力, 移速提升, 效果持续3分钟。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1833617523",
      "Source": "Multi-Tool",
      "Trans": {"SC":"万象工具","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1992884846",
      "Source": "A multi-tool able to function as a Pick, Hatchet, Sickle, and Club. <#RN#>Use the toggle attachment button to toggle between modes. <#RN#><#RN#>Not only bypasses the damage reduction on Resource variants, but deals double damage to them. This can make the Multi-Tool in club mode an extremely effective way to KO low tier Resource creatures.",
      "Trans": {"SC":"此多功能工具可充当镐、斧、镰、棍使用。<#RN#>使用切换形态按钮可在模式间转换。<#RN#><#RN#>不仅能无视资源变体的伤害减免, 更可对其造成双倍伤害。 因此, 切换至棍棒形态的万象工具, 堪称快速击溃低阶资源生物的利器。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3120944801",
      "Source": "Getaway Orb",
      "Trans": {"SC":"脱身宝珠","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3671749015",
      "Source": "An orb that is used to summon a Spiritual mount to get you out of a bad situation. The mount cannot be used for combat, and will disappear when dismounted or out of render range.<#N#><#N#>The mount lasts 30 seconds, with a 60 second total cooldown.<#N#><#N#>Permanent item, cannot be broken and is not consumed on use.",
      "Trans": {"SC":"可召唤灵体坐骑助你脱离险境。此坐骑无法用于战斗, 离体或超出渲染距离即消。<#N#><#N#>坐骑持续30秒, 总冷却时间60秒。<#N#><#N#>可无限次使用。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::216771790",
      "Source": "Psychosis Grenade",
      "Trans": {"SC":"狂乱手雷","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2507510739",
      "Source": "While it deals low damage, it will also enrage everything in the explosion radius, forcing them to attack eachother.",
      "Trans": {"SC":"伤害虽低, 但却能使范围内所有目标陷入狂乱无差别攻击。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2917325611",
      "Source": "Unstable Water",
      "Trans": {"SC":"不稳定水源","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2511082040",
      "Source": "Instantly restores all water, but may cause other side effects. Can be used as an infinite water source in the Soul Furnace and for Farming variants to water crops.",
      "Trans": {"SC":"瞬间补满水分, 但可能引发随机副作用。可在灵魂炉中作无限水源, 亦可灌溉耕作模块作物。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::213529657",
      "Source": "Stoneskin Potion",
      "Trans": {"SC":"石肤药水","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2748187929",
      "Source": "Grants you stoneskin for 60 seconds, giving you 75% damage reduction.",
      "Trans": {"SC":"使你获得石肤效果, 持续60秒, 并提供75%的伤害减免。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3467053462",
      "Source": "Siren Potion",
      "Trans": {"SC":"海妖之歌药水","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::731373982",
      "Source": "Makes nearby enemies go passive and wander towards you for a short time.",
      "Trans": {"SC":"使附近敌人进入被动状态并短暂游荡至你身边。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::757648107",
      "Source": "Rampage Potion",
      "Trans": {"SC":"狂暴药水","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3175967107",
      "Source": "Sends you into a Rampage, increasing damage done and reducing damage taken by the same % for a short time.",
      "Trans": {"SC":"使用后使你进入狂暴状态, 短时间内按相同百分比提升造成的伤害并减少受到的伤害。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1912789353",
      "Source": "Quantum Compactor",
      "Trans": {"SC":"量子压缩器","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::583831118",
      "Source": "Items placed in the Quantum Compactors inventory can be smashed to infinitely small, no longer taking up inventory space.<#N#><#N#>Similar to Dedicated Storage, but able to hold an almost limitless number of different item types.<#N#><#N#>Will not be able to compact any item that has custom data stored on it.",
      "Trans": {"SC":"放置在量子压缩机物品栏中的物品可被压缩至无限小, 不再占用物品栏空间<#N#><#N#>类似于专用存储物柜, 但可容纳几乎无限种类的不同物品。<#N#><#N#>无法压缩任何带有自定义数据的物品。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2237246720",
      "Source": "Soul Compressor",
      "Trans": {"SC":"灵魂压缩机","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::28947614",
      "Source": "A storage unit able to compress and cache various souls into itself, taking up no inventory space.<#N#><#N#>Cached souls are able to be pulled out using a Soul Magnet.<#N#><#N#>Picking this up will retain all souls EXCEPT Paragon souls, so remove them first!",
      "Trans": {"SC":"一种可将多种灵魂压缩并缓存至内部的存储装置, 且不占用背包空间。<#N#><#N#>缓存的灵魂可通过灵魂磁石(Soul Magnet)提取。<#N#><#N#>拾取此装置时将保留除完美(Paragon)灵魂外的所有灵魂, 因此需提前移除它们!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1663003856",
      "Source": "Standing Hades Torch",
      "Trans": {"SC":"立式冥王火炬","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4011952116",
      "Source": "A tall version of the Hades Torch used to provide permanent heat and light.",
      "Trans": {"SC":"冥王火炬的立式版本, 用于提供永久的热量与光源。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1775376616",
      "Source": "Crafting Potion",
      "Trans": {"SC":"制作药水","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::731569331",
      "Source": "Using this doubles your current Crafting Skill.",
      "Trans": {"SC":"使用后可使你当前的制作技能翻倍。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3509113287",
      "Source": "Magic Find Potion",
      "Trans": {"SC":"魔法寻觅药水","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::735251755",
      "Source": "Use this to gain 100% Magic Find for 90 seconds.",
      "Trans": {"SC":"使用后获得100%魔法寻获率, 持续90秒。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::814237589",
      "Source": "Endless Magic Find Potion",
      "Trans": {"SC":"无尽魔法寻觅药水","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2917664068",
      "Source": "Use this to gain 100% Magic Find.<#N#><#N#>Lasts until death.<#N#><#N#>Does not work outside of the No-Tame game mode.",
      "Trans": {"SC":"使用后可获得100%魔法寻获率。<#N#><#N#>效果持续至死亡。<#N#><#N#>仅在“禁止驯服”游戏模式下生效。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3332128832",
      "Source": "Endless Spiritual Potion",
      "Trans": {"SC":"无尽灵体药水","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3752382784",
      "Source": "Makes you ignore weight and stamina, and move faster.<#N#><#N#>Lasts until death.<#N#><#N#>Does not work outside of the No-Tame game mode.",
      "Trans": {"SC":"使你无视重量与耐力消耗, 并加快移动速度。<#N#><#N#>效果持续至死亡。<#N#><#N#>仅在“禁止驯服”游戏模式下生效。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3156221780",
      "Source": "Endless Fortitude Potion",
      "Trans": {"SC":"无尽坚韧药水","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::864762775",
      "Source": "Protects you from the weather, by making you nearly immune to hot and cold.<#N#><#N#>Lasts until death.<#N#><#N#>Does not work outside of the No-Tame game mode.",
      "Trans": {"SC":"通过使你近乎免疫高温与寒冷, 抵御天气伤害。<#N#><#N#>效果持续至死亡。<#N#><#N#>仅在“禁止驯服”游戏模式下生效。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2930527864",
      "Source": "Ethereal Spear",
      "Trans": {"SC":"缥缈之矛","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4294274453",
      "Source": "A spear imbued with Ethereal power. Cannot be broken, can be infinitely thrown, and isn't effected by gravity. Thrown damage will scale with melee damage.",
      "Trans": {"SC":"一把被注入缥缈之力的长矛。不会损坏, 可无限投掷, 且不受重力影响。投掷伤害会随近战伤害的提升而相应增加。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1587203020",
      "Source": "Hades Torch",
      "Trans": {"SC":"冥王火炬","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1762515999",
      "Source": "A torch imbued with the mythical power of Hades. Greatly increased light radius, damage, and is unbreakable.  <#RN#><#RN#>The light can be toggled on/off.<#RN#>PC: Toggle Attachment (N)<#RN#>XBOX: X<#RN#>PS5: Square",
      "Trans": {"SC":"一个拥有冥王哈德斯神话力量的火炬, 给与极大的伤害与照明, 无耐久。<#RN#><#RN#>灯光开关切换。<#RN#>PC: N<#RN#>XBOX: X<#RN#>PS5: 方框","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2198814871",
      "Source": "Vacuum Grenade",
      "Trans": {"SC":"真空手雷","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3388029984",
      "Source": "This grenades create a poweful vacuum capable of gathering resources from a massive area. Right click (Alt-Fire) to switch between Pick and Hatchet modes.<#N#><#N#>Pick - Blue<#N#>Hatchet - Yellow",
      "Trans": {"SC":"一个能产生强大的真空场的手雷。可大面积区域收集资源。点击右键 (次要攻击) 可在「镐模式」和「斧模式」间切换。<#N#><#N#>镐模式 - 蓝色<#N#>斧模式 - 黄色","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::369762157",
      "Source": "Warp Bow",
      "Trans": {"SC":"弯曲弓","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1272587959",
      "Source": "A bow surging with Cosmic power. Projectiles fired from this bow instantly warp to their target, with no gravity drop or delay. Can be fired underwater. Uses Knockout Arrows.<#RN#><#RN#>Weapon may need to be re-equipped if switching from an empty ammo type. <#RN#><#RN#>Ammo type can be cycled:<#RN#>PC: Toggle Attachment (N)<#RN#>XBOX: X<#RN#>PS5: Square",
      "Trans": {"SC":"一把拥有天体力量的弓, 可在水下发射, 发射出的弓箭不受重力影响, 需装配击晕箭(Knockout Arrow)。<#RN#><#RN#>若从空弹药类型切换, 可能需要重新装备该武器。<#RN#><#RN#>弹药切换操作:<#RN#>PC: N<#RN#>XBOX: X<#RN#>PS5: 方框","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1615956998",
      "Source": "Boomstick",
      "Trans": {"SC":"爆炸木棒","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3740473742",
      "Source": "A club capable of area explosions, dealing damage in a wide area. The fuse must be lit on the Boomstick in order for it to be able to explode during attack.<#RN#><#RN#>To light the fuse:<#RN#>PC: Toggle Attachment (N)<#RN#>XBOX: X<#RN#>PS5: Square",
      "Trans": {"SC":"一根能够引发区域爆炸的棍棒，可在广泛范围内造成伤害。攻击前需要在木棒上点燃导火索才能使其爆炸。<#RN#><#RN#>点燃导火索操作:<#RN#>PC: N<#RN#>XBOX: X<#RN#>PS5: 方框","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1964778238",
      "Source": "Dimensional Storage",
      "Trans": {"SC":"次元储物箱","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1558910907",
      "Source": "A storage container able to hide a vast number of things in a separate dimension.<#N#><#N#>Place the items inside that you want to store there and press Save, and the Void Vacuum will automatically send those items to that container.",
      "Trans": {"SC":"一种能连接次元空间的储物箱。<#N#><#N#>将物品放入其中, 然后点击保存按钮, “虚无真空”会自动将这些物品发送到该容器。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4225763650",
      "Source": "Scroll Storage",
      "Trans": {"SC":"蓝图存放书架","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2990496633",
      "Source": "A structure designed to store all of your blueprints. <#N#><#N#>The void vacuum can be toggled on to automatically send all blueprints it grabs into your scroll storage.",
      "Trans": {"SC":"一个用于存储所有蓝图的建筑。<#N#><#N#>可以使用“虚无真空”自动分配蓝图到各个蓝图存放书架里。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::783846083",
      "Source": "Pygmy Armor",
      "Trans": {"SC":"矮小盔甲","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3250267460",
      "Source": "Place this on any Pygmy dino to provide them with some protection",
      "Trans": {"SC":"将这个放置在任意一只矮小恐龙身上, 为它们提供一定的保护。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1100440710",
      "Source": "Unstable Steak",
      "Trans": {"SC":"不稳定牛排","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::499021139",
      "Source": "Instantly restores all food, but may have other side effects.",
      "Trans": {"SC":"可立即恢复所有食物, 但可能存在其他副作用。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1211911741",
      "Source": "Phantom",
      "Trans": {"SC":"幻影斧","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3671428612",
      "Source": "The ghost of an infamous deadly hatchet. Curses enemies on attack, making them take more damage.<#N#><#N#>Can only be equipped at night.",
      "Trans": {"SC":"一把恶名昭著的致命短斧之魂。攻击时诅咒敌人, 使其受到更多伤害。<#N#><#N#>只能在夜晚装备。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4103469401",
      "Source": "An old Sickle infused with the powers of Nature. Icicle deals Ice damage, and is capable of quickly freezing enemies.",
      "Trans": {"SC":"一把注入自然之力的古老镰刀。可造成寒冰伤害, 且能快速冻结敌人。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2008715178",
      "Source": "Unique Totem",
      "Trans": {"SC":"独特的图腾","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3505338573",
      "Source": "Store Unique Items Here.<#N#><#N#>Place one of these near a Void Vacuum, and it will automatically send all Unique items directly to it.",
      "Trans": {"SC":"在此存储独特(Unique)物品。<#N#><#N#>将此物品放置在“虚无真空”附近, 它会自动将所有独特物品直接传送至“虚无真空”中。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1564627437",
      "Source": "Set Item Mannequin",
      "Trans": {"SC":"人体模型","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3836215757",
      "Source": "Designate a specific set for your mannequin, and the void vacuum will send all of that set here.<#N#><#N#>Equip a full set to your mannequin, and see the visual bonuses!",
      "Trans": {"SC":"为你的模型设置预定套装后, “虚无真空”会将该套装的所有物品传送至此处。<#N#><#N#>为你的展示架穿戴完整套装, 即可查看外观特效!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1121685281",
      "Source": "Craptivator",
      "Trans": {"SC":"Omega-马桶","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3395533122",
      "Source": "This captivating container of crap can be used to brew up some interesting items. <#N#><#N#>Careful, you don't always know what will crawl out of it.",
      "Trans": {"SC":"这个马桶可用于酿造一些稀奇的物品。<#N#><#N#>但要小心, 你不知道里面可能会爬出什么东西来!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2827460759",
      "Source": "Fortune",
      "Trans": {"SC":"暴击刀","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3706227692",
      "Source": "A golden gilded sword of Luck and Power.<#N#><#N#>There is a 25% chance to crit for double damage.",
      "Trans": {"SC":"一把蕴含幸运与力量的镀金黄铜剑。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::298132114",
      "Source": "Infinity Stone",
      "Trans": {"SC":"压重石","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1564794371",
      "Source": "This item has infinite weight in a dino inventory, causing them to be weighed down and unable to move",
      "Trans": {"SC":"这个物品在恐龙的物品栏中具有无限大重量, 会使它们被压得无法移动。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3600253932",
      "Source": "Dimensional Dumpster",
      "Trans": {"SC":"次元垃圾桶","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1575639228",
      "Source": "A container that can be filled by the vacuum with items you want to destroy.<#N#><#N#>Place the items inside that you want to store there and press Save, and the Void Vacuum will automatically send those items to that container. Press the Dump button to remove them from the game.",
      "Trans": {"SC":"可使用虚空吞纳之力, 将你欲毁之物尽数收存。<#N#><#N#>将你想存入的物品放入其中并按下保存, “虚无真空”会自动将这些物品传送至该容器。按下倾倒按钮即可将它们从游戏中移除。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::180828866",
      "Source": "Dimensional Grinder",
      "Trans": {"SC":"次元粉碎机","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3329917929",
      "Source": "A storage container able to grind any items inserted into it. <#N#><#N#>Place the items inside that you want to store there and press Save, and the Void Vacuum will automatically send those items to that container.",
      "Trans": {"SC":"一种可粉碎任何放入其中的物品的存储容器。<#N#><#N#>将需要存储的物品放入其中并按下“保存”按钮，“虚无真空”会自动将这些物品传送至该容器。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3595455968",
      "Source": "Nature Resistance Potion",
      "Trans": {"SC":"自然抗性药水","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1406327832",
      "Source": "This potion will reduce all nature damage taken by 75% for 30 seconds.",
      "Trans": {"SC":"此药水可降低所受到的自然伤害减少75%, 持续30秒。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::431124769",
      "Source": "Reliquary",
      "Trans": {"SC":"圣骨箱","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3887638439",
      "Source": "Place this structure to capture your killed tames! \\n\\nAny tame above basic tier will lose a tier before being instantly trapped in a cryopod and sent to the Reliquary when killed. If the tame is basic tier, the tame will be lost when killed!\\n\\nOnly one Reliquary per tribe can be placed.",
      "Trans": {"SC":"部署此装置可捕获被击杀的驯养生物!\\n\\n任何Basic等级以上的驯养生物被击杀时, 将降低一个等级后立即封存至冷冻舱, 并传送至遗物储藏库。若驯养生物为Basic等级, 被击杀时将永久消失!\\n\\n每个部落仅能部署一个遗物储藏库。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2776487873",
      "Source": "Delta Sedative",
      "Trans": {"SC":"Delta麻醉药","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::606698281",
      "Source": "These powerful sedatives provide 4x the torpor of Narcotics.",
      "Trans": {"SC":"麻醉效果相当于普通麻醉药物的4倍。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2436194643",
      "Source": "Gamma Health Potion",
      "Trans": {"SC":"Gamma生命药水","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1443851235",
      "Source": "This potion will restore 3% health per second for 30 seconds.",
      "Trans": {"SC":"此药水每秒恢复3%的生命值, 持续30秒。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1859647784",
      "Source": "Gamma Stamina Potion",
      "Trans": {"SC":"Gamma耐力药水","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2615267843",
      "Source": "This potion will restore 3% Stamina per second for 30 seconds.",
      "Trans": {"SC":"此药水每秒恢复3%的耐力, 持续30秒。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2906228929",
      "Source": "Gamma Sedative",
      "Trans": {"SC":"Gamma麻醉药","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3078175852",
      "Source": "These powerful sedatives provide 8x the torpor of Narcotics.",
      "Trans": {"SC":"麻醉效果相当于普通麻醉药物的8倍。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1866873166",
      "Source": "Knockout Arrow",
      "Trans": {"SC":"Basic一阶击晕箭","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1367279476",
      "Source": "An arrow infused with Basic Essence.<#RN#>Base Damage: 10<#RN#>Initial Torpor: 60<#RN#>Torpor Over 5 Seconds: 30<#RN#>Total Torpor Potential: 90<#RN#><#RN#>Numbers are multiplied by Weapon Quality %.<#RN#>Numbers are multiplied by 1.75 for Compound Bow.<#RN#>Numbers are multiplied by 1.35 for Crossbow and Warp Bow.",
      "Trans": {"SC":"一支注入了Basic精华的箭<#RN#>基础伤害: 10<#RN#>初始眩晕值: 60<#RN#>5秒内附加眩晕值: 30<#RN#>单次眩晕总量: 90<#RN#><#RN#>数值会根据武器品质百分比进行乘算。<#RN#>使用复合弓数值: x1.75<#RN#>使用十字弩数值: 1.35<#RN#>使用弯曲弓数值: 1.35","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1567832548",
      "Source": "Cursed Idol",
      "Trans": {"SC":"诅咒神像","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2357580298",
      "Source": "Curse your items. Do it.",
      "Trans": {"SC":"放入要诅咒物品吧。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1065579390",
      "Source": "Red Dwarf",
      "Trans": {"SC":"红星","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::851465717",
      "Source": "A small red star that can be placed to provide 300% greenhouse effect to nearby crop plots.<#RN#><#RN#>Can be upgraded with the Blue Star module crafted in the Soul Grinder to increase it to 600% greenhouse effect.",
      "Trans": {"SC":"一颗小红星, 放置后可为附近的作物种植区提供300%的温室效应。<#RN#><#RN#>可通过在灵魂分解机中制作的蓝星模块进行升级, 将温室效应提升至600%","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4038618850",
      "Source": "Wake-Up Dart",
      "Trans": {"SC":"唤醒镖","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2641769532",
      "Source": "A dart laced with a powerful stimulant. Will instantly wake up a player, and restore 10% max torpor per second to dinos.",
      "Trans": {"SC":"一支含有强效兴奋剂的飞镖, 可以立即唤醒一名被击晕的玩家, 也可为恐龙减少每秒10%的最大眩晕值。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
