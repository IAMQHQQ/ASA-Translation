    },
    {
      "NamespaceHash": "Content::1580479333",
      "Source": "This potion will restore 9% Stamina per second for 30 seconds.",
      "Trans": {"SC":"此药水每秒恢复9%的耐力, 持续30秒。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1858553642",
      "Source": "Omega Workbench",
      "Trans": {"SC":"Omega-工作台","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4055094415",
      "Source": "Craft most of Ark Omega's items here!",
      "Trans": {"SC":"方舟欧米伽的大部分物品都在这里制作!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::778877968",
      "Source": "Versatile Slingshot",
      "Trans": {"SC":"多功能弹弓","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2458947477",
      "Source": "A slingshot with the versatility of firing multiple types of projectiles for various effects. An excellent go-to weapon in a pinch.<#N#><#N#>Press R to cycle ammunition types.<#N#><#N#>Stone - Low Damage and Torpor<#N#>Metal - Medium Damage and Torpor<#N#>Obsidian - High Damage and Torpor<#N#>Crystal - High Damage Piercing<#N#>Human Feces - Low Damage, Blind, Slow",
      "Trans": {"SC":"一把可发射多种弹药的弹弓。危急时刻的应急首选武器。<#N#><#N#>按R键可选择切换弹药类型。<#N#><#N#>石头: 低伤害+眩晕<#N#>金属: 中伤害+眩晕<#N#>黑曜石: 高伤害+眩晕<#N#>水晶: 高伤害+穿透<#N#>人类粪便: 低伤害+致盲+缓速","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2883698660",
      "Source": "Basic Health Potion",
      "Trans": {"SC":"Basic生命药水","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::459371417",
      "Source": "This potion will restore 1% health per second for 30 seconds.",
      "Trans": {"SC":"此药水每秒恢复1%的生命值, 持续30秒。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2077912951",
      "Source": "Gathering Sickle",
      "Trans": {"SC":"采集镰刀","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1651384921",
      "Source": "A primitive Sickle used for harvesting fiber and chopping berries off of bushes and shrubs. Works as a fast paced version of hand-gathering.<#N#><#N#>Not very effective in combat.",
      "Trans": {"SC":"一把用于采集纤维以及收割浆果的原始镰刀, 其作用相当于快速版的手工采集。<#N#><#N#>战斗效果欠佳。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1245531800",
      "Source": "Basic Stamina Potion",
      "Trans": {"SC":"Basic耐力药水","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2118458167",
      "Source": "This potion will restore 1% Stamina per second for 30 seconds.",
      "Trans": {"SC":"此药水将每秒恢复1%的耐力, 持续30秒。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1069121000",
      "Source": "Suicide Potion",
      "Trans": {"SC":"自杀药水","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1285812539",
      "Source": "Use this to get unstuck from a bad situation.",
      "Trans": {"SC":"可以用这个来摆脱困境。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2810313684",
      "Source": "Gathering Tool",
      "Trans": {"SC":"采集工具","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4187662289",
      "Source": "A stone tool made out of both a hatchet and pick. Harvests at the same rate as metal tools.<#RN#><#RN#>Tool mode can be cycled:<#RN#>PC: Toggle Attachment (N)<#RN#>XBOX: X<#RN#>PS5: Square",
      "Trans": {"SC":"由斧头和镐子制成的工具。采集效率与金属工具相同。<#RN#><#RN#>工具模式切换操作。<#RN#>PC: N<#RN#>XBOX: X<#RN#>PS5: 方框","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::949461791",
      "Source": "Net Gun",
      "Trans": {"SC":"网枪","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1852013213",
      "Source": "A small, net-launching gun used to ensnare targets for an extended period. Does not require ammo, and cannot be broken. <#N#><#N#>Can trap enemies 50% larger than a Bola, and is much easier to use.",
      "Trans": {"SC":"一种小型网状发射器, 可长时间困住目标。 无需弹药且无法被破坏。<#N#><#N#>可捕捉比流星锤大50%的敌人, 且操作更简便。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2057005072",
      "Source": "Reflect Shield",
      "Trans": {"SC":"反射盾","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1778636858",
      "Source": "An unbreakable shield that reflects 50% of damage back to the attacker.",
      "Trans": {"SC":"一种不可破坏的护盾, 可将50%的伤害反弹给攻击者。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4022943607",
      "Source": "Elemental Resistance Potion",
      "Trans": {"SC":"元素抗性药剂","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::829575737",
      "Source": "This potion will reduce all elemental damage taken by 75% for 30 seconds.",
      "Trans": {"SC":"饮用后30秒内, 承受的所有元素伤害降低75%。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2354353335",
      "Source": "Malice",
      "Trans": {"SC":"激怒之鞭","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3488622015",
      "Source": "A violent whip, that has a 10% chance to enrage the attacker enough to make everything in the area wants it dead.<#N#>Unbreakable.",
      "Trans": {"SC":"一种狂暴的鞭子, 有10%概率使目标陷入狂怒, 导致区域内所有生物对其产生致命敌意。<#N#>它不会损坏。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1405181265",
      "Source": "Summon Decoy",
      "Trans": {"SC":"召唤诱饵","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::309924450",
      "Source": "Using this will summon a decoy that will draw aggro of nearby dinos.",
      "Trans": {"SC":"使用后将召唤一个诱饵, 吸引附近恐龙的仇恨。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3570007514",
      "Source": "Immortality Potion",
      "Trans": {"SC":"金身药水","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2719752140",
      "Source": "Makes you Immortal for 15 seconds. <#N#>You cannot attack while Immortal.",
      "Trans": {"SC":"使你进入无敌状态, 持续15秒。<#N#>无敌状态下无法进行攻击。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1921871475",
      "Source": "Nightvision Potion",
      "Trans": {"SC":"夜视药水","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1645627194",
      "Source": "Gain the vision of Nightmare creatures for 3 minutes.",
      "Trans": {"SC":"使用后将获得梦魇生物的视觉能力, 持续3分钟。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3263931242",
      "Source": "Transmuter",
      "Trans": {"SC":"转换器","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3798635018",
      "Source": "This structure allows you to combine stat potions and essence together to take up less space. <#RN#><#RN#>This can combine one of each stat into all-stats, one of each allocation type into all-types, and more.<#RN#><#RN#>It can also upgrade essence to the next highest tier, at a rate of 10 essence for 1 essence of the next tier up.",
      "Trans": {"SC":"该装置允许你将属性药水与精华合成, 从而减少所占空间。<#RN#><#RN#>可将每种属性药水各1瓶合成为全属性药水, 每种分配类型的精华各1份合成为全类型精华, 还支持其它组合方式。<#RN#><#RN#>还能消耗10份当前等级精华, 获得1份下一等级精华。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::834679364",
      "Source": "Stormbringer",
      "Trans": {"SC":"风暴使者","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3362084738",
      "Source": "Swinging this around above your head will surround you in an elemental storm.<#N#><#N#>Hold R to choose Storm type.",
      "Trans": {"SC":"在头顶挥舞该武器可召唤环绕自身的元素风暴。<#N#><#N#>长按R键以选择风暴类型。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2436744828",
      "Source": "Healing!",
      "Trans": {"SC":"治愈!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::343330871",
      "Source": "You are regaining your health.",
      "Trans": {"SC":"你正在恢复生命值。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4129585924",
      "Source": "Alpha Essence",
      "Trans": {"SC":"精英精华","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1285534003",
      "Source": "Essence harvested from the Alpha Tier.\\nProvides 5 imbue rolls in the Imbue workbench.\\nReturns 3 Beta Essence in the Dimensional Grinder.",
      "Trans": {"SC":"从Alpha五阶生物上萃取的精华。\\n在附魔工作台中可提供5次附魔次数。\\n置于次元粉碎机中可被转化为3份Beta四阶精华。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3225391373",
      "Source": "Essence harvested from a Unique Group Master or equivalent Boss.\\nProvides 10 imbue rolls in the Imbue workbench.\\nReturns 3 Ultimate Essence in the Dimensional Grinder.",
      "Trans": {"SC":"从独特(Unique)Group Master或同级Boss生物上萃取的精华。\\n在附魔工作台中可提供10次附魔次数。\\n置于次元粉碎机中可被转化为3份Ultimate九阶精华。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::804695921",
      "Source": "Apex Essence",
      "Trans": {"SC":"Apex八阶精华","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1128602988",
      "Source": "Essence harvested from a Master or equivalent Boss.\\nProvides 8 imbue rolls in the Imbue workbench.\\nReturns 3 Prime Essence in the Dimensional Grinder.",
      "Trans": {"SC":"从Master或同级Boss生物上萃取的精华。\\n在附魔工作台中可提供8次附魔次数。\\n置于次元粉碎机中可被转化为3份Prime七阶精华。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2438280596",
      "Source": "Basic Essence",
      "Trans": {"SC":"Basic一阶精华","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4137011767",
      "Source": "Essence harvested from the Basic Tier.\\nProvides 1 imbue roll in the Imbue workbench.",
      "Trans": {"SC":"从Basic一阶生物上萃取的精华。\\n在附魔工作台中可提供1次附魔次数。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2072926530",
      "Source": "Beta Essence",
      "Trans": {"SC":"Beta四阶精华","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3788113281",
      "Source": "Essence harvested from the Beta Tier.\\nProvides 4 imbue rolls in the Imbue workbench.\\nReturns 3 Gamma Essence in the Dimensional Grinder.",
      "Trans": {"SC":"从Beta四阶生物上萃取的精华。\\n在附魔工作台中可提供4次附魔次数。\\n置于次元粉碎机中可被转化为3份Gamma三阶精华。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1534104805",
      "Source": "Delta Essence",
      "Trans": {"SC":"Delta二阶精华","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2645603167",
      "Source": "Essence harvested from the Delta Tier.\\nProvides 2 imbue rolls in the Imbue workbench.\\nReturns 3 Basic Essence in the Dimensional Grinder.",
      "Trans": {"SC":"从Delta二阶生物上萃取的精华。\\n在附魔工作台中可提供2次附魔次数。\\n置于次元粉碎机中可被转化为3份Basic一阶精华。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2200659432",
      "Source": "Elite Essence",
      "Trans": {"SC":"Elite六阶精华","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4053263568",
      "Source": "Essence harvested from the Elite Tier.\\nProvides 6 imbue rolls in the Imbue workbench.\\nReturns 3 Alpha Essence in the Dimensional Grinder.",
      "Trans": {"SC":"从Elite六阶生物上萃取的精华。\\n在附魔工作台中可提供6次附魔次数。\\n置于次元粉碎机中可被转化为3份Alpha五阶精华。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::283211368",
      "Source": "Endless Essence",
      "Trans": {"SC":"Endless十一阶精华","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4097079008",
      "Source": "Essence harvested from an Aspect or equivalent Boss.\\nProvides 11 imbue rolls in the Imbue workbench.\\nReturns 3 Ancient Essence in the Dimensional Grinder.",
      "Trans": {"SC":"从Aspect或同级Boss生物上萃取的精华。\\n在附魔工作台中可提供11次附魔次数。\\n置于次元粉碎机中可被转化为3份Ancient十阶精华。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::471468966",
      "Source": "Gamma Essence",
      "Trans": {"SC":"Gamma三精华","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4247863541",
      "Source": "Essence harvested from the Gamma Tier.\\nProvides 3 imbue rolls in the Imbue workbench.\\nReturns 3 Delta Essence in the Dimensional Grinder.",
      "Trans": {"SC":"从Gamma三阶生物上萃取的精华。\\n在附魔工作台中可提供3次附魔次数。\\n置于次元粉碎机中可被转化为3份Delta二阶精华。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1360876284",
      "Source": "Omega Essence",
      "Trans": {"SC":"Omega-十二阶精华","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3877861614",
      "Source": "Essence harvested from Zodiac or equivalent Boss.\\nProvides 12 imbue rolls in the Imbue workbench.\\nReturns 3 Endless Essence in the Dimensional Grinder.",
      "Trans": {"SC":"从Zodiac或同级Boss生物上萃取的精华。\\n在附魔工作台中可提供12次附魔次数。\\n置于次元粉碎机中可被转化为3份Endless十一阶精华。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1269394280",
      "Source": "Prime Essence",
      "Trans": {"SC":"Prime七阶精华","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3408731977",
      "Source": "Essence harvested from a Beacon Boss or equivalent Boss.\\nProvides 7 imbue rolls in the Imbue workbench.\\nReturns 3 Elite Essence in the Dimensional Grinder.",
      "Trans": {"SC":"从信标Boss或同级Boss生物上萃取的精华。\\n在附魔工作台中可提供7次附魔次数。\\n置于次元粉碎机中可被转化为3份Elite六阶精华。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1458989356",
      "Source": "Ultimate Essence",
      "Trans": {"SC":"Ultimate九阶精华","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::400961385",
      "Source": "Essence harvested from a Group Master or equivalent Boss.\\nProvides 9 imbue rolls in the Imbue workbench.\\nReturns 3 Apex Essence in the Dimensional Grinder.",
      "Trans": {"SC":"从Group Master或同级Boss生物上萃取的精华。\\n在附魔工作台中可提供9次附魔次数。\\n置于次元粉碎机中可被转化为3份Apex八阶精华。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3228575369",
      "Source": "Cosmic Soul",
      "Trans": {"SC":"寰宇灵魂","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3281711322",
      "Source": "Soul harvested from a Cosmic creature.<#N#><#N#>Its primary use is for crafting kibble, equipment, and potions.<#N#>Once unlocked, the Omega beacon can be used to sacrifice souls to attract wild creatures, or even Bosses.",
      "Trans": {"SC":"从寰宇系生物收集来的灵魂<#N#><#N#>其主要用途用于制作饲料, 装备和药水。<#N#>激活欧米伽信标后, 可通过献祭灵魂吸引野生生物乃至Bosses级生物降临。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3892206591",
      "Source": "Elemental Soul",
      "Trans": {"SC":"元素灵魂","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4067153954",
