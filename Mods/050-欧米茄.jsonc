    },
    {
      "NamespaceHash": "Content::3083958844",
      "Source": "Uses the powerful vacuum of space to draw in and hold any loose items dropped nearby. Will also collect items from bag drops.",
      "Trans": {"SC":"利用太空的强大真空吸力, 将附近掉落的物品及物品缓存包吸入到其中。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::163012441",
      "Source": "Soul Grinder",
      "Trans": {"SC":"灵魂分解机","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1391771146",
      "Source": "Grind Boss and God souls down to get the souls, essence, and soul shards from them.",
      "Trans": {"SC":"可通过分解Boss和God的灵魂, 以此来获取精华和灵魂碎片。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2024584415",
      "Source": "Soul Furnace",
      "Trans": {"SC":"灵魂炉","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::184003761",
      "Source": "A structure specifically designed to burn souls for heat. This Furnace has the ability to do the tasks of many other structures. It can cook meat, smelt metal, make jerky, gasoline, charcoal, and even sweet veggie cakes.<#N#><#N#>Burns Souls for energy. Can be upgraded with the Soul Furnace Intensifier crafted in the Soul Grinder to make everything craft instantly.",
      "Trans": {"SC":"一种以燃烧灵魂获取热能的建筑。集合了其它建筑的一些功能, 可用于烹饪, 熔炼, 风干, 甚至还能制作蔬菜蛋糕。<#N#><#N#>可通过在灵魂分解机中制作的灵魂炉增强器进行升级, 使所有制作过程能瞬间完成。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3304543696",
      "Source": "Undead Sword",
      "Trans": {"SC":"亡灵之剑","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1752380347",
      "Source": "A sword imbued with Nightmarish powers, it can both suck the life out of enemies when dealing damage, and return them as Zombies when killed.",
      "Trans": {"SC":"一把浸染梦魇之力的魔剑。可以在造成伤害时汲取敌人的生命, 且亡灵之力会附于被杀死的敌人尸身, 将其化为“僵尸”为我所用!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3373801531",
      "Source": "Cloner Staff",
      "Trans": {"SC":"克隆杖","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3594703462",
      "Source": "Hitting creatures with this tool will spawn clone for you.",
      "Trans": {"SC":"被该武器攻击的生物会复制一个克隆体为你所用。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2545530605",
      "Source": "Eggsecutioner",
      "Trans": {"SC":"蛋蛋枪","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2966203062",
      "Source": "A powerful weapon that fires unfertilized eggs for both damage and debuffs.",
      "Trans": {"SC":"这是一种强大的武器, 它发射未受精的蛋, 对敌人造成伤害并附加负面状态","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1034260248",
      "Source": "Eviscerator",
      "Trans": {"SC":"怨怒之刃","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1817583163",
      "Source": "Weapons of rage and hatred. <#N#><#N#>The more you attack, the faster you attack.",
      "Trans": {"SC":"怒恨与狂怒凝成的武器<#N#><#N#>连续攻击后会提升攻速。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3828346528",
      "Source": "Gravitron",
      "Trans": {"SC":"引力剑","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3835433496",
      "Source": "A blunt weapon made out of just the right amount of alloys and Anti-matter.<#N#><#N#>Left control (secondary melee attack) will cause Gravitron to pull enemies towards you.",
      "Trans": {"SC":"一把由适量合金与反物质打造的钝器。<#N#><#N#>按下左Ctrl键 (副近战攻击键) 可启动引力剑, 将敌人拉向玩家。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2358143039",
      "Source": "Heartsong",
      "Trans": {"SC":"天使之弓","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4069267523",
      "Source": "Not meant to be a damage dealer, this bow is purely for support.<#N#><#N#>Shooting allies will provide a small healing bonus.<#N#>Shooting enemies will Siren them.",
      "Trans": {"SC":"这把弓并非用于造成伤害, 它纯粹是为了提供支援<#N#><#N#>射击盟友将提供少量治疗加成。<#N#><#N#>射击敌人将对其施加海妖之歌(Siren)效果。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2525127995",
      "Source": "Golden Chest",
      "Trans": {"SC":"黄金宝箱","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2265663644",
      "Source": "A trophy fit for a master chest hunter!",
      "Trans": {"SC":"这是专为寻宝大师准备的战利品!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3055273962",
      "Source": "DPS Dummy",
      "Trans": {"SC":"伤害测试假人","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3200801822",
      "Source": "A dummy that is dino based and displays accurate DPS information from all sources, including headshot modifiers.",
      "Trans": {"SC":"这是一只恐龙造型的训练假人, 能精准显示包括爆头伤害加成在内的所有伤害来源的DPS数据。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2786434640",
      "Source": "Resource Collector",
      "Trans": {"SC":"资源采集器","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4119803746",
      "Source": "This structure lets you integrate tames from the Resource group (excluding Uniques and the Group Variant) in order to passively produce those resources. <#N#><#N#>The integrated resources will remain when picked up by hand.",
      "Trans": {"SC":"该建筑允许您整合资源组中的驯养生物 (不包括独特生物和群体变种), 以便被动地生产这些资源。<#N#><#N#>手动采集时, 已整合的资源将保留下来。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
