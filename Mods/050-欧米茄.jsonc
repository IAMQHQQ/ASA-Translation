      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2151089880",
      "Source": "Delta Metal Knockout Arrow",
      "Trans": {"SC":"Delta二阶金属击晕箭","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1846636124",
