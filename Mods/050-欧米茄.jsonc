    },
    {
      "NamespaceHash": "Content::1128170154",
      "Source": "An armor-piercing arrow infused with Gamma Essence.<#RN#>Base Damage: 260<#RN#>Initial Torpor: 1560<#RN#>Torpor Over 5 Seconds: 780<#RN#>Total Torpor Potential: 2340<#RN#><#RN#>Numbers are multiplied by Weapon Quality %.",
      "Trans": {"SC":"一支注入了Gamma精华的金属箭<#RN#>基础伤害: 260<#RN#>初始眩晕值: 1560<#RN#>5秒内附加眩晕值: 780<#RN#>单次眩晕总量: 2340<#RN#><#RN#>数值会根据武器品质百分比进行乘算。","JA":""},
