    },
    {
      "NamespaceHash": "Content::3094125993",
      "Source": "Inversion",
      "Trans": {"SC":"逆转者","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3720984294",
      "Source": "Inversion will put enemies under an Absorbent bubble, forcing them to take damage for every other nearby creature.",
      "Trans": {"SC":"这把逆转者能够将敌对生物放入一个吸收伤害的空泡中, 强迫它们吸收周围生物受到的一切伤害。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4034021233",
      "Source": "Outburst",
      "Trans": {"SC":"爆炸弩","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::286448131",
      "Source": "A weapon of explosions, this crossbow fires arrows that explode and deal area damage on impact.<#N#><#N#>Hold R after equipping to choose the type of essence used as ammo. The higher the tier, the more powerful the shot.",
      "Trans": {"SC":"这是一款爆炸型武器, 该十字弩发射的箭矢会在命中目标时爆炸并造成范围伤害。<#N#><#N#>装备后按住R键可选择精华作为类型。精华等级越高, 射击威力越强。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2195568277",
      "Source": "Plaguefork",
      "Trans": {"SC":"瘟疫叉","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::614008470",
      "Source": "A deadly pitchfork used to help cart away bodies during the plague. Has a chance to inflict Plague while dealing damage.",
      "Trans": {"SC":"这是一把致命的干草叉, 曾在瘟疫期间用于协助运送尸体。它在造成伤害时有概率施加 “瘟疫” 效果。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3251410601",
      "Source": "Shatter",
      "Trans": {"SC":"爆炸稿","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4001498553",
      "Source": "A blunt weapon that has been carelessly carved from a block of stone, it has a chance to break off explosives shards that harvest when it hits an object.",
      "Trans": {"SC":"这是一种用石块粗略雕琢而成的钝器, 当它击中物体时, 有可能会崩落爆炸碎片。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::846444809",
      "Source": "Translocator",
      "Trans": {"SC":"瞬影","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1916386217",
      "Source": "This pick isn't restricted by space or time. Attacking with it will warp you between enemies, striking each of them as you go.",
      "Trans": {"SC":"这把镐不受空间或时间的限制。用它攻击时, 你会在敌人之间扭曲穿梭, 每次移动都会攻击到其中一个敌人。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2232600601",
      "Source": "Wabbajack",
      "Trans": {"SC":"瓦巴杰克","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3637014866",
      "Source": "A weapon of luck and destruction, the Wabbajack constantly rolls unknown damage modifiers and status effects with each attack.",
      "Trans": {"SC":"瓦巴杰克是一件兼具运气与毁灭属性的武器, 每次攻击时都会不断随机生成未知的伤害修正值和状态效果。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3903694262",
      "Source": "Lurkers",
      "Trans": {"SC":"潜伏之刃","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3856823304",
      "Source": "Claws that become more deadly the more they are used, they use Nightmare souls for fuel and allow you to go into Stalker mode with right-click, dealing a huge critical hit on your next attack.",
      "Trans": {"SC":"这是一双越使用越致命的利爪, 以噩梦灵魂为能量来源。右键点击可让你进入潜行者模式, 使下次攻击造成巨额暴击伤害。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2313293636",
      "Source": "Wyvern's Breath",
      "Trans": {"SC":"飞龙吐息","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2768278163",
      "Source": "Powered by Elemental Souls, this flamethrower can have its element changed by holding R, choosing between the 6 elemental types.",
      "Trans": {"SC":"这款喷火器由元素(Elemental)灵魂驱动, 按住R键即可在6种元素类型之间切换来改变元素属性。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1371992189",
      "Source": "Mind's Eye",
      "Trans": {"SC":"心灵之眼","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::437832800",
      "Source": "A shoulder mounted Ethereal weapon with configurable targeting and firing modes. Consumes Ethereal Souls for ammunition.",
      "Trans": {"SC":"一种可肩扛的飘渺(Ethereal)武器, 具备可配置的瞄准和射击模式, 以飘渺(Ethereal)灵魂作为弹药。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::468872407",
      "Source": "Judgement",
      "Trans": {"SC":"终末审判","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4209463203",
      "Source": "Cuts through metal and armor when infused with Utility Souls, and supports a Charge Attack. Equipping requires learning this Tekgram",
      "Trans": {"SC":"当注入实用系(Utility)灵魂时, 可切割金属和装甲, 还可蓄力发动强力攻击。<#RN#>需要先学会该泰克印痕才可使用。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2048586434",
      "Source": "Coffer",
      "Trans": {"SC":"秘匣","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3441727993",
      "Source": "An old box said to contain some unruly creatures. Use it to summon them. The minions last 15 seconds, and the weapon can be used every 30 seconds. Consumes 10 Summoner Souls per use. <#N#><#N#>Permanent item, cannot be broken and is not consumed on use.",
      "Trans": {"SC":"一个传闻中，内封印着桀骜不驯上古生灵的远古秘匣。使用时会召唤匣中生物助战, 召唤体持续存在15秒。该秘匣需间隔30秒方可再次发动召唤, 每次使用将消耗10个召唤(Summoner)灵魂。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2301099895",
      "Source": "Big Bang",
      "Trans": {"SC":"超新星爆炸弓","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2219745628",
      "Source": "A bow infused with Cosmic power, it can instantly cause Supernova explosions in the target area by consuming Cosmic Souls. It can also fire various arrow projectiles.",
      "Trans": {"SC":"一把注入了寰宇能量的弓, 通过消耗寰宇系(Cosmic)灵魂, 它能在目标区域瞬间引发超新星爆炸, 也能发射各种箭矢。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3306755161",
      "Source": "Force Shield",
      "Trans": {"SC":"守护盾","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3230112912",
      "Source": "Absorbs damage from the front when activated. <#N#><#N#>It can consume Guardian Souls to reflect ranged attacks back at attackers, and to create an Absorbent Bubble to protect allies.",
      "Trans": {"SC":"激活后可吸收来自前方的伤害。<#N#><#N#>它能消耗守卫系(Guardian)灵魂，将远程攻击反弹给攻击者，并生成一个护盾以保护盟友。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3585720812",
      "Source": "Lucky Lantern",
      "Trans": {"SC":"幸运灯笼","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3826740246",
      "Source": "Weaponized Luck that damages and cripples enemies. <#N#><#N#>Powered by Lucky Souls, this weapon will target enemies, dealing damage and applying the Crippled debuff, which reduces their melee damage output by 50%.",
      "Trans": {"SC":"Weaponized Luck that damages and cripples enemies. <#N#><#N#>Powered by Lucky Souls, this weapon will target enemies, dealing damage and applying the Crippled debuff, which reduces their melee damage output by 50%.","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3734800625",
      "Source": "Ancient Stamina Potion",
      "Trans": {"SC":"Ancient耐力药水","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4265898497",
      "Source": "This potion will restore 10% Stamina per second for 30 seconds.",
      "Trans": {"SC":"此药水每秒恢复10%的耐力, 持续30秒。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1044186361",
      "Source": "Apex Stamina Potion",
      "Trans": {"SC":"Apex耐力药水","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
