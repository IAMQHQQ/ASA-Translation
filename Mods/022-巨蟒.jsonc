    },
    {
      "NamespaceHash": "Content::2018295006",
      "Source": "Currently Digesting {Dino Name}<#RN#><#RN#>Use This Item to force Gigantophis to spit out the creature.<#RN#><#RN#>When creature is fully digested, it will be gone forever, but grant recovery buff and have a chance to give loot from the digestion remains.",
      "Trans": {"SC":"正在消化 {Dino Name}<#RN#><#RN#>使用这个物品迫使巨蟒吐出生物.<#RN#><#RN#>当生物被完全消化，它将永远消失，但会给予恢复增益，并且有可能从消化残余中获得战利品。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
