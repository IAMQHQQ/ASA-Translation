    {
      "NamespaceHash": "Content::1437967045",
      "Source": "<RichColor Color=\"1,0,0,1\">Want to create your own legend?</><#RN#>Give the core to a Legendary alpha dodorexy to create your own Legend!<#RN#><RichColor Color=\"0,0,1,1\">The process may be hard,the result may also be less than satisfactory!</>",
      "Trans": {"SC":"<RichColor Color=\"1,0,0,1\">想要创造属于自己的传奇吗?</><#RN#>给一个传奇精英渡渡霸王龙的核心来创造你自己的传奇！<#RN#><RichColor Color=\"0,0,1,1\">过程可能艰辛，结果也可能不尽人意！</>","JA":""},
