    },
    {
      "NamespaceHash": "CBB5756646F70FC86BBD20B228B62C33",
      "Source": "Players can capture dinos in combat",
      "Trans": {"SC":"玩家可以在战斗中捕获恐龙","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"3571328783"}
    },
    {
      "NamespaceHash": "12FEE1504931F9DB82F6979F08D2486F",
      "Source": "Keep in Mind:",
      "Trans": {"SC":"请注意：","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"829159967"}
    },
    {
      "NamespaceHash": "2E8313BD49726E9CB9B0138AA8E0FDAC",
      "Source": "Players will not be able to Capture or Deploy dinos during storms",
      "Trans": {"SC":"玩家在风暴期间将无法捕获或部署恐龙","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"1737070869"}
    },
    {
      "NamespaceHash": "85B087AC4AD242545B6E40A975512CBB",
      "Source": "Loading Data...",
      "Trans": {"SC":"加载数据中...","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"1381022868"}
    },
    {
      "NamespaceHash": "952EE0604CB0B7C06D4B3686AB505CDD",
      "Source": "Players will be able to capture Titanosaur and Oasisaur",
      "Trans": {"SC":"玩家将能够捕获泰坦龙和绿洲龙","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"1088443734"}
    },
    {
      "NamespaceHash": "F766611B41427E37887083BF8A8C8595",
      "Source": "Use the official Cryopod settings for deploying",
      "Trans": {"SC":"使用官方低温舱设置进行部署","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"237841117"}
    },
    {
      "NamespaceHash": "85D08BF343E082EC6B42A4A27A07234E",
      "Source": "Everything you change in this panel will be applied in real time. There is no need to restart the server.",
      "Trans": {"SC":"您在此面板中所做的所有更改都将实时应用，无需重启服务器。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"2226128493"}
    },
    {
      "NamespaceHash": "76627B2E413C651857C01B9541C9BF4E",
      "Source": "If you accidentaly hit \"Restore Defaults\". Just close the panel without saving and open it again",
      "Trans": {"SC":"如果您不小心点击了“恢复默认设置”，只需关闭面板而不保存，然后重新打开即可。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"1475934430"}
    },
    {
      "NamespaceHash": "8FC49FE94D68B0FF2E850F95C47FD786",
      "Source": "You can access Dino Recovery using the wheel menu in SCS Terminal",
      "Trans": {"SC":"您可以通过 SCS 终端中的轮盘菜单访问恐龙恢复功能","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"1641303582"}
    },
    {
      "NamespaceHash": "1DE9F97D48CD207A46A84DA88B8060C2",
      "Source": "To activate the Admin Mode, remember to use \"enablecheats\" in the console",
      "Trans": {"SC":"要激活管理员模式，请记得在控制台中使用“enablecheats”","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"493375201"}
    },
    {
      "NamespaceHash": "D02B7C554FFED400589C96B9591760CB",
      "Source": "Check Discord",
      "Trans": {"SC":"查看 Discord","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"4201401247"}
    },
    {
      "NamespaceHash": "C208DE624B7AD76B05A1E58BD76D9989",
      "Source": "Click \"Save\" button everytime you make a change",
      "Trans": {"SC":"每次进行更改后，请点击“保存”按钮","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"2849148169"}
    },
    {
      "NamespaceHash": "0AD95FD3492F94A6DB6E8395DAF1778A",
      "Source": "If enabled, Auto Grow will use the same rate as the server",
      "Trans": {"SC":"如果启用，自动成长将使用与服务器相同的速率","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"2214694627"}
    },
    {
      "NamespaceHash": "EAFBEB81490BCF978E548AA829764B74",
      "Source": "All items in dino inventory will be saved with the dino",
      "Trans": {"SC":"恐龙背包中的所有物品都将与恐龙一起保存","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"3336236336"}
    },
    {
      "NamespaceHash": "C9E0453F4B239F56B67193878FCA62CD",
      "Source": "If enabled players will be able to deploy all dinos in aberration",
      "Trans": {"SC":"如果启用，玩家将能够在畸变地图中部署所有恐龙","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"695787410"}
    },
    {
      "NamespaceHash": "41D0479946BF7FBE7AFC6B946968835F",
      "Source": "Stored babies will grow up inside cryopods",
      "Trans": {"SC":"存储的幼崽将在低温舱内成长","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"1029425573"}
    },
    {
      "NamespaceHash": "53C508EA43FA11887D971EA90719CC1B",
      "Source": "For any questions or suggestions:",
