      "Config": {"Item":false,"Dino":false,"Default_Hash":"3323761851"}
    },
    {
      "NamespaceHash": "C57464D648DDC4474493A998E62E3F5A",
      "Source": "If enabled, players will be able to capture extinction titans",
      "Trans": {"SC":"如果启用，玩家将能够捕获灭绝泰坦","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"3946299457"}
    },
    {
      "NamespaceHash": "D36E15EB46BED5F901AE018F215798B3",
      "Source": "Players can collect Death Cache using the SCS Gun",
