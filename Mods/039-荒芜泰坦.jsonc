    {
      "NamespaceHash": "Content::2213548901",
      "Source": "Alpha Primal Desolatitan Charm",
      "Trans": {"SC":"困难太古荒芜泰坦护身符","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::410047784",
      "Source": "Combine various Apex Drops to create this charm to summon the Primal Desolatitan Boss for a brutal challenge & huge rewards upon it's defeat.<#RN#><#RN#>WARNING: This Boss is meant to be very difficult. Do not underestimate it. Only Summon if absolutely prepared.<#RN#><#RN#>Note: Crafting costs will change if you have the Arkology: New Encounters Variant Mod installed or not. (Change does not show in engram list)",
      "Trans": {"SC":"组合各种顶级掉落物来制作这个护身符，以此召唤太古荒芜泰坦Boss，挑战这场残酷的战斗，击败它后可获得丰厚奖励。<#RN#><#RN#>警告：这个Boss的难度极高。切勿低估它。只有在完全准备就绪后再进行召唤。<#RN#><#RN#>注意：若安装了《Arkology: New Encounters Variant》模组，制作成本将会改变（此变化不会显示在印痕列表中）。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2937993391",
      "Source": "Beta Primal Desolatitan Charm",
      "Trans": {"SC":"中等太古荒芜泰坦护身符","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::977536443",
      "Source": "Gamma Primal Desolatitan Charm",
      "Trans": {"SC":"简单太古荒芜泰坦护身符","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2650878142",
      "Source": "Overseer's Primal Desolatitan Charm",
      "Trans": {"SC":"监察者太古荒芜泰坦护身符","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::685704979",
      "Source": "Desolatitan Saddle",
      "Trans": {"SC":"荒芜泰坦鞍","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::721938210",
      "Source": "Equip a Desolatitan with this to ride it.",
      "Trans": {"SC":"装备到荒芜泰坦上以骑乘。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3836333439",
      "Source": "Desolatitan Bone Saddle",
      "Trans": {"SC":"荒芜泰坦骸骨鞍","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3982498261",
      "Source": "Equip a Desolatitan with this saddle to ride it. Gives your Desolatitan a more Primal look with a saddle covered in Bones.<#RN#><#RN#>This saddle can only be obtained by defeating Alpha Primal Desolatitan Boss.<#RN#><#RN#>A Blueprint of this saddle can only be obtained by defeating the Overseer's Primal Desolatian Boss.",
      "Trans": {"SC":"给荒芜泰坦配备这个鞍具即可骑乘它。这个布满骸骨的鞍具能让你的荒芜泰坦更具原始风貌。<#RN#><#RN#>此鞍具仅能通过击败困难太古荒芜泰坦获得。<#RN#><#RN#>此鞍具的蓝图仅能通过击败监督者太古荒芜泰坦获得。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2672616076",
      "Source": "Berserk",
      "Trans": {"SC":"狂暴","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2393083319",
      "Source": "25% increase to damage output & resistance, 50% increase to movement speed",
      "Trans": {"SC":"伤害输出和抗性提升 25%，移动速度提升 50%","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4255333805",
      "Source": "Exhaustion",
      "Trans": {"SC":"疲惫","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2740580254",
      "Source": "Cannot Move or Attack, Damage Resistance decreased by 75%",
      "Trans": {"SC":"无法移动或攻击，伤害抗性降低 75%","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4266348390",
      "Source": "Combine various Apex Drops to create this charm to summon the Primal Desolatitan Boss for a brutal challenge & huge rewards upon it's defeat.<#RN#><#RN#>WARNING: This Boss is meant to be twice as hard as Alpha Primal Desolatitan. Do not underestimate it. Only Summon if absolutely prepared.<#RN#><#RN#>Note: Crafting costs will change if you have the Arkology: New Encounters Variant Mod installed or not. (Change does not show in engram list)",
      "Trans": {"SC":"组合各种顶级掉落物可制作此符咒，用于太古荒芜泰坦Boss，挑战成功后可获得丰厚奖励。<#RN#><#RN#>警告：该Boss的难度是困难太古荒芜泰坦的两倍。切勿轻敌。只有在万全准备的情况下才能召唤。<#RN#><#RN#>注：若安装了 “Arkology: New Encounters Variant” 模组，制作成本将会改变（此变化不会显示在印痕列表中）。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1119556672",
      "Source": "Primal Desolatitan Costume",
      "Trans": {"SC":"太古荒芜泰坦套装","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::143671241",
      "Source": "This costume can be used to make your Desolatitan look like the Primal Desolatitan Boss",
      "Trans": {"SC":"这套服饰可以让你的荒芜泰坦看起来像太古荒芜泰坦Boss。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
