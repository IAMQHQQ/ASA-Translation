    },
    {
      "NamespaceHash": "Content::1092234218",
      "Source": "- Collects fertilized eggs (won't pick up eggs at or below 1% incubation)<#RN#>- Incubates eggs in its inventory (only incubates to 1%)<#RN#>- Boosts egg production of nearby dinos<#RN#>- Requires power",
      "Trans": {"SC":"- 收集受精蛋（不会拾取孵化率≤1%的蛋）<#RN#>- 在其库存中孵化蛋（仅孵化至1%）<#RN#>- 提升附近恐龙的产蛋量<#RN#>- 需要电力","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
