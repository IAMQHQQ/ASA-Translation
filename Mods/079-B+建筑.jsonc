      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1074897431",
      "Source": "Place another crafting station inside and this will automatically craft any recipe selected from the inserted crafting station.<#RN#><#RN#>**Does not give crafting exp**",
