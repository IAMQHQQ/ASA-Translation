    },
    {
      "NamespaceHash": "Content::559183824",
      "Source": "Will draw charge from nearby light pets & vivariums that contain light pets.<#N#><#N#>Can re-charge Charge Batteries. <#N#><#N#>Does not protect against nameless and can not craft element.",
      "Trans": {"SC":"会从附近的光宠及装有光宠的饲养器中汲取电荷。<#N#><#N#>可给电荷电池充电。<#N#><#N#>无法抵御无名怪，也无法制作元素。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3222952749",
      "Source": "Crafts element but requires direct contact with liquid Element to function.<#N#><#N#>- Recipe is the same as at a Charge Node except there is no cooldown.",
      "Trans": {"SC":"可制作元素，但需要与液态元素直接接触才能运行。<#N#><#N#>- 配方与电荷节点相同，但无冷却时间。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1279096495",
      "Source": "Place on a Gas Vent to extract Congealed Gas Balls over time.<#N#><#N#>- Will automatically send full stacks of gas balls to any dedicated storage units that are set to accept gas balls.<#N#>- Does not detoriate over time.",
      "Trans": {"SC":"放置在气体喷口上，可随时间提取凝固气体球。<#N#><#N#>- 会自动将整堆气体球发送至任何设置为接收气体球的专用存储单元。<#N#>- 不会随时间损坏。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1703874125",
      "Source": "Has infinite items",
      "Trans": {"SC":"拥有无限物品","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4268451230",
      "Source": "Unlocks All Doors & Containers",
