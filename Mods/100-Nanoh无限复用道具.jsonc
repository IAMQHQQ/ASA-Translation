    {
      "NamespaceHash": "Content::2897107400",
      "Source": "Use this item to respec without having to relearn all your engrams. You will have to allocate ALL points before clicking accept. You can also click cancel at any time to cancel the respec. ",
      "Trans": {"SC":"使用此物品可重新分配属性，无需重新学习所有印痕。你需要分配所有点数后才能点击接受。你也可以随时点击取消来取消重新分配。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
