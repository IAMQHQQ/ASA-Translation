    },
    {
      "NamespaceHash": "Content::4080301688",
      "Source": "Can only be used on your tamed Drakyros. Use it to establish a deeper connection, forming a Bond that grants powerful benefits.",
      "Trans": {"SC":"只能在你已驯服的德拉基罗斯上使用。用它建立更深的联系，形成牵绊，赋予强大增益。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2934092443",
      "Source": "Fish Bait",
      "Trans": {"SC":"鱼饵","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::847145946",
      "Source": "A pungent bundle of fish flesh prepared to attract wild Drakyros. Required to earn their initial attention and begin forming a bond. Can be held and offered by hand… or awkwardly used as a weak improvised weapon.",
      "Trans": {"SC":"一束气味浓郁的鱼肉，用于吸引野生德拉基罗斯。要获得它们的初步关注并开始形成牵绊，这是必需的。可以手持献上……或者尴尬地用作弱效临时武器。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::732364588",
      "Source": "Drakyros Bond",
      "Trans": {"SC":"德拉基罗斯契约","JA":"德拉基羅斯契約"},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2882194355",
      "Source": "You have bonded with your Drakyros, you may now harnest mythical abilities!",
      "Trans": {"SC":"你已与你的德拉基罗斯建立纽带，现在你可以驾驭神话般的能力！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3241127965",
      "Source": "Drakyros has depleted its charge. Movement speed and charge regeneration are reduced.",
      "Trans": {"SC":"德拉基罗斯的能量已耗尽。移动速度和能量再生速度降低。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
