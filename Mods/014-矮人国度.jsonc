      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2534727922",
      "Source": "A foundation is required to build structures in an area.  This one is made from sturdy dwarven rocks.",
      "Trans": {"SC":"在某一区域建造建筑需要地基。这种地基由坚固的矮人岩石制成。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
