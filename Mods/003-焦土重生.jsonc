    {
      "NamespaceHash": "Content::2941376188",
      "Source": "Artifact of the Brood",
      "Trans": {"SC":"上古神器之育母","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1840961441",
      "Source": "Getting this artifact proves you are stronger than the brood.<#RN#><RichColor Color=\"1,0,0,1\">Only one of these may be carried at a time by an organism.</>",
      "Trans": {"SC":"获得此神器足以证明你比育母更加强大。<#RN#><RichColor Color=\"1,0,0,1\">一个生物一次只能携带一个此类物品。</>","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3466859862",
      "Source": "Artifact of the FlameKeeper",
      "Trans": {"SC":"上古神器之守焰者","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3473054060",
      "Source": "The mystery of this artifact exceeds many.<#RN#><RichColor Color=\"1,0,0,1\">Only one of these may be carried at a time by an organism.</>",
      "Trans": {"SC":"此神器的神秘之处远不止于此。<#RN#><RichColor Color=\"1,0,0,1\">一个生物一次只能携带一个此类物品。</>","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2933713490",
      "Source": "Artifact of the Infested",
      "Trans": {"SC":"上古神器之感染","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2593061257",
      "Source": "The infestation originates from a far off ARK and its been around a long time.<#RN#><RichColor Color=\"1,0,0,1\">Only one of these may be carried at a time by an organism.</>",
      "Trans": {"SC":"感染源自一个遥远的方舟，且已存在很长时间。<#RN#><RichColor Color=\"1,0,0,1\">一个生物一次只能携带一个此类物品。</>","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1698881029",
      "Source": "Artifact of the Inquisitive",
      "Trans": {"SC":"上古神器之求知","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::34645591",
      "Source": "The Overseer shows interest in your knowledge.<#RN#><RichColor Color=\"1,0,0,1\">Only one of these may be carried at a time by an organism.</>",
      "Trans": {"SC":"监察者对你的知识表现出兴趣。<#RN#><RichColor Color=\"1,0,0,1\">一个生物一次只能携带一个此类物品。</>","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3971903039",
      "Source": "Artifact of the Molten",
      "Trans": {"SC":"上古神器之熔火","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3306566659",
      "Source": "This Artifact stands for the many things that can be molten including element...<#RN#><RichColor Color=\"1,0,0,1\">Only one of these may be carried at a time by an organism.</>",
      "Trans": {"SC":"此神器代表着许多可熔化的东西，包括元素...<#RN#><RichColor Color=\"1,0,0,1\">一个生物一次只能携带一个此类物品。</>","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3822535755",
      "Source": "Artifact of the Storm",
      "Trans": {"SC":"上古神器之风暴","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2480594554",
      "Source": "This artifact gives you an omninous feeling of whats to come.<#RN#><RichColor Color=\"1,0,0,1\">Only one of these may be carried at a time by an organism.</>",
      "Trans": {"SC":"此神器让你对即将到来的事物有一种不祥的预感。<#RN#><RichColor Color=\"1,0,0,1\">一个生物一次只能携带一个此类物品。</>","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3914009942",
      "Source": "Artifact of the Noxious",
      "Trans": {"SC":"上古神器之剧毒","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2974352980",
      "Source": "Holding this artifact makes you feel off.<#RN#><RichColor Color=\"1,0,0,1\">Only one of these may be carried at a time by an organism.</>",
      "Trans": {"SC":"持有此神器让你感到不适。<#RN#><RichColor Color=\"1,0,0,1\">一个生物一次只能携带一个此类物品。</>","JA":""},
