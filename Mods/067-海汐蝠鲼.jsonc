{
  "Hydrovanta": [//2025.12.03 技能图标未汉化
    {
      "NamespaceHash": "Content::687417705",
      "Source": "Hydrovanta",
      "Trans": {"SC":"海汐蝠鲼","JA":"海汐蝠鱝"},
      "Config": {"Item":false,"Dino":true,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1781100505",
      "Source": "Hydrovanta Saddle",
      "Trans": {"SC":"海汐蝠鲼鞍","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3730111780",
      "Source": "Ride that Pancake!",
      "Trans": {"SC":"骑那个煎饼！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1839189287",
      "Source": "Hydrovanta Gel Healing Brew (Tier 1)",
      "Trans": {"SC":"海汐蝠鲼凝胶治疗药剂（1级）","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::356637625",
      "Source": "Stronger than a Medical Brew, but it can only be fed to creatures. <#RN#><#RN#>This is (Tier 1) and the least potent of the Hydrovanta Gel Brews<#RN#><#RN#>Good for on the go healing for your creatures.<#RN#><#RN#>Promotes healing.",
      "Trans": {"SC":"比医疗药剂更强，但只能喂给生物。<#RN#><#RN#>这是（1级），也是海汐蝠鲼凝胶药剂中效力最弱的<#RN#><#RN#>适合随时为你的生物治疗。<#RN#><#RN#>促进愈合。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1648237028",
      "Source": "Hydrovanta Gel",
      "Trans": {"SC":"海汐蝠鲼凝胶","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3595903826",
      "Source": "Promotes healing in it's raw form and can be consumed by humans & creatures, but is less potant than a medical brew. <#RN#>----------------------------------<#RN#><#RN#>Tamed Hydrovantas Passively Generate Gel by Consuming Black Pearls, Silica Pearls, Ammonite Bile, Angler Gel, & Bio Toxin. <#RN#><#RN#> (Gel Generation can be toggled off in hydrovanta radial menu)<#RN#>----------------------------------<#RN#><#RN#>Crafting Use: Used to create Hydrovanta Healing Brews for Dinos",
      "Trans": {"SC":"原始形态下即可促进愈合，人类和生物均可食用，但效力比医疗药剂弱。<#RN#>----------------------------------<#RN#><#RN#>被驯服的海汐蝠鲼通过食用黑珍珠、硅珍珠、菊石胆汁、鮟鱇鱼凝胶和生物毒素来被动生成凝胶。<#RN#><#RN#>（可在海汐蝠鲼的径向菜单中关闭凝胶生成）<#RN#>----------------------------------<#RN#><#RN#>制作用途：用于为恐龙制作海汐蝠鲼治疗药剂","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3809528516",
      "Source": "Hydrovanta Gel Healing Brew (Tier 2)",
      "Trans": {"SC":"海汐蝠鲼凝胶治疗药剂（2级）","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3638460929",
      "Source": "More potent than Tier 1 Hydrovanta Gel Brew, but not as potent as Tier 3<#RN#><#RN#>Can only be fed to creatures. <#RN#><#RN#>Good for on the go healing for your creatures.<#RN#><#RN#>Promotes healing.",
      "Trans": {"SC":"效力比1级海汐蝠鲼凝胶药剂强，但不如3级<#RN#><#RN#>只能喂给生物。<#RN#><#RN#>适合随时为你的生物治疗。<#RN#><#RN#>促进愈合。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::800770650",
      "Source": "Hydrovanta Gel Healing Brew (Tier 3)",
      "Trans": {"SC":"海汐蝠鲼凝胶治疗药剂（3级）","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::91539504",
      "Source": "Strongest & most potent Hydrovanta Gel Brew (Tier 3)<#RN#><#RN#>Can only be fed to creatures. <#RN#><#RN#>Good for on the go healing for your creatures.<#RN#><#RN#>Promotes healing.",
      "Trans": {"SC":"最强且效力最高的海汐蝠鲼凝胶药剂（3级）<#RN#><#RN#>只能喂给生物。<#RN#><#RN#>适合随时为你的生物治疗。<#RN#><#RN#>促进愈合。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::230056809",
      "Source": "A thick, viscous substance that can sustain a flame for a remarkably long duration and be used to craft healing property items.",
      "Trans": {"SC":"一种浓稠、黏滞的物质，能维持火焰极长时间，还可用于制作具有治疗属性的物品。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
