      "Config": {"Item":false,"Dino":false,"Default_Hash":"2688099721"}
    },
    {
      "NamespaceHash": "FED6365147297B8AB28B879D3A24C2BF",
      "Source": "If this is set to true, Hydrovanta will use the regular ark passive tame method. Instead of the custom one.",
      "Trans": {"SC":"如果此设置为 true，海汐蝠鲼将使用方舟常规的被动驯养方法，而非自定义方法。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"888519274"}
    },
    {
      "NamespaceHash": "063E03E748E1648C26BD5E94F8EC6077",
      "Source": "This determines the amount of health that the Tier 1 Hydrovanta Healing brew will do when used on a creature.",
      "Trans": {"SC":"这决定了 1 阶海汐蝠鲼治疗药剂用于生物时的治疗量。","JA":""},
