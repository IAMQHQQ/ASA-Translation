      "Trans": {"SC":"黑牙","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::966364613",
      "Source": "The smoldering black fang of a great wyrm, felled after a gruesome battle. Still warm. Handle with care, survivor.",
      "Trans": {"SC":"一条巨龙阴燃的黑牙，在一场惨烈的战斗后被斩落，仍有余温，生存者，务必小心触碰。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
