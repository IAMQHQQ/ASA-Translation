      "Trans": {"SC":"可击打","JA":"可擊打"},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::416731554",
      "Source": "Can be hit by wild ridden Zaldrirs",
