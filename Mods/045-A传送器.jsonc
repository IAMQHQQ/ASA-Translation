  "A传": [//2025.11.29
    {
      "NamespaceHash": "Content::2758355484",
      "Source": "Awesome Teleporter Remote",
      "Trans": {"SC":"A传送器遥控器","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::753953340",
      "Source": "Primary fire allows Teleporting to anywhere an Awesome Teleporter can. Creates a bubble at your current location.<#RN#><#RN#>Secondary Fire will allow you to find your tracked dinos and teleport them to your current location.",
      "Trans": {"SC":"主键可将你传送到超级传送器能到达的任何地方，并在你当前位置生成一个传送泡泡。<#RN#><#RN#>右键可用于查找你追踪的恐龙，并将它们传送到你的当前位置。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1145908353",
      "Source": "Awesome Teleporter",
      "Trans": {"SC":"A传送器","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4211361923",
      "Source": "Allows for quick travel across any distance.<#N#><#N#>Finds and teleports any of your dinos equipped with an Awesome Dino Tracker.<#N#><#N#>Can retrieve any items from your corpse.",
      "Trans": {"SC":"可实现任意距离的快速旅行。<#RN#><#RN#>能找到并传送所有装备了超级恐龙追踪器的恐龙。<#RN#><#RN#>可从你的尸体上取回所有物品。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3175316582",
      "Source": "Awesome Dino Tracker",
      "Trans": {"SC":"A恐龙追踪器","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::518734296",
      "Source": "Using this on your Dino will allow it to be found using an Awesome Teleporter or Remote.",
      "Trans": {"SC":"在你的恐龙身上使用此物品后，即可通过A传送器或遥控器找到它。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
