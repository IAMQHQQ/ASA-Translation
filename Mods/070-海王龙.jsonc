    {
      "NamespaceHash": "B40D62714C39D3B966C5F5A51EAC53DC",
      "Source": "Higher Number = More Damage",
      "Trans": {"SC":"数值越高=伤害越高","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"1182676814"}
    },
    {
      "NamespaceHash": "EEEAF3AC4E37B7CBA67B56B270D6B813",
      "Source": "Higher number = More Damage Taken",
      "Trans": {"SC":"数值越高=受到的伤害越高","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"352091389"}
    },
    {
      "NamespaceHash": "647ABE0945280CCEEC494CBCB1E15FB0",
      "Source": "This is the amount of health that is drained from the victim over time per venom bite. Make sure this is a negative number. ",
      "Trans": {"SC":"这是每次毒液咬伤随时间从受害者身上流失的生命值。请确保这是一个负数。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"3443339030"}
    },
    {
      "NamespaceHash": "83A8925A4ABE842BB9E695824B715EE9",
      "Source": "The Venom Damage is applied over time. So this value is the duration of the damage for each bite of venom. By Default it's 5 seconds",
      "Trans": {"SC":"毒液伤害会随时间施加。因此该值是每次毒液咬伤的伤害持续时间。默认是5秒。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"185931174"}
    },
    {
      "NamespaceHash": "AC7CAB3941D4E2460BF190B21284037D",
      "Source": "This is the amount of Torpidity that is added to the victim over time per venom bite.",
      "Trans": {"SC":"这是每次毒液咬伤随时间添加到受害者身上的昏迷值。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"2535271415"}
    },
    {
      "NamespaceHash": "54B4CB5D4EE3F7347732A9BB03DCAAFA",
      "Source": "The Venom Torpidity is applied over time. So this value is the duration of the torpidity being added for each bite of venom. By Default it's 5 seconds",
      "Trans": {"SC":"毒液昏迷效果会随时间施加。因此该值是每次毒液咬伤的昏迷效果添加持续时间。默认是5秒。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"1365105030"}
    },
