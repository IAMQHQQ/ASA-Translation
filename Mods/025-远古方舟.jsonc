    },
    {
      "NamespaceHash": "Content::4222448212",
      "Source": "Paleo Cryptoclidus",
      "Trans": {"SC":"远古浅隐龙","JA":"遠古浅隱龙"},
      "Config": {"Item":false,"Dino":true,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1944016530",
      "Source": "Aberrant Obelisk squid",
      "Trans": {"SC":"畸变方尖碑鱿鱼","JA":"畸變方尖碑魷鱼"},
      "Config": {"Item":false,"Dino":true,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::257933314",
      "Source": "Obelisk squid",
      "Trans": {"SC":"方尖碑鱿鱼","JA":"方尖碑魷鱼"},
      "Config": {"Item":false,"Dino":true,"Default_Hash":""}
    },
        {
      "NamespaceHash": "Content::970088804",
      "Source": "Cryptoclidus Gel",
      "Trans": {"SC":"浅隐龙凝胶","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::589386355",
      "Source": "Secretions from the glands in Cryptoclidus' neck. Gives jellyfish immunity, and can be burned like angler gel!",
      "Trans": {"SC":"浅隐蛇颈龙腺体的分泌物.使用后免疫水母的伤害.并且可以当做燃料使用。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2480308699",
      "Source": "Cryptoclidus Saddle",
      "Trans": {"SC":"浅隐龙鞍","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1108400543",
      "Source": "Equip a Cryptoclidus with this to ride it.",
      "Trans": {"SC":"装备到浅隐龙上以骑乘。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1874940989",
      "Source": "Cooked Calamari",
      "Trans": {"SC":"熟鱿鱼肉","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1528461463",
      "Source": "Sates your hunger, and provides health while being digested. Better than raw meat for eating, but less effective for taming. Crunchy, yet chewy!",
      "Trans": {"SC":"消除你的饥饿感，并在消化的同时提供健康。吃起来比生肉好，但驯服生物就没那么有效了。松脆又有嚼劲！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3379529236",
      "Source": "Raw Calamari",
      "Trans": {"SC":"生鱿鱼肉","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3486189523",
      "Source": "Eating raw food will SLIGHTLY sate hunger, but is unhealthy for humans. This excellent cut spoils very quickly. Most wild Carnivores love this meat even more than prime fish meat.",
      "Trans": {"SC":"生吃食物会稍微满足饥饿感，但对人体是不健康的。这种上等的肉很快就坏了。大多数野生食肉动物喜欢这种肉甚至超过了上等的鱼肉。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::257947766",
      "Source": "Fertilized Obelisk Squid Egg",
      "Trans": {"SC":"受精的方尖碑鱿鱼卵","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
        {
      "NamespaceHash": "Content::1942062630",
      "Source": "Veil Charge",
      "Trans": {"SC":"全体隐匿 [充能值],","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2884129185",
      "Source": "Veiled",
      "Trans": {"SC":"隐匿中","JA":"隱匿中"},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::54726363",
      "Source": "Aggro radius reduced!",
      "Trans": {"SC":"仇恨半径缩小了！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::387533496",
      "Source": "Immune to Shock",
      "Trans": {"SC":"免疫电击","JA":"免疫電擊"},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1221508728",
      "Source": "You are immune to the stunning effects of shock inducing creatures!",
      "Trans": {"SC":"你对生物造成的电击眩晕效果免疫！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1849468823",
      "Source": "Cryptoclidus",
      "Trans": {"SC":"浅隐龙","JA":"浅隱龙"},
      "Config": {"Item":false,"Dino":true,"Default_Hash":""}
    },
    {
