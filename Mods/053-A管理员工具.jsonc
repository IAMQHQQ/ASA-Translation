      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3282755233",
      "Source": "Dye Package",
      "Trans": {"SC":"染料包","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3476888117",
      "Source": "A package containing all dyes. Crafting this gives 100 of each dye.",
      "Trans": {"SC":"包含所有染料的包裹。制作它可获得每种染料各100个。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3294076939",
      "Source": "A large unbreakable billboard for displaying important information.",
      "Trans": {"SC":"用于展示重要信息的大型不可破坏广告牌。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3889050660",
      "Source": "An indestructible admin storage.",
      "Trans": {"SC":"不可破坏的管理员储物箱。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3912740911",
      "Source": "Powers Tek Structures and electrical structures without using any fuel.",
      "Trans": {"SC":"无需使用任何燃料即可为泰克建筑和电力建筑供电。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1906008616",
      "Source": "Allows instantaneous traversal between Teleporters! Does not require any power or learned engram.",
      "Trans": {"SC":"允许在传送器之间瞬时穿梭！无需任何电力或已学习的印痕。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1774379604",
      "Source": "Cartography Table",
      "Trans": {"SC":"制图桌","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2655418311",
      "Source": "This table can be used to save and sync your static map markers with your tribe mates and yourself.",
      "Trans": {"SC":"这张桌子可用于保存你的静态地图标记，并与你的部落成员及你自己同步。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1955693442",
      "Source": "Can generate zones that change how players, dinos and structures inside of them behave. (Admin required to configure)",
