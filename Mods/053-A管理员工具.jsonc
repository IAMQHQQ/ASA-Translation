    },
    {
      "NamespaceHash": "Content::3375425056",
      "Source": "Translation \"Global\"",
      "Trans": {"SC":"翻译“全局”","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1964682620",
      "Source": "Translation of the word \"Global\" to the language of your ARK installation.Is used to check if you are talking in global chat which will get sent to the cross-chat.Only required if your ARK is not in english.",
      "Trans": {"SC":"将单词“Global”翻译为您的ARK安装语言。用于检查您是否在全局聊天中发言，该聊天将发送到跨服聊天。仅当您的ARK不是英文时才需要。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2994621218",
      "Source": "Clears all dino, item, buff and engram cache.",
      "Trans": {"SC":"清除所有恐龙、物品、增益和印痕缓存。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
