    {
      "NamespaceHash": "Content::4001869040",
      "Source": "Reset your server token if someone did share the token.",
      "Trans": {"SC":"如果有人分享了服务器令牌，请重置它。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1104216178",
      "Source": "This token allows you to connect your server to the Awesome Ark Bot. Do not share this token.",
      "Trans": {"SC":"此令牌允许您将服务器连接到Awesome Ark Bot。请勿分享此令牌。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
