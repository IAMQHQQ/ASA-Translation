    },
    {
      "NamespaceHash": "Content::3967456523",
      "Source": "Adds an option to open the AATMenu to the radial wheel.",
      "Trans": {"SC":"向径向菜单添加打开AAT菜单的选项。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::642224746",
      "Source": "Adds an option to spawn the Admin Tool to the radial wheel.",
