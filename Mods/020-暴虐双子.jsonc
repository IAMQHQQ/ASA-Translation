      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1889860610",
      "Source": "Must contain Power Cells to run. Turns 100% DNA Vials into Hybrid embryos.",
      "Trans": {"SC":"需要装入能量电池才能运行。可将100%纯度的基因瓶转化为基因蛋。","JA":""},
