    },
    {
      "NamespaceHash": "Content::3477591782",
      "Source": "DNA Synthesizer",
      "Trans": {"SC":"基因合成仪","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1225854027",
      "Source": "Must contain Power Cells to run. Turns DNA Petri dishes into Pure DNA strand vials",
      "Trans": {"SC":"需要装入能量电池才能运行。可将基因培养皿转化为纯基因瓶。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
