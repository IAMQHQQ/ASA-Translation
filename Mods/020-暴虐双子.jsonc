      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2866346686",
      "Source": "Power with PowerCells, put egg in inventory and select it to bring up the hatch egg button",
      "Trans": {"SC":"用能量电池供电，将蛋放入物品栏并选中它，即可调出 “孵化蛋” 按钮。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1327843250",
      "Source": "Must contain Gasoline. Crafts machines for hybrid creation process & power cells",
      "Trans": {"SC":"必须含有汽油。用于制造基因生物创造过程所需的机器和能量电池。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3538904644",
      "Source": "Must contain Power Cells to run. Turns 100% DNA Vials into Hybrid embryos. To craft egg it requires a Indom Genome and a Fertilized Rex egg.",
      "Trans": {"SC":"必须装入能量电池才能运行。可将100%纯度的基因瓶转化为基因蛋。要制作基因蛋，需要一个暴虐龙基因组和一个受精霸王龙蛋。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3695031325",
      "Source": "Must contain Power Cells to run. Turns PetriDishes into pure DNA Strands",
