    {
      "NamespaceHash": "Content::1611033124",
      "Source": "This  makes Drakaras neutral, they won't attack you unless you attack them! Use this Spray to get close enough to tame them!",
      "Trans": {"SC":"使用后可让德卡拉进入中立状态，除非你主动攻击，否则它们不会发起进攻！用这款喷雾靠近目标，即可进行驯服！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
