    {
      "NamespaceHash": "Content::1121009506",
      "Source": "Sanguivern Gothic Saddle",
      "Trans": {"SC":"血灵龙蝠哥特鞍","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1523184774",
      "Source": "Equip a Sanguivern with this saddle to ride it. Gives your Sanguivern a more Gothic look with a saddle covered in details inspired by hunters from Bloodborne.<#RN#><#RN#>This saddle can only be obtained by defeating Alpha Sanguivern Boss.<#RN#><#RN#>A Blueprint of this saddle can only be obtained by defeating the Overseer's Sanguivern Boss.",
      "Trans": {"SC":"为血灵龙蝠装备此鞍以骑乘它。赋予你的血灵龙蝠更哥特的外观，鞍具上布满了受《血源诅咒》中猎人启发的细节。<#RN#><#RN#>此鞍只能通过击败困难血灵龙蝠首领获得。<#RN#><#RN#>此鞍的蓝图只能通过击败监察者血灵龙蝠首领获得。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4257494375",
      "Source": "Sanguivern Blood",
      "Trans": {"SC":"血灵龙蝠血液","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3739054962",
      "Source": "Blood harvested from Sanguivern. Can consume to restore health similar to Bloodpacks albeit alot weaker. Mix with Sanguine Elixer to make more potent Elixers",
      "Trans": {"SC":"从血灵龙蝠身上采集的血液。可以饮用以恢复生命值，类似于血袋，但效果弱得多。与血之灵药混合可制成更有效的灵药","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2242480199",
      "Source": "Sanguivern Cocktail",
      "Trans": {"SC":"血灵龙蝠鸡尾酒","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1368185220",
      "Source": "A unique mixture of different forms of Blood & other satisfying ingredients. Feed to a tamed creature then have a Sanguivern kill it to gain taming affinity.",
      "Trans": {"SC":"由不同形式的血液和其他令人满足的成分混合而成的独特混合物。喂给已驯服的生物，然后让一只血灵龙蝠杀死它，以获得驯养亲密度。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2714675343",
      "Source": "Sanguivern Egg",
      "Trans": {"SC":"血灵龙蝠蛋","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
