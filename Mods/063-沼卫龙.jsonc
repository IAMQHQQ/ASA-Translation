      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2610193878",
      "Source": "Equip a Hapipalus with this to ride it.",
      "Trans": {"SC":"装备到沼卫龙上以骑乘。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2005523830",
      "Source": "Hapipalus Aberrant Saddle",
      "Trans": {"SC":"沼卫龙畸变鞍","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2549043821",
      "Source": "Equip a Hapipalus with this saddle to ride it. Gives your Hapipalus a more Aberrant look with a saddle covered in Aberrant Wood.<#RN#><#RN#>This saddle can only be obtained by defeating Alpha Hapipalus Boss.<#RN#><#RN#>A Blueprint of this saddle can only be obtained by defeating the Overseer's Hapipalus Boss.",
      "Trans": {"SC":"装备到沼卫龙上以骑乘。让你的沼卫龙外观更畸变，鞍身覆盖畸变木材。<#RN#><#RN#>这个鞍只能通过击败精英沼卫龙 Boss 获得。<#RN#><#RN#>这个鞍的蓝图只能通过击败监察者的沼卫龙 Boss 获得。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
