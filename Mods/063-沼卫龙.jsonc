      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::564272518",
      "Source": "Your dino's Speed, Health Regeneration, and Damage are boosted! 20% stronger than standard Hydrated buff!",
