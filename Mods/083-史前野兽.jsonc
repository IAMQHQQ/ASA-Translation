      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1527578112",
      "Source": "Made from teeth and bone, this jaw can be strapped to Doli to increase damage!",
      "Trans": {"SC":"这件由牙齿和骨骼制成的颚部附件，绑在长喙龙身上即可提升其伤害！","JA":""},
