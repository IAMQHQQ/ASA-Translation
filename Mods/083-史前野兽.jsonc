    {
      "NamespaceHash": "Content::487225592",
      "Source": "Sea King Kibble ",
      "Trans": {"SC":"海王饲料","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1050683491",
      "Source": "This specially blended food is a favorite of Hyneria. Containing only the finest natural ingredients, it provides them with the balanced nutrition they crave. And with a taste they can't resist, they'll warm up to you in no time! Not intended for human consumption.",
      "Trans": {"SC":"这种特制混合饲料是含肺鱼的最爱，采用优质天然原料，提供均衡营养，味道让它无法抗拒，会快速对你亲近！禁止人类食用。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3189371798",
      "Source": "Sweet Melon Seed",
      "Trans": {"SC":"甜瓜种子","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1224968390",
      "Source": "Eat it to gain a tiny amount of nourishment or plant it to grow your own Sweet Melon vine. Can be planted in Small, Medium, or Large Crop Plots.",
      "Trans": {"SC":"食用可获得少量营养，也可种植出甜瓜藤，能种在小型、中型、大型耕地中。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::771819388",
      "Source": "Sweet Melon",
      "Trans": {"SC":"甜瓜","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::932496033",
      "Source": "This wild melon can be found on most plains. It is very sweet and juicy.",
      "Trans": {"SC":"这种野生甜瓜在多数平原都能找到，香甜多汁。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3704206563",
      "Source": "Fermented Sweet Melon",
      "Trans": {"SC":"发酵甜瓜","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1403117604",
      "Source": "This sticky, sweet melon is a great treat to eat. Either consumed alone or can be used on a pet.",
      "Trans": {"SC":"这种黏稠香甜的甜瓜非常美味，可直接食用或投喂宠物。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::966733141",
      "Source": "Fertilized Hyneria Egg",
      "Trans": {"SC":"受精的含肺鱼蛋","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
