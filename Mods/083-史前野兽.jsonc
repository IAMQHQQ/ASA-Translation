      "Trans": {"SC":"受精的 X-含肺鱼蛋","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3971713043",
      "Source": "Venenosaurus BioNarc",
      "Trans": {"SC":"毒瘾龙生物麻醉剂","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1038638602",
      "Source": "Gross origin, but it's a great way to put things to sleep.",
      "Trans": {"SC":"来源很恶心，但催眠效果一流。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2862475268",
