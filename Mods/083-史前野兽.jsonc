    },
    {
      "NamespaceHash": "Content::1322389858",
      "Source": "Hainosaurus Bone Costume",
      "Trans": {"SC":"海诺龙骨架装扮","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1282972134",
      "Source": "This costume can be used to make your Hainosaurus look just like a skeleton! Spooky!",
      "Trans": {"SC":"这款装扮能让你的海诺龙化身骨架形态！阴森又酷炫！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1765476078",
      "Source": "Temnospondyl Treat",
      "Trans": {"SC":"离片椎类美味","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3700049808",
      "Source": "This specially blended food is a favorite of Prionosuchus. Containing only the finest natural ingredients, it provides Prionosuchus with the balanced nutrition they love. And with a taste they can't stay away from, they'll warm up to you in no time! Not intended for human consumption.",
      "Trans": {"SC":"这款特制调配饲料是锯齿螈的最爱。它仅采用顶级天然原料制成，能为锯齿螈提供其所需的均衡营养。饲料的味道让锯齿螈欲罢不能，能让它们迅速对你产生好感！注意：禁止人类食用。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
