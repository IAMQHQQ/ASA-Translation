      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3312097328",
      "Source": "Yeiks! You do less damage as you run in terror!",
      "Trans": {"SC":"妈呀！你在恐惧奔逃中造成的伤害降低！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4084468781",
