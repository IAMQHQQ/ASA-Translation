      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4228538823",
      "Source": "Give a baby Genyodectes this if you want to train it to be tolerant towards others, but loose Lone Wolf. (Put the item in its inventory when it is a baby, then consume it)",
      "Trans": {"SC":"若想让幼年颌齿龙变得合群、摒弃独行习性，可给它使用该道具。（需在其幼年时放入物品栏，再让它自行食用）","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3233380328",
      "Source": "Savory Meatloaf",
      "Trans": {"SC":"鲜香肉糕","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1274682311",
      "Source": "A rich and meaty concoction which carnivores find a delight, and will be automatically eaten when needed for healing. Alas, humans and herbivores tend to find its taste repulsive. ",
      "Trans": {"SC":"","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3646368617",
      "Source": "Raw Tender Meat",
      "Trans": {"SC":"生嫩肉","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2350525928",
      "Source": "Winter Squash Seed",
      "Trans": {"SC":"冬南瓜种子","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3769671448",
      "Source": "Eat it to gain a tiny amount of nourishment or plant it to grow your own Winter Squash vine. Can be planted in Small, Medium, or Large Crop Plots.",
      "Trans": {"SC":"食用可获得少量营养，也可种植以培育冬南瓜藤。该种子可种植于小-、中-及大-种植田。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
