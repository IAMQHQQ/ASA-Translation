    {
      "NamespaceHash": "Content::1419960203",
      "Source": "Sego Lily Seed",
      "Trans": {"SC":"塞戈百合种子","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1135264039",
      "Source": "Eat it to gain a tiny amount of nourishment, or plant it to grow your own Sego Lily flower.  Can be planted in Medium or Large Crop Plots.",
      "Trans": {"SC":"食用可获得少量营养，也可种植以培育属于你的塞戈百合花。该种子可种植于中型或大型种植田中。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3230217860",
      "Source": "Sego Lily",
      "Trans": {"SC":"塞戈百合花","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2929307586",
      "Source": "This beautiful flower is a native to the swampy marshes of ARK! Nasutoceratops find this flower irresistable!!",
      "Trans": {"SC":"这种美丽的花朵原产于方舟的沼泽湿地！鼻角龙对它毫无抵抗力！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::375204056",
      "Source": "Neovenator Bone Costume",
      "Trans": {"SC":"新猎龙骨架装扮","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3128970140",
      "Source": "This costume can be used to make your Neovenator look just like a skeleton! Spooky!",
      "Trans": {"SC":"这款装扮能让你的新猎龙化身骨架形态！阴森又酷炫！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
