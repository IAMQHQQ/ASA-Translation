      "Trans": {"SC":"埃德蒙顿龙头盔","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3249502392",
      "Source": "Stick this on your Edmontosaurus for some added armor, additional damage. Side affects include making your Edmontosaurus look 200% more badass!!",
      "Trans": {"SC":"给埃德蒙顿龙装备，可提升护甲与伤害，还能让它看起来霸气翻倍！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::505419310",
      "Source": "Edmontosaurus Saddle",
      "Trans": {"SC":"埃德蒙顿龙鞍","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1561560191",
      "Source": "Equip a Edmontosaurus with this to ride it.",
      "Trans": {"SC":"给埃德蒙顿龙装备此物，即可骑乘。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
