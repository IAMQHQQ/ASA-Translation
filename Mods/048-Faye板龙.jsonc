      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1124378439",
      "Source": "A special mixture crafted from Fermented Narcoberries. When consumed by a herbivore, it awakens something deep within them...",
      "Trans": {"SC":"由发酵麻醉果特制而成的混合物。当草食动物食用后，会唤醒它们体内深处的某种东西……","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
