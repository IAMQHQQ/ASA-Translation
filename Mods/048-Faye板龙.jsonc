    },
    {
      "NamespaceHash": "Content::2211512304",
      "Source": "Fermented in the ingluvies of a Plateosaurus, this sweet substance is irresistable to herbivores.",
      "Trans": {"SC":"经板龙嗉囊发酵而成，这种甜味物质对草食动物有着不可抗拒的吸引力。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1921671290",
      "Source": "Herbivore Delight",
