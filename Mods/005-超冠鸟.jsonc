    {
      "NamespaceHash": "F4B87A8640E0A3567C1C1990E2B26AFD",
      "Source": "Higher the number, the more damage done",
      "Trans": {"SC":"数字越高，造成的伤害越多","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"1741591273"}
      //ini提示
    },
    {
      "NamespaceHash": "556827F34FAA589F52A2DD8BDB51EDFE",
      "Source": "Lower the number = less damage taken",
      "Trans": {"SC":"数字越低 = 受到的伤害越少","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"1614153535"}
      //ini提示
    },
    {
      "NamespaceHash": "563F753A4BFA06377D1E3B830C9A5E56",
      "Source": "Set to the amount of damage you want each shot to take off the gun's durability",
      "Trans": {"SC":"设置为每次射击消耗枪支耐久度的伤害量","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"909819897"}
      //ini提示
    },
    {
      "NamespaceHash": "6F67485E4D3208A1E90F269C06693701",
      "Source": "Higher number = More Damage :: Lower number = Less Damage",
      "Trans": {"SC":"数字越高 = 伤害越高 :: 数字越低 = 伤害越低","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"2953270102"}
      //ini提示
    },
    {
      "NamespaceHash": "F38CDEB843F0E85BD4A9AA8317447DBB",
      "Source": "The master Adjustment multiplier for the damage output for the gun.",
      "Trans": {"SC":"枪支伤害输出的主调整倍率。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"3978803781"}
      //ini提示
    },
    {
      "NamespaceHash": "6CB08B6A4789C44800C7209A235704D3",
      "Source": "For example: 300 means it can pickup any dino with a dragweight of 300 or lower",
      "Trans": {"SC":"例如：300 表示可以抓取拖拽重量为 300 或更低的任何恐龙","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"2528245841"}
      //ini提示
    },
    {
      "NamespaceHash": "87A800414FF3E52D1CF646A624CAE420",
      "Source": "True = Allowed to pickup players",
      "Trans": {"SC":"True = 允许抓取玩家","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"3355447920"}
      //ini提示
    },
    {
      "NamespaceHash": "285639644DA72CCA6D0A0A8EFBEAD557",
      "Source": "True = Allowed to pickup dinos",
      "Trans": {"SC":"True = 允许抓取恐龙","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"4111331570"}
      //ini提示
    },
    {
      "NamespaceHash": "5C8CB6E941D7A5FF14144C8EE62B5630",
      "Source": "True = Allowed to pickup eggs",
      "Trans": {"SC":"True = 允许抓取蛋","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"719593279"}
      //ini提示
    },
    {
      "NamespaceHash": "6935DAA142A8226A0E8053A1BBCEA8E2",
      "Source": "What health % the victim in your beak needs to be in order to be swallowed as the finishing blow.",
      "Trans": {"SC":"喙中受害者需要处于多少生命值百分比才能被作为终结技吞下。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"1560301554"}
      //ini提示
    },
    {
      "NamespaceHash": "168C090448EA3AC6FB3BFF9002C0450C",
      "Source": "What Dragweight is allowed to be swallowed",
      "Trans": {"SC":"允许被吞下的拖拽重量","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"528199934"}
      //ini提示
    },
    {
      "NamespaceHash": "0C63B8FF475DCF5E9429E6A5F2485501",
      "Source": "The base quantity needed for making a supercephalosornis genome from a schematic",
      "Trans": {"SC":"从图纸制作超冠鸟基因组所需的基础数量","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"1743178499"}
      //ini提示
    },
    {
      "NamespaceHash": "265B8A294B7A07C284FDA288C5A45140",
      "Source": "For every Gene Trait Tier, 1-3, you can increase DNA cost by this amount.",
      "Trans": {"SC":"对于每个基因特质等级（1-3），你可以按此数量增加 DNA 成本。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"2615458585"}
      //ini提示
    },
    {
      "NamespaceHash": "63EAB9084382D952F755429E5E716B2D",
      "Source": "-1 means no level requirement. Any other number will mean a player has to be that level or higher to use.",
      "Trans": {"SC":"-1 表示无等级要求。任何其他数字意味着玩家必须达到该等级或更高才能使用。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"1631099042"}
      //ini提示
    },
    {
      "NamespaceHash": "0690834C486B19B71A3E24BB17C20976",
      "Source": "Higher the number, the faster eggs will incubate inside the nest.",
      "Trans": {"SC":"数字越高，蛋在巢中孵化的速度越快。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"3497205588"}
      //ini提示
    },
    {
      "NamespaceHash": "63D143B041279695B06FC594A32DDC46",
      "Source": "Format is MapName_WP then separate different names by comma",
      "Trans": {"SC":"格式为 MapName_WP，然后用逗号分隔不同的名称","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"2538665397"}
