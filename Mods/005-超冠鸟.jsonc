    {
      "NamespaceHash": "Content::1502012830",
      "Source": "A placeable Supercephalosornis Dossier full of knowledge on the hybrid super quetz<#RN#><#RN#>Can be used as decoration, or to learn information about Supercephalosornis",
      "Trans": {"SC":"一个可放置的超冠鸟图鉴，充满了关于杂交版超级风神翼龙的知识<#RN#><#RN#>可用作装饰，或了解超冠鸟的信息。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
