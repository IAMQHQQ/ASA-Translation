    },
    {
      "NamespaceHash": "68424ED64F9FDD9203F6DC90D65FC3D3",
      "Source": "Hints / Objectives",
      "Trans": {"SC":"提示 / 目标<#RN#>","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"3314784443"}
    },
    {
      "NamespaceHash": "E0629CA841A1F1F76989639AB4410C71",
      "Source": "<#RN#>- Enable Virtual Keypad<#RN#><#RN#>- Press Tap / Range button <#RN#>using virtual keypad to <#RN#>attempt connecting with <#RN#>a wild Livyatan. This will <#RN#>start the taming process. <#RN#><#RN#>Or to practice using this pad press the<#RN#> \"Training Mode\" Button to simulate <#RN#>the games without needing to find <#RN#>a Livyatan",
      "Trans": {"SC":"<#RN#>- 启用虚拟键盘<#RN#><#RN#>使用虚拟键盘按下 “启用” 按钮 尝试与野生利维坦鲸建立联系<#RN#>这将启动驯服过程<#RN#>若想练习使用此键盘 按下 “训练模式” 按钮<#RN#>无需寻找利维坦鲸即可模拟游戏","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":"3664282199"}
    },
