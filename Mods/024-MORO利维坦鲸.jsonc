{
  "MORO利维坦鲸": [//2025.11.29
    {
      "NamespaceHash": "Content::652938172",
      "Source": "Alpha Livyatan",
      "Trans": {"SC":"精英利维坦鲸","JA":"精英利維坦鯨"},
      "Config": {"Item":false,"Dino":true,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4275316868",
      "Source": "Livyatan",
      "Trans": {"SC":"利维坦鲸","JA":"利維坦鯨"},
      "Config": {"Item":false,"Dino":true,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1258956240",
      "Source": "Moros Livyatan Admin Menu Remote",
      "Trans": {"SC":"利维坦鲸管理器","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2162596852",
      "Source": "This device is an Admin Spawn / Configure Menu for Moro's Livyatan Mod. Engram can only be unlocked and used in creative mode (gcm).",
      "Trans": {"SC":"此设备是Moro的利维坦鲸模组的管理员生成 / 配置菜单。该技能印记只能在创造模式(GCM)中解锁和使用。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3996434808",
      "Source": "CraftingStation Livyatan",
      "Trans": {"SC":"利维坦鲸制作站","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2929268877",
      "Source": "Use this crafting station to make items, saddles, and more for Livyatan. This crafting bench has a custom Saddle Assembly and Upgrade menu",
      "Trans": {"SC":"使用这个制作站来为利维坦鲸制作物品、鞍具等。这个制作台有一个自定义的鞍具组装和升级菜单。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::437712839",
      "Source": "Drying Rack",
      "Trans": {"SC":"晾干架","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::587597460",
      "Source": "Requires Wood, Thatch, or Sparkpowder to activate the campfire and to begin drying the hide put in raw Livyatan Hide while the camp fire is activated..",
      "Trans": {"SC":"需要木材、茅草或引火粉来点燃篝火，并且在篝火点燃后，才能使放置在里面的生利维坦鲸兽皮干燥。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::626635577",
      "Source": "Alpha Livyatan Summoner Horn",
      "Trans": {"SC":"精英利维坦鲸召唤号角","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::427209247",
      "Source": "This item can be used to summon the Alpha Livyatan, the King of the sea which will grant high quality loot and engrams when killed. Many ocean tributes are required to create this horn. (CAN ONLY BE USED UNDERWATER AND ONLY 1 USE ONLY!)",
      "Trans": {"SC":"该物品可用于召唤精英利维坦鲸 —— 海洋之王。将其击杀后可获得高品质的战利品和技能印记。制作这个号角需要许多海洋贡品。（只能在水下使用，且仅能使用一次！）","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2763467909",
      "Source": "Ancient Whale Mandables",
      "Trans": {"SC":"古代鲸鱼下颌骨","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::946247569",
      "Source": "To obtain this you must kill an ADULT LIVYATAN.   Use this to make a Livyatan Bone Saddle in the Livyatan Crafting Station Saddle Assembly Menu",
      "Trans": {"SC":"要获得这个物品，你必须杀死一头成年利维坦鲸。用它在利维坦鲸制作站的鞍具组装菜单中制作一个利维坦鲸骨制鞍具。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2525474573",
      "Source": "Ancient Whale Skull",
      "Trans": {"SC":"古代鲸鱼头骨","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::561931658",
      "Source": "Baby Livyatan Skull",
      "Trans": {"SC":"幼年利维坦鲸头骨","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2141103417",
      "Source": "To obtain this you must kill a WILD BABY LIVYATAN (They can be found with adults).   Use this to make a Livyatan Bone Saddle in the Livyatan Crafting Station Saddle Assembly Menu",
      "Trans": {"SC":"要获得这个物品，你必须杀死一只野生幼年利维坦鲸（它们会和成年利维坦鲸在一起）。用这个在利维坦鲸制作站的鞍具组装菜单中制作一个利维坦鲸骨制鞍具。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2739370038",
      "Source": "Livyatan Jaw Bones",
      "Trans": {"SC":"利维坦鲸鲸颌骨","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4197110509",
      "Source": "Livyatan Ribcage",
      "Trans": {"SC":"利维坦鲸胸腔骨架","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4045419538",
      "Source": "Raw Livyatan Hide",
      "Trans": {"SC":"生利维坦鲸兽皮","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::987075610",
      "Source": "Fresh Hide from a Livyatan. Put this into a Livyatan Hide Drying Rack to dry it out and use it to craft Hide Pads used to craft Livyatan saddles.",
      "Trans": {"SC":"取自利维坦鲸的新鲜兽皮。将其放入烘干架中晾干，然后用于制作兽皮垫，兽皮垫可用来制作利维坦鲸鞍具。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3642026270",
      "Source": "Siege Saddle Back Plates",
      "Trans": {"SC":"攻城鞍具背板","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1933150439",
      "Source": "This Engram is learned by killing an ALPHA LIVYATAN which can be spawned using the Alpha Livyatan calling horn. Use this item to make a Livyatan Siege Saddle.",
      "Trans": {"SC":"这个技能印记可通过击杀一只精英利维坦鲸来学习，精英利维坦鲸可以使用精英利维坦鲸召唤号角来召唤。使用这个物品可以制作一个利维坦鲸攻城鞍。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::508481959",
      "Source": "Livyatan Bone Saddle Fishing Nets",
      "Trans": {"SC":"利维坦鲸骨鞍渔网","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2368676674",
      "Source": "Use this to make a Livyatan Bone Saddle",
      "Trans": {"SC":"用这个来制作一个利维坦鲸骨制鞍具。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2029693726",
      "Source": "Siege Saddle Head Metal Plates",
      "Trans": {"SC":"攻城鞍具头部金属板","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1119555476",
      "Source": "Livyatan Hide Pads",
      "Trans": {"SC":"利维坦鲸兽皮垫","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::505244632",
      "Source": "Made from dried livyatan hide. Use this to make a Livyatan Bone Saddle",
      "Trans": {"SC":"由干燥的利维坦鲸兽皮制成，用这个来制作一个利维坦鲸骨制鞍具。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4099519413",
      "Source": "Siege Saddle Metal Helmet",
      "Trans": {"SC":"攻城鞍具金属头盔","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::647092325",
      "Source": "Siege Saddle Metal Pads",
      "Trans": {"SC":"攻城鞍具金属护垫","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3420679122",
      "Source": "Siege Saddle Stomach Plates",
      "Trans": {"SC":"攻城鞍具腹部护板","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1122509825",
      "Source": "Livyatan Saddle Straps",
      "Trans": {"SC":"利维坦鲸鞍带","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3415550026",
      "Source": "Livyatan Bone Saddle",
      "Trans": {"SC":"利维坦鲸骨制鞍具","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2095160431",
      "Source": "Equip this on a Livyatan to ride it. This is a saddle made of primitive materials such as whalebones, and other marine animal bones that are obtained by killing a wild adult livyatan and baby livyatan. This saddle can be upgraded in the Livyatan Crafting station upgrade menu by combinding 2 Bone Saddles together.",
      "Trans": {"SC":"将这个装备在利维坦鲸身上以便骑乘它。这是一种由原始材料制成的鞍具，这些材料如鲸骨以及其他海洋动物的骨头，需通过猎杀野生成年利维坦鲸和幼年利维坦鲸来获取。这个鞍具可以在利维坦鲸制作站的升级菜单中，通过将两个骨制鞍具组合在一起来进行升级 。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3168350562",
      "Source": "Livyatan Default Saddle",
      "Trans": {"SC":"利维坦鲸初始鞍","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::835200589",
      "Source": "Equip a Livyatan with this to ride it. This is the first / default livyatan saddle with very low armor and no upgrade capabilities",
      "Trans": {"SC":"给利维坦鲸装备这个就能骑乘它。这是首个默认的利维坦鲸鞍具，护甲值极低且不具备升级能力 。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1058166324",
      "Source": "Livyatan Siege Saddle",
      "Trans": {"SC":"利维坦鲸攻城鞍","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3962089909",
      "Source": "Engram can only be obtained by defeating an Alpha Livyatan.  You must craft this item by creating the siege saddle parts and combinding them in the saddle assembly menu in the Livyatan Crafting station. You can also upgrade this saddle in the Saddle Upgrade menu in the Livyatan crafting station by combinding 2 siege saddles together to increase the rarity.Equip a Livyatan with this to ride it, and to use it's super powerful gun which requires element to shoot and fires a giant laser. This saddle also grants oxygen to the rider.",
      "Trans": {"SC":"该技能印记只能通过击败一只精英利维坦鲸获得。你必须先制作攻城鞍具的各个部件，然后在利维坦鲸制作站的鞍具组装菜单中将它们组合起来，才能制作出这个物品。你还可以在利维坦鲸制作站的鞍具升级菜单中，通过将两个攻城鞍具组合在一起来提升其稀有度，从而对这个鞍具进行升级。给利维坦鲸装备上这个鞍具，你就可以骑乘它，还能使用它那超级强大的需要元素才能发射的枪炮，它发射出的是一道巨大的激光。这个鞍具还能为骑手提供氧气。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3487745394",
      "Source": "Livyatan Communication Pad",
      "Trans": {"SC":"利维坦鲸通讯器","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::62800081",
      "Source": "Must be crafted in the inventory of the Livyatan crafting station. This pad allows you to tame a wild livyatan by connecting and communicating with it through sound waves generated through the success of the objectives and minigames given through the pad.",
      "Trans": {"SC":"必须在利维坦鲸制作站的物品栏中制作。这个通讯板能让你通过完成板上给出的任务和小游戏，产生声波与野生利维坦鲸建立连接并进行交流，从而驯服它。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::455300751",
      "Source": "Livyatan Spine",
      "Trans": {"SC":"利维坦鲸脊椎","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1556417484",
      "Source": "Dried Livyatan Hide",
      "Trans": {"SC":"晒干的利维坦鲸皮","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3257191850",
      "Source": "This is the result of drying out Fresh Livyatan Hide. Use this to craft Hide Pads for a Livyatan Saddle",
      "Trans": {"SC":"这是将新鲜的利维坦鲸皮晾干后的产物。用这个来制作利维坦鲸鞍具所需的兽皮垫。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
