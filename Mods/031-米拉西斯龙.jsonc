    {
      "NamespaceHash": "Content::1318001921",
      "Source": "Earn XP from Alpha creature kills when equipped, to increase its level and earn additional max-levels for your Survivor!<#RN#><#RN#>Aswell gives you and others around DOUBLE XP buff.",
      "Trans": {"SC":"装备后通过击杀精英生物来获得经验值, 以提高其等级并使您的生存者获得额外的最高等级上限!<#N#><#N#>同时为你和周围的人提供双倍经验增益。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4135115037",
      "Source": "Earn XP from Alpha creature kills when equipped, to increase its level and earn additional max-levels for your Survivor!<#RN#><#RN#>Aswell gives you the Defense buff.",
