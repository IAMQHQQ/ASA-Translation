  "Helicoprion": [
    {
      "NamespaceHash": "Content::434935549",
      "Source": "This specially blended pet food is a favorite for Helicoprion. Containing heavy mixes of the finest Cephalopods, it provides Helicoprion with the balanced nutrition they need. And with a taste they can't resist, they'll warm up to you in no time!\r\n\r\nCalamari ~ So Divine!~~",
      "Trans": {"SC":"这种特别调配的宠物食品是旋齿鲨的最爱。配料富含精选头足类动物, 为旋齿鲨均等提供所需营养。并且, 这种美味它们无法抗拒, 很快就会对你产生好感!\r\n\r\n鱿鱼 芜湖~ 好吃到起飞!~~","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::109179675",
      "Source": "Helicoprion",
      "Trans": {"SC":"旋齿鲨","JA":"旋齿鯊"},
      "Config": {"Item":false,"Dino":true,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1227807040",
      "Source": "Helicoprion Dossier",
      "Trans": {"SC":"旋齿鲨图鉴","JA":"旋齿鲨圖鑒"},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::388759659",
      "Source": "Helicoprion Saddle",
      "Trans": {"SC":"旋齿鲨鞍","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3128151458",
      "Source": "Equip a Helicoprion with this to ride it. Can also be used as a smithy!",
      "Trans": {"SC":"装备到旋齿鲨上以骑乘。还可以作为一个铁匠台来使用!","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3179187789",
      "Source": "Little Ratfish Treats!",
      "Trans": {"SC":"鲨鲨小零食!","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3756051259",
      "Source": "This specially blended pet food is a favorite for Helicoprion. Containing heavy mixes of the finest Cephalopods, it provides Helicoprion with the balanced nutrition they need. And with a taste they can't resist, they'll warm up to you in no time! Be careful of the cloud of Ammonite Bile and other toxins that occur when they chomp into these little treats...\n\nCalamari ~ So Divine!~~",
      "Trans": {"SC":"这种特别调配的宠物食品是旋齿鲨的最爱。配料富含精选头足类动物, 为旋齿鲨均等提供所需营养。并且, 这种美味它们无法抗拒, 很快就会对你产生好感! 要注意的是, 它们对小零食大快朵颐时会形成菊石黏液与其它毒素混合而成的云雾...\r\n\r\n鱿鱼 芜湖~ 好吃到起飞!~~","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    }
  ]
}
