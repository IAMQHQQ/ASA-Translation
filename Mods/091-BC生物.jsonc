      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::109899552",
      "Source": "It can be used to tame creatures just like official Kibble, and it can be used to tame the creatures in the BC Mod, including: Shinosaurus.",
      "Trans": {"SC":"和官方饲料一样可用于驯服生物，可驯服 BC 模组生物，包括：秀尼鱼龙。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1663110214",
      "Source": "BC Medium Kibble",
      "Trans": {"SC":"BC中型饲料","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::842190415",
      "Source": "It can be used to tame creatures just like official Kibble, and it can be used to tame the creatures in the BC Mod, including: Torvosaurus, Saurophaganax.",
      "Trans": {"SC":"和官方饲料一样可用于驯服生物，可驯服 BC 模组生物，包括：蛮龙、食蜥王龙。","JA":""},
