      "Trans": {"SC":"BC小型饲料","JA":""},
      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3976747071",
      "Source": "It can be used to tame creatures just like official Kibble, and it can be used to tame the creatures in the BC Mod, including: Austroraptor",
