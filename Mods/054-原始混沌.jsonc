      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3157078295",
      "Source": "Gives player or tame experience when consumed.",
      "Trans": {"SC":"食用后为玩家或驯化生物提供经验。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3673880365",
      "Source": "Grapple onto the environment & other creatures. Primary Fire to \"Reel-In\", Secondary Fire to \"Reel-Out\", Crouch to Detach, Jump + Reel-In to Vault-Jump!",
      "Trans": {"SC":"钩住环境与其他生物。主火键「收绳」，副火键「放绳」，蹲伏键脱离，跳跃+收绳可进行翻越跳跃！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2585295480",
      "Source": "Use this while falling to slow your fall. Jump while parachuting to deactivate it. Can be used Multiple times!",
      "Trans": {"SC":"坠落时使用可减缓下落速度。跳伞状态下跳跃可关闭降落伞。可多次使用！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1973582898",
      "Source": "A reusable melee weapon that can also be thrown multiple times. Also applies a little torpor per hit!",
      "Trans": {"SC":"可重复使用的近战武器，也可多次投掷。每次命中还会施加少量麻醉值！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
