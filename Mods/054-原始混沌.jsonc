    {
      "NamespaceHash": "Content::3071239155",
      "Source": "Use this kibble to tame Toxic dinos",
      "Trans": {"SC":"使用这种饲料驯服毒系恐龙","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1379584204",
      "Source": "Use this kibble to tame Alpha dinos",
      "Trans": {"SC":"使用这种饲料驯服精英恐龙","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::199213398",
      "Source": "Use this kibble to tame Volcanic/Hydro/Electric dinos",
      "Trans": {"SC":"使用这种饲料 驯服熔岩/水力/电系恐龙","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1438472434",
      "Source": "Use this kibble to tame Fairy dinos",
      "Trans": {"SC":"使用这种饲料驯服仙灵恐龙","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
