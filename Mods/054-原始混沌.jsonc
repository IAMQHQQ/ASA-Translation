    },
    {
      "NamespaceHash": "Content::3064582230",
      "Source": "Souls such as these are utilized to summon formidable ancient Bosses!",
      "Trans": {"SC":"此类灵魂可用于召唤强大的远古 Boss！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::740571722",
      "Source": "Will recharge your stamina and remove torpor!",
      "Trans": {"SC":"会恢复你的耐力并消除眩晕！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::111776906",
      "Source": "Will remove food!",
      "Trans": {"SC":"会移除食物！","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1355625267",
      "Source": "This token is used to summon the Nightmare Boss!",
