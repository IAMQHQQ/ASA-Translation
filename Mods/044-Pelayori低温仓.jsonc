      "Config": {"Item":true,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4205261526",
      "Source": "Are you sure you want to delete selected dinos? This action cannot be undone.",
      "Trans": {"SC":"您确定要删除选中的恐龙吗？此操作无法撤销。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::413634523",
      "Source": "Are you sure you want to delete ALL dinos? This action cannot be undone.",
      "Trans": {"SC":"您确定要删除所有恐龙吗？此操作无法撤销。","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2841167983",
      "Source": "This setting makes player unable to throw dinos inside caves",
      "Trans": {"SC":"此设置使玩家无法在洞穴内放出恐龙","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1192869960",
      "Source": "Prevent deploy in caves",
      "Trans": {"SC":"禁止在洞穴部署","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::523691895",
      "Source": "Cryogun Cooldown",
      "Trans": {"SC":"低温枪冷却时间","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2287858776",
      "Source": "Amount of cooldown seconds between sucessful uses",
