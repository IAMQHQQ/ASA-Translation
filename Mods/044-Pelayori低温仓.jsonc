      "Source": "Neuter gun distance",
      "Trans": {"SC":"绝育枪射程","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2451498511",
      "Source": "Range of the neuter gun, in foundations",
      "Trans": {"SC":"绝育枪的射程（以地基为单位）","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4220206426",
      "Source": "Disable cryopods requirement",
      "Trans": {"SC":"禁用低温舱需求","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::260997923",
      "Source": "Gives free cryopods in cryo terminal and cryo gun if no empty cryopds are found in the inventory",
      "Trans": {"SC":"若背包中无空低温舱，低温终端和低温枪将提供免费低温舱","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2653420433",
      "Source": "Auto trap interval",
      "Trans": {"SC":"自动捕获间隔","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::4012501095",
      "Source": "Seconds between born dino checks in cryo terminal. This is not necessary but can be enabled for different purposes",
      "Trans": {"SC":"低温终端检查新生恐龙的时间间隔（秒）。非必需设置，但可按需启用","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3470125104",
      "Source": "Auto trap max range",
      "Trans": {"SC":"自动捕获最大范围","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2229779446",
      "Source": "Radius, in foundations, that the cryo terminal will check for born babies",
      "Trans": {"SC":"低温终端检查新生幼崽的半径范围（以地基为单位）","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2586277322",
      "Source": "Pass imprint to deployer",
      "Trans": {"SC":"将留痕转移给部署者","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2890645426",
      "Source": "Give imprint of whoever throws the cryopod",
      "Trans": {"SC":"赋予低温舱投掷者相应的留痕效果","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::1421047949",
      "Source": "Imprint amount to give",
      "Trans": {"SC":"赋予的留痕数值","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::3814135422",
      "Source": "Minimum imprint value a bred dino will have. If it's 0 it won't have any effect. If dino has more imprint than the value, it will be skipped",
      "Trans": {"SC":"繁殖恐龙的最低印痕值。设为 0 则无效果；若恐龙印痕值高于此数值，将跳过该设置","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2077935471",
      "Source": "Fully grown babies",
      "Trans": {"SC":"幼崽完全成长","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
    {
      "NamespaceHash": "Content::2152896414",
      "Source": "Make babies get fully grown when thrown out of a cryopod",
      "Trans": {"SC":"使幼崽从低温舱放出时即完全成年","JA":""},
      "Config": {"Item":false,"Dino":false,"Default_Hash":""}
    },
