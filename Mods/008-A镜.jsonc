    },
    {
      "NamespaceHash": "Content::3050666368",
      "Source": "Like a regular Spyglass, except Awesomer!\\n\r\n-Can target: Dinos, Players, Structures, Eggs, Crates and Natural Structures (configurable)\\n\r\n-Bring up the radial menu to adjust settings and quickly toggle options",
      "Trans": { "SC": "超越常规望远镜的卓越之作!\\n\r\n-可锁定目标: 恐龙, 玩家, 建筑物, 蛋, 补给箱, 以及天然建筑物 (均可设置)\\n\r\n-通过呼出轮盘菜单以快速调整设置并切换选项", "JA": "" },
      "Config": { "Item": false, "Dino": false, "Default_Hash": "" }
    },
